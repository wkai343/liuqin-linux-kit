; SPDX-License-Identifier: MIT
; Keep Fedora's fprintd domain and D-Bus policy. Add only the OEM runtime,
; local private state, the FPC/TEE/RPMB nodes and firmware lookup parameter.
(type liuqin_fpc_program_t)
(type liuqin_fpc_state_t)
(type liuqin_fpc_device_t)
(type liuqin_fpc_sysfs_t)
(roletype object_r liuqin_fpc_program_t)
(roletype object_r liuqin_fpc_state_t)
(roletype object_r liuqin_fpc_device_t)
(roletype object_r liuqin_fpc_sysfs_t)
(typeattributeset file_type (liuqin_fpc_program_t liuqin_fpc_state_t liuqin_fpc_sysfs_t))
(typeattributeset device_node (liuqin_fpc_device_t))
(allow fprintd_t liuqin_fpc_program_t (dir (getattr search open read)))
(allow fprintd_t liuqin_fpc_program_t (file (getattr open read map execute execute_no_trans ioctl)))
(allow fprintd_t liuqin_fpc_program_t (lnk_file (getattr read)))
(allow init_t liuqin_fpc_state_t (dir (mounton getattr search open read write add_name remove_name create rmdir setattr)))
(allow init_t liuqin_fpc_state_t (file (getattr setattr)))
(allow fprintd_t liuqin_fpc_state_t (dir (getattr search open read write add_name remove_name create rmdir setattr)))
(allow fprintd_t liuqin_fpc_state_t (file (getattr open read write append create unlink rename setattr lock map ioctl link)))
(allow fprintd_t liuqin_fpc_device_t (chr_file (getattr open read write ioctl map)))
(allow fprintd_t liuqin_fpc_sysfs_t (file (getattr open read write)))
(allow fprintd_t bin_t (file (getattr open read execute execute_no_trans map)))
(allow fprintd_t self (capability (sys_rawio)))
(filecon "/usr/local/lib/liuqin-fpc-oem(/.*)?" any (system_u object_r liuqin_fpc_program_t ((s0) (s0))))
(filecon "/usr/local/lib/liuqin-fpc-oem/fprintd" file (system_u object_r fprintd_exec_t ((s0) (s0))))
(filecon "/var/lib/liuqin-fingerprint(/.*)?" any (system_u object_r liuqin_fpc_state_t ((s0) (s0))))
(filecon "/var/run/liuqin-fpc-oem-runtime(/.*)?" any (system_u object_r liuqin_fpc_state_t ((s0) (s0))))
(filecon "/dev/fpc1020" char (system_u object_r liuqin_fpc_device_t ((s0) (s0))))
(filecon "/dev/tee(priv)?0" char (system_u object_r liuqin_fpc_device_t ((s0) (s0))))
(filecon "/dev/bsg/0:0:0:49476" char (system_u object_r liuqin_fpc_device_t ((s0) (s0))))
(genfscon sysfs "/module/firmware_class/parameters/path" (system_u object_r liuqin_fpc_sysfs_t ((s0) (s0))))
(allow liuqin_fpc_sysfs_t sysfs_t (filesystem (associate)))
(filecon "/sys/module/firmware_class/parameters/path" file (system_u object_r liuqin_fpc_sysfs_t ((s0) (s0))))
(allow init_t liuqin_fpc_sysfs_t (file (mounton getattr open read)))
(allow fprintd_t self (process (setrlimit)))

(type liuqin_fpc_memfd_t)
(roletype object_r liuqin_fpc_memfd_t)
(typeattributeset file_type (liuqin_fpc_memfd_t))
(typetransition fprintd_t tmpfs_t file liuqin_fpc_memfd_t)
(allow liuqin_fpc_memfd_t tmpfs_t (filesystem (associate)))
(allow fprintd_t liuqin_fpc_memfd_t (file (create getattr open read write setattr map ioctl lock)))
(filecon "/run/liuqin-fpc-oem-runtime(/.*)?" any (system_u object_r liuqin_fpc_state_t ((s0) (s0))))
