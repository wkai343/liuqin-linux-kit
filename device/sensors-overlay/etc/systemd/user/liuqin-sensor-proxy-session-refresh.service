[Unit]
Description=Re-announce iio-sensor-proxy to the session's gnome-shell
# gnome-shell claims the accelerometer only at the moment the SensorProxy
# D-Bus name appears.  The boot-time proxy predates the user shell (the
# system-level liuqin-sensor-proxy-refresh.service covers the greeter
# shell), so a desktop session started after it would run the whole login
# without a claim and auto-rotation stays dead.  Re-announce the name once
# the session's shell is actually up and watching; the helper waits for
# org.gnome.Shell on the session bus, restarts the proxy and verifies the
# claim.  The proxy is stateless across restarts.

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/liuqin-sensor-proxy-session-refresh

[Install]
WantedBy=graphical-session.target
