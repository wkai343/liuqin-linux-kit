[Unit]
Description=liuqin private WLAN MAC admission
Documentation=file:///usr/local/sbin/liuqin-wlan-mac
# NetworkManager must never see the factory-zero address first.  The matching
# drop-in makes this a required, ordered dependency, so a missing/corrupt
# private secret fails networking closed rather than silently falling back to
# a shared test identity.
Before=NetworkManager.service network-pre.target
# Wait for coldplug to be submitted, then let the helper wait only for the
# QCA6490 netdev's udev initialization (including its final interface name).
# A global settle also blocks sysinit.target on unrelated device events.
After=systemd-udev-trigger.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/liuqin-wlan-mac
TimeoutStartSec=45
RemainAfterExit=yes
