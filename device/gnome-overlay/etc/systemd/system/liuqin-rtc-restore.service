[Unit]
Description=Restore Liuqin time from the PMIC RTC and saved calibration
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target time-set.target chronyd.service chrony.service systemd-timesyncd.service shutdown.target
Wants=time-set.target
Conflicts=shutdown.target
ConditionPathExists=/sys/firmware/devicetree/base/compatible

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/liuqin-rtc restore
TimeoutStartSec=8
StateDirectory=liuqin-rtc
StateDirectoryMode=0700
UMask=0077
CapabilityBoundingSet=CAP_SYS_TIME
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=sysinit.target
