From: Fady <me@fadyackad.dev> and yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
Subject: [PATCH] hexagonrpcd: fetch and validate complete listener requests

OEM protocol: Qualcomm fastrpc 3b7f929145db1a52a8d0a334805defefd287e97e,
src/listener_android.c and inc/adsp_listener.h. The listener continues a
long request with get_in_bufs2(), passing the same context and the number
of bytes already received, then checks the reported size against capacity.

The Linux port and its protocol tests require matching total lengths
before dispatch and keep the existing registry property allowlist.

diff --git a/hexagonrpcd/interface/adsp_listener.c b/hexagonrpcd/interface/adsp_listener.c
index d2197df..507efdc 100644
--- a/hexagonrpcd/interface/adsp_listener.c
+++ b/hexagonrpcd/interface/adsp_listener.c
@@ -48,3 +48,19 @@ const struct hrpc_method_def_interp4 adsp_listener_next2_def = {
 	.n_inner_types = 0,
 	.inner_types = NULL,
 };
+
+/* get_in_bufs2(ctx, offset, rout bufs, rout bufsLenReq), quic/fastrpc inc/adsp_listener.h */
+struct hrpc_arg_def_interp4 adsp_listener_get_in_bufs2_args[] = {
+	{ HRPC_ARG_WORD, sizeof(uint32_t) },
+	{ HRPC_ARG_WORD, sizeof(uint32_t) },
+	{ HRPC_ARG_OUT_BLOB, sizeof(uint32_t) },
+	{ HRPC_ARG_OUT_BLOB_SEQ, sizeof(char) },
+};
+
+const struct hrpc_method_def_interp4 adsp_listener_get_in_bufs2_def = {
+	.msg_id = 5,
+	.n_args = HRPC_ARRAY_SIZE(adsp_listener_get_in_bufs2_args),
+	.args = adsp_listener_get_in_bufs2_args,
+	.n_inner_types = 0,
+	.inner_types = NULL,
+};
diff --git a/hexagonrpcd/interface/adsp_listener.h b/hexagonrpcd/interface/adsp_listener.h
index 362d775..5744b13 100644
--- a/hexagonrpcd/interface/adsp_listener.h
+++ b/hexagonrpcd/interface/adsp_listener.h
@@ -51,4 +51,22 @@ static inline int adsp_listener_next2(int fd,
 			  inbufs_size, (void *) inbufs);
 }
 
+/*
+ * Fetches the part of a request's input buffers that next2 could not
+ * inline: OFFSET bytes in, up to INBUFS_SIZE bytes into INBUFS
+ * (quic/fastrpc inc/adsp_listener.h: get_in_bufs2(ctx, offset, bufs,
+ * bufsLen, bufsLenReq)).
+ */
+extern const struct hrpc_method_def_interp4 adsp_listener_get_in_bufs2_def;
+static inline int adsp_listener_get_in_bufs2(int fd,
+					     uint32_t rctx,
+					     uint32_t offset,
+					     uint32_t *inbufs_len,
+					     uint32_t inbufs_size, char *inbufs)
+{
+	return hexagonrpc(&adsp_listener_get_in_bufs2_def, fd, ADSP_LISTENER,
+			  rctx, offset, inbufs_len,
+			  inbufs_size, (void *) inbufs);
+}
+
 #endif /* INTERFACE_ADSP_LISTENER_H */
diff --git a/hexagonrpcd/iobuffer.c b/hexagonrpcd/iobuffer.c
index 0c36df6..37f012a 100644
--- a/hexagonrpcd/iobuffer.c
+++ b/hexagonrpcd/iobuffer.c
@@ -54,6 +54,11 @@ static int try_populate_inbuf(struct fastrpc_decoder_context *ctx)
 	if (ctx->size_off)
 		return 0;
 
+	if (!ctx->size) {
+		ctx->idx++;
+		return 0;
+	}
+
 	buf = malloc(ctx->size);
 	if (buf == NULL)
 		return -1;
@@ -127,7 +132,7 @@ void iobuf_free(size_t n_iobufs, struct fastrpc_io_buffer *iobufs)
 	free(iobufs);
 }
 
-struct fastrpc_decoder_context *inbuf_decode_start(uint32_t sc)
+struct fastrpc_decoder_context *inbuf_decode_start(uint32_t sc, size_t wire_len)
 {
 	struct fastrpc_decoder_context *ctx;
 
@@ -135,6 +140,7 @@ struct fastrpc_decoder_context *inbuf_decode_start(uint32_t sc)
 	if (ctx == NULL)
 		return ctx;
 
+	ctx->remaining = wire_len;
 	ctx->idx = 0;
 	ctx->size = 0;
 	ctx->n_inbufs = REMOTE_SCALARS_INBUFS(sc);
@@ -143,7 +149,7 @@ struct fastrpc_decoder_context *inbuf_decode_start(uint32_t sc)
 	ctx->buf_off = 0;
 	ctx->align = 0;
 
-	ctx->inbufs = malloc(sizeof(*ctx->inbufs) * ctx->n_inbufs);
+	ctx->inbufs = calloc(ctx->n_inbufs, sizeof(*ctx->inbufs));
 	if (ctx->inbufs == NULL && ctx->n_inbufs != 0)
 		goto err;
 
@@ -168,15 +174,31 @@ int inbuf_decode_is_complete(struct fastrpc_decoder_context *ctx)
 	return ctx->idx >= ctx->n_inbufs;
 }
 
+void inbuf_decode_abort(struct fastrpc_decoder_context *ctx)
+{
+	iobuf_free(ctx->n_inbufs, ctx->inbufs);
+	free(ctx);
+}
+
 int inbuf_decode(struct fastrpc_decoder_context *ctx, size_t len, const void *src)
 {
 	const char *buf = src;
 	size_t off = 0;
 	int ret = 0;
 
+	if (len > ctx->remaining)
+		return -1;
+
 	while (off < len && ctx->idx < ctx->n_inbufs) {
 		if (!ctx->size || ctx->size_off) {
 			off += consume_size(ctx, len - off, &buf[off]);
+			if (!ctx->size_off) {
+				size_t padding = ctx->size ? ((8 - ctx->align) & 7) : 0;
+				size_t available = ctx->remaining - off;
+
+				if (available < padding || ctx->size > available - padding)
+					return -1;
+			}
 			ret = try_populate_inbuf(ctx);
 		} else if (ctx->align && !ctx->buf_off) {
 			off += consume_alignment(ctx, len - off);
@@ -188,6 +210,7 @@ int inbuf_decode(struct fastrpc_decoder_context *ctx, size_t len, const void *sr
 			return ret;
 	}
 
+	ctx->remaining -= len;
 	return 0;
 }
 
@@ -199,9 +222,12 @@ size_t outbufs_calculate_size(size_t n_outbufs, const struct fastrpc_io_buffer *
 	for (i = 0; i < n_outbufs; i++) {
 		size += 4;
 
-		if (size & 0x7)
-			size += 8 - (size & 0x7);
-		size += outbufs[i].s;
+		/* Match outbufs_encode: empty error replies have only a size word. */
+		if (outbufs[i].s) {
+			if (size & 0x7)
+				size += 8 - (size & 0x7);
+			size += outbufs[i].s;
+		}
 	}
 
 	return size;
diff --git a/hexagonrpcd/iobuffer.h b/hexagonrpcd/iobuffer.h
index de4218d..144ffe8 100644
--- a/hexagonrpcd/iobuffer.h
+++ b/hexagonrpcd/iobuffer.h
@@ -36,6 +36,7 @@ struct fastrpc_decoder_context {
