#!/bin/sh
# SPDX-License-Identifier: MIT
#
# Validate the Snap privilege boundary in an installed Ubuntu Desktop root.
#
# snap-confine is deliberately not supplied by the liuqin device layer: it is
# a Canonical snapd package executable and its capability recipe belongs to
# that package.  A normal tar/rsync deployment can silently drop
# security.capability, leaving a same-named 0755 binary which makes a desktop
# image look complete until the first strict snap launch.  Keep the package
# recipe, the xattr restoration operation and the boot-time admission check in
# one small program so they cannot drift apart.
set -eu

prog=${0##*/}
root=/
action=admit

die() {
	printf '%s: %s\n' "$prog" "$*" >&2
	exit 1
}

usage() {
	die 'usage: liuqin-snap-root-admission [--root <target-root>] [--restore|--verify|--admit]'
}

while [ "$#" -gt 0 ]; do
	case $1 in
	--root)
		[ "$#" -ge 2 ] || usage
		root=$2
		shift 2
		;;
	--restore) action=restore; shift ;;
	--verify) action=verify; shift ;;
	--admit) action=admit; shift ;;
	*) usage ;;
	esac
done

[ -d "$root" ] || die "target root is unavailable: $root"
case $root in
/|/*) ;;
*) die "target root must be absolute: $root" ;;
esac
root=${root%/}
[ -n "$root" ] || root=/

snap_confine=$root/usr/lib/snapd/snap-confine
snap_caps=$root/usr/lib/snapd/snap-confine.caps
snap_postinst=$root/var/lib/dpkg/info/snapd.postinst
# This is the literal, one-line payload in Canonical's snapd package.  Do not
# derive an expectation from an already-modified xattr or from an arbitrary
# same-named .caps file: either would turn corruption into a self-confirming
# test.
snap_caps_literal='cap_chown,cap_dac_override,cap_dac_read_search,cap_fowner,cap_setgid,cap_setuid,cap_sys_chroot,cap_sys_ptrace,cap_sys_admin,cap_sys_resource=p'
postinst_literal='        setcap -q - /usr/lib/snapd/snap-confine < /usr/lib/snapd/snap-confine.caps'

regular_root_file() {
	path=$1 expected_mode=$2
	[ -f "$path" ] && [ ! -L "$path" ] &&
		[ "$(stat -c '%a:%u:%g:%F' "$path" 2>/dev/null)" = "$expected_mode:0:0:regular file" ]
}

package_contract() {
	regular_root_file "$snap_confine" 755 || return 1
	regular_root_file "$snap_caps" 644 || return 1
	regular_root_file "$snap_postinst" 755 || return 1
	# cmp makes the package recipe a literal contract, including the sole final
	# newline.  Command substitution would erase it and accept a truncated file.
	printf '%s\n' "$snap_caps_literal" | cmp -s - "$snap_caps" || return 1
	[ "$(grep -Fxc "$postinst_literal" "$snap_postinst" 2>/dev/null || :)" = 1 ] || return 1
}

capability_contract() {
	getcap_bin=${LIUQIN_GETCAP:-/usr/sbin/getcap}
	[ -x "$getcap_bin" ] || return 1
	actual=$($getcap_bin -n "$snap_confine" 2>/dev/null || :)
	[ "$actual" = "$snap_confine $snap_caps_literal" ]
}

runtime_snap_capability_contract() {
	# snapd re-execs from the mounted snapd snap.  Checking only the ext4
	# package path missed kernels built without SQUASHFS_XATTR: getcap looked
	# correct on /usr/lib while the executable actually used by every strict
	# snap had no visible security.capability.
	getcap_bin=${LIUQIN_GETCAP:-/usr/sbin/getcap}
	[ -x "$getcap_bin" ] || return 1
	runtime=$(/usr/bin/readlink -f /snap/snapd/current/usr/lib/snapd/snap-confine 2>/dev/null || :)
	case $runtime in /snap/snapd/[0-9]*/usr/lib/snapd/snap-confine) ;; *) return 1 ;; esac
	regular_root_file "$runtime" 755 || return 1
	actual=$($getcap_bin -n "$runtime" 2>/dev/null || :)
	[ "$actual" = "$runtime $snap_caps_literal" ]
}

restore_capability() {
	setcap_bin=${LIUQIN_SETCAP:-/usr/sbin/setcap}
	[ -x "$setcap_bin" ] || die 'setcap is unavailable; cannot restore snap-confine security.capability'
	# Match Canonical's snapd.postinst exactly: libcap parses the target
	# package's own .caps file and writes security.capability to that target
	# executable.  Never copy an xattr from the build host or a device layer.
	"$setcap_bin" -q - "$snap_confine" <"$snap_caps" ||
		die 'setcap failed while restoring snap-confine security.capability'
}

check_apparmor() {
	[ -r /sys/kernel/security/lsm ] || return 1
	grep -Eq '(^|,)apparmor(,|$)' /sys/kernel/security/lsm || return 1
	[ -r /sys/module/apparmor/parameters/enabled ] || return 1
	[ "$(cat /sys/module/apparmor/parameters/enabled 2>/dev/null)" = Y ]
}

check_fuse() {
	[ "$(stat -c '%a:%u:%g:%F' /dev/fuse 2>/dev/null || :)" = \
		'666:0:0:character special file' ]
}

package_contract || die 'Canonical snapd package contract is missing, modified, symlinked, or has unsafe metadata'
case $action in
restore)
	restore_capability
	capability_contract || die 'snap-confine capability did not match the Canonical package recipe after restoration'
	;;
verify)
	capability_contract || die 'snap-confine security.capability does not match the Canonical package recipe'
	;;
admit)
	capability_contract || die 'snap-confine security.capability does not match the Canonical package recipe'
	runtime_snap_capability_contract || die 'mounted snapd snap-confine capability is unavailable; require SQUASHFS_XATTR'
	check_apparmor || die 'AppArmor is not active in the kernel LSM stack'
	check_fuse || die '/dev/fuse is unavailable or not 0666 root:root'
	;;
*) usage ;;
esac

printf '%s: PASS (%s)\n' "$prog" "$action"
