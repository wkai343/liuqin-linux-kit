#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu

marker=/etc/liuqin-rescue-enabled
unit=liuqin-gnome-usb-rescue.service

listening() {
    ss -H -ltn 'sport = :2323' | awk '
        $4 == "192.168.7.2:2323" { found = 1 }
        END { exit !found }'
}

case ${1:-status} in
on|off)
    [ "$(id -u)" = 0 ] || { echo "Use sudo liuqin-rescue $1" >&2; exit 1; }
    if [ "$1" = off ]; then
        rm -f "$marker"
        echo 'Disabling rescue; existing rescue connections will close.'
        systemctl stop "$unit"
        exit 0
    fi
    touch "$marker"
    if ! listening; then
        systemctl restart "$unit"
    fi
    if ! listening; then
        echo "Rescue is not listening. Check: systemctl status $unit" >&2
        exit 1
    fi
    echo 'Rescue enabled: 192.168.7.2:2323 (unauthenticated root access).'
    ;;
status)
    if [ -e "$marker" ]; then
        echo 'Startup: enabled'
    else
        echo 'Startup: disabled'
    fi
    if listening; then
        echo 'Listener: 192.168.7.2:2323 (unauthenticated root access)'
    else
        echo 'Listener: inactive'
        exit 1
    fi
    ;;
*) echo 'Usage: liuqin-rescue [on|off|status]' >&2; exit 2 ;;
esac
