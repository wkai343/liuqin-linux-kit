XIAOMI_SVID = 0x2717
FAST_CHARGE_NOTIFICATION_TITLE = "Charging profile"
NOTIFICATION_STATE_FILE = "/run/liuqin-mipps-auth/last-notification"
CHARGE_PROFILE_STATE_FILE = "/run/liuqin-mipps-auth/charge-profile"
ATTEMPT_STATE_FILE = "/run/liuqin-mipps-auth/role-first-attempt"
READY_STATE_FILE = "/run/liuqin-mipps-auth/readiness-attempt"
VERIFIED_STATE_FILE = "/run/liuqin-mipps-auth/verified-attach"
ACTIVE_ATTACH = None
AUTHENTICATED_STATE_FILE = "/run/liuqin-mipps-auth/authenticated-adapter"
USB_ONLINE_STATE_FILE = "/run/liuqin-mipps-auth/usb-online"
SYSTEMD_UNIT = "liuqin-mipps-auth.service"
SYSTEMD_PATH_UNIT = "liuqin-mipps-auth.path"
PENDING_EVENT_FILE = "/run/liuqin-mipps-auth/pending"
READINESS_ATTEMPTS = 3
READINESS_RETRY_DELAY = 2.0
# OS2.0.6.0.VMYCNXM /vendor/bin/batterysecret, usbpd_conmunication()
# and usbpd_send_vdm_cmd(): these are poll counts, NOT millisecond delays.
# See docs/FASTCHARGE-SOURCES.md for the pinned binary and function addresses.
VDM_POLL_COUNTS = {1: 5, 2: 5, 3: 5, 4: 500, 5: 500, 7: 5, 6: 5}
VDM_POLL_INTERVAL = 0.01
VDM_CONNECT_INTERVAL = 0.02
ROLE_ATTEMPTS = 4
ROLE_TIMEOUT = 12.0
TRANSIENT_READ_ERRORS = (errno.EAGAIN, errno.EBUSY)
TRANSIENT_ROLE_ERRORS = (errno.EAGAIN, errno.EBUSY, errno.ETIMEDOUT, errno.EIO)


class UnsupportedChargerError(Exception):
    def __init__(self, message, terminal=False):
        super().__init__(message)
        self.terminal = terminal

class ChargerDisconnectedError(UnsupportedChargerError):
    pass


class AdapterReadinessTimeout(UnsupportedChargerError):
    def __init__(self, last, snapshot):
        super().__init__(f"adapter capabilities not ready: {last}")
        # None means unreadable, not a stable capability snapshot.
        self.snapshot = snapshot


class VdmResponseTimeout(UnsupportedChargerError):
    """A command was written, but its UVDM state did not arrive in time.

    This is batterysecret's local -EAGAIN, not a failed GLINK write/read.
    Only this condition allows the one-pass sequence to advance.
    """

    def __init__(self, cmd, last):
        super().__init__(f"timed out waiting for VDM state {cmd}, last={last}")
        self.cmd = cmd


def check_usb_connection(attach_token=None):
    online = usb_is_online()
    if online is None:
        raise OSError(errno.EAGAIN, "USB power status is unreadable")
    if not online:
        raise ChargerDisconnectedError("USB power disconnected", terminal=True)
    current = current_attach_token()
    if attach_token is not None and current != attach_token:
        raise ChargerDisconnectedError("Type-C partner changed", terminal=True)
    return current


def adapter_readiness_snapshot(root):
    # Preserve read errors instead of converting them to apparently valid data.
    return [read_node(root, "real_type"), read_node(root, "current_state"),
            int(read_node(root, "pdo2")[:8], 16)]


def adapter_is_ready(snapshot):
    return (snapshot is not None and snapshot[0] in ("PD", "PD_PPS")
            and snapshot[1] == "SNK_Ready" and snapshot[2] != 0)


def readiness_read_error(exc):
    return isinstance(exc, ValueError) or exc.errno in (
        errno.EAGAIN, errno.EBUSY, errno.ETIMEDOUT, errno.EIO,
        errno.ENODEV, errno.ENODATA, errno.ENOENT)


def readiness_retry_state():
    try:
        state = json.loads(read_state_file(READY_STATE_FILE) or "null")
        if (isinstance(state, dict) and isinstance(state.get("key"), list)
                and isinstance(state.get("attempts"), int)
                and 1 <= state["attempts"] <= READINESS_ATTEMPTS
                and isinstance(state.get("retry_at"), (float, int))):
            return state
    except (ValueError, TypeError):
        pass
    # Includes the old pre-wait snapshot cache, which could block recovery.
    return {}


def wait_adapter_ready(root, timeout, attach_token):
    deadline = time.monotonic() + timeout
    last = "no capabilities"
    while True:
        check_usb_connection(attach_token)
        snapshot = None
        try:
            snapshot = adapter_readiness_snapshot(root)
            last = str(snapshot)
            if adapter_is_ready(snapshot):
                return snapshot[0]
        except (ValueError, OSError) as exc:
            if not readiness_read_error(exc):
                raise
            last = str(exc)
        if time.monotonic() >= deadline:
            raise AdapterReadinessTimeout(last, snapshot)
        time.sleep(0.1)


def require_current_attach():
    if not ACTIVE_ATTACH:
        raise ChargerDisconnectedError("no Type-C partner", terminal=True)
    check_usb_connection(ACTIVE_ATTACH)


def clear_verdict(root):
    # Clear the local proof even if the transport has gone away.
    write_state_file(VERIFIED_STATE_FILE, "none")
    write_state_file(AUTHENTICATED_STATE_FILE, "none")
    # Rewriting zero on every OEM notification can generate another event.
    if current_string_value(root, "pd_verifed") != "0":
        write_node_if_present(root, "pd_verifed", "0")


def set_verify_process(root, active):
    value = "1" if active else "0"
    # Avoid a write/uevent loop on repeated notifications. This also clears
    # an interrupted previous worker's flag before starting a new exchange.
    if read_node(root, "verify_process") != value:
        write_node(root, "verify_process", value)


def reserve_adapter_attempt(token):
    # Persist before touching the role. Bounded role retries happen inside
    # this worker; notifications must not replay a completed/failed exchange.
    write_state_file(ATTEMPT_STATE_FILE, token)
    if read_state_file(ATTEMPT_STATE_FILE) != token:
        raise RuntimeError("cannot persist adapter attempt; refusing to repeat handshake")


def attempt_available(force=False):
    if force:
        return True
    if read_state_file(ATTEMPT_STATE_FILE) == ACTIVE_ATTACH:
        print("role_first=already_attempted_this_attach")
        return False
    return True


def find_xiaomi_dir():
    candidates = ["/sys/class/qcom-battery"]
    candidates += glob.glob("/sys/devices/platform/pmic-glink/*/xiaomi")
    for path in candidates:
        if os.path.exists(os.path.join(path, "request_vdm_cmd")):
            return path
    raise FileNotFoundError("request_vdm_cmd sysfs node not found")


def read_node(root, name):
    with open(os.path.join(root, name), "r", encoding="ascii", errors="ignore") as f:
        return f.read().strip().replace("\x00", "")


def write_node(root, name, value):
    with open(os.path.join(root, name), "w", encoding="ascii") as f:
        f.write(value)
        if not value.endswith("\n"):
            f.write("\n")


def write_node_if_present(root, name, value):
    path = os.path.join(root, name)
    if os.path.exists(path):
        write_node(root, name, value)
        return True
    return False


def find_power_supply(*names):
    for name in names:
        path = os.path.join("/sys/class/power_supply", name)
        if os.path.exists(path):
            return path
    return None


def usb_is_online():
    # An unavailable property is not evidence of a disconnect. Callers that
    # start a transaction must still require a positive online result.
    path = find_power_supply("qcom-battmgr-usb", "usb")
    if not path:
        print("warning: USB power_supply node not found", file=sys.stderr)
        return None

    try:
        value = read_node(path, "online")
        if value not in ("0", "1"):
            raise ValueError(f"invalid USB online value {value!r}")
        return value == "1"
    except (OSError, ValueError) as e:
        print(f"warning: failed to read {path}/online: {e}", file=sys.stderr)
        return None


def wait_usb_online(timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if usb_is_online():
            return True
        time.sleep(0.05)
    return usb_is_online()


def find_typec_port():
    for path in glob.glob("/sys/class/typec/port*"):
        if os.path.exists(os.path.join(path, "data_role")):
            return path
    return None


def cable_current_capability_amps():
    """Return the e-marked VBUS current rating of the attached cable in
    amps, or None when the kernel exposes no cable identity.

    USB-PD passive and active cable VDO1 bits 6:5 encode the rating:
    0b01 = 3 A, 0b10 = 5 A.  Linux publishes the VDO under
    /sys/class/typec/port*-cable/identity/product_type_vdo1 when the
    Type-C stack retrieved the cable's Discover Identity response.
    """
    for cable in sorted(glob.glob("/sys/class/typec/port*-cable")):
        vdo_path = os.path.join(cable, "identity", "product_type_vdo1")
        try:
            with open(vdo_path, "r", encoding="ascii") as f:
                vdo = int(f.read().strip(), 16)
        except (OSError, ValueError):
            continue
        if vdo == 0:
            continue
        return {1: 3, 2: 5}.get((vdo >> 5) & 0x3)
    return None


def unverified_adapter_allowed(root):
    """Decide whether pd_verifed may be asserted for an adapter that failed
    Xiaomi's authentication.  Returns (allowed, reason).

    The high-voltage charge path draws well above 3 A from the adapter, so
    the cable must be e-marked for 5 A.  When the kernel exposes the cable
    identity that rating is checked directly.  When it does not, the
    decision relies on USB-PD's source-side rule: a compliant source only
    offers more than 3 A after reading a 5 A e-marker itself, so the ADSP
    cannot negotiate a contract the cable does not support.
    """
    real_type = current_string_value(root, "real_type")
    if real_type != "PD_PPS":
        return False, f"real_type={real_type or 'unknown'} is not PD_PPS"

    amps = cable_current_capability_amps()
    if amps is None:
        return True, "cable identity not exposed by the kernel; " \
                     "relying on adapter-side e-marker enforcement"
    if amps >= 5:
        return True, f"cable e-marked for {amps} A"
    return False, f"cable e-marked for {amps} A, 5 A required"


def current_attach_token():
    for path in sorted(glob.glob("/sys/class/typec/port*-partner")):
        try:
            st = os.stat(path)
        except OSError:
            continue
        return f"{os.path.basename(path)}:{st.st_dev}:{st.st_ino}:{st.st_ctime_ns}"
    return None


def read_state_file(path):
    try:
        with open(path, "r", encoding="ascii", errors="ignore") as f:
            return f.read().strip()
    except FileNotFoundError:
        return None
    except OSError as e:
        print(f"warning: failed to read {path}: {e}", file=sys.stderr)
        return None


def write_state_file(path, value):
    try:
        directory = os.path.dirname(path)
        if directory:
            os.makedirs(directory, exist_ok=True)
        with open(path, "w", encoding="ascii") as f:
            f.write(value)
            f.write("\n")
    except OSError as e:
        print(f"warning: failed to write {path}: {e}", file=sys.stderr)


def start_systemd_unit(unit):
    systemctl = "/usr/bin/systemctl" if os.path.exists("/usr/bin/systemctl") else "systemctl"
    subprocess.run([systemctl, "--no-block", "start", unit],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                   timeout=2, check=True)


def queue_auth_event():
    # A level-triggered path survives StartUnit coalescing and the worker's
    # exit window. systemd rechecks it after the service becomes inactive.
    os.makedirs(os.path.dirname(PENDING_EVENT_FILE), exist_ok=True)
    fd = os.open(PENDING_EVENT_FILE, os.O_WRONLY | os.O_CREAT | os.O_CLOEXEC, 0o600)
    os.close(fd)
    start_systemd_unit(SYSTEMD_PATH_UNIT)


def consume_auth_event():
    # Claim before reading the charger. Never remove events in final cleanup:
    # an event arriving during this worker belongs to the next activation.
    try:
        os.unlink(PENDING_EVENT_FILE)
    except FileNotFoundError:
        pass


def parse_power_watts(value):
    try:
        power = int(value.strip(), 0)
    except ValueError:
        return None

    if power <= 0:
        return None
    return power


def parse_int(value):
    try:
        return int(value.strip(), 0)
    except ValueError:
        return None


def current_int_value(root, name):
    path = os.path.join(root, name)
    if not os.path.exists(path):
        return None
    try:
        return parse_int(read_node(root, name))
    except OSError as e:
        print(f"warning: failed to read {path}: {e}", file=sys.stderr)
        return None


def current_string_value(root, name):
    path = os.path.join(root, name)
    if not os.path.exists(path):
        return None
    try:
        return read_node(root, name).strip()
    except OSError as e:
        print(f"warning: failed to read {path}: {e}", file=sys.stderr)
        return None


def current_battery_capacity():
    battery = find_power_supply("qcom-battmgr-bat", "battery")
    if not battery:
        return None
    return current_int_value(battery, "capacity")


def current_power_max_watts(root):
    path = os.path.join(root, "power_max")
    if not os.path.exists(path):
        return None
    try:
        return parse_power_watts(read_node(root, "power_max"))
    except OSError as e:
        print(f"warning: failed to read {path}: {e}", file=sys.stderr)
        return None


def gvariant_string(value):
    return "'" + value.replace("\\", "\\\\").replace("'", "\\'") + "'"


def notify_session_bus(bus, uid, title, body):
    env = os.environ.copy()
    env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={bus}"
    env["XDG_RUNTIME_DIR"] = os.path.dirname(bus)

    def drop_privileges():
        if os.geteuid() != 0:
            return
        entry = pwd.getpwuid(uid)
        os.setgid(entry.pw_gid)
        os.setuid(uid)

    cmd = [
        "gdbus", "call", "--session",
        "--dest", "org.freedesktop.Notifications",
        "--object-path", "/org/freedesktop/Notifications",
        "--method", "org.freedesktop.Notifications.Notify",
        gvariant_string("liuqin-mipps-auth"),
        "0",
        gvariant_string("battery-good-symbolic"),
        gvariant_string(title),
        gvariant_string(body),
        "[]",
        "{}",
        "5000",
    ]
    subprocess.run(cmd, env=env, preexec_fn=drop_privileges,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                   timeout=2, check=True)


def pd_verified(root):
    path = os.path.join(root, "pd_verifed")
    if not os.path.exists(path):
        return False
    try:
        return read_node(root, "pd_verifed").strip() == "1"
    except OSError:
        return False


def charge_mode_body(mode, watts):
    if mode == "MiPPS":
        return f"MiPPS active; reported maximum {watts}W"
    if mode == "PD":
        return "PD enabled"
    return f"PPS negotiated; reported maximum {watts}W"


def current_charge_profile(root, pd_auth):
    capacity = current_battery_capacity()
    if capacity is None or capacity >= 95:
        return None

    watts = current_power_max_watts(root)
    if not watts:
        return None

    fastchg_mode = current_int_value(root, "fastchg_mode")
    real_type = current_string_value(root, "real_type")
    fastchg_active = fastchg_mode is not None and fastchg_mode > 0

    if pd_auth and fastchg_active:
        return "MiPPS", watts

    if real_type == "PD_PPS":
        return "PPS", watts

    if real_type == "PD":
        return "PD", watts

    return None


def wait_charge_profile(root, pd_auth, timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        profile = current_charge_profile(root, pd_auth)
        if profile:
            return profile
        time.sleep(0.1)
    return current_charge_profile(root, pd_auth)


def charge_profile_notification_key(profile):
    attach_token = current_attach_token() or "no-typec-partner"
    mode, watts = profile
    return f"{attach_token}:{mode}:{watts}"


def write_charge_profile(profile):
    if not profile:
        write_state_file(CHARGE_PROFILE_STATE_FILE, "none")
        return
    mode, _ = profile
    write_state_file(CHARGE_PROFILE_STATE_FILE, mode)


def notify_charge_profile(root, pd_auth, state_file, timeout=2.0):
    profile = wait_charge_profile(root, pd_auth, timeout)
    write_charge_profile(profile)
    if not profile:
        print("fast_charge_notification=none")
        write_state_file(state_file, "none")
        return False

    mode, watts = profile
    key = charge_profile_notification_key(profile)
    if read_state_file(state_file) == key:
        print(f"fast_charge_notification=skipped:{mode}:{watts}W")
        return False

    body = charge_mode_body(mode, watts)
    sent = False
    for bus in sorted(glob.glob("/run/user/[0-9]*/bus")):
        try:
            st = os.stat(bus)
            notify_session_bus(bus, st.st_uid,
                               FAST_CHARGE_NOTIFICATION_TITLE, body)
            sent = True
        except (KeyError, OSError, subprocess.SubprocessError) as e:
            print(f"warning: failed to send notification on {bus}: {e}",
                  file=sys.stderr)

    if sent:
        write_state_file(state_file, key)
        if mode == "PD":
            print("fast_charge_notification=PD")
        else:
            print(f"fast_charge_notification={mode}:{watts}W")
    else:
        print("warning: no desktop session accepted fast charge notification",
              file=sys.stderr)
    return sent


def notify_completed_charge(root, state_file, pd_auth=None, timeout=2.0):
    if pd_auth is None:
        # pd_verifed can also be set by the optional PPS policy. Only a
        # remembered successful digest exchange establishes Xiaomi auth.
        token = current_attach_token()
        pd_auth = (bool(token) and pd_verified(root) and
                   read_state_file(AUTHENTICATED_STATE_FILE) == token)
    return notify_charge_profile(root, pd_auth, state_file, timeout)


def partner_source_usb_data():
    """Read the current partner's first fixed source PDO, never cached SVID.

    None means unreported/invalid, not a power-only source. The kernel owns
    PDO lifetime; detach removes the directory with the Type-C partner.
    """
    partners = glob.glob("/sys/class/typec/port*-partner")
    if len(partners) != 1:
        return None
    root = os.path.join(partners[0], "usb_power_delivery/source-capabilities/1:fixed_supply")
    try:
        voltage = read_node(root, "voltage")
        current = read_node(root, "maximum_current")
        data = read_node(root, "usb_communication_capable")
        if voltage != "5000mV" or not current.endswith("mA") or int(current[:-2]) <= 0:
            return None
        return {"0": False, "1": True}.get(data)
    except (OSError, ValueError):
        return None


def wait_partner_source_usb_data(timeout):
    deadline = time.monotonic() + timeout
    while True:
        require_current_attach()
        value = partner_source_usb_data()
        require_current_attach()
        if value is not None or time.monotonic() >= deadline:
            return value
        time.sleep(0.1)


def request_data_role(port, role, timeout):
    # Bound the synchronous UCSI store and preserve errno. A shell's generic
    # exit status cannot distinguish a transient refusal from EACCES/EINVAL.
    if role not in ("host", "device"):
        raise ValueError("invalid Type-C data role")
    command = """import sys
try:
    with open(sys.argv[1], 'w', encoding='ascii') as stream:
        stream.write(sys.argv[2])
except OSError as exc:
    print(str(exc), file=sys.stderr)
    sys.exit(exc.errno or 1)
"""
    try:
        result = subprocess.run([sys.executable, "-c", command,
                                 os.path.join(port, "data_role"), role], text=True,
                                capture_output=True, timeout=timeout)
        return result.returncode, result.stderr.strip()
    except subprocess.TimeoutExpired as exc:
        return errno.ETIMEDOUT, str(exc)


def request_host_data_role(port, timeout):
    return request_data_role(port, "host", timeout)


def take_host_data_role(root, port, args):
    # Stock retries DR_SWAP up to four times; its not-ready loop is unbounded.
    # Keep the retry count, but bound the whole operation for the Linux unit.
    deadline = time.monotonic() + ROLE_TIMEOUT
    for attempt in range(1, ROLE_ATTEMPTS + 1):
        require_current_attach()
        if "[host]" in read_node(port, "data_role"):
            return True
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        real_type = wait_adapter_ready(root, remaining, ACTIVE_ATTACH)
        data = partner_source_usb_data()
        if data is not False and not (data is None and args.probe_unknown_pps and real_type == "PD_PPS"):
            raise UnsupportedChargerError("source data capability changed before role retry")
        require_current_attach()
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        print(f"role_request=begin attempt={attempt}", flush=True)
        code, error = request_host_data_role(port, min(8.0, remaining))
        require_current_attach()
        role = read_node(port, "data_role")
        print(f"role_request=end returncode={code} role={role} stderr={error}", flush=True)
        # A timed-out store may have completed the swap. Never swap again
        # solely because the child reported an error.
        if "[host]" in role:
            return True
        if code and code not in TRANSIENT_ROLE_ERRORS:
            break
        for _ in range(4):
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            time.sleep(min(0.1, remaining))
            require_current_attach()
            if "[host]" in read_node(port, "data_role"):
                return True
    print("role_first=no_host_no_adapter_commands")
    return False


def role_first_prelude(root, args):
    require_current_attach()
    snapshot = None
    try:
        snapshot = adapter_readiness_snapshot(root)
    except (OSError, ValueError) as exc:
        if not readiness_read_error(exc):
            raise
    previous = readiness_retry_state()
    key = [ACTIVE_ATTACH, snapshot]
    if not args.force and previous.get("key") == key and not adapter_is_ready(snapshot):
        if previous["attempts"] >= READINESS_ATTEMPTS:
            print("role_first=unchanged_unready_source")
            return False
        # A newly readable/ready source bypasses this delay. A detached source
        # cancels it, leaving the next connection's pending event untouched.
        deadline = min(previous["retry_at"], time.monotonic() + READINESS_RETRY_DELAY)
        while time.monotonic() < deadline:
            require_current_attach()
            remaining = deadline - time.monotonic()
            if remaining > 0:
                time.sleep(min(0.1, remaining))
    try:
        real_type = wait_adapter_ready(root, args.ready_timeout, ACTIVE_ATTACH)
    except AdapterReadinessTimeout as exc:
        require_current_attach()
        # Cache the failed observation, never the snapshot from before waiting.
        # Read errors have their own key and cannot poison a healthy snapshot.
        key = [ACTIVE_ATTACH, exc.snapshot]
        count = previous.get("attempts", 0) if previous.get("key") == key else 0
        count = min(count + 1, READINESS_ATTEMPTS)
        state = json.dumps(dict(key=key, attempts=count,
                                retry_at=time.monotonic() + READINESS_RETRY_DELAY))
        write_state_file(READY_STATE_FILE, state)
        if read_state_file(READY_STATE_FILE) != state:
            raise RuntimeError("cannot persist readiness retry budget")
        if count < READINESS_ATTEMPTS:
            queue_auth_event()
        raise
    require_current_attach()
    usb_data = wait_partner_source_usb_data(args.timeout)
    if usb_data is True:
        # M81 can retain the previous charger's SVID even on a computer.
        print("role_first=usb_data_source_no_role_swap")
        return False
    if usb_data is None and not (args.probe_unknown_pps and real_type == "PD_PPS"):
        print("role_first=source_data_capability_unknown")
        return False
    svid = current_adapter_svid(root)
    probe = (real_type == "PD_PPS" and svid in (None, 0) and
             (usb_data is False or args.probe_unknown_pps))
    if svid != XIAOMI_SVID and not probe:
        print(f"role_first=unidentified_or_non_xiaomi adapter_svid={svid}")
        return False
    if probe:
        print(f"role_first={'power_only_pps_probe' if usb_data is False else 'explicit_pps_probe'}")
    if not attempt_available(args.force):
        return False
    port = find_typec_port()
    if not port:
        print("role_first=no_typec_port")
        return False
    role = read_node(port, "data_role")
    require_current_attach()
    if args.no_data_role_swap and not args.role_first and "[host]" not in role:
        print("role_first=host_required_but_swap_disabled")
        return False
    reserve_adapter_attempt(ACTIVE_ATTACH)
    set_verify_process(root, True)
    changed_role = "[host]" not in role
    if changed_role:
        time.sleep(0.07)
        require_current_attach()
        if not take_host_data_role(root, port, args):
            return False
    # DR_SWAP can reveal or replace the cached identity. Recheck even a
    # previously known SVID; discovery alone does not establish authentication.
    deadline = time.monotonic() + args.timeout
    while current_adapter_svid(root) != XIAOMI_SVID:
        require_current_attach()
        if time.monotonic() >= deadline:
            print("role_first=probe_did_not_identify_xiaomi")
            if changed_role:
                require_current_attach()
                code, error = request_data_role(port, "device", 8)
                print(f"role_restore=returncode:{code} stderr={error}")
            return False
        time.sleep(0.05)
    require_current_attach()
    print("role_first=proceed")
    return True


def vdm_state(root):
    text = read_node(root, "request_vdm_cmd")
    state, _, payload = text.partition(",")
    state = int(state)
    if not 0 <= state <= 9:
        raise ValueError(f"invalid UVDM state {state}")
    return state, payload.strip()


def poll_vdm_state(root, expected, count, interval, attach_token):
    # Bound both reads and elapsed time: a slow/failed GLINK read must not
    # multiply the stock 500-poll budget into minutes of waiting.
    deadline = time.monotonic() + count * interval
    last = None
    last_error = None
    for sample in range(count):
        if sample and time.monotonic() >= deadline:
            break
        check_usb_connection(attach_token)
        try:
            last = vdm_state(root)
            last_error = None
        except OSError as exc:
            if exc.errno not in TRANSIENT_READ_ERRORS:
                raise
            last_error = exc
        check_usb_connection(attach_token)
        if last_error is None and last is not None:
            if expected is None:
                if last[0] != 0:
                    return last
            elif last[0] == 0:
                raise ChargerDisconnectedError("firmware UVDM state is disconnected", terminal=True)
            elif last[0] == expected:
                return last
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        time.sleep(min(interval, remaining))
    check_usb_connection(attach_token)
    if last_error is not None:
        raise last_error
    if expected is None:
        raise UnsupportedChargerError("firmware UVDM connection not ready")
    raise VdmResponseTimeout(expected, last)


def send_vdm(root, cmd, payload="null"):
    if cmd not in VDM_POLL_COUNTS:
        raise ValueError(f"unsupported UVDM command {cmd}")
    require_current_attach()
    attach_token = ACTIVE_ATTACH
    # Stock waits for a nonzero UVDM state before every command (20 reads
    # for command 1, four for later commands), then checks Xiaomi identity.
    poll_vdm_state(root, None, 20 if cmd == 1 else 4,
                   VDM_CONNECT_INTERVAL, attach_token)
    if normalize_adapter_svid(read_node(root, "adapter_svid")) != XIAOMI_SVID:
        raise UnsupportedChargerError("Xiaomi identity changed during adapter commands")
    require_current_attach()
    write_node(root, "request_vdm_cmd", f"{cmd},{payload}")
    return poll_vdm_state(root, cmd, VDM_POLL_COUNTS[cmd],
                          VDM_POLL_INTERVAL, attach_token)


def normalize_adapter_id(adapter_id):
    adapter_id = adapter_id.strip().lower()[:8]
    if len(adapter_id) == 8 and adapter_id != "00000000":
        bytes.fromhex(adapter_id)
        return adapter_id
    return None


def normalize_adapter_svid(adapter_svid):
    adapter_svid = adapter_svid.strip().lower()
    if not adapter_svid:
        return None
    token = adapter_svid.split()[0]
    if token in ("2717", "0x2717"):
        return XIAOMI_SVID
    try:
        return int(token, 0)
    except ValueError:
        return None


def current_adapter_svid(root):
    try:
        return normalize_adapter_svid(read_node(root, "adapter_svid"))
    except OSError:
        return None


def detect_adapter_id(root, timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        require_current_attach()
        try:
            adapter_id = normalize_adapter_id(read_node(root, "adapter_id"))
            if adapter_id:
                return adapter_id
        except (FileNotFoundError, ValueError):
            pass
        time.sleep(0.05)
    return None


def auth_already_completed(root):
    """Return True/False for known state, None when a proven attach is unreadable."""
    token = current_attach_token()
    # Stock checks verify_process=0 and pd_verifed=1, not the last command
    # number. A lost 7/6 response must not erase a verified fresh digest.
    # A fresh attach has no proof. Leave its first UVDM read to the bounded
    # connection wait, where a transient read can recover before any command.
    if not token or read_state_file(VERIFIED_STATE_FILE) != token:
        return False
    online = usb_is_online()
    if online is False:
        return False
    unknown = online is None
    # Read all three even after an error: a definite gate reset or firmware
    # disconnect takes precedence over a different unavailable property.
    for name, expected in (("pd_verifed", "1"), ("verify_process", "0"),
                           ("request_vdm_cmd", None)):
        try:
            if expected is None:
                if vdm_state(root)[0] == 0:
                    return False
            else:
                value = read_node(root, name)
                if value not in ("0", "1"):
                    raise ValueError(f"invalid {name} value {value!r}")
                if value != expected:
                    return False
        except (OSError, ValueError) as exc:
            print(f"warning: completed auth state unreadable: {name}: {exc}", file=sys.stderr)
            unknown = True
    if current_attach_token() != token or read_state_file(VERIFIED_STATE_FILE) != token:
        return False
    return None if unknown else True


def print_status(root):
    for name in ("request_vdm_cmd", "authentic", "slave_authentic",
                 "adapter_svid", "adapter_id", "apdo_max",
                 "power_max", "fastchg_mode", "quick_charge_type",
                 "pps_ptf", "verify_process", "pd_verifed",
                 "bq2597x_bus_voltage", "bq2597x_bus_current",
                 "bq2597x_slave_bus_current"):
        path = os.path.join(root, name)
        if os.path.exists(path):
            try:
                value = read_node(root, name)
            except OSError as exc:
                print(f"warning: status unavailable: {name}: {exc}", file=sys.stderr)
                continue
            print(f"{name}={value}")


def report_completed_charge(root, status=False):
    # Reporting follows the transaction commit. It must never undo a valid
    # digest or reopen the gate on its own when the transport is unavailable.
    if status:
        print_status(root)
    try:
        notify_completed_charge(root, NOTIFICATION_STATE_FILE)
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        print(f"warning: charge notification unavailable: {exc}", file=sys.stderr)


def node_is_one(root, name):
    path = os.path.join(root, name)
    return os.path.exists(path) and read_node(root, name).strip() == "1"


def verify_fuel_gauge_once(root, slave):
    flag = "1" if slave else "0"
    result_node = "slave_authentic" if slave else "authentic"
    challenge = secrets.token_hex(32)

    write_node(root, "verify_slave_flag", flag)
    write_node(root, "verify_digest", challenge)
    time.sleep(1.4)

    bq_digest = read_node(root, "verify_digest")[:64].lower()
    expected = [
        hmac.new(bytes.fromhex(key), bytes.fromhex(challenge),
                 hashlib.sha256).hexdigest()
        for key in FG_KEYS
    ]
    ok = bq_digest in expected
    write_node_if_present(root, result_node, "1" if ok else "0")
    return ok


def verify_fuel_gauge(root, slave, required=True, retries=10):
    result_node = "slave_authentic" if slave else "authentic"

    for attempt in range(1, retries + 1):
        try:
            if node_is_one(root, result_node) or verify_fuel_gauge_once(root, slave):
                print(f"{result_node}_verified=1")
                return True
        except OSError as exc:
            if exc.errno not in (*TRANSIENT_READ_ERRORS, errno.EIO, errno.ETIMEDOUT, errno.ENODEV):
                raise
            print(f"{result_node}_retry={attempt} error={exc}", file=sys.stderr)
        # Battery challenges are independent and stock retries each cell up
        # to ten times. This does not restart an adapter UVDM exchange.
        if attempt < retries:
            time.sleep(0.2)

    print(f"{result_node}_verified=0")
    if required:
        raise RuntimeError(f"{result_node} digest verification failed after {retries} attempts")
    print(f"warning: {result_node} digest verification failed", file=sys.stderr)
    return False


def enable_battery_auth(root):
    if not os.path.exists(os.path.join(root, "verify_digest")):
        raise FileNotFoundError("verify_digest sysfs node not found")

    verify_fuel_gauge(root, False, required=True)
    # Stock main() waits one second between the two fuel gauges.
    time.sleep(1.0)
    verify_fuel_gauge(root, True, required=True)


def authenticate_adapter(root, args, attach_token):
    seed_index = args.seed_index if args.seed_index is not None else random.randrange(len(SEEDS))
    print(f"seed_index={seed_index}")

    def send(cmd, *values):
        check_usb_connection(attach_token)
        try:
            return send_vdm(root, cmd, *values)
        except VdmResponseTimeout:
            # batterysecret advances after its local -EAGAIN. Do not resend
            # the command, and do not confuse a failed GLINK write with this.
            print(f"vdm_response=timeout cmd={cmd} action=continue", flush=True)
            return None

    adapter_svid = current_adapter_svid(root)
    if adapter_svid != XIAOMI_SVID:
        raise UnsupportedChargerError("Xiaomi identity missing before adapter commands")
    print(f"adapter_svid=0x{adapter_svid:04x}")

    for cmd in (1, 2, 3):
        send(cmd)
    send(4, SEEDS[seed_index])

    challenge = secrets.token_hex(16)
    response = send(5, challenge)
    auth_failure = None
    adapter_id = None
    pd_auth = False
    if response is None:
        auth_failure = "adapter digest response timed out"
    else:
        auth = response[1].lower()
        try:
            valid_digest = len(auth) == 32 and len(bytes.fromhex(auth)) == 16
        except ValueError:
            valid_digest = False
        if not valid_digest:
            auth_failure = "adapter digest response is malformed"
        else:
            adapter_id = detect_adapter_id(root, args.timeout)
            if not adapter_id:
                auth_failure = "adapter_id sysfs node did not report a valid adapter id"
            else:
                digest = hmac.new(bytes.fromhex(KEYS[seed_index]),
                                  bytes.fromhex(challenge + adapter_id),
                                  hashlib.sha256).hexdigest()
                pd_auth = hmac.compare_digest(auth, digest[:32])
                if not pd_auth:
                    print(f"adapter auth mismatch: seed_index={seed_index} adapter_id={adapter_id}",
                          file=sys.stderr)
    print(f"adapter_id={adapter_id}")

    pd_auth_payload = "01000000" if pd_auth else "00000000"
    # Stock batterysecret closes even a missing/mismatched digest with 7 -> 6
    # carrying zero. Only successful writes followed by a fresh valid digest
    # may open the gate; a response timeout alone is not a transport failure.
    send(7, pd_auth_payload)
    send(6, pd_auth_payload)
    set_verify_process(root, False)
    print("adapter_sequence=android:7,6")
    if auth_failure:
        raise UnsupportedChargerError(auth_failure, terminal=True)

    # pd_verifed is the firmware's gate on the high-voltage charge path and
    # is normally the outcome of the adapter authentication above.  Adapters
    # without Xiaomi authentication support cannot compute this digest.
    # Preserve the existing opt-in policy for completed but mismatched
    # handshakes; transport failures must not assert the gate.
    check_usb_connection(attach_token)
    gate = False
    if os.path.exists(os.path.join(root, "pd_verifed")):
        gate = pd_auth
        if not pd_auth and args.allow_unverified_adapter:
            gate, reason = unverified_adapter_allowed(root)
            print(f"unverified_adapter={'allowed' if gate else 'refused'}: {reason}")
        check_usb_connection(attach_token)
        write_node(root, "pd_verifed", "1" if gate else "0")
        if gate and not pd_auth:
            print("pd_verifed=1 (adapter authentication bypassed on request)")

    require_current_attach()
    write_state_file(AUTHENTICATED_STATE_FILE, attach_token if pd_auth else "none")
    if gate:
        write_state_file(VERIFIED_STATE_FILE, attach_token)
    print(f"pd_auth={1 if pd_auth else 0}")
    return gate


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--sysfs", help="directory containing request_vdm_cmd")
    parser.add_argument("--seed-index", type=int, choices=range(10), help="fixed seed index for repeatable tests")
    parser.add_argument("--battery-auth-only", action="store_true",
                        help="authenticate the fuel gauges without adapter commands")
    parser.add_argument("--role-first", action="store_true",
                        help="compatibility option; role-first is always required")
    parser.add_argument("--no-data-role-swap", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--probe-unknown-pps", action="store_true",
                        help="explicitly probe the host role for a known PPS charger with missing SVID")
    parser.add_argument("--allow-unverified-adapter", action="store_true",
                        help="assert pd_verifed even when adapter authentication fails, "
                             "which enables standard PPS fast charging on third-party "
                             "adapters that cannot pass Xiaomi's private authentication")
    parser.add_argument("--force", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--skip-completed", action="store_true",
                        help="deprecated; completed handshakes are skipped unless --force is used")
    parser.add_argument("--once-per-attach", action="store_true",
                        help="attempt authentication at most once for the current Type-C partner attach")
    parser.add_argument("--state-file", default="/run/liuqin-mipps-auth/last-attach",
                        help="state file used by --once-per-attach")
    parser.add_argument("--clear-notification", action="store_true",
                        help=argparse.SUPPRESS)
    parser.add_argument("--usb-online-trigger", action="store_true",
                        help=argparse.SUPPRESS)
    parser.add_argument("--xm-property-trigger", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--typec-trigger", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--consume-event", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--ready-timeout", type=float, default=12.0,
                        help="seconds to wait for SNK_Ready and PD capabilities (max 12)")
    parser.add_argument("--timeout", type=float, default=2.0,
                        help="seconds for source/identity discovery (max 4); "
                             "UVDM response budgets follow the stock command table")
    args = parser.parse_args()
    if not (0 < args.timeout <= 4 and 0 < args.ready_timeout <= 12):
        parser.error("timeout must be in (0,4], ready-timeout in (0,12]")

    if args.clear_notification:
        write_state_file(NOTIFICATION_STATE_FILE, "none")
        write_state_file(CHARGE_PROFILE_STATE_FILE, "none")
        write_state_file(USB_ONLINE_STATE_FILE, "0")
        write_state_file(VERIFIED_STATE_FILE, "none")
        write_state_file(AUTHENTICATED_STATE_FILE, "none")
        write_state_file(READY_STATE_FILE, "")
        # The worker clears any stale firmware gate outside the udev process.
        queue_auth_event()
        print("fast_charge_notification_state=cleared")
        return

    if args.xm_property_trigger:
        if read_state_file(USB_ONLINE_STATE_FILE) == "1":
            queue_auth_event()
        return

    if args.typec_trigger:
        queue_auth_event()
        return

    if args.usb_online_trigger:
        if read_state_file(USB_ONLINE_STATE_FILE) == "1":
            print("usb_online_trigger=skipped")
            return
        write_state_file(USB_ONLINE_STATE_FILE, "1")
        queue_auth_event()
        print("usb_online_trigger=started")
        return

    if args.consume_event and not args.battery_auth_only:
        consume_auth_event()
    try:
        root = args.sysfs or find_xiaomi_dir()
    except FileNotFoundError:
        if args.consume_event:
            raise UnsupportedChargerError("charger interfaces not ready")
        raise
    if args.battery_auth_only:
        enable_battery_auth(root)
        print("battery_auth_only=completed")
        return
    global ACTIVE_ATTACH
    ACTIVE_ATTACH = current_attach_token()
    try:
        completed = False if args.force else auth_already_completed(root)
        if completed is None:
            print("MiPPS completed auth check deferred; preserving this attach's verdict")
            return
        if completed:
            print("MiPPS auth sequence already completed for this attach")
            report_completed_charge(root)
            return
        clear_verdict(root)
        set_verify_process(root, False)
        require_current_attach()
        write_state_file(USB_ONLINE_STATE_FILE, "1")
        # Also covers a manual invocation without the boot unit.
        enable_battery_auth(root)
        require_current_attach()
        if args.once_per_attach and read_state_file(args.state_file) == ACTIVE_ATTACH and not args.force:
            return
        if not role_first_prelude(root, args):
            return
        if args.once_per_attach:
            write_state_file(args.state_file, ACTIVE_ATTACH)
        authenticate_adapter(root, args, ACTIVE_ATTACH)
        print("MiPPS auth sequence completed")
        report_completed_charge(root, status=True)
    finally:
        # A proof is published only after successful 7/6 writes, verify_process
        # cleanup and the gate write. Once committed, diagnostic read failures
        # or termination during reporting must not roll it back. Do not write
        # verify_process again for a completed transaction on every notification.
        keep_verdict = (bool(ACTIVE_ATTACH) and usb_is_online() is not False
                        and current_attach_token() == ACTIVE_ATTACH
                        and read_state_file(VERIFIED_STATE_FILE) == ACTIVE_ATTACH)
        if not keep_verdict:
            try:
                set_verify_process(root, False)
            finally:
                clear_verdict(root)



if __name__ == "__main__":
    def interrupted(signum, _frame):
        raise SystemExit(128 + signum)
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGINT, interrupted)
    try:
        main()
    except UnsupportedChargerError as e:
        print(f"MiPPS auth skipped: {e}")
        sys.exit(0)
    except Exception as e:
        print(f"error: {e}", file=sys.stderr)
        sys.exit(1)
