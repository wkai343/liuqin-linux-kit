[Desktop Entry]
Type=Application
Version=1.0
Name=Reboot to Android
Name[zh_CN]=重启到 Android
Comment=Write the Android boot image into boot_a and restart the tablet
Comment[zh_CN]=将 Android 的 boot 镜像写入 boot_a 并重启平板
Exec=pkexec /usr/local/sbin/liuqin-switch to-android
Icon=system-reboot
Terminal=false
Categories=System;
Keywords=android;dualboot;switch;reboot;
StartupNotify=false
