<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- SPDX-License-Identifier: MIT -->
<!--
  pkexec matches this action by program and first argument, so the desktop
  entry's `pkexec /usr/local/sbin/liuqin-switch to-android` asks for an
  administrator password for exactly that and nothing else.  Every other
  liuqin-switch invocation falls back to pkexec's generic action.
-->
<policyconfig>
  <vendor>Liuqin Linux Kit</vendor>
  <action id="io.github.liuqin.switch.to-android">
    <description>Reboot into Android</description>
    <description xml:lang="zh_CN">重启到 Android</description>
    <message>Authentication is required to write the Android boot image into boot_a and restart the tablet</message>
    <message xml:lang="zh_CN">需要认证才能将 Android 的 boot 镜像写入 boot_a 并重启平板</message>
    <icon_name>system-reboot</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/liuqin-switch</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">to-android</annotate>
  </action>
</policyconfig>
