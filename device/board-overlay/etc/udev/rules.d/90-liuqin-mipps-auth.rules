# Trigger Xiaomi MiPPS/PPS charger authentication after USB-C partner attach or
# USB power becoming available through an already-attached dock.
#
# udev records a pending event and starts the path watcher without charger I/O.
# Events during a running worker remain pending for the next activation.

ACTION=="add|remove", SUBSYSTEM=="typec", KERNEL=="port*-partner", RUN+="/usr/local/libexec/liuqin-mipps-auth --typec-trigger"
# A late source-PDO link publishes partner change after capability registration.
ACTION=="change", SUBSYSTEM=="typec", KERNEL=="port*-partner", RUN+="/usr/local/libexec/liuqin-mipps-auth --typec-trigger"
# OEM 0x50 notifications publish late capabilities on the GLINK child.
# The worker retries late readiness only, with one handshake per attach.
# udev performs no charger sysfs I/O.
ACTION=="change", SUBSYSTEM=="auxiliary", KERNEL=="pmic_glink.power-supply.*", RUN+="/usr/local/libexec/liuqin-mipps-auth --xm-property-trigger"
ACTION=="change", SUBSYSTEM=="power_supply", KERNEL=="qcom-battmgr-usb", ENV{POWER_SUPPLY_ONLINE}=="1", RUN+="/usr/local/libexec/liuqin-mipps-auth --usb-online-trigger"
ACTION=="change", SUBSYSTEM=="power_supply", KERNEL=="qcom-battmgr-usb", ENV{POWER_SUPPLY_ONLINE}=="0", RUN+="/usr/local/libexec/liuqin-mipps-auth --clear-notification"
