# Keep the historical filename for upgrades. The old external classification
# bypassed tablet-mode suppression to work around an inverted hall mapping.
# SW_TABLET_MODE now describes detach/fold correctly; the folio touchpad is
# internal and should also follow libinput's lid and tablet-mode handling.
ACTION=="add|change", SUBSYSTEM=="input", ATTRS{name}=="Xiaomi Touch", ENV{ID_INPUT_TOUCHPAD_INTEGRATION}="internal"
