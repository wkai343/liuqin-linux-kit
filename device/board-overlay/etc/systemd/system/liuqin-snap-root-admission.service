[Unit]
Description=liuqin Snap privilege-boundary admission
# A strict snap cannot be diagnosed from a graphical Firefox launch.  Make
# the package xattr, AppArmor LSM and FUSE character device prerequisites of
# basic.target, before GDM or NetworkManager have a chance to hide the cause.
DefaultDependencies=no
Wants=snapd.mounts.target
After=local-fs.target snapd.mounts.target
Before=basic.target network-pre.target display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/liuqin-snap-root-admission --admit
RemainAfterExit=yes

[Install]
RequiredBy=basic.target
