[Unit]
Description=LiUQIN MiPPS/PPS charger authentication
Documentation=https://github.com/wkai343/liuqin-linux-kit/blob/main/docs/FASTCHARGE.md
Wants=liuqin-mipps-battery-auth.service
After=liuqin-mipps-battery-auth.service
# A service restart must not block the next cable attach. Authentication
# attempts remain bounded per connection by the worker.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/libexec/liuqin-mipps-auth --timeout 4 --role-first --consume-event --watch
# One process waits on inotify between events. Each transaction takes the shared
# authentication lock and retains its own 120-second timeout and cleanup.
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
Environment=PYTHONUNBUFFERED=1
