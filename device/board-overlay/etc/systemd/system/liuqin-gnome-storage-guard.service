[Unit]
Description=liuqin persistent-root storage guard
DefaultDependencies=no
# Stage 1 has already waited for, snapshotted and moved the complete /dev
# namespace before systemd starts.  Waiting for udev-settle here duplicates
# that gate and costs minutes under emulation without adding authority.
#
# The guard derives its read-write set from /proc/mounts, so the mounts it
# judges must be final before it runs.  local-fs.target covers the ordinary
# fstab mounts, but the split layout's /home is nofail, and a nofail mount is
# not ordered before local-fs.target (systemd.mount(5)), so home.mount is named
# explicitly.  Without it the guard re-sealed linux_home seconds before
# systemd mounted /home, which then came up read-only and first-boot user
# creation failed.  In the legacy layout there is no home.mount and the
# ordering is inert.  Neither mount unit is ordered after basic.target, so
# staying before basic.target adds no cycle.
After=local-fs.target home.mount
Before=basic.target network-pre.target display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/liuqin-gnome-storage-guard
RemainAfterExit=yes

[Install]
RequiredBy=basic.target
