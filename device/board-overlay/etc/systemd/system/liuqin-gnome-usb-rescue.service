[Unit]
Description=liuqin USB NCM rescue shell
After=liuqin-gnome-storage-guard.service
Requires=liuqin-gnome-storage-guard.service
Before=display-manager.service
# Unauthenticated root telnet is a development/maintenance channel, not a
# product default (tech debt S3-3).  It starts only when the operator has
# explicitly opted in on this device:
#   touch /etc/liuqin-rescue-enabled && systemctl restart liuqin-gnome-usb-rescue
# Release images ship without the marker.  The stage-1 RAM shell (contract
# failure / fastboot boot) remains the unauthenticated recovery path of last
# resort and requires physical bootloader access.
ConditionPathExists=/etc/liuqin-rescue-enabled

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/liuqin-gnome-usb-rescue start
ExecStop=/usr/local/sbin/liuqin-gnome-usb-rescue stop
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
