[Unit]
Description=LiUQIN pending charger authentication events

[Path]
PathExists=/run/liuqin-mipps-auth/pending
Unit=liuqin-mipps-auth.service
# Start the persistent worker for the first event. Its inotify listener handles
# subsequent markers, including those arriving during a transaction.
TriggerLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
