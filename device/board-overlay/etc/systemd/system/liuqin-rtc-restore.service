[Unit]
Description=Restore Liuqin time from the PMIC RTC and saved calibration
DefaultDependencies=no
# StateDirectory adds the required mount and remount-fs ordering. Sample the
# RTC while unrelated local filesystems and udev devices are initialising.
RequiresMountsFor=/var/lib/liuqin-rtc /var
Before=sysinit.target time-set.target chronyd.service chrony.service systemd-timesyncd.service shutdown.target
Wants=time-set.target
Conflicts=shutdown.target
ConditionPathExists=/sys/firmware/devicetree/base/compatible

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/liuqin-rtc restore
TimeoutStartSec=8
StateDirectory=liuqin-rtc
StateDirectoryMode=0700
UMask=0077
CapabilityBoundingSet=CAP_SYS_TIME
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# Keep private temporary storage without waiting for host tmpfiles setup.
PrivateTmp=disconnected
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=sysinit.target
