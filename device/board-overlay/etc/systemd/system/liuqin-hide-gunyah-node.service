[Unit]
Description=Hide the ABL-injected Gunyah /hypervisor node from userspace
# ABL's DTBO (androidboot.dtbo_idx=15) injects /hypervisor (compatible
# "qcom,gunyah-vm") into the live device tree even though Linux runs as the
# Gunyah host, not a guest.  systemd-detect-virt keys off that exact node
# and reports vm-other, which sent GSD down VM code paths (greeter power
# key -> immediate PowerOff, 2026-09-12 evidence) and skipped every
# ConditionVirtualization=no unit (battery-check, bsod).  The kernel never
# binds a driver to the node (probe ENODEV); only userspace readers of
# /proc/device-tree are affected, so an empty bind mount over the devicetree
# export restores an honest "none" without touching the kernel or any ABL
# partition.  The upstream fix (teach detect-virt the Gunyah-host case) is
# tracked as tech debt S2-14k; this unit is the local containment.
DefaultDependencies=no
Conflicts=shutdown.target
Before=sysinit.target shutdown.target
ConditionPathExists=/sys/firmware/devicetree/base/hypervisor

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/mkdir -p /run/liuqin-empty
ExecStart=/bin/mount --bind /run/liuqin-empty /sys/firmware/devicetree/base/hypervisor
ExecStop=/bin/umount /sys/firmware/devicetree/base/hypervisor

[Install]
WantedBy=sysinit.target
