{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/main/.schema/devbox.schema.json",
  "packages": [
    "path:./build/devbox/nix#build-tools"
  ],
  "env": {
    "LC_ALL": "C",
    "CROSS_COMPILE": "aarch64-unknown-linux-musl-",
    "PYTHONNOUSERSITE": "1",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "shell": {
    "init_hook": [
      ". build/devbox/env.sh"
    ],
    "scripts": {
      "help": "python3 build/devbox/build.py help \"$@\"",
      "init": "python3 build/devbox/build.py init \"$@\"",
      "doctor": "python3 build/devbox/build.py doctor \"$@\"",
      "fetch-rom": "python3 build/scripts/fetch-stock-rom.py \"$@\"",
      "plan": "python3 build/devbox/build.py plan \"$@\"",
      "build": "python3 build/devbox/build.py build \"$@\"",
      "outputs": "python3 build/devbox/build.py outputs \"$@\"",
      "test": "python3 build/devbox/build.py test \"$@\""
    }
  }
}
