diff --git a/test/software-contrast.cpp b/test/software-contrast.cpp
new file mode 100644
index 00000000..ff599c47
--- /dev/null
+++ b/test/software-contrast.cpp
@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include <cassert>
+#include <cmath>
+#include <cstring>
+#include <sys/mman.h>
+#include <vector>
+#include <libcamera/camera_manager.h>
+#include <libcamera/formats.h>
+#include <libcamera/stream.h>
+#include "libcamera/internal/software_isp/swstats_cpu.h"
+#include "../src/ipa/simple/contrast_af.h"
+
+using namespace libcamera;
+
+int main()
+{
+ CameraManager cm;
+ for (const PixelFormat &format : { formats::SGRBG8, formats::SGRBG10, formats::SGRBG10_CSI2P,
+                                   formats::SBGGR10_CSI2P, formats::SGRBG12, formats::SGRBG12_CSI2P }) {
+  SwStatsCpu stats(cm);
+  assert(stats.isValid());
+  StreamConfiguration cfg;
+  cfg.size = Size(64, 64);
+  cfg.pixelFormat = format;
+  bool packed10 = format == formats::SGRBG10_CSI2P || format == formats::SBGGR10_CSI2P;
+  bool packed12 = format == formats::SGRBG12_CSI2P;
+  bool eight = format == formats::SGRBG8;
+  cfg.stride = packed10 ? 80 : packed12 ? 96 : eight ? 64 : 128;
+  assert(stats.configure(cfg, 2) == 0);
+  stats.setWindow(Rectangle(cfg.size));
+  std::vector<uint8_t> image(cfg.stride * 64);
+  auto *result = static_cast<SwIspStats *>(mmap(nullptr, sizeof(SwIspStats), PROT_READ,
+                                             MAP_SHARED, stats.getStatsFD().get(), 0));
+  assert(result != MAP_FAILED);
+  double scores[4]{};
+  for (unsigned int pattern = 0; pattern < 4; ++pattern) {
+   std::fill(image.begin(), image.end(), 0);
+   for (unsigned int y = 0; y < 64; ++y) {
+    for (unsigned int x = 0; x < 64; ++x) {
+     unsigned value = 80;
+     if (pattern == 1 && x >= 16 && x < 48 && y >= 16 && y < 48)
+      value += ((x / 4) & 1) * 80;
+     if (pattern == 2 && (x < 8 || x >= 56 || y < 8 || y >= 56))
+      value += ((x / 4) & 1) * 80;
+     if (pattern == 3) value = 16 + ((x * 13 + y * 7) % 7) - 3;
+     uint8_t *line = image.data() + y * cfg.stride;
+     if (packed10) line[x / 4 * 5 + x % 4] = value;
+     else if (packed12) line[x / 2 * 3 + x % 2] = value;
+     else if (eight) line[x] = value;
+     else { uint16_t raw = value * (format == formats::SGRBG12 ? 16 : 4); std::memcpy(line + x * 2, &raw, 2); }
+    }
+   }
+   stats.startFrame(pattern * 4);
+   for (unsigned int y = 0; y < 64; y += 2) {
+    const uint8_t *lines[] = { image.data() + y * cfg.stride,
+                              image.data() + y * cfg.stride,
+                              image.data() + (y + 1) * cfg.stride };
+    stats.processLine0(pattern * 4, y, lines, y % 4 ? 1 : 0);
+   }
+   stats.finishFrame(pattern * 4, 0);
+   assert(result->valid && result->focusSamples > 0 && result->focusSum > 0);
+   scores[pattern] = ipa::soft::ContrastAf::contrast(result->focusGradient,
+                       result->focusSum, result->focusSamples, 12);
+   if (pattern == 3) assert(result->focusGradient > 0);
+  }
+  assert(scores[0] == 0 && scores[1] > 0.01 && scores[2] == 0 && scores[3] == 0);
+  stats.startFrame(13); stats.finishFrame(13, 0); assert(!result->valid);
+  munmap(result, sizeof(SwIspStats));
+ }
+}
