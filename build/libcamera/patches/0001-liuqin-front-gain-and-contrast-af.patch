diff --git a/test/contrast-af.cpp b/test/contrast-af.cpp
new file mode 100644
index 00000000..a80ef8e5
--- /dev/null
+++ b/test/contrast-af.cpp
@@ -0,0 +1,49 @@
+#include "../src/ipa/simple/contrast_af.h"
+#include <cassert>
+#include <iostream>
+using libcamera::ipa::soft::ContrastAf;
+
+static int scan(ContrastAf &af, bool texture, bool fail = false)
+{
+ int position = 0, moves = 0;
+ for (uint64_t t = 1000000000ULL; t < 16000000000ULL; t += 133333333ULL) {
+  double score = texture ? 0.001 + 0.1 * std::exp(-std::pow((position - 437.0) / 120, 2)) : 0.00001;
+  if (auto next = af.process(t, score, true)) {
+   assert(*next >= 0 && *next <= 1023);
+   ++moves; position = *next;
+   assert(!af.process(t + 1, 999, true)); // no score before an acknowledgement
+   af.applied(position, t + 100000000, fail ? -5 : 0);
+   assert(!af.process(t + 2, 999, true)); // stale frame after acknowledgement
+  }
+  if (af.state() == ContrastAf::Focused || af.state() == ContrastAf::Failed) break;
+ }
+ assert(moves && moves < 25);
+ return position;
+}
+int main()
+{
+ ContrastAf af;
+ af.configure(0, 1023);
+ int p = scan(af, true);
+ assert(af.state() == ContrastAf::Focused && std::abs(p - 437) <= 32);
+ af.reset(); scan(af, false); assert(af.state() == ContrastAf::Failed);
+ af.reset(); scan(af, true, true); assert(af.state() == ContrastAf::Failed);
+ assert(af.mode() == ContrastAf::Continuous);
+ af.setMode(ContrastAf::Continuous);
+ assert(!af.process(50000000000ULL, 0.1, true));
+ af.reset(); af.setMode(ContrastAf::Auto);
+ assert(!af.process(1000000000, 0.1, true));
+ assert(!af.process(5000000000, 0.1, true));
+ af.trigger(true); assert(af.process(5100000000, 0.1, true));
+ af.applied(0, 5200000000, 0); af.trigger(true);
+ assert(af.process(5300000000, 0.1, true) == 128);
+ af.trigger(false); af.applied(128, 5400000000, 0);
+ assert(!af.process(6000000000, 0.1, true) && af.state() == ContrastAf::Idle);
+ af.trigger(true); assert(af.process(6100000000, 0.1, true));
+ af.setMode(ContrastAf::Manual); af.applied(0, 6200000000, 0);
+ assert(!af.process(7000000000, 0.1, true));
+ af.reset(); assert(!af.process(1000000000, NAN, true));
+ assert(!af.process(2000000000, 0.1, false));
+ assert(!af.process(0, 0.1, true));
+ std::cout << "AF peak, flat scene, stale frames, I2C error, cancel/retrigger, manual and invalid stats passed\n";
+}
