diff --git a/src/ipa/simple/contrast_af.h b/src/ipa/simple/contrast_af.h
new file mode 100644
index 00000000..72308d96
--- /dev/null
+++ b/src/ipa/simple/contrast_af.h
@@ -0,0 +1,175 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Bounded contrast search with acknowledged lens writes and capture timestamps. */
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <optional>
+
+namespace libcamera::ipa::soft {
+
+class ContrastAf
+{
+public:
+	enum Mode { Manual, Auto, Continuous };
+	enum State { Idle, Scanning, Focused, Failed };
+
+	/* Statistics are in 8-bit raw levels, before black-level subtraction. */
+	static double contrast(uint64_t gradient, uint64_t sum, uint64_t samples,
+			       unsigned int blackLevel)
+	{
+		/* Near the sensor pedestal, noise is not evidence of scene detail. */
+		if (!samples || sum <= samples * (blackLevel + 8))
+			return 0;
+		return static_cast<double>(gradient) * samples /
+		       (static_cast<double>(sum) * sum);
+	}
+
+	void configure(int minimum, int maximum)
+	{
+		minimum_ = minimum;
+		maximum_ = maximum;
+		reset();
+	}
+
+	void reset()
+	{
+		mode_ = Continuous;
+		state_ = Scanning;
+		position_ = minimum_;
+		pending_ = false;
+		faulted_ = false;
+		readyAt_ = 0;
+		firstTimestamp_ = 0;
+		restart_ = true;
+		phase_ = Phase::Coarse;
+		badFrames_ = 0;
+	}
+
+	void setMode(int mode)
+	{
+		if (mode < Manual || mode > Continuous || mode == mode_)
+			return;
+		mode_ = static_cast<Mode>(mode);
+		faulted_ = false;
+		state_ = mode_ == Continuous ? Scanning : Idle;
+		restart_ = mode_ == Continuous;
+	}
+
+	void trigger(bool start)
+	{
+		if (mode_ != Auto)
+			return;
+		/* Repeated Start requests must not restart a scan in progress. */
+		if (start && state_ == Scanning)
+			return;
+		if (start)
+			faulted_ = false;
+		restart_ = start;
+		state_ = start ? Scanning : Idle;
+	}
+
+	/* Called only after the pipeline has actually attempted the I2C write. */
+	void applied(int position, uint64_t readyAt, int error)
+	{
+		if (!pending_ || position != position_)
+			return;
+		pending_ = false;
+		readyAt_ = readyAt;
+		if (error) {
+			state_ = Failed;
+			restart_ = false;
+			/* A broken actuator must not be retried in a tight loop. */
+			faulted_ = true;
+		}
+	}
+
+	std::optional<int> process(uint64_t timestamp, double score, bool valid)
+	{
+		if (!timestamp || !valid || !std::isfinite(score) || score < 0)
+			return {};
+		if (!firstTimestamp_)
+			firstTimestamp_ = timestamp;
+		if (mode_ == Manual || faulted_ || pending_ || timestamp < readyAt_)
+			return {};
+		if (restart_) {
+			/* Give AE time to leave its start-up setting. */
+			if (timestamp - firstTimestamp_ < 1000000000ULL)
+				return {};
+			restart_ = false;
+			state_ = Scanning;
+			phase_ = Phase::Coarse;
+			step_ = std::max(1, (maximum_ - minimum_ + 7) / 8);
+			end_ = maximum_;
+			bestPosition_ = minimum_;
+			bestScore_ = 0;
+			worstScore_ = score;
+			return move(minimum_);
+		}
+		if (state_ == Scanning) {
+			if (phase_ == Phase::Verify) {
+				/* Textureless scenes must not report successful focus. */
+				state_ = score > 0.0001 && bestScore_ > worstScore_ * 1.05 &&
+					 score >= bestScore_ * 0.7 ? Focused : Failed;
+				lockedScore_ = score;
+				badFrames_ = 0;
+				lastScan_ = timestamp;
+				return {};
+			}
+			worstScore_ = std::min(worstScore_, score);
+			if (score > bestScore_) {
+				bestScore_ = score;
+				bestPosition_ = position_;
+			}
+			if (position_ < end_)
+				return move(std::min(end_, position_ + step_));
+			if (phase_ == Phase::Coarse) {
+				phase_ = Phase::Fine;
+				int begin = std::max(minimum_, bestPosition_ - step_);
+				end_ = std::min(maximum_, bestPosition_ + step_);
+				step_ = std::max(1, step_ / 4);
+				/* Compare fine samples under the current illumination. */
+				bestScore_ = 0;
+				return move(begin);
+			}
+			phase_ = Phase::Verify;
+			return move(bestPosition_);
+		}
+		if (mode_ == Continuous &&
+		    (state_ == Focused || state_ == Failed) &&
+		    timestamp - lastScan_ > 2000000000ULL) {
+			bool changed = state_ == Failed || score < lockedScore_ * 0.70 ||
+				       score > lockedScore_ * 1.5;
+			badFrames_ = changed ? badFrames_ + 1 : 0;
+			if (badFrames_ >= 3)
+				restart_ = true;
+		}
+		return {};
+	}
+
+	State state() const { return state_; }
+	Mode mode() const { return mode_; }
+	bool searching() const { return state_ == Scanning && !restart_; }
+
+private:
+	enum class Phase { Coarse, Fine, Verify };
+	std::optional<int> move(int position)
+	{
+		position_ = std::clamp(position, minimum_, maximum_);
+		pending_ = true;
+		return position_;
+	}
+
+	int minimum_ = 0, maximum_ = 1023;
+	int position_ = 0, bestPosition_ = 0, step_ = 1, end_ = 0;
+	Mode mode_ = Continuous;
+	State state_ = Idle;
+	Phase phase_ = Phase::Coarse;
+	bool pending_ = false, restart_ = true, faulted_ = false;
+	uint64_t readyAt_ = 0, firstTimestamp_ = 0, lastScan_ = 0;
+	unsigned int badFrames_ = 0;
+	double bestScore_ = 0, worstScore_ = 0, lockedScore_ = 0;
+};
+
+} /* namespace libcamera::ipa::soft */
