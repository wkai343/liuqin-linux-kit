+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <utility>
+
+namespace libcamera::ipa::soft {
+
+/* Fixed-period video: prefer the shortest period within the requested range. */
+class FrameDuration
+{
+public:
+	void configure(uint32_t lineLength, uint64_t pixelRate, uint32_t height,
+		       int32_t minBlank, int32_t maxBlank, int32_t defaultBlank,
+		       uint32_t margin)
+	{
+		lineLength_ = lineLength;
+		pixelRate_ = pixelRate;
+		height_ = height;
+		minBlank_ = minBlank;
+		maxBlank_ = maxBlank;
+		defaultBlank_ = defaultBlank;
+		blank_ = defaultBlank;
+		margin_ = margin;
+	}
+
+	int64_t durationUs(int32_t blank) const
+	{
+		return uint64_t(height_ + blank) * lineLength_ * 1000000 / pixelRate_;
+	}
+	int64_t minUs() const { return durationUs(minBlank_); }
+	int64_t maxUs() const { return durationUs(maxBlank_); }
+	int64_t defaultUs() const { return durationUs(defaultBlank_); }
+	int32_t vblank() const { return blank_; }
+	int32_t exposureMax() const { return height_ + blank_ - margin_; }
+
+	/* Preserve exposure product while preferring shutter time over gain. */
+	std::pair<int32_t, double> exposureAndGain(int32_t exposure, double gain) const
+	{
+		double total = exposure * gain;
+		int32_t lines = std::clamp<double>(total, 1, exposureMax());
+		return { lines, total / lines };
+	}
+
+	void set(int64_t minUs, int64_t maxUs)
+	{
+		if (minUs <= 0 && maxUs <= 0) {
+			blank_ = defaultBlank_;
+			return;
+		}
+		/* Zero means the mode default; never multiply an unchecked request. */
+		int64_t period = std::clamp(minUs > 0 ? minUs : defaultUs(), this->minUs(), this->maxUs());
+		if (maxUs > 0)
+			period = std::min(period, std::clamp(maxUs, this->minUs(), this->maxUs()));
+		int64_t lines = uint64_t(period) * pixelRate_ / (uint64_t(lineLength_) * 1000000);
+		blank_ = std::clamp<int64_t>(lines - height_, minBlank_, maxBlank_);
+	}
+
+private:
+	uint64_t pixelRate_ = 1;
+	uint32_t lineLength_ = 1, height_ = 0, margin_ = 0;
+	int32_t minBlank_ = 0, maxBlank_ = 0, defaultBlank_ = 0, blank_ = 0;
+};
+
+} /* namespace libcamera::ipa::soft */
