diff --git a/test/frame-duration.cpp b/test/frame-duration.cpp
new file mode 100644
index 00000000..66d0b198
--- /dev/null
+++ b/test/frame-duration.cpp
@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include <cassert>
+#include <cstdint>
+#include <cmath>
+#include <limits>
+#include "../src/ipa/simple/frame_duration.h"
+using libcamera::ipa::soft::FrameDuration;
+int main()
+{
+	FrameDuration timing;
+	timing.configure(4644, 878080000, 1472, 1679, 65535 - 1472, 4830, 24);
+	assert(timing.defaultUs() == 33330);
+	timing.set(16666, 16666);
+	assert(timing.vblank() == 1679 && timing.exposureMax() == 3127);
+	assert(timing.durationUs(timing.vblank()) == 16665);
+	timing.set(33333, 33333);
+	assert(timing.vblank() == 4830 && timing.exposureMax() == 6278);
+	auto [exposure, gain] = timing.exposureAndGain(1000, 42.666668);
+	assert(exposure == 6278 && gain < 7);
+	assert(std::abs(exposure * gain - 42666.668) < 0.001);
+	timing.set(16666, 16666);
+	auto fast = timing.exposureAndGain(exposure, gain);
+	assert(fast.first == 3127 && std::abs(fast.first * fast.second - 42666.668) < 0.001);
+	auto low = timing.exposureAndGain(1000, 1);
+	assert(low.first == 1000 && low.second == 1);
+	timing.set(0, 0);
+	assert(timing.vblank() == 4830);
+	timing.set(std::numeric_limits<int64_t>::max(), std::numeric_limits<int64_t>::max());
+	assert(timing.vblank() <= 65535 - 1472 && timing.exposureMax() <= 65535 - 24);
+	timing.set(-1, -1);
+	assert(timing.vblank() == 4830);
+	timing.configure(7288, 727040000, 3904, 6071, 65535 - 3904, 6071, 24);
+	timing.set(33333, 33333);
+	assert(timing.vblank() == 6071 && timing.exposureMax() == 9951);
+	assert(timing.defaultUs() == 99991);
+	timing.configure(4644, 878080000, 1952, 4350, 65535 - 1952, 4350, 24);
+	timing.set(16666, 16666);
+	assert(timing.vblank() == 4350);
+}
