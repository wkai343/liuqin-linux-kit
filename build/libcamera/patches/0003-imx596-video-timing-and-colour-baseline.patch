+void IPASoftSimple::applyFrameDuration(const ControlList &controls)
+{
+	if (!hasFrameDuration_)
+		return;
+	if (auto limits = controls.get(controls::FrameDurationLimits))
+		frameDuration_.set((*limits)[0], (*limits)[1]);
+	context_.configuration.agc.exposureMax = frameDuration_.exposureMax();
+	if (context_.activeState.agc.valid)
+		context_.activeState.agc.exposure = std::min(context_.activeState.agc.exposure,
+							 frameDuration_.exposureMax());
+}
+
+int IPASoftSimple::prepareStart(const ControlList &controls, const ControlList &currentSensorControls,
+			       ControlList *sensorControls)
+{
+	*sensorControls = ControlList(sensorInfoMap_);
+	applyFrameDuration(controls);
+	if (hasFrameDuration_) {
+		if (!currentSensorControls.contains(V4L2_CID_EXPOSURE) ||
+		    !currentSensorControls.contains(V4L2_CID_ANALOGUE_GAIN))
+			return -EINVAL;
+		auto [exposure, gain] = frameDuration_.exposureAndGain(
+			currentSensorControls.get(V4L2_CID_EXPOSURE).get<int32_t>(),
+			camHelper_->gain(currentSensorControls.get(V4L2_CID_ANALOGUE_GAIN).get<int32_t>()));
+		gain = std::clamp(gain, context_.configuration.agc.againMin,
+				 context_.configuration.agc.againMax);
+		sensorControls->set(V4L2_CID_VBLANK, frameDuration_.vblank());
+		sensorControls->set(V4L2_CID_EXPOSURE, exposure);
+		sensorControls->set(V4L2_CID_ANALOGUE_GAIN,
+				    static_cast<int32_t>(camHelper_->gainCode(gain)));
+	}
+	return 0;
+}
