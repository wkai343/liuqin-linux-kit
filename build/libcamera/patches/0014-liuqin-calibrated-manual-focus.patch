+/* Optical chart measurements for this actuator, ordered far to near. */
+struct LiuqinFocusMap {
+	struct Point { float dioptres; int dac; };
+	std::vector<Point> points;
+
+	void load(const ValueNode &table, int low, int high)
+	{
+		points.clear();
+		if (!table.isList() || table.size() < 2 || table.size() > 32)
+			return;
+		std::vector<Point> valid;
+		for (const auto &row : table.asList()) {
+			Point p{row["dioptres"].get<float>(-1), row["dac"].get<int>(-1)};
+			if (!std::isfinite(p.dioptres) || p.dioptres < 0 ||
+			    p.dac < low || p.dac > high ||
+			    (!valid.empty() && (p.dioptres <= valid.back().dioptres || p.dac <= valid.back().dac)))
+				return;
+			valid.push_back(p);
+		}
+		points = std::move(valid);
+	}
+
+	int dac(float value) const
+	{
+		value = std::clamp(value, points.front().dioptres, points.back().dioptres);
+		auto b = std::find_if(points.begin() + 1, points.end(), [value](const Point &p) { return p.dioptres >= value; });
+		const Point &a = *(b - 1);
+		return a.dac + std::lround((value - a.dioptres) / (b->dioptres - a.dioptres) * (b->dac - a.dac));
+	}
+
+	std::optional<float> dioptres(int value) const
+	{
+		if (points.empty() || value < points.front().dac || value > points.back().dac)
+			return {};
+		auto b = std::find_if(points.begin() + 1, points.end(), [value](const Point &p) { return p.dac >= value; });
+		const Point &a = *(b - 1);
+		return a.dioptres + (value - a.dac) * (b->dioptres - a.dioptres) / (b->dac - a.dac);
+	}
+};
