+static uint64_t focusNow()
+{
+	return std::chrono::duration_cast<std::chrono::nanoseconds>(
+		std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+int LiuqinIsp::moveLens(int dac)
+{
+	uint64_t issued = focusNow();
+	int ret = sensor_->focusLens()->setFocusPosition(dac);
+	// A failed I2C transfer leaves the physical position uncertain.
+	lensHistory_.push_back({ issued, focusNow() + 100000000ULL, ret ? -1 : dac });
+	return ret;
+}
+
+int LiuqinIsp::setManualFocus(const ControlList &controls, bool starting)
+{
+	auto requested = controls.get(controls::LensPosition);
+	if ((!starting && !requested) || calibration_.focus.points.empty())
+		return 0;
+	float value = requested.value_or(1.0f);
+	if (!std::isfinite(value))
+		return -EINVAL;
+	int dac = calibration_.focus.dac(value);
+	if (!lensHistory_.empty() && lensHistory_.back().dac == dac)
+		return 0;
+	return moveLens(dac);
+}
