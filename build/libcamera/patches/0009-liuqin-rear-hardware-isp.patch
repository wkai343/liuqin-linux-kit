+void LiuqinIsp::focus(FrameBuffer *buffer, Request *request)
+{
+	if (auto mode = request->controls().get(controls::AfMode)) af_.setMode(*mode);
+	if (auto trigger = request->controls().get(controls::AfTrigger)) af_.trigger(*trigger == controls::AfTriggerStart);
+	if (buffer->metadata().sequence % 4 == 0 && !buffer->planes().empty()) {
+		DmaSyncer sync(buffer->planes()[0].fd, DmaSyncer::SyncType::Read);
+		MappedFrameBuffer mapped(buffer, MappedFrameBuffer::MapFlag::Read);
+		unsigned int w = info_.outputSize.width, h = info_.outputSize.height;
+		if (mapped.isValid() && !mapped.planes().empty() && mapped.planes()[0].size() >= stride_ * h) {
+			const uint8_t *p = mapped.planes()[0].data();
+			uint64_t gradient = 0, sum = 0, samples = 0;
+			for (unsigned int y = h / 4; y < h * 3 / 4; y += 4) {
+				for (unsigned int x = w / 4; x < w * 3 / 4; x += 4) {
+					int dx = int(p[y * stride_ + x + 2]) - p[y * stride_ + x - 2];
+					int dy = int(p[(y + 2) * stride_ + x]) - p[(y - 2) * stride_ + x];
+					gradient += dx * dx + dy * dy;
+					sum += p[y * stride_ + x]; samples++;
+				}
+			}
+			double score = ipa::soft::ContrastAf::contrast(gradient, sum, samples, 0);
+			auto position = af_.process(buffer->metadata().timestamp, score, true);
+			if (position) {
+				int ret = sensor_->focusLens()->setFocusPosition(*position);
+				uint64_t ready = std::chrono::duration_cast<std::chrono::nanoseconds>(
+					std::chrono::steady_clock::now().time_since_epoch()).count() + 100000000ULL;
+				af_.applied(*position, ready, ret);
+				LOG(LiuqinIsp, Debug) << "AF lens=" << *position << " score=" << score << " result=" << ret;
+			}
+		}
+	}
+	request->_d()->metadata().set(controls::AfMode, int32_t(af_.mode()));
+	request->_d()->metadata().set(controls::AfState, int32_t(af_.state()));
+}
