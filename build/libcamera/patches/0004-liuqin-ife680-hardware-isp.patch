+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <array>
+#include <deque>
+#include <libcamera/ipa/core_ipa_interface.h>
+#include <libcamera/request.h>
+#include "libcamera/internal/camera_sensor.h"
+#include "liuqin_calibration.h"
+
+namespace libcamera {
+
+/* Local experimental ABI, deliberately checked before selecting the PIX path. */
+constexpr uint32_t LiuqinIspBase = V4L2_CID_USER_BASE + 0x3000;
+class LiuqinIsp {
+public:
+	LiuqinIsp(CameraSensor *sensor, V4L2Subdevice *isp) : sensor_(sensor), isp_(isp) {}
+	static bool supported(V4L2Subdevice *isp);
+	int configure(Transform transform, ControlInfoMap *controls);
+	int start(const ControlList &controls);
+	void process(FrameBuffer *buffer, Request *request);
+
+private:
+	void update(const ControlList &controls);
+	int apply();
+	float shading(unsigned int channel, float x, float y) const;
+	CameraSensor *sensor_;
+	V4L2Subdevice *isp_;
+	LiuqinCalibration calibration_;
+	IPACameraSensorInfo info_;
+	Transform transform_;
+	double lineUs_ = 0, exposure_ = 10000, gain_ = 1, red_ = 1, blue_ = 1;
+	unsigned int frameLines_ = 0;
+	bool ae_ = true, awb_ = true;
+	uint32_t nextUpdate_ = 0;
+	struct Applied { uint32_t sequence; int exposure; float gain, red, blue; int64_t duration; };
+	std::deque<Applied> pending_;
+	Applied effective_{};
+};
+
+} /* namespace libcamera */
