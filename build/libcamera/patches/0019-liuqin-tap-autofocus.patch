+void LiuqinIsp::setFocusControls(const ControlList &controls)
+{
+	auto mode = controls.get(controls::AfMode);
+	if (mode && (*mode != controls::AfModeManual || !calibration_.focus.points.empty()))
+		af_.setMode(*mode);
+
+	if (af_.mode() != ipa::soft::ContrastAf::Auto)
+		focusWindow_ = {};
+
+	auto trigger = controls.get(controls::AfTrigger);
+	if (!trigger)
+		return;
+	auto x = controls.get(controls::liuqin::AfPointX);
+	auto y = controls.get(controls::liuqin::AfPointY);
+	if (*trigger == controls::AfTriggerStart && af_.mode() == ipa::soft::ContrastAf::Auto &&
+	    x && y && *x >= 0 && *x <= 1 && *y >= 0 && *y <= 1) {
+		const Size &size = info_.outputSize;
+		const Size window(std::max(1U, size.width / 6), std::max(1U, size.height / 6));
+		const Point centre(std::lround(*x * (size.width - 1)), std::lround(*y * (size.height - 1)));
+		const Rectangle next = window.centeredTo(centre).boundedTo(Rectangle(size));
+		if (next != focusWindow_) {
+			focusWindow_ = next;
+			/* Discard scores accumulated on a previously selected object. */
+			af_.trigger(false);
+		}
+		LOG(LiuqinIsp, Debug) << "Tap AF region " << focusWindow_;
+	}
+	af_.trigger(*trigger == controls::AfTriggerStart);
+}
