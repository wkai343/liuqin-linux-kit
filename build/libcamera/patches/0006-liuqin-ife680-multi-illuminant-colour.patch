+namespace libcamera::liuqinColour {
+/* Shipping IMX596 IPE CC13, same DRC/custom/LED/lux branch as the D50
+ * baseline. Kelvin intervals and matrices come from the five CCT leaves.
+ * Selection and interpolation here are local algorithms, not the OEM AWB.
+ */
+struct MatrixAnchor { double start, end; std::array<float, 9> matrix; };
+inline constexpr MatrixAnchor matrices[] = {
+ {2000, 2450, {1.4726f, -.60985f, .13725f, -.27053f, 1.21319f, .05734f, -.16336f, -.49502f, 1.65838f}},
+ {2650, 3250, {1.37475f, -.44368f, .06893f, -.21636f, 1.20229f, .01407f, -.09141f, -.49107f, 1.58248f}},
+ {3500, 4300, {1.2229f, -.365f, .1421f, -.1435f, 1.2306f, -.0871f, -.0098f, -.362f, 1.3718f}},
+ {4500, 5500, {1.2678f, -.2751f, .0073f, -.1373f, 1.2508f, -.1135f, -.0101f, -.3168f, 1.3269f}},
+ {5800, 8500, {1.24929f, -.21534f, -.03395f, -.10731f, 1.30871f, -.2014f, -.00383f, -.27879f, 1.28262f}},
+};
+inline std::array<float, 9> matrix(double kelvin)
+{
+ if (!std::isfinite(kelvin)) kelvin = 5000;
+ for (unsigned int i = 0; i < std::size(matrices); ++i) {
+  if (kelvin <= matrices[i].end || i + 1 == std::size(matrices))
+   return matrices[i].matrix;
+  if (kelvin < matrices[i + 1].start) {
+   double t = (kelvin - matrices[i].end) / (matrices[i + 1].start - matrices[i].end);
+   auto result = matrices[i].matrix;
+   for (unsigned int j = 0; j < result.size(); ++j)
+    result[j] += t * (matrices[i + 1].matrix[j] - result[j]);
+   return result;
+  }
+ }
+ return matrices[3].matrix;
+}
+/* refPtV1 (module 197) indexes 7, 6, 3, 2, 1: A, TL84, D50, D65, D75.
+ * Kelvin values are nominal illuminant temperatures used by our estimator;
+ * the stock reference-point array does not encode a CCT transfer function.
+ * Normalize to D50 before applying this unit's EEPROM D50 ratios. This keeps
+ * the already validated unit white point and uses the OEM relative locus.
+ */
+struct WhiteAnchor { double kelvin, rg, bg; };
+inline constexpr WhiteAnchor whites[] = {
+ {2856, .83547, .35374}, {4000, .59795, .4458},
+ {5000, .53362, .54795}, {6500, .45391, .6851}, {7500, .42896, .73227},
+};
+inline std::pair<double, double> gains(double kelvin, double unitRG, double unitBG)
+{
+ kelvin = std::isfinite(kelvin) ? std::clamp(kelvin, whites[0].kelvin, whites[4].kelvin) : 5000;
+ for (unsigned int i = 0; i + 1 < std::size(whites); ++i) {
+  if (kelvin > whites[i + 1].kelvin) continue;
+  double t = (1 / kelvin - 1 / whites[i].kelvin) / (1 / whites[i + 1].kelvin - 1 / whites[i].kelvin);
+  double rg = std::exp((1 - t) * std::log(whites[i].rg) + t * std::log(whites[i + 1].rg));
+  double bg = std::exp((1 - t) * std::log(whites[i].bg) + t * std::log(whites[i + 1].bg));
+  return {std::clamp(whites[2].rg / (rg * unitRG), 1.0, 16.0),
+          std::clamp(whites[2].bg / (bg * unitBG), 1.0, 16.0)};
+ }
+ return {1, 1};
+}
+struct Estimate { double kelvin = 5000, distance = std::numeric_limits<double>::infinity(); };
+inline Estimate estimate(double rg, double bg, double unitRG, double unitBG)
+{
+ Estimate result;
+ if (!(rg > 0 && bg > 0 && unitRG > 0 && unitBG > 0) ||
+     !std::isfinite(rg + bg + unitRG + unitBG)) return result;
+ double x = std::log(rg / unitRG * whites[2].rg);
+ double y = std::log(bg / unitBG * whites[2].bg);
+ for (unsigned int i = 0; i + 1 < std::size(whites); ++i) {
+  double ax = std::log(whites[i].rg), ay = std::log(whites[i].bg);
+  double dx = std::log(whites[i + 1].rg) - ax, dy = std::log(whites[i + 1].bg) - ay;
+  double t = std::clamp(((x - ax) * dx + (y - ay) * dy) / (dx * dx + dy * dy), 0.0, 1.0);
+  double distance = std::hypot(x - ax - t * dx, y - ay - t * dy);
+  if (distance < result.distance) {
+   result.distance = distance;
+   result.kelvin = 1 / ((1 - t) / whites[i].kelvin + t / whites[i + 1].kelvin);
+  }
+ }
+ return result;
+}
+} /* namespace libcamera::liuqinColour */
