@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+namespace libcamera::liuqinColour {
+/* Local robust selection, not the proprietary OEM AWB. Inputs have already
+ * passed the calibrated OEM white-locus and clipping tests. Keep each RGB
+ * observation paired, and avoid averaging different illuminant populations.
+ */
+struct Neutral {
+ double red, blue, kelvin, green, spatial;
+};
+struct Balance {
+ double red = 1, blue = 1;
+ unsigned int selected = 0;
+};
+inline Balance balance(std::vector<Neutral> samples)
+{
+ Balance result;
+ samples.erase(std::remove_if(samples.begin(), samples.end(), [](const Neutral &n) {
+  return !std::isfinite(n.red + n.blue + n.kelvin + n.green + n.spatial) ||
+         n.red < 1 || n.red > 4 || n.blue < 1 || n.blue > 4 ||
+         n.kelvin < 2856 || n.kelvin > 7500 || n.green < .03 || n.green > .75 || n.spatial <= 0;
+ }), samples.end());
+ if (samples.size() < 24) return result;
+ auto weight = [](const Neutral &n) { return n.spatial * n.green * n.green; };
+ std::sort(samples.begin(), samples.end(), [](const Neutral &a, const Neutral &b) { return a.kelvin < b.kelvin; });
+ double total = 0;
+ for (const auto &n : samples) total += weight(n);
+ double cumulative = 0, median = samples.back().kelvin;
+ for (const auto &n : samples) {
+  cumulative += weight(n);
+  if (cumulative >= total / 2) { median = n.kelvin; break; }
+ }
+ double r = 0, b = 0, weights = 0;
+ for (const auto &n : samples) {
+  /* Reject a separate light population instead of mixing unrelated R/B medians. */
+  if (std::abs(std::log(n.kelvin / median)) > std::log(1.18)) continue;
+  double w = weight(n);
+  r += w * std::log(n.red); b += w * std::log(n.blue); weights += w;
+  result.selected++;
+ }
+ if (result.selected < 8 || weights <= 0) return {};
+ result.red = std::exp(r / weights); result.blue = std::exp(b / weights);
+ return result;
+}
+} /* namespace libcamera::liuqinColour */
