# The initramfs must start before any shared library is available.
CONFIG_STATIC=y
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_INSTALL=y
CONFIG_BLOCKDEV=y
CONFIG_CHROOT=y
CONFIG_CTTYHACK=y
CONFIG_FINDFS=y
CONFIG_IP=y
CONFIG_LOSETUP=y
CONFIG_MDEV=y
CONFIG_SETSID=y
CONFIG_TIMEOUT=y
CONFIG_STAT=y
CONFIG_FEATURE_STAT_FORMAT=y
CONFIG_FEATURE_STAT_FILESYSTEM=y
CONFIG_SHA256SUM=y
CONFIG_SWITCH_ROOT=y
CONFIG_TELNETD=y
CONFIG_UDHCPD=y
CONFIG_GZIP=y
CONFIG_XZ=y
CONFIG_UNXZ=y
CONFIG_FEATURE_TAR_XZ=y
