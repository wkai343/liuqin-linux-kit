From: Liuqin Linux Kit <liuqin@localhost>
Date: Sat, 14 Nov 2026 18:47:59 +0800
Subject: [PATCH] avcodec/v4l2: reopen decoder sessions after flush

A stateful decoder retains EOS and queued pictures until its session is reset.
Implement flush by stopping and detaching the old session, and lazily creating
a new one on receive. Retained DRM frames keep their own old capture buffers;
never feed those buffers back into the new session. Return reopen errors from
receive, and clear the borrowed AVCodecContext pointer before delayed cleanup.

diff --git a/libavcodec/v4l2_m2m_dec.c b/libavcodec/v4l2_m2m_dec.c
--- a/libavcodec/v4l2_m2m_dec.c
+++ b/libavcodec/v4l2_m2m_dec.c
@@ -191,12 +191,27 @@
     return 0;
 }
 
+static av_cold int v4l2_decode_init(AVCodecContext *avctx);
+
 static int v4l2_receive_frame(AVCodecContext *avctx, AVFrame *frame)
 {
-    V4L2m2mContext *s = ((V4L2m2mPriv*)avctx->priv_data)->context;
-    V4L2Context *const capture = &s->capture;
-    V4L2Context *const output = &s->output;
-    int ret;
+    V4L2m2mPriv *priv = avctx->priv_data;
+    V4L2m2mContext *s;
+    V4L2Context *capture, *output;
+    int ret;
+
+    /* Flush detaches the old session. Reopen lazily so errors can be returned
+     * here, while exported frames may still retain the old capture buffers. */
+    if (!priv->context) {
+        ret = v4l2_decode_init(avctx);
+        if (ret < 0) {
+            ff_v4l2_m2m_codec_end(priv);
+            return ret;
+        }
+    }
+    s = priv->context;
+    capture = &s->capture;
+    output = &s->output;
 
     if (!s->buf_pkt.size) {
         ret = ff_decode_get_packet(avctx, &s->buf_pkt);
@@ -262,7 +277,8 @@
     output->av_pix_fmt  = AV_PIX_FMT_NONE;
 
     capture->av_codec_id = AV_CODEC_ID_RAWVIDEO;
-    capture->av_pix_fmt = avctx->pix_fmt;
+    capture->av_pix_fmt = avctx->pix_fmt == AV_PIX_FMT_DRM_PRIME ?
+                         avctx->sw_pix_fmt : avctx->pix_fmt;
 
     s->avctx = avctx;
     ret = ff_v4l2_m2m_codec_init(priv);
@@ -277,6 +293,14 @@
 static av_cold int v4l2_decode_close(AVCodecContext *avctx)
 {
     return ff_v4l2_m2m_codec_end(avctx->priv_data);
+}
+
+static void v4l2_decode_flush(AVCodecContext *avctx)
+{
+    /* STREAMOFF both queues and detach the session, including pending input,
+     * reordered output, EOS events and timestamp history. Do not recycle
+     * buffers that a renderer still owns into the new decode session. */
+    ff_v4l2_m2m_codec_end(avctx->priv_data);
 }
 
 #define OFFSET(x) offsetof(V4L2m2mPriv, x)
@@ -325,6 +349,7 @@
         .init           = v4l2_decode_init, \
         FF_CODEC_RECEIVE_FRAME_CB(v4l2_receive_frame), \
         .close          = v4l2_decode_close, \
+        .flush          = v4l2_decode_flush, \
         .bsfs           = bsf_name, \
         .p.capabilities = AV_CODEC_CAP_HARDWARE | AV_CODEC_CAP_DELAY | AV_CODEC_CAP_AVOID_PROBING, \
         .caps_internal  = FF_CODEC_CAP_NOT_INIT_THREADSAFE | \
diff --git a/libavcodec/v4l2_m2m.c b/libavcodec/v4l2_m2m.c
--- a/libavcodec/v4l2_m2m.c
+++ b/libavcodec/v4l2_m2m.c
@@ -283,6 +283,9 @@
     ff_v4l2_context_release(&s->output);
 
     s->self_ref = NULL;
+    /* Capture frames can outlive the AVCodecContext. Error logging during
+     * their eventual unmap must not dereference the old codec context. */
+    s->avctx = NULL;
     av_refstruct_unref(&priv->context);
 
     return 0;
