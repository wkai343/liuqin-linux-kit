#!/bin/sh
# SPDX-License-Identifier: MIT
# Scope Qt's GStreamer/OpenGL playback policy to the requested application.
if [ "$#" -eq 0 ]; then
    printf 'Usage: liuqin-qt-video PROGRAM [ARGUMENT ...]\n' >&2
    exit 2
fi
exec env QT_MEDIA_BACKEND=gstreamer QSG_RHI_BACKEND=opengl \
    QT_GSTREAMER_DISABLE_PIXEL_ASPECT_RATIO=1 "$@"
