diff --git a/src/plasmacamera/liuqinorientation.h b/src/plasmacamera/liuqinorientation.h
new file mode 100644
index 0000000..2513fc5
--- /dev/null
+++ b/src/plasmacamera/liuqinorientation.h
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <QImage>
+#include <QTransform>
+
+namespace LiuqinOrientation
+{
+// Both built-in streams are already upright in RightUp landscape. The two
+// cameras look in opposite directions when the device turns about the lens.
+constexpr int degrees(int poseDegrees, bool front)
+{
+    const int fromLandscape = poseDegrees - 270;
+    return ((front ? -fromLandscape : fromLandscape) + 360) % 360;
+}
+
+inline QImage rotateStill(const QImage &frame, int degrees, bool mirror = false)
+{
+    // Qt has exact integer paths for canonical quarter-turns. An equivalent
+    // angle of 450 degrees goes through the general transform and grows the image.
+    QImage upright = frame.transformed(QTransform().rotate((degrees % 360 + 360) % 360));
+    return mirror ? upright.flipped(Qt::Horizontal) : upright;
+}
+}
