@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <gst/video/video.h>
+#include <condition_variable>
+#include <memory>
+#include <mutex>
+
+namespace FlashCapture {
+using Sample = std::shared_ptr<GstSample>;
+struct Window {
+    const GstClockTime base;
+    GstClockTime before = GST_CLOCK_TIME_NONE, after = GST_CLOCK_TIME_NONE;
+    GstClockTime selectedStamp = GST_CLOCK_TIME_NONE;
+    unsigned early = 0, late = 0, invalid = 0, incomplete = 0;
+    guint rejectedFlags = 0;
+    std::mutex mutex;
+    std::condition_variable ready;
+    Sample frame;
+    explicit Window(GstClockTime baseTime) : base(baseTime) {}
+};
+using WindowPtr = std::shared_ptr<Window>;
+
+inline GstPadProbeReturn selectFrame(GstPad *pad, GstPadProbeInfo *info, gpointer data)
+{
+    auto &w = **static_cast<WindowPtr *>(data);
+    auto *buffer = GST_PAD_PROBE_INFO_BUFFER(info);
+    std::lock_guard lock(w.mutex);
+    if (!GST_CLOCK_TIME_IS_VALID(w.after) || GST_CLOCK_TIME_IS_VALID(w.selectedStamp))
+        return GST_PAD_PROBE_OK;
+    GstEvent *event = gst_pad_get_sticky_event(pad, GST_EVENT_SEGMENT, 0);
+    GstClockTime running = GST_CLOCK_TIME_NONE;
+    if (event) {
+        const GstSegment *segment;
+        gst_event_parse_segment(event, &segment);
+        if (segment->format == GST_FORMAT_TIME && GST_BUFFER_PTS_IS_VALID(buffer))
+            running = gst_segment_to_running_time(segment, GST_FORMAT_TIME, GST_BUFFER_PTS(buffer));
+        gst_event_unref(event);
+    }
+    if (!GST_CLOCK_TIME_IS_VALID(running) || running >= GST_CLOCK_TIME_NONE - w.base) {
+        ++w.invalid;
+        return GST_PAD_PROBE_OK;
+    }
+    // S5KJN1, 4080x3060 at 30 fps: allow for integration, rolling readout and IPE delay.
+    const auto stamp = w.base + running;
+    if (stamp < w.after || stamp - w.after < 130 * GST_MSECOND) {
+        ++w.early;
+    } else if (stamp - w.before > 190 * GST_MSECOND) {
+        ++w.late;
+    } else {
+        // DISCONT can mark the first complete raw image after a skipped image.
+        // It is safe only with a current TIME segment, matching raw caps and a full payload.
+        GstCaps *caps = gst_pad_get_current_caps(pad);
+        GstVideoInfo video;
+        if (!(GST_BUFFER_FLAGS(buffer) & (GST_BUFFER_FLAG_CORRUPTED | GST_BUFFER_FLAG_GAP | GST_BUFFER_FLAG_DECODE_ONLY | GST_BUFFER_FLAG_HEADER))
+            && caps && gst_structure_has_name(gst_caps_get_structure(caps, 0), "video/x-raw")
+            && gst_video_info_from_caps(&video, caps) && video.width == 4080 && video.height == 3060
+            && GST_VIDEO_INFO_INTERLACE_MODE(&video) == GST_VIDEO_INTERLACE_MODE_PROGRESSIVE
+            && gst_buffer_get_size(buffer) >= GST_VIDEO_INFO_SIZE(&video)) {
+            w.frame.reset(gst_sample_new(buffer, caps, nullptr, nullptr), gst_sample_unref);
+            w.selectedStamp = stamp;
+            w.ready.notify_one();
+        } else {
+            ++w.incomplete;
+            w.rejectedFlags |= GST_BUFFER_FLAGS(buffer);
+        }
+        gst_clear_caps(&caps);
+    }
+    return GST_PAD_PROBE_OK;
+}
+
+// Observe buffers before firing. Only the STROBE write brackets the instant of ignition;
+// the separate STATUS ioctl authorizes saving, but cannot move either exposure bound.
+template<class Clock, class Fire, class Status>
+bool arm(const WindowPtr &w, GstPad *pad, gulong &probe, Clock now, Fire fire, Status lit)
+{
+    if (!GST_CLOCK_TIME_IS_VALID(w->base))
+        return false;
+    probe = gst_pad_add_probe(pad, GST_PAD_PROBE_TYPE_BUFFER, selectFrame,
+                              new WindowPtr(w), [](gpointer p) { delete static_cast<WindowPtr *>(p); });
+    if (!probe)
+        return false;
+    {
+        std::lock_guard lock(w->mutex);
+        w->before = now();
+        if (!fire())
+            return false;
+        w->after = now();
+    }
+    return lit();
+}
+}
