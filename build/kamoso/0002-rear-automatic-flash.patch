+RearFlash::RearFlash()
+{
+    m_meterTimer.setSingleShot(true);
+    m_meterTimer.setTimerType(Qt::PreciseTimer);
+    connect(&m_meterTimer, &QTimer::timeout, this, &RearFlash::sampleExposure);
+}
+
+void RearFlash::resetMeter()
+{
+    cancel();
+    m_lastAutoFlash = false;
+    m_meterAfter = std::max(m_meterAfter, QDeadlineTimer(800, Qt::PreciseTimer));
+}
+
+void RearFlash::meter(GstElement *cameraSource, const QUrl &destination)
+{
+    if (busy())
+        return;
+    m_sensor.setFileName(rearSensorNode());
+    if (!m_sensor.open(QIODevice::ReadOnly | QIODevice::Unbuffered)) {
+        Q_EMIT failed(i18n("Could not meter the rear camera. Try again or select a flash mode."));
+        return;
+    }
+    GstElement *source = nullptr;
+    g_object_get(cameraSource, "video-source", &source, nullptr);
+    m_pad = source ? gst_element_get_static_pad(source, "src") : nullptr;
+    gst_clear_object(&source);
+    m_frameLuma = std::make_shared<std::atomic<int>>(lumaIdle);
+    if (m_pad)
+        m_probe = gst_pad_add_probe(m_pad, GST_PAD_PROBE_TYPE_BUFFER, meterFrame,
+                                    new FrameLuma(m_frameLuma), [](gpointer p) { delete static_cast<FrameLuma *>(p); });
+    if (!m_probe) {
+        m_sensor.close();
+        clearProbe();
+        Q_EMIT failed(i18n("Could not meter the rear camera. Try again or select a flash mode."));
+        return;
+    }
+    m_meterDestination = destination;
+    m_samples = 0;
+    m_agree = 0;
+    m_meterTimer.start(int(m_meterAfter.remainingTime()));
+    Q_EMIT busyChanged();
+}
+
+void RearFlash::sampleExposure()
+{
+    // The first request is armed only after the preview / previous strobe settles.
+    const int luma = m_frameLuma->exchange(lumaRequested);
+    if (luma == lumaIdle) {
+        m_meterTimer.start(100);
+        return;
+    }
+    auto exposure = unityExposureMs(m_sensor.handle());
+    ++m_samples;
+    if (exposure && luma >= 0) {
+        // A dark object can need high gain while the finished image is well exposed.
+        const bool fire = m_lastAutoFlash ? (*exposure > 150.0 && luma < 96)
+                                          : (*exposure >= 240.0 && luma <= 80);
+        m_agree = (m_agree && fire == m_candidate) ? m_agree + 1 : 1;
+        m_candidate = fire;
+        if (m_agree == 3) {
+            qCDebug(flashLog) << "Auto flash: unity-gain exposure (ms)" << *exposure << "preview Y75" << luma << "fire" << fire;
+            m_lastAutoFlash = fire;
+            const QUrl destination = m_meterDestination;
+            m_meterDestination.clear();
+            m_sensor.close();
+            clearProbe();
+            Q_EMIT metered(destination, fire);
+            Q_EMIT busyChanged();
+            return;
+        }
+    } else {
+        m_agree = 0;
+    }
+    if (m_samples < 10) {
+        m_meterTimer.start(100);
+    } else {
+        cancel();
+        Q_EMIT failed(i18n("Could not meter the rear camera. Try again or select a flash mode."));
+    }
+}
+
 RearFlash::~RearFlash()
 {
     cancel();
 }
 
