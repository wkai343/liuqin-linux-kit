+QString rearSensorNode()
+{
+    // Match the sensor backing the PipeWire camera, even when the minor changes.
+    const QDir sensors(QStringLiteral("/sys/class/video4linux"));
+    const QString rear = QFileInfo(QStringLiteral("/sys/firmware/devicetree/base/soc@0/cci@ac15000/i2c-bus@1/camera@10")).canonicalFilePath();
+    if (!rear.isEmpty()) {
+        for (const auto &node : sensors.entryList({QStringLiteral("v4l-subdev*")}, QDir::Dirs)) {
+            if (QFileInfo(sensors.filePath(node + QStringLiteral("/device/of_node"))).canonicalFilePath() == rear)
+                return QStringLiteral("/dev/") + node;
+        }
+    }
+    return {};
+}
+
+// The S5KJN1 driver exposes integration in lines and analogue gain in whole
+// multiples of unity. Read them together while WirePlumber owns the stream.
+std::optional<double> unityExposureMs(int fd)
+{
+    v4l2_subdev_format format{};
+    format.which = V4L2_SUBDEV_FORMAT_ACTIVE;
+    if (ioctl(fd, VIDIOC_SUBDEV_G_FMT, &format) < 0 ||
+        format.format.width != 4080 || format.format.height != 3060)
+        return std::nullopt;
+    v4l2_ext_control values[4]{};
+    values[0].id = V4L2_CID_EXPOSURE;
+    values[1].id = V4L2_CID_ANALOGUE_GAIN;
+    values[2].id = V4L2_CID_HBLANK;
+    values[3].id = V4L2_CID_PIXEL_RATE;
+    v4l2_ext_controls controls{};
+    controls.which = V4L2_CTRL_WHICH_CUR_VAL;
+    controls.count = 4;
+    controls.controls = values;
+    if (ioctl(fd, VIDIOC_G_EXT_CTRLS, &controls) < 0 || values[0].value <= 0 ||
+        values[1].value <= 0 || values[2].value < 0 || values[3].value64 <= 0)
+        return std::nullopt;
+    return 1000.0 * values[0].value * values[1].value *
+           (double(format.format.width) + values[2].value) / values[3].value64;
+}
+
+// Sample the unfiltered ISP output only on request. The streaming thread owns
+// the frame mapping, and only a scalar crosses into the Qt event loop.
+constexpr int lumaIdle = -2;
+constexpr int lumaRequested = -1;
+using FrameLuma = std::shared_ptr<std::atomic<int>>;
+
+GstPadProbeReturn meterFrame(GstPad *pad, GstPadProbeInfo *info, gpointer data)
+{
+    auto &reading = **static_cast<FrameLuma *>(data);
+    auto *buffer = GST_PAD_PROBE_INFO_BUFFER(info);
+    if (reading.load() != lumaRequested || !GST_BUFFER_PTS_IS_VALID(buffer) ||
+        GST_BUFFER_FLAG_IS_SET(buffer, GST_BUFFER_FLAG_DISCONT) ||
+        GST_BUFFER_FLAG_IS_SET(buffer, GST_BUFFER_FLAG_CORRUPTED))
+        return GST_PAD_PROBE_OK;
+
+    GstVideoInfo video;
+    GstCaps *caps = gst_pad_get_current_caps(pad);
+    bool nv12 = caps && gst_video_info_from_caps(&video, caps) &&
+                GST_VIDEO_INFO_FORMAT(&video) == GST_VIDEO_FORMAT_NV12 &&
+                video.width == 4080 && video.height == 3060;
+    gst_clear_caps(&caps);
+    GstVideoFrame frame;
+    if (!nv12 || !gst_video_frame_map(&frame, &video, buffer, GST_MAP_READ))
+        return GST_PAD_PROBE_OK;
+
+    constexpr int columns = 32, rows = 24;
+    std::array<int, columns * rows> samples;
+    const auto *plane = GST_VIDEO_FRAME_COMP_DATA(&frame, 0);
+    const int stride = GST_VIDEO_FRAME_COMP_STRIDE(&frame, 0);
+    for (int j = 0; j < rows; ++j) {
+        const int y = (2 * j + 1) * video.height / (2 * rows);
+        for (int i = 0; i < columns; ++i) {
+            const int x = (2 * i + 1) * video.width / (2 * columns);
+            samples[j * columns + i] = plane[y * stride + x];
+        }
+    }
+    gst_video_frame_unmap(&frame);
+    auto quartile = samples.begin() + 3 * samples.size() / 4;
+    std::nth_element(samples.begin(), quartile, samples.end());
+    int luma = *quartile;
+    if (video.colorimetry.range == GST_VIDEO_COLOR_RANGE_16_235)
+        luma = std::clamp((luma - 16) * 255 / 219, 0, 255);
+    reading.store(luma);
+    return GST_PAD_PROBE_OK;
+}
