+bool WebcamControl::focusAt(const QPointF &tap)
+{
+    Device *device = DeviceManager::self()->playingDevice();
+    if (!device || !device->rearFlash() || m_currentDevice != device->objectId() ||
+        !m_viewfinder || !m_cameraSource || !m_surface)
+        return false;
+
+    // Spatial effects such as kaleidoscope can show one object several times.
+    if (!m_extraFilters.isEmpty() && m_extraFilters != QStringLiteral("identity") &&
+        !m_extraFilters.startsWith(QStringLiteral("videobalance ")) &&
+        !m_extraFilters.startsWith(QStringLiteral("coloreffects ")))
+        return false;
+
+    GstElement *source = nullptr;
+    g_object_get(m_cameraSource.data(), "video-source", &source, nullptr);
+    GstPointer<GstElement> camera(source);
+    GstPointer<GstElement> view(gst_bin_get_by_name(GST_BIN(m_viewfinder.data()), "videosink"));
+    if (!camera || !view)
+        return false;
+    GstPointer<GstPad> src(gst_element_get_static_pad(camera.data(), "src"));
+    GstPointer<GstPad> sink(gst_element_get_static_pad(view.data(), "sink"));
+    const QSize size(int(m_surface->width()), int(m_surface->height()));
+    auto point = cameraFocusPoint(sink.data(), src.data(), size, tap);
+    if (!point)
+        return false;
+    m_pendingFocus = point;
+    sendPendingFocus();
+    return true;
+}
+
+void WebcamControl::sendPendingFocus()
+{
+    if (!m_pendingFocus || m_focusProcess.state() != QProcess::NotRunning)
+        return;
+    const QPointF point = *m_pendingFocus;
+    m_pendingFocus.reset();
+    m_focusProcess.start(QStringLiteral(KAMOSO_FOCUS_HELPER),
+                         {QStringLiteral("tap"), QString::number(point.x(), 'f', 7),
+                          QString::number(point.y(), 'f', 7)});
+}
+
+void WebcamControl::clearFocusTarget()
+{
+    m_pendingFocus.reset();
+    if (m_focusProcess.state() != QProcess::NotRunning)
+        m_focusProcess.kill();
+    Q_EMIT focusTargetCleared();
+}
+
 void WebcamControl::stop()
 {
+    clearFocusTarget();
     m_flash.cancel();
     if(m_pipeline) {
         gst_element_set_state(GST_ELEMENT(m_pipeline.data()), GST_STATE_NULL);
@@ -498,6 +564,7 @@ void WebcamControl::setExtraFilters(const QString& extraFilters)
 
 void WebcamControl::updateSourceFilter()
 {
+    clearFocusTarget();
     m_flash.resetMeter();
     if (!m_pipeline)
         return;
