diff --git a/src/video/tapfocus.cpp b/src/video/tapfocus.cpp
new file mode 100644
index 0000000..20ca402
--- /dev/null
+++ b/src/video/tapfocus.cpp
@@ -0,0 +1,75 @@
+/*
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "tapfocus.h"
+
+#include <gst/video/video.h>
+#include <algorithm>
+#include <cmath>
+
+namespace {
+bool videoInfo(GstPad *pad, GstVideoInfo *info)
+{
+    GstCaps *caps = gst_pad_get_current_caps(pad);
+    if (!caps)
+        return false;
+    const bool valid = gst_video_info_from_caps(info, caps);
+    gst_caps_unref(caps);
+    return valid;
+}
+
+struct FocusEvent {
+    guint32 seqnum;
+    std::optional<QPointF> point;
+};
+
+GstPadProbeReturn readPoint(GstPad *, GstPadProbeInfo *probe, gpointer data)
+{
+    auto *focus = static_cast<FocusEvent *>(data);
+    GstEvent *event = GST_PAD_PROBE_INFO_EVENT(probe);
+    if (GST_EVENT_TYPE(event) != GST_EVENT_NAVIGATION || gst_event_get_seqnum(event) != focus->seqnum)
+        return GST_PAD_PROBE_OK;
+    double x, y;
+    if (gst_navigation_event_get_coordinates(event, &x, &y))
+        focus->point = QPointF(x, y);
+    return GST_PAD_PROBE_DROP;
+}
+}
+
+std::optional<QPointF> cameraFocusPoint(GstPad *preview, GstPad *camera, QSize item, QPointF tap)
+{
+    GstVideoInfo view, source;
+    if (!preview || !camera || item.isEmpty() || !videoInfo(preview, &view) || !videoInfo(camera, &source))
+        return {};
+    // qml6glsink keeps the display aspect ratio inside the logical Quick item.
+    guint num, den;
+    if (!gst_video_calculate_display_ratio(&num, &den, view.width, view.height,
+                                           view.par_n, view.par_d, 1, 1))
+        return {};
+    GstVideoRectangle display{0, 0, view.width, view.height};
+    if (view.height % den == 0 || view.width % num != 0)
+        display.w = gst_util_uint64_scale_int(view.height, num, den);
+    else
+        display.h = gst_util_uint64_scale_int(view.width, den, num);
+    const GstVideoRectangle bounds{0, 0, item.width(), item.height()};
+    GstVideoRectangle content;
+    gst_video_center_rect(&display, &bounds, &content, TRUE);
+    const double x = tap.x() - content.x;
+    const double y = tap.y() - content.y;
+    if (!(x >= 0 && x < content.w && y >= 0 && y < content.h))
+        return {};
+
+    // Navigation travels upstream synchronously. Each videoflip, crop and
+    // scaler translates the coordinates using its actually negotiated geometry.
+    GstEvent *event = gst_navigation_event_new_mouse_move(x * view.width / content.w,
+                                                          y * view.height / content.h,
+                                                          GST_NAVIGATION_MODIFIER_NONE);
+    FocusEvent focus{gst_event_get_seqnum(event), {}};
+    gulong probe = gst_pad_add_probe(camera, GST_PAD_PROBE_TYPE_EVENT_UPSTREAM, readPoint, &focus, nullptr);
+    gst_pad_push_event(preview, event);
+    gst_pad_remove_probe(camera, probe);
+    if (!focus.point || !std::isfinite(focus.point->x()) || !std::isfinite(focus.point->y()))
+        return {};
+    return QPointF(std::clamp(focus.point->x() / source.width, 0., 1.),
+                   std::clamp(focus.point->y() / source.height, 0., 1.));
+}
