@@ -436,10 +437,13 @@ bool WebcamControl::playDevice(Device *device)
 
     m_rearRecording.configure(m_pipeline.data(), device->rearFlash());
 
-    // The preview sink may discard late frames locally. Its QoS events must
-    // not drop a full-resolution rear frame before the flash shutter sees it.
+    // Rear frames keep their sensor timestamps through PipeWire and GL upload.
+    // Allow for delivery jitter here and keep preview QoS events off the flash path.
+    constexpr gint64 rearPreviewMaxLateness = 120 * GST_MSECOND;
+    const bool rear = device->rearFlash();
     auto *previewSink = gst_bin_get_by_name(GST_BIN(m_viewfinder.data()), "videosink");
-    g_object_set(previewSink, "qos", !device->rearFlash(), nullptr);
+    g_object_set(previewSink, "qos", !rear,
+                 "max-lateness", rear ? rearPreviewMaxLateness : m_defaultPreviewMaxLateness, nullptr);
     gst_object_unref(previewSink);
     setVideoSettings();
 
