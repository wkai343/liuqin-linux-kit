+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include "gstpointer.h"
+#include <gst/gst.h>
+#include <atomic>
+#include <memory>
+
+// Keep the board camera's monotonic capture timestamps when its provider
+// exposes a PipeWire source. Other providers retain their normal source.
+GstElement *createRearCameraSource(GstDevice *device, const char *name);
+
+class RearRecording
+{
+public:
+    // The caller keeps its device reference and owns the returned source.
+    GstElement *cameraSource(GstElement *device, bool rear);
+    void configure(GstPipeline *pipeline, bool rear);
+    bool begin(GstPipeline *pipeline);
+    void releaseMode();
+
+private:
+    std::shared_ptr<std::atomic<GstClockTime>> m_shutter =
+        std::make_shared<std::atomic<GstClockTime>>(GST_CLOCK_TIME_NONE);
+    GstPointer<GstElement> m_modeFilter;
+};
