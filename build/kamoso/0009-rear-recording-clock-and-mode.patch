diff --git a/src/video/rearrecording.cpp b/src/video/rearrecording.cpp
new file mode 100644
index 0000000..9a9f2b9
--- /dev/null
+++ b/src/video/rearrecording.cpp
@@ -0,0 +1,171 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "rearrecording.h"
+#include <algorithm>
+#include <gst/base/gstbasesrc.h>
+
+namespace {
+using Shutter = std::shared_ptr<std::atomic<GstClockTime>>;
+
+void cameraTimes(GstBaseSrc *src, GstBuffer *buffer, GstClockTime *start, GstClockTime *end)
+{
+    // The board's libcamera SPA node puts the monotonic V4L2 capture time
+    // in the header. The push source already waits for the captured frame.
+    // BaseSrc's pseudo-live scheduling would instead shift every PTS by
+    // the delivery latency of the first preview frame.
+    const auto base = gst_element_get_base_time(GST_ELEMENT(src));
+    const auto pts = GST_BUFFER_PTS(buffer);
+    GstPointer<GstClock> clock(gst_element_get_clock(GST_ELEMENT(src)));
+    if (clock && GST_CLOCK_TIME_IS_VALID(base) && GST_CLOCK_TIME_IS_VALID(pts) &&
+        pts >= base && pts <= gst_clock_get_time(clock.data())) {
+        GST_BUFFER_PTS(buffer) = pts - base;
+        const auto dts = GST_BUFFER_DTS(buffer);
+        GST_BUFFER_DTS(buffer) = GST_CLOCK_TIME_IS_VALID(dts) && dts >= base ? dts - base : GST_CLOCK_TIME_NONE;
+        *start = *end = GST_CLOCK_TIME_NONE;
+        return;
+    }
+    auto *parent = GST_BASE_SRC_CLASS(g_type_class_peek_parent(G_OBJECT_GET_CLASS(src)));
+    parent->get_times(src, buffer, start, end);
+}
+
+GType captureSourceType(GType parent)
+{
+    // PipeWire registers its source type at runtime. Use its GType sizes
+    // and only override the public GstBaseSrc scheduling virtual method.
+    GTypeQuery query{};
+    g_type_query(parent, &query);
+    if (!g_type_is_a(parent, GST_TYPE_BASE_SRC) || G_TYPE_IS_FINAL(parent) || !query.instance_size)
+        return G_TYPE_INVALID;
+    return g_type_register_static_simple(parent, "KamosoLiuqinCaptureSrc", query.class_size,
+        [](gpointer klass, gpointer) { GST_BASE_SRC_CLASS(klass)->get_times = cameraTimes; },
+        query.instance_size, nullptr, GTypeFlags(0));
+}
+
+GstPadProbeReturn recordingSegment(GstPad *, GstPadProbeInfo *info, gpointer data)
+{
+    GstEvent *event = GST_PAD_PROBE_INFO_EVENT(info);
+    if (GST_EVENT_TYPE(event) != GST_EVENT_SEGMENT)
+        return GST_PAD_PROBE_OK;
+
+    const GstSegment *input = nullptr;
+    gst_event_parse_segment(event, &input);
+    const auto shutter = (*static_cast<Shutter *>(data))->load();
+    if (!GST_CLOCK_TIME_IS_VALID(shutter) || input->format != GST_FORMAT_TIME ||
+        input->rate != 1.0 || input->applied_rate != 1.0)
+        return GST_PAD_PROBE_OK;
+
+    // camerabin starts each live TIME segment at that source's first PTS.
+    // Both sources use pipeline running time. Keep their relative start and
+    // let downstream clip any preview buffer that predates this shutter.
+    GstSegment segment = *input;
+    segment.start = std::max(input->start, shutter);
+    segment.base = segment.start - shutter;
+    segment.time = segment.base;
+    segment.position = std::max(input->position, segment.start);
+    GstEvent *replacement = gst_event_new_segment(&segment);
+    gst_event_set_seqnum(replacement, gst_event_get_seqnum(event));
+    gst_event_set_running_time_offset(replacement, gst_event_get_running_time_offset(event));
+    GST_PAD_PROBE_INFO_DATA(info) = replacement;
+    gst_event_unref(event);
+    return GST_PAD_PROBE_OK;
+}
+
+GstElement *timedBranch(const Shutter &shutter)
+{
+    auto *filter = gst_element_factory_make("identity", nullptr);
+    gst_object_ref_sink(filter);
+    GstPointer<GstPad> pad(gst_element_get_static_pad(filter, "src"));
+    gst_pad_add_probe(pad.data(), GST_PAD_PROBE_TYPE_EVENT_DOWNSTREAM, recordingSegment,
+                      new Shutter(shutter), [](gpointer p) { delete static_cast<Shutter *>(p); });
+    return filter;
+}
+}
+
+GstElement *createRearCameraSource(GstDevice *device, const char *name)
+{
+    g_autoptr(GstElement) original = gst_device_create_element(device, name);
+    GstElementFactory *factory = original ? gst_element_get_factory(original) : nullptr;
+    if (factory && g_strcmp0(gst_plugin_feature_get_name(factory), "pipewiresrc") == 0) {
+        static const GType type = captureSourceType(G_OBJECT_TYPE(original));
+        if (type) {
+            g_autoptr(GstElement) source = GST_ELEMENT(g_object_new(type, "name", name, nullptr));
+            // Let the provider set its own node serial and portal fd.
+            if (gst_device_reconfigure_element(device, source))
+                return g_steal_pointer(&source);
+        }
+    }
+    return g_steal_pointer(&original);
+}
+
+GstElement *RearRecording::cameraSource(GstElement *device, bool rear)
+{
+    m_modeFilter.reset();
+    if (!rear)
+        return GST_ELEMENT(gst_object_ref(device));
+
+    g_autoptr(GstElement) bin = GST_ELEMENT(gst_object_ref_sink(gst_bin_new(nullptr)));
+    GstElement *filter = gst_element_factory_make("capsfilter", nullptr);
+    if (!filter)
+        return nullptr;
+    gst_bin_add_many(GST_BIN(bin), device, filter, nullptr);
+    if (!gst_element_link(device, filter))
+        return nullptr;
+    GstPointer<GstPad> src(gst_element_get_static_pad(filter, "src"));
+    GstPad *output = gst_ghost_pad_new("src", src.data());
+    if (!gst_element_add_pad(bin, output)) {
+        gst_object_unref(output);
+        return nullptr;
+    }
+    m_modeFilter.reset(GST_ELEMENT(gst_object_ref(filter)));
+    return g_steal_pointer(&bin);
+}
+
+void RearRecording::configure(GstPipeline *pipeline, bool rear)
+{
+    m_shutter->store(GST_CLOCK_TIME_NONE);
+    if (!rear) {
+        gst_pipeline_auto_clock(pipeline);
+        g_object_set(pipeline, "audio-filter", nullptr, "video-filter", nullptr, nullptr);
+        return;
+    }
+    GstPointer<GstClock> clock(gst_system_clock_obtain());
+    gst_pipeline_use_clock(pipeline, clock.data());
+    GstPointer<GstElement> audio(timedBranch(m_shutter));
+    GstPointer<GstElement> video(timedBranch(m_shutter));
+    g_object_set(pipeline, "audio-filter", audio.data(), "video-filter", video.data(), nullptr);
+}
+
+bool RearRecording::begin(GstPipeline *pipeline)
+{
+    if (!m_modeFilter)
+        return true;
+    const auto shutter = gst_element_get_current_running_time(GST_ELEMENT(pipeline));
+    GstPointer<GstPad> input(gst_element_get_static_pad(m_modeFilter.data(), "sink"));
+    g_autoptr(GstCaps) caps = gst_pad_get_current_caps(input.data());
+    if (!GST_CLOCK_TIME_IS_VALID(shutter) || !caps || !gst_caps_is_fixed(caps))
+        return false;
+    m_shutter->store(shutter);
+    const GstStructure *s = gst_caps_get_structure(caps, 0);
+    int width, height;
+    if (gst_structure_has_name(s, "video/x-raw") &&
+        g_strcmp0(gst_structure_get_string(s, "format"), "NV12") == 0 &&
+        gst_structure_get_int(s, "width", &width) && width == 4080 &&
+        gst_structure_get_int(s, "height", &height) && height == 3060) {
+        // Keep the exact live format, including memory features, variable
+        // input framerate and colorimetry, through the valve/tee change.
+        g_autoptr(GstCaps) previous = nullptr;
+        g_object_get(m_modeFilter.data(), "caps", &previous, nullptr);
+        if (!previous || !gst_caps_is_equal(previous, caps))
+            g_object_set(m_modeFilter.data(), "caps", caps, nullptr);
+    }
+    return true;
+}
+
+void RearRecording::releaseMode()
+{
+    if (!m_modeFilter)
+        return;
+    g_autoptr(GstCaps) caps = nullptr;
+    g_object_get(m_modeFilter.data(), "caps", &caps, nullptr);
+    if (caps && !gst_caps_is_any(caps))
+        g_object_set(m_modeFilter.data(), "caps", nullptr, nullptr);
+}
