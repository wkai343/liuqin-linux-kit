+static void configureVideoEncoder(GstElement *camerabin)
+{
+    GstPointer<GstElementFactory> encoder(gst_element_factory_find("v4l2h264enc"));
+    if (!encoder)
+        return;
+
+    g_autoptr(GstCaps) containerCaps = gst_caps_new_empty_simple("video/x-matroska");
+    g_autoptr(GstCaps) videoCaps = gst_caps_new_simple("video/x-h264", "profile", G_TYPE_STRING, "high", nullptr);
+    // PipeWire can advertise a variable rate (0/1). Give encodebin a real
+    // timebase so Iris rate control and Matroska frame durations agree.
+    g_autoptr(GstCaps) rawCaps = gst_caps_new_simple("video/x-raw", "framerate", GST_TYPE_FRACTION, 30, 1, nullptr);
+    g_autoptr(GstCaps) audioCaps = gst_caps_new_empty_simple("audio/x-vorbis");
+    auto *container = gst_encoding_container_profile_new("mkv", "H.264 and Vorbis", containerCaps, nullptr);
+    auto *video = gst_encoding_video_profile_new(videoCaps, nullptr, rawCaps, 1);
+    // Select this encoder for recording without changing process-wide codec ranks.
+    gst_encoding_profile_set_preset_name(GST_ENCODING_PROFILE(video), "v4l2h264enc");
+    gst_encoding_container_profile_add_profile(container, GST_ENCODING_PROFILE(video));
+    auto *audio = gst_encoding_audio_profile_new(audioCaps, nullptr, nullptr, 1);
+    gst_encoding_container_profile_add_profile(container, GST_ENCODING_PROFILE(audio));
+    g_object_set(camerabin, "video-profile", container, nullptr);
+    gst_encoding_profile_unref(container);
+}
