diff --git a/src/video/rearflash.cpp b/src/video/rearflash.cpp
new file mode 100644
index 0000000..895b23b
--- /dev/null
+++ b/src/video/rearflash.cpp
@@ -0,0 +1,222 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "rearflash.h"
+
+#include <KIO/CopyJob>
+#include <KLocalizedString>
+#include <QDir>
+#include <QLoggingCategory>
+#include <QSaveFile>
+#include <QTemporaryFile>
+#include <QtConcurrent/qtconcurrentrun.h>
+#include <gst/video/video.h>
+#include <linux/videodev2.h>
+#include <sys/ioctl.h>
+
+#include <chrono>
+#include <condition_variable>
+#include <memory>
+#include <mutex>
+
+Q_LOGGING_CATEGORY(flashLog, "kamoso.rearflash", QtWarningMsg)
+
+namespace {
+// PipeWire timestamps the processed S5KJN1 frame. Allow for sensor integration,
+// rolling readout and the IPE frame delay at 4080 x 3060, 30 fps.
+constexpr GstClockTime firstFrame = 130 * GST_MSECOND;
+constexpr GstClockTime lastFrame = 190 * GST_MSECOND;
+constexpr int pulseUs = 200000;
+using Sample = std::shared_ptr<GstSample>;
+
+struct Window {
+    GstClockTime triggerBefore;
+    GstClockTime triggerAfter;
+    GstClockTime base;
+    std::mutex mutex;
+    std::condition_variable ready;
+    Sample frame;
+    bool selected = false;
+};
+using WindowPtr = std::shared_ptr<Window>;
+
+bool control(int fd, __u32 id, int value)
+{
+    v4l2_control ctrl{};
+    ctrl.id = id;
+    ctrl.value = value;
+    return ioctl(fd, VIDIOC_S_CTRL, &ctrl) == 0;
+}
+
+bool strobing(int fd)
+{
+    v4l2_control ctrl{};
+    ctrl.id = V4L2_CID_FLASH_STROBE_STATUS;
+    return ioctl(fd, VIDIOC_G_CTRL, &ctrl) == 0 && ctrl.value;
+}
+
+QString flashNode()
+{
+    QDir sys(QStringLiteral("/sys/class/video4linux"));
+    for (const auto &node : sys.entryList({QStringLiteral("v4l-subdev*")}, QDir::Dirs)) {
+        QFile name(sys.filePath(node + QStringLiteral("/name")));
+        if (name.open(QIODevice::ReadOnly) && name.readAll().trimmed() == "white:flash")
+            return QStringLiteral("/dev/") + node;
+    }
+    return {};
+}
+
+GstPadProbeReturn selectFrame(GstPad *pad, GstPadProbeInfo *info, gpointer data)
+{
+    auto &window = **static_cast<WindowPtr *>(data);
+    auto *buffer = GST_PAD_PROBE_INFO_BUFFER(info);
+    if (!GST_BUFFER_PTS_IS_VALID(buffer) || GST_BUFFER_FLAG_IS_SET(buffer, GST_BUFFER_FLAG_DISCONT)
+        || GST_BUFFER_FLAG_IS_SET(buffer, GST_BUFFER_FLAG_CORRUPTED))
+        return GST_PAD_PROBE_OK;
+    GstEvent *event = gst_pad_get_sticky_event(pad, GST_EVENT_SEGMENT, 0);
+    if (!event)
+        return GST_PAD_PROBE_OK;
+    const GstSegment *segment;
+    gst_event_parse_segment(event, &segment);
+    GstClockTime running = segment->format == GST_FORMAT_TIME
+        ? gst_segment_to_running_time(segment, GST_FORMAT_TIME, GST_BUFFER_PTS(buffer)) : GST_CLOCK_TIME_NONE;
+    gst_event_unref(event);
+    if (!GST_CLOCK_TIME_IS_VALID(running) || running > G_MAXUINT64 - window.base)
+        return GST_PAD_PROBE_OK;
+    const auto stamp = window.base + running;
+    if (stamp < window.triggerAfter || stamp - window.triggerAfter < firstFrame
+        || stamp - window.triggerBefore > lastFrame)
+        return GST_PAD_PROBE_OK;
+
+    std::lock_guard lock(window.mutex);
+    if (!window.selected) {
+        GstCaps *caps = gst_pad_get_current_caps(pad);
+        GstVideoInfo video;
+        if (caps && gst_video_info_from_caps(&video, caps) && video.width == 4080 && video.height == 3060) {
+            window.frame.reset(gst_sample_new(buffer, caps, nullptr, nullptr), gst_sample_unref);
+            qCDebug(flashLog) << "Selected" << video.width << video.height << "at"
+                              << (stamp - window.triggerAfter) / GST_MSECOND << "ms";
+            window.selected = true;
+            window.ready.notify_one();
+        }
+        gst_clear_caps(&caps);
+    }
+    return GST_PAD_PROBE_OK;
+}
+
+QByteArray encode(const WindowPtr &window)
+{
+    Sample frame;
+    {
+        std::unique_lock lock(window->mutex);
+        if (!window->ready.wait_for(lock, std::chrono::milliseconds(650), [&] { return window->selected; }))
+            return {};
+        frame = std::move(window->frame);
+    }
+    GstCaps *caps = gst_caps_new_empty_simple("image/jpeg");
+    GError *error = nullptr;
+    GstSample *converted = gst_video_convert_sample(frame.get(), caps, 3 * GST_SECOND, &error);
+    gst_caps_unref(caps);
+    if (!converted) {
+        qCWarning(flashLog) << "JPEG conversion failed" << (error ? error->message : "");
+        g_clear_error(&error);
+        return {};
+    }
+    Sample jpeg(converted, gst_sample_unref);
+    GstBuffer *buffer = gst_sample_get_buffer(jpeg.get());
+    GstMapInfo map;
+    if (!gst_buffer_map(buffer, &map, GST_MAP_READ))
+        return {};
+    QByteArray bytes(reinterpret_cast<const char *>(map.data), map.size);
+    gst_buffer_unmap(buffer, &map);
+    return bytes;
+}
+}
+
+RearFlash::~RearFlash()
+{
+    cancel();
+}
+
+void RearFlash::cancel()
+{
+    if (m_probe)
+        gst_pad_remove_probe(m_pad, m_probe);
+    m_probe = 0;
+    gst_clear_object(&m_pad);
+    if (m_led.isOpen()) {
+        control(m_led.handle(), V4L2_CID_FLASH_STROBE_STOP, 0);
+        control(m_led.handle(), V4L2_CID_FLASH_LED_MODE, V4L2_FLASH_LED_MODE_NONE);
+        m_led.close();
+    }
+    if (m_watcher) {
+        disconnect(m_watcher, nullptr, this, nullptr);
+        m_watcher->deleteLater();
+        m_watcher = nullptr;
+        Q_EMIT busyChanged();
+    }
+}
+
+void RearFlash::capture(GstPipeline *pipeline, GstElement *filter, const QUrl &destination)
+{
+    if (busy())
+        return;
+    auto window = std::make_shared<Window>();
+    GstClock *clock = gst_element_get_clock(GST_ELEMENT(pipeline));
+    m_pad = filter ? gst_element_get_static_pad(filter, "src") : nullptr;
+    m_led.setFileName(flashNode());
+    qCDebug(flashLog) << "Shutter" << GST_OBJECT_NAME(pipeline) << "clock" << (clock ? GST_OBJECT_NAME(clock) : "none")
+                      << "filter" << (filter ? GST_OBJECT_NAME(filter) : "none") << "pad" << bool(m_pad) << m_led.fileName();
+    if (clock && m_pad && m_led.open(QIODevice::ReadWrite | QIODevice::Unbuffered)) {
+        int fd = m_led.handle();
+        window->base = gst_element_get_base_time(GST_ELEMENT(pipeline));
+        if (control(fd, V4L2_CID_FLASH_LED_MODE, V4L2_FLASH_LED_MODE_FLASH)
+            && control(fd, V4L2_CID_FLASH_TIMEOUT, pulseUs)
+            && control(fd, V4L2_CID_FLASH_INTENSITY, 250000)) {
+            // Both bounds matter if the shutter thread is preempted during the ioctl.
+            window->triggerBefore = gst_clock_get_time(clock);
+            if (control(fd, V4L2_CID_FLASH_STROBE, 0) && strobing(fd)) {
+                window->triggerAfter = gst_clock_get_time(clock);
+                m_probe = gst_pad_add_probe(m_pad, GST_PAD_PROBE_TYPE_BUFFER, selectFrame,
+                                            new WindowPtr(window), [](gpointer p) { delete static_cast<WindowPtr *>(p); });
+            }
+        }
+    }
+    gst_clear_object(&clock);
+    if (!m_probe) {
+        cancel();
+        qCWarning(flashLog) << "Strobe setup failed" << m_led.errorString();
+        Q_EMIT failed(i18n("Could not fire the rear flash."));
+        return;
+    }
+    m_watcher = new QFutureWatcher<QByteArray>(this);
+    connect(m_watcher, &QFutureWatcher<QByteArray>::finished, this, [this, destination] {
+        QByteArray jpeg = m_watcher->result();
+        cancel();
+        if (jpeg.isEmpty()) {
+            Q_EMIT failed(i18n("No complete flash frame was captured. Try again."));
+            return;
+        }
+        if (destination.isLocalFile()) {
+            QSaveFile file(destination.toLocalFile());
+            if (!file.open(QIODevice::WriteOnly) || file.write(jpeg) != jpeg.size() || !file.commit()) {
+                Q_EMIT failed(file.errorString());
+                return;
+            }
+            Q_EMIT saved(destination.toLocalFile());
+        } else {
+            auto temp = std::make_shared<QTemporaryFile>();
+            if (!temp->open() || temp->write(jpeg) != jpeg.size() || !temp->flush()) {
+                Q_EMIT failed(temp->errorString());
+                return;
+            }
+            auto job = KIO::copy(QUrl::fromLocalFile(temp->fileName()), destination);
+            connect(job, &KJob::result, this, [this, job, destination, temp] {
+                if (job->error())
+                    Q_EMIT failed(job->errorString());
+                else
+                    Q_EMIT saved(destination.toDisplayString());
+            });
+        }
+    });
+    m_watcher->setFuture(QtConcurrent::run(encode, window));
+    Q_EMIT busyChanged();
+}
