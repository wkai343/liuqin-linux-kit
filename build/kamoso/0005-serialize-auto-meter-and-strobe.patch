+namespace {
+QString recoveryPath()
+{
+    return QDir(QStandardPaths::writableLocation(QStandardPaths::RuntimeLocation))
+        .filePath(QStringLiteral("kamoso-rear-flash.recovery"));
+}
+
+// All accesses are serialized by the per-user shutter lock. An interrupted
+// strobe has an unknown completion time, so the next meter waits a full interval.
+bool recordRecovery(qint64 deadline)
+{
+    QSaveFile marker(recoveryPath());
+    const QByteArray value = QByteArray::number(deadline);
+    return marker.open(QIODevice::WriteOnly) && marker.write(value) == value.size() && marker.commit();
+}
+
+int recoveryWait()
+{
+    QFile marker(recoveryPath());
+    if (!marker.exists())
+        return 0;
+    if (!marker.open(QIODevice::ReadOnly))
+        return 1200;
+    bool ok;
+    const qint64 end = marker.read(32).toLongLong(&ok);
+    const qint64 now = QDeadlineTimer::current(Qt::PreciseTimer).deadline();
+    if (!ok || end < 0 || end > now + 1200)
+        return 1200;
+    return int(std::max<qint64>(0, end - now));
+}
+}
