# Fedora desktop security policy.
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
# CONFIG_DEFAULT_SECURITY_APPARMOR is not set
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,ipe,bpf"

# Firmware startup in the PCI probe otherwise holds kernel_init's async
# barrier. The local root and login devices do not depend on Wi-Fi; let
# early root-system module loading handle it, retaining the WLAN readiness/MAC gate.
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
