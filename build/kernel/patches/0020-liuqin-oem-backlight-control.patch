From: Liuqin Linux Kit contributors
Subject: [PATCH] backlight: align Liuqin M81 enable states with its ROM

Use the M81 enable mask 0x7f and blank mask 0x1f, including the original
10 ms post-disable wait. Keep voltage, bias, ramp settings and the current
0..2047 raw brightness range; the OEM remap curve is a separate change.

Propagate bus errors and invalidate cached enable state after partial
updates so opposite-direction retries cannot leave the LEDs stuck off.
Configure hardware before publishing the backlight device, and exclude
the read-to-clear FLAG register from ordinary regmap debug dumps.
Validated with the OEM PHY profile on one Tianma Liuqin; long-term
stability and the CSOT variant still need hardware coverage.

diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts
@@ -696,11 +696,9 @@
 	 * plain compatible would defer forever, and the panel, which waits on
 	 * this device through drm_panel_of_backlight(), would defer with it.
 	 *
-	 * current-num-sinks = 5 follows sm8250-xiaomi-pipa.dts:519 and
-	 * sm8250-xiaomi-elish-common.dtsi:585 rather than yudi: the vendor tree
-	 * specifies no sink count at all, and pipa is the same 11" panel
-	 * generation. Enabling a sink with no string on it is what the driver
-	 * would do by default (all six, ktz8866.c:110-113).
+	 * The shipped M81 Tianma/CSOT path writes BL_EN=0x7f when lit and
+	 * 0x1f when blanked, then waits 10 ms before clearing brightness.
+	 * Use the ROM's six active sinks rather than the earlier Pipa guess.
 	 */
 	backlight: backlight@11 {
 		compatible = "kinetic,ktz8866";
@@ -711,7 +709,9 @@
 
 		enable-gpios = <&tlmm 6 GPIO_ACTIVE_HIGH>;
 
-		current-num-sinks = <5>;
+		current-num-sinks = <6>;
+		kinetic,blanked-current-sink-mask = <0x1f>;
+		kinetic,backlight-disable-delay-ms = <10>;
 		kinetic,backlight-initially-off;
 		kinetic,current-ramp-delay-ms = <128>;
 		kinetic,led-enable-ramp-delay-ms = <1>;
diff --git a/drivers/video/backlight/ktz8866.c b/drivers/video/backlight/ktz8866.c
--- a/drivers/video/backlight/ktz8866.c
+++ b/drivers/video/backlight/ktz8866.c
@@ -6,6 +6,7 @@
  */
 
 #include <linux/backlight.h>
+#include <linux/delay.h>
 #include <linux/err.h>
 #include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
@@ -47,13 +48,24 @@
 	struct i2c_client *client;
 	struct regmap *regmap;
 	bool led_on;
+	bool enable_state_valid;
+	u8 active_sink_mask;
+	u8 blanked_sink_mask;
+	u32 disable_delay_ms;
 	struct gpio_desc *enable_gpio;
 };
+
+/* Reading FLAG clears latched faults; ordinary debug dumps must skip it. */
+static bool ktz8866_precious_reg(struct device *dev, unsigned int reg)
+{
+	return reg == FLAG;
+}
 
 static const struct regmap_config ktz8866_regmap_config = {
 	.reg_bits = 8,
 	.val_bits = 8,
 	.max_register = REG_MAX,
+	.precious_reg = ktz8866_precious_reg,
 };
 
 struct ktz8866 *ktz_b;
@@ -61,43 +73,56 @@
 static int ktz8866_write(struct ktz8866 *ktz, unsigned int reg,
 			 unsigned int val)
 {
-	regmap_write(ktz->regmap, reg, val);
-
+	int ret;
+
+	ret = regmap_write(ktz->regmap, reg, val);
+	if (ret)
+		return ret;
 	if (ktz_b)
-		regmap_write(ktz_b->regmap, reg, val);
-
+		return regmap_write(ktz_b->regmap, reg, val);
 	return 0;
 }
 
-static int ktz8866_update_bits(struct ktz8866 *ktz, unsigned int reg,
-			       unsigned int mask, unsigned int val)
-{
-	regmap_update_bits(ktz->regmap, reg, mask, val);
-
-	if (ktz_b)
-		regmap_update_bits(ktz_b->regmap, reg, mask, val);
-
+static int ktz8866_set_brightness(struct ktz8866 *ktz, unsigned int brightness)
+{
+	bool on = brightness > 0;
+	bool transition = !ktz->enable_state_valid || ktz->led_on != on;
+	int ret;
+
+	if (brightness > MAX_BRIGHTNESS)
+		return -EINVAL;
+	if (transition) {
+		ret = ktz8866_write(ktz, BL_EN, on ?
+			BL_EN_BIT | ktz->active_sink_mask : ktz->blanked_sink_mask);
+		if (ret)
+			goto invalid;
+		if (!on && ktz->disable_delay_ms)
+			usleep_range(ktz->disable_delay_ms * 1000,
+				     ktz->disable_delay_ms * 1000 + 10);
+	}
+	ret = ktz8866_write(ktz, BL_BRT_LSB, brightness & 0x7);
+	if (ret)
+		goto invalid;
+	ret = ktz8866_write(ktz, BL_BRT_MSB, (brightness >> 3) & 0xff);
+	if (ret)
+		goto invalid;
+	ktz->led_on = on;
+	ktz->enable_state_valid = true;
 	return 0;
+
+invalid:
+	/* A failed partial update may have changed BL_EN. Resend the requested
+	 * state on the next update, even if the requested direction reverses.
+	 */
+	ktz->enable_state_valid = false;
+	return ret;
 }
 
 static int ktz8866_backlight_update_status(struct backlight_device *backlight_dev)
 {
 	struct ktz8866 *ktz = bl_get_data(backlight_dev);
-	unsigned int brightness = backlight_get_brightness(backlight_dev);
-
-	if (!ktz->led_on && brightness > 0) {
-		ktz8866_update_bits(ktz, BL_EN, BL_EN_BIT, BL_EN_BIT);
-		ktz->led_on = true;
-	} else if (brightness == 0) {
-		ktz8866_update_bits(ktz, BL_EN, BL_EN_BIT, 0);
-		ktz->led_on = false;
-	}
-
-	/* Set brightness */
-	ktz8866_write(ktz, BL_BRT_LSB, brightness & 0x7);
-	ktz8866_write(ktz, BL_BRT_MSB, (brightness >> 3) & 0xFF);
-
-	return 0;
+
+	return ktz8866_set_brightness(ktz, backlight_get_brightness(backlight_dev));
 }
 
 static const struct backlight_ops ktz8866_backlight_ops = {
@@ -105,35 +130,67 @@
 	.update_status = ktz8866_backlight_update_status,
 };
 
-static void ktz8866_init(struct ktz8866 *ktz)
-{
-	unsigned int val = 0;
-
-	if (!of_property_read_u32(ktz->client->dev.of_node, "current-num-sinks", &val))
-		ktz8866_write(ktz, BL_EN, BIT(val) - 1);
-	else
-		/* Enable all 6 current sinks if the number of current sinks isn't specified. */
-		ktz8866_write(ktz, BL_EN, BIT(6) - 1);
-
-	if (!of_property_read_u32(ktz->client->dev.of_node, "kinetic,current-ramp-delay-ms", &val)) {
+static int ktz8866_init(struct ktz8866 *ktz)
+{
+	struct device_node *node = ktz->client->dev.of_node;
+	unsigned int sinks = 6, mask, val, ramp;
+	int ret;
+
+	of_property_read_u32(node, "current-num-sinks", &sinks);
+	if (!sinks || sinks > 6)
+		return -EINVAL;
+	ktz->active_sink_mask = BIT(sinks) - 1;
+	mask = ktz->active_sink_mask;
+	of_property_read_u32(node, "kinetic,blanked-current-sink-mask", &mask);
+	if (mask & ~ktz->active_sink_mask)
+		return -EINVAL;
+	ktz->blanked_sink_mask = mask;
+	of_property_read_u32(node, "kinetic,backlight-disable-delay-ms",
+			     &ktz->disable_delay_ms);
+	if (ktz->disable_delay_ms > 100)
+		return -EINVAL;
+
+	ret = ktz8866_write(ktz, BL_EN, ktz->blanked_sink_mask);
+	if (ret)
+		return ret;
+	if (!of_property_read_u32(node, "kinetic,current-ramp-delay-ms", &val)) {
+		if (!val || val > 640)
+			return -EINVAL;
 		if (val <= 128)
-			ktz8866_write(ktz, BL_CFG2, BIT(7) | (ilog2(val) << 3) | PWM_HYST);
+			ramp = BIT(7) | (ilog2(val) << 3) | PWM_HYST;
 		else
-			ktz8866_write(ktz, BL_CFG2, BIT(7) | ((5 + val / 64) << 3) | PWM_HYST);
-	}
-
-	if (!of_property_read_u32(ktz->client->dev.of_node, "kinetic,led-enable-ramp-delay-ms", &val)) {
-		if (val == 0)
-			ktz8866_write(ktz, BL_DIMMING, 0);
-		else {
+			ramp = BIT(7) | ((5 + val / 64) << 3) | PWM_HYST;
+		ret = ktz8866_write(ktz, BL_CFG2, ramp);
+		if (ret)
+			return ret;
+	}
+	if (!of_property_read_u32(node, "kinetic,led-enable-ramp-delay-ms", &val)) {
+		if (val > 16384)
+			return -EINVAL;
+		if (!val) {
+			ret = ktz8866_write(ktz, BL_DIMMING, 0);
+		} else {
 			unsigned int ramp_off_time = ilog2(val) + 1;
 			unsigned int ramp_on_time = ramp_off_time << 4;
-			ktz8866_write(ktz, BL_DIMMING, ramp_on_time | ramp_off_time);
+
+			ret = ktz8866_write(ktz, BL_DIMMING,
+					    ramp_on_time | ramp_off_time);
 		}
-	}
-
-	if (of_property_read_bool(ktz->client->dev.of_node, "kinetic,enable-lcd-bias"))
-		ktz8866_write(ktz, LCD_BIAS_CFG1, LCD_BIAS_EN);
+		if (ret)
+			return ret;
+	}
+	if (of_property_read_bool(node, "kinetic,enable-lcd-bias")) {
+		ret = ktz8866_write(ktz, LCD_BIAS_CFG1, LCD_BIAS_EN);
+		if (ret)
+			return ret;
+	}
+	ktz->led_on = false;
+	ktz->enable_state_valid = true;
+	dev_info(&ktz->client->dev,
+		 "LED sinks=%u, on=0x%02x, blank=0x%02x, disable wait=%u ms\n",
+		 sinks, (unsigned int)(BL_EN_BIT | ktz->active_sink_mask),
+		 ktz->blanked_sink_mask, ktz->disable_delay_ms);
+	return 0;
 }
 
 static int ktz8866_probe(struct i2c_client *client)
@@ -141,6 +198,7 @@
 	const struct i2c_device_id *id = i2c_client_get_device_id(client);
 	struct backlight_device *backlight_dev;
 	struct backlight_properties props;
+	unsigned int initial_brightness;
 	struct ktz8866 *ktz;
 	int ret = 0;
 
@@ -182,16 +240,28 @@
 		props.power = BACKLIGHT_POWER_OFF;
 	props.scale = BACKLIGHT_SCALE_LINEAR;
 
+	/* Publish only after configuration and the initial LED state succeeded. */
+	ret = ktz8866_init(ktz);
+	if (ret)
+		return dev_err_probe(&client->dev, ret, "failed to configure backlight\n");
+	initial_brightness = props.brightness;
+	if (props.power == BACKLIGHT_POWER_OFF)
+		initial_brightness = 0;
+	ret = ktz8866_set_brightness(ktz, initial_brightness);
+	if (ret) {
+		ktz8866_set_brightness(ktz, 0);
+		return dev_err_probe(&client->dev, ret, "failed to set initial brightness\n");
+	}
+
 	backlight_dev = devm_backlight_device_register(&client->dev, "ktz8866-backlight",
 					&client->dev, ktz, &ktz8866_backlight_ops, &props);
-	if (IS_ERR(backlight_dev))
+	if (IS_ERR(backlight_dev)) {
+		ktz8866_set_brightness(ktz, 0);
 		return dev_err_probe(&client->dev, PTR_ERR(backlight_dev),
 				"failed to register backlight device\n");
-
-	ktz8866_init(ktz);
+	}
 
 	i2c_set_clientdata(client, backlight_dev);
-	backlight_update_status(backlight_dev);
 
 end:
 	return 0;
