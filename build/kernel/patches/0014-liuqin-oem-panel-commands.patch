From: Liuqin Linux Kit contributors
Subject: [PATCH] drm/panel: nt36532: use selected Liuqin OEM ON/OFF packets

Select Tianma or CSOT from the exact bootloader primary-panel name. Preserve
OS2.0.6.0.VMYCNXM DTBO entry 15 packet types, payloads, ordering and waits.
Send the OEM OFF page selection as well as display-off/sleep-in. The known
OEM path configures DSC in its ON table and sends PPS once, avoiding the
legacy extra compression command and duplicate display-on/PPS sequence.

Downstream batch grouping is intentionally not ported: mainline submits
the packets separately. Unknown or conflicting panel selectors retain the
legacy sequence. Pipa/Yudi, voltages, supply constraints, 120ms margin waits
and backlight ownership are unchanged. Hardware acceptance is separate.

--- a/drivers/gpu/drm/panel/panel-novatek-nt36532.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36532.c
@@ -2,6 +2,8 @@
 // Copyright (c) 2024 Luka Panio <lukapanio@gmail.com>
 
 #include <linux/backlight.h>
+#include <linux/ctype.h>
+#include <linux/string.h>
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
 #include <linux/module.h>
@@ -23,6 +25,7 @@
 	struct drm_panel panel;
 	struct mipi_dsi_device *dsi[2];
 	const struct panel_desc *desc;
+	const struct liuqin_oem_panel *oem_panel;
 	struct drm_dsc_config dsc;
 	struct regulator_bulk_data supplies[3];
 	struct gpio_desc *reset_gpio;
@@ -431,6 +434,573 @@
 	return dsi_ctx.accum_err;
 }
 
+/* OEM payloads from OS2.0.6.0.VMYCNXM, DTBO entry 15.
+ * Preserve DCS long packets (including two-byte writes), order and waits.
+ * Qualcomm's downstream 0x40 batch flag has no mainline transport equivalent:
+ * submit each original packet independently, never reinterpret it as ACK.
+ */
+struct liuqin_oem_cmd {
+	u8 type;
+	u8 wait_ms;
+	u8 len;
+	u8 data[17];
+};
+
+struct liuqin_oem_panel {
+	const char *boot_name;
+	const char *label;
+	const struct liuqin_oem_cmd *on;
+	size_t on_count;
+};
+
