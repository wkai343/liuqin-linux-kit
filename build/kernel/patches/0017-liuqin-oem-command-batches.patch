diff --git a/drivers/gpu/drm/msm/dsi/dsi_cmd_batch.h b/drivers/gpu/drm/msm/dsi/dsi_cmd_batch.h
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/msm/dsi/dsi_cmd_batch.h
@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __DSI_CMD_BATCH_H__
+#define __DSI_CMD_BATCH_H__
+
+/* OEM broadcast DMA flushes after crossing 240 bytes, or at a table boundary.
+ * The complete transaction must fit the controller's 512-byte broadcast limit.
+ * Prevalidate the entire group before any command can reach the peripheral.
+ */
+static int dsi_cmd_batch_validate(const struct mipi_dsi_msg *msgs, size_t count,
+				  size_t capacity)
+{
+	size_t i, used = 0;
+	int payload = 0;
+
+	if (!msgs || !count || count > 256 || !capacity)
+		return -EINVAL;
+	for (i = 0; i < count; i++) {
+		const struct mipi_dsi_msg *msg = &msgs[i];
+		size_t bytes;
+
+		if (msg->type != MIPI_DSI_DCS_LONG_WRITE || !msg->tx_buf ||
+		    !msg->tx_len || msg->tx_len > 0xffff || msg->rx_buf ||
+		    msg->rx_len || msg->channel > 3 ||
+		    msg->flags & ~MIPI_DSI_MSG_USE_LPM ||
+		    msg->channel != msgs[0].channel || msg->flags != msgs[0].flags)
+			return -EINVAL;
+		bytes = ALIGN(msg->tx_len + 4, 4);
+		if (bytes > capacity || bytes > 512 ||
+		    used + bytes > capacity || used + bytes > 512)
+			return -EMSGSIZE;
+		used += bytes;
+		payload += msg->tx_len;
+		if (used > 240 || i + 1 == count)
+			used = 0;
+	}
+	return payload;
+}
+
+/* Only called after validation, with the same immutable message array. */
+static int dsi_cmd_batch_pack(const struct mipi_dsi_msg *msgs, size_t count,
+			      size_t start, u8 *data, size_t *next)
+{
+	size_t i, used = 0;
+
+	for (i = start; i < count; i++) {
+		const struct mipi_dsi_msg *msg = &msgs[i];
+		size_t bytes = ALIGN(msg->tx_len + 4, 4);
+		bool last = used + bytes > 240 || i + 1 == count;
+		u8 *packet = data + used;
+
+		packet[0] = msg->tx_len & 0xff;
+		packet[1] = msg->tx_len >> 8;
+		packet[2] = msg->type | (msg->channel << 6);
+		packet[3] = BIT(6) | (last ? BIT(7) : 0);
+		memcpy(packet + 4, msg->tx_buf, msg->tx_len);
+		memset(packet + 4 + msg->tx_len, 0xff, bytes - 4 - msg->tx_len);
+		used += bytes;
+		if (last)
+			break;
+	}
+	*next = i + 1;
+	return used;
+}
+#endif
diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -24,6 +24,7 @@
 #include <drm/drm_of.h>
 
 #include "dsi.h"
+#include "dsi_cmd_batch.h"
 #include "dsi.xml.h"
 #include "sfpb.xml.h"
 #include "dsi_cfg.h"
@@ -1744,10 +1745,28 @@
 	return ret;
 }
 
+static ssize_t dsi_host_transfer_batch(struct mipi_dsi_host *host,
+				       const struct mipi_dsi_msg *msgs, size_t count)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+	int ret;
+
+	if (!msm_host->power_on)
+		return -EINVAL;
+	ret = dsi_cmd_batch_validate(msgs, count, msm_host->tx_size);
+	if (ret < 0)
+		return ret;
+	mutex_lock(&msm_host->cmd_mutex);
+	ret = msm_dsi_manager_cmd_xfer_batch(msm_host->id, msgs, count);
+	mutex_unlock(&msm_host->cmd_mutex);
+	return ret;
+}
+
 static const struct mipi_dsi_host_ops dsi_host_ops = {
 	.attach = dsi_host_attach,
 	.detach = dsi_host_detach,
 	.transfer = dsi_host_transfer,
+	.transfer_batch = dsi_host_transfer_batch,
 };
 
 /*
@@ -2177,6 +2196,39 @@
 	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
 
 	return dsi_cmds2buf_tx(msm_host, msg);
+}
+
+int msm_dsi_host_cmd_tx_batch(struct mipi_dsi_host *host,
+			      const struct mipi_dsi_msg *msgs, size_t count)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+	const struct msm_dsi_cfg_handler *cfg_hnd = msm_host->cfg_hnd;
+	size_t start = 0, next;
+	int payload, len, ret;
+	u8 *data;
+
+	payload = dsi_cmd_batch_validate(msgs, count, msm_host->tx_size);
+	if (payload < 0)
+		return payload;
+	while (start < count) {
+		data = cfg_hnd->ops->tx_buf_get(msm_host);
+		if (IS_ERR(data))
+			return PTR_ERR(data);
+		len = dsi_cmd_batch_pack(msgs, count, start, data, &next);
+		if (cfg_hnd->ops->tx_buf_put)
+			cfg_hnd->ops->tx_buf_put(msm_host);
+		if ((msm_host->mode_flags & MIPI_DSI_MODE_VIDEO) &&
+		    len > msm_host->mode->hdisplay *
+			mipi_dsi_pixel_format_to_bpp(msm_host->format) / 8)
+			return -EMSGSIZE;
+		ret = dsi_cmd_dma_tx(msm_host, len);
+		if (ret < 0)
+			return ret;
+		if (ret != len)
+			return -EIO;
+		start = next;
+	}
+	return payload;
 }
 
 int msm_dsi_host_cmd_rx(struct mipi_dsi_host *host,
