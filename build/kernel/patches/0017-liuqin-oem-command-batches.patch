--- a/drivers/gpu/drm/msm/dsi/dsi_manager.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_manager.c
@@ -29,6 +29,8 @@
 };
 
 static struct msm_dsi_manager msm_dsim_glb;
+/* Serialize both hosts, so a read cannot disturb a bonded write group. */
+static DEFINE_MUTEX(dsi_cmd_lock);
 
 #define IS_BONDED_DSI()		(msm_dsim_glb.is_bonded_dsi)
 #define IS_SYNC_NEEDED()	(msm_dsim_glb.is_sync_needed)
@@ -492,7 +494,8 @@
 	return 0;
 }
 
-int msm_dsi_manager_cmd_xfer(int id, const struct mipi_dsi_msg *msg)
+static int dsi_mgr_cmd_xfer(int id, const struct mipi_dsi_msg *msg,
+			    const struct mipi_dsi_msg *batch, size_t count)
 {
 	struct msm_dsi *msm_dsi = dsi_mgr_get_dsi(id);
 	struct msm_dsi *msm_dsi0 = dsi_mgr_get_dsi(DSI_0);
@@ -509,8 +512,16 @@
 	 * when DSI_1 calls the cmd transfer function, no matter it happens
 	 * before or after DSI_0 cmd transfer.
 	 */
-	if (need_sync && (id == DSI_0))
-		return is_read ? msg->rx_len : msg->tx_len;
+	if (need_sync && id == DSI_0) {
+		size_t i;
+
+		if (!batch)
+			return msg->tx_len;
+		ret = 0;
+		for (i = 0; i < count; i++)
+			ret += batch[i].tx_len;
+		return ret;
+	}
 
 	if (need_sync && msm_dsi0) {
 		ret = msm_dsi_host_xfer_prepare(msm_dsi0->host, msg);
@@ -526,8 +537,11 @@
 		goto restore_host0;
 	}
 
-	ret = is_read ? msm_dsi_host_cmd_rx(host, msg) :
-			msm_dsi_host_cmd_tx(host, msg);
+	if (batch)
+		ret = msm_dsi_host_cmd_tx_batch(host, batch, count);
+	else
+		ret = is_read ? msm_dsi_host_cmd_rx(host, msg) :
+				msm_dsi_host_cmd_tx(host, msg);
 
 	msm_dsi_host_xfer_restore(host, msg);
 
@@ -535,6 +549,29 @@
 	if (need_sync && msm_dsi0)
 		msm_dsi_host_xfer_restore(msm_dsi0->host, msg);
 
+	return ret;
+}
+
+int msm_dsi_manager_cmd_xfer(int id, const struct mipi_dsi_msg *msg)
+{
+	int ret;
+
+	mutex_lock(&dsi_cmd_lock);
+	ret = dsi_mgr_cmd_xfer(id, msg, NULL, 0);
+	mutex_unlock(&dsi_cmd_lock);
+	return ret;
+}
+
+int msm_dsi_manager_cmd_xfer_batch(int id, const struct mipi_dsi_msg *msgs,
+				   size_t count)
+{
+	int ret;
+
+	if (!msgs || !count)
+		return -EINVAL;
+	mutex_lock(&dsi_cmd_lock);
+	ret = dsi_mgr_cmd_xfer(id, msgs, msgs, count);
+	mutex_unlock(&dsi_cmd_lock);
 	return ret;
 }
 
