 /* OEM payloads from OS2.0.6.0.VMYCNXM, DTBO entry 15.
  * Preserve DCS long packets (including two-byte writes), order and waits.
- * Qualcomm's downstream 0x40 batch flag has no mainline transport equivalent:
- * submit each original packet independently, never reinterpret it as ACK.
+ * Preserve downstream 0x40 continuation flags through an ordered host group.
+ * They never become MIPI_DSI_MSG_REQ_ACK; the host marks the last DMA packet.
  */
 struct liuqin_oem_cmd {
 	u8 type;
+	u8 flags;
 	u8 wait_ms;
 	u8 len;
 	u8 data[17];
