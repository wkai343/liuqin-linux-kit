+/* The MCU reports real connector state independently of the cover magnets.
+ * NanoSic v2 source 0x38 -> host 0x80, A2 payload byte 4: bit 0 Connected.
+ * Validate the complete report boundary before reading this byte.
+ */
+static bool nanosic_parse_connection_status(struct nanosic *nano, const u8 *p,
+					   size_t len)
+{
+	bool changed;
+
+	if (len < 10 || (p[0] != 0x22 && p[0] != 0x23 &&
+			 p[0] != 0x24 && p[0] != 0x26) ||
+	    p[2] != 0x38 || p[3] != 0x80 || p[4] != 0xa2)
+		return false;
+
+	changed = !nano->connection_known || nano->keyboard_connected != !!(p[9] & BIT(0));
+	nano->keyboard_status = p[9];
+	nano->keyboard_connected = !!(p[9] & BIT(0));
+	nano->connection_known = true;
+	nano->connection_reports++;
+	input_report_switch(nano->tablet_mode_input, SW_TABLET_MODE,
+			    !nano->keyboard_connected);
+	input_sync(nano->tablet_mode_input);
+	if (changed)
+		kobject_uevent(&nano->client->dev.kobj, KOBJ_CHANGE);
+	return true;
+}
