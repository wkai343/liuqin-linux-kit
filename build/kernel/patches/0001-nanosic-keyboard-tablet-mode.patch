+/* Only bounded startup/resume queries. Normal connection changes arrive
+ * through the existing data IRQ; no periodic polling keeps the MCU awake.
+ */
+static void nanosic_status_work(struct work_struct *work)
+{
+	struct nanosic *nano = container_of(to_delayed_work(work),
+					  struct nanosic, status_work);
+	bool was_awake;
+	int ret;
+	struct i2c_msg msg = {
+		.addr = nano->client->addr,
+		.len = sizeof(nanosic_status_command),
+		.buf = (u8 *)nanosic_status_command,
+	};
+
+	guard(mutex)(&nano->lock);
+	if (nano->suspended || (nano->status_attempts &&
+			      nano->connection_reports != nano->status_query_report))
+		return;
+	if (!nano->status_attempts)
+		nano->status_query_report = nano->connection_reports;
+	was_awake = nano->awake;
+	nanosic_wake(nano);
+	if (!was_awake)
+		usleep_range(NANOSIC_I2C_RETRY_US, NANOSIC_I2C_RETRY_US + 500);
+	nano->status_attempts++;
+	ret = nanosic_i2c_transfer(nano, &msg, 1, NANOSIC_I2C_STATUS_WRITE);
+	if (!ret) {
+		usleep_range(10000, 10500);
+		ret = nanosic_read_frame(nano, NANOSIC_I2C_DATA_READ);
+		if (!ret)
+			nanosic_parse_frame(nano, nano->rxbuf, sizeof(nano->rxbuf));
+	}
+	if (nano->connection_reports == nano->status_query_report && nano->status_attempts < 3)
+		mod_delayed_work(system_wq, &nano->status_work, msecs_to_jiffies(200));
+}
