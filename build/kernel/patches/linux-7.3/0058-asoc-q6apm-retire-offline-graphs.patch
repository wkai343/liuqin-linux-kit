From af05dc69c5c440b90b2bb1290862cff203d634fc Mon Sep 17 00:00:00 2001
From: wk <58632380+wkai343@users.noreply.github.com>
Date: Fri, 13 Nov 2026 15:20:43 +0800
Subject: [PATCH] ASoC: qcom: retire Liuqin graph teardown after ADSP loss

Complete STOP and CLOSE locally when the owning GPR service is offline, including a reset while waiting for the command. Keep normal error handling for online failures and for commands that create or start resources. Host graph references and port cleanup still run.
---
 sound/soc/qcom/qdsp6/q6apm.c | 24 +++++++++++++++++++++---
 1 file changed, 21 insertions(+), 3 deletions(-)

diff --git a/sound/soc/qcom/qdsp6/q6apm.c b/sound/soc/qcom/qdsp6/q6apm.c
index 42b328c2f..fea32eda7 100644
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -104,6 +104,14 @@ static struct audioreach_graph *q6apm_get_audioreach_graph(struct q6apm *apm, ui
 	return graph;
 }
 
+static bool audioreach_graph_teardown_offline(struct audioreach_graph *graph,
+					     uint32_t opcode)
+{
+	return liuqin_board_quirks() &&
+		(opcode == APM_CMD_GRAPH_STOP || opcode == APM_CMD_GRAPH_CLOSE) &&
+		!gpr_service_up(&graph->apm->gdev->svc);
+}
+
 static int audioreach_graph_mgmt_cmd(struct audioreach_graph *graph, uint32_t opcode)
 {
 	struct audioreach_graph_info *info = graph->info;
@@ -112,9 +120,14 @@ static int audioreach_graph_mgmt_cmd(struct audioreach_graph *graph, uint32_t op
 	struct apm_graph_mgmt_cmd *mgmt_cmd;
 	struct audioreach_sub_graph *sg;
 	struct q6apm *apm = graph->apm;
-	int i = 0, payload_size = APM_GRAPH_MGMT_PSIZE(mgmt_cmd, num_sub_graphs);
+	int i = 0, ret, payload_size = APM_GRAPH_MGMT_PSIZE(mgmt_cmd, num_sub_graphs);
+	struct gpr_pkt *pkt __free(kfree) = NULL;
+
+	/* DSP graphs no longer exist after PD loss; retire the host references. */
+	if (audioreach_graph_teardown_offline(graph, opcode))
+		return 0;
 
-	struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_cmd_pkt(payload_size, opcode, 0);
+	pkt = audioreach_alloc_apm_cmd_pkt(payload_size, opcode, 0);
 	if (IS_ERR(pkt))
 		return PTR_ERR(pkt);
 
@@ -130,7 +143,12 @@ static int audioreach_graph_mgmt_cmd(struct audioreach_graph *graph, uint32_t op
 	list_for_each_entry(sg, &info->sg_list, node)
 		mgmt_cmd->sub_graph_id_list[i++] = sg->sub_graph_id;
 
-	return q6apm_send_cmd_sync(apm, pkt, 0);
+	ret = q6apm_send_cmd_sync(apm, pkt, 0);
+	/* Also complete teardown if the service vanished while waiting. */
+	if (ret == -ENETRESET && audioreach_graph_teardown_offline(graph, opcode))
+		return 0;
+
+	return ret;
 }
 
 static void q6apm_put_audioreach_graph(struct kref *ref)
-- 
