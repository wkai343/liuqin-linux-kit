 	struct clk *mclk;
@@ -1609,6 +1613,81 @@ static int s5kjn1_power_off(struct device *dev)
 	return 0;
 }
 
+/* Stock Qtech map reads 0x0000..0x47ff at 7-bit address 0x51.
+ * Hold sensor power and its state lock; never access during capture. */
+static int s5kjn1_eeprom_read(void *priv, unsigned int offset, void *val,
+			      size_t bytes)
+{
+	struct s5kjn1 *sensor = priv;
+	u8 address[2];
+	u8 *data = val;
+	struct i2c_msg msgs[2] = {
+		{ .addr = 0x51, .len = 2, .buf = address },
+		{ .addr = 0x51, .flags = I2C_M_RD },
+	};
+	int ret;
+
+	if (offset > 18432 || bytes > 18432 - offset)
+		return -EINVAL;
+	mutex_lock(sensor->ctrl_handler.lock);
+	if (v4l2_subdev_is_streaming(&sensor->sd)) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+	ret = pm_runtime_resume_and_get(sensor->dev);
+	if (ret < 0)
+		goto unlock;
+	while (bytes) {
+		unsigned int count = min_t(size_t, bytes, 12);
+
+		address[0] = offset >> 8;
+		address[1] = offset;
+		msgs[1].len = count;
+		msgs[1].buf = data;
+		ret = i2c_transfer(sensor->eeprom->adapter, msgs, 2);
+		if (ret != 2) {
+			ret = ret < 0 ? ret : -EIO;
+			goto put_pm;
+		}
+		offset += count;
+		data += count;
+		bytes -= count;
+	}
+	ret = 0;
+put_pm:
+	pm_runtime_mark_last_busy(sensor->dev);
+	pm_runtime_put_autosuspend(sensor->dev);
+unlock:
+	mutex_unlock(sensor->ctrl_handler.lock);
+	return ret;
+}
+
+static int s5kjn1_register_eeprom(struct s5kjn1 *sensor, struct i2c_client *client)
+{
+	struct nvmem_config config = {
+		.dev = sensor->dev,
+		.name = "s5kjn1-qtech-eeprom",
+		.id = NVMEM_DEVID_AUTO,
+		.type = NVMEM_TYPE_EEPROM,
+		.owner = THIS_MODULE,
+		.read_only = true,
+		.root_only = true,
+		.size = 18432,
+		.word_size = 1,
+		.stride = 1,
+		.reg_read = s5kjn1_eeprom_read,
+		.priv = sensor,
+	};
+
+	if (!liuqin_board_quirks())
+		return 0;
+	sensor->eeprom = devm_i2c_new_dummy_device(sensor->dev, client->adapter, 0x51);
+	if (IS_ERR(sensor->eeprom))
+		return PTR_ERR(sensor->eeprom);
+	sensor->nvmem = nvmem_register(&config);
+	return PTR_ERR_OR_ZERO(sensor->nvmem);
+}
+
 static int s5kjn1_probe(struct i2c_client *client)
 {
 	struct s5kjn1 *s5kjn1;
@@ -1746,10 +1825,16 @@ static int s5kjn1_probe(struct i2c_client *client)
 	pm_runtime_set_active(s5kjn1->dev);
 	pm_runtime_enable(s5kjn1->dev);
 
+	ret = s5kjn1_register_eeprom(s5kjn1, client);
+	if (ret)
+		goto subdev_cleanup;
+
 	ret = v4l2_async_register_subdev_sensor(&s5kjn1->sd);
 	if (ret < 0) {
 		dev_err_probe(s5kjn1->dev, ret,
 			      "failed to register V4L2 subdev\n");
+		if (s5kjn1->nvmem)
+			nvmem_unregister(s5kjn1->nvmem);
 		goto subdev_cleanup;
 	}
 
@@ -1781,6 +1866,8 @@ static void s5kjn1_remove(struct i2c_client *client)
 	struct v4l2_subdev *sd = i2c_get_clientdata(client);
 	struct s5kjn1 *s5kjn1 = to_s5kjn1(sd);
 
+	if (s5kjn1->nvmem)
+		nvmem_unregister(s5kjn1->nvmem);
 	v4l2_async_unregister_subdev(sd);
 	v4l2_subdev_cleanup(sd);
 	media_entity_cleanup(&sd->entity);
