+/* Keep consumer handles and rates while the firmware transport is replaced. */
+int q6dsp_clock_recover(struct device *dev, bool online)
+{
+	struct q6dsp_cc *cc = dev_get_drvdata(dev);
+	struct q6dsp_clk *clk;
+	bool replayed[Q6DSP_MAX_CLK_ID] = {};
+	int pass, i, ret;
+
+	if (!cc || !READ_ONCE(cc->registered))
+		return -EPROBE_DEFER;
+
+	guard(mutex)(&cc->lock);
+	cc->offline = true;
+	if (!online)
+		return 0;
+
+	/* Resource votes must precede the clocks that use those resources. */
+	for (pass = 0; pass < 2; pass++) {
+		for (i = 0; i < ARRAY_SIZE(cc->clks); i++) {
+			clk = cc->clks[i];
+			if (!clk || !clk->requested || clk->vote != (pass == 0))
+				continue;
+			if (clk->vote)
+				ret = cc->desc->lpass_vote_clk(dev, clk->q6dsp_clk_id,
+						clk_hw_get_name(&clk->hw), &clk->handle);
+			else
+				ret = cc->desc->lpass_set_clk(dev, clk->q6dsp_clk_id,
+						clk->attributes,
+						Q6DSP_LPASS_CLK_ROOT_DEFAULT, clk->rate);
+			if (ret)
+				goto rollback;
+			replayed[i] = true;
+		}
+	}
+	cc->offline = false;
+	return 0;
+
+rollback:
+	for (pass = 1; pass >= 0; pass--) {
+		for (i = ARRAY_SIZE(cc->clks) - 1; i >= 0; i--) {
+			clk = cc->clks[i];
+			if (!replayed[i] || clk->vote != (pass == 0))
+				continue;
+			if (clk->vote)
+				cc->desc->lpass_unvote_clk(dev, clk->q6dsp_clk_id,
+							 clk->handle);
+			else
+				cc->desc->lpass_set_clk(dev, clk->q6dsp_clk_id,
+						clk->attributes,
+						Q6DSP_LPASS_CLK_ROOT_DEFAULT, 0);
+		}
+	}
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6dsp_clock_recover);
