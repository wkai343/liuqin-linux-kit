+static int audioreach_wait_cmd(struct pkt_router_svc *svc,
+			      struct gpr_ibasic_rsp_result_t *result,
+			      wait_queue_head_t *wait, u32 opcode, u32 rsp_opcode)
+{
+	unsigned long deadline = jiffies + 5 * HZ;
+	int ret;
+
+	if (!liuqin_board_quirks())
+		return wait_event_timeout(*wait, result->opcode == opcode ||
+				(rsp_opcode && result->opcode == rsp_opcode), 5 * HZ);
+
+	/* PD down has no DSP reply. Bound cancellation independently of RX. */
+	do {
+		if (!gpr_service_up(svc))
