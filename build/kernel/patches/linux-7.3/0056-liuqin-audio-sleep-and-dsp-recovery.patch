diff --git a/include/linux/platform_data/liuqin-audio.h b/include/linux/platform_data/liuqin-audio.h
new file mode 100644
index 0000000000000000000000000000000000000000..4c0dc70dabee65ab659717b7f246a382964232c9
--- /dev/null
+++ b/include/linux/platform_data/liuqin-audio.h
@@ -0,0 +1,79 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_PLATFORM_DATA_LIUQIN_AUDIO_H
+#define _LINUX_PLATFORM_DATA_LIUQIN_AUDIO_H
+
+#include <linux/pm_runtime.h>
+#include <linux/pm_clock.h>
+#include <linux/regmap.h>
+#include <linux/platform_data/liuqin.h>
+
+/* Supplier order: suspend consumers first, resume providers first. */
+enum liuqin_audio_pm_order {
+	LIUQIN_AUDIO_PINCTRL,
+	LIUQIN_AUDIO_VA,
+	LIUQIN_AUDIO_MACRO,
+	LIUQIN_AUDIO_SWR,
+	LIUQIN_AUDIO_SWR_MASTER,
+	LIUQIN_AUDIO_SWR_SLAVE,
+	LIUQIN_AUDIO_CODEC,
+};
+
+#if IS_REACHABLE(CONFIG_QCOM_Q6V5_PAS)
+bool liuqin_audio_transport_ready(void);
+unsigned int liuqin_audio_generation(void);
+void liuqin_audio_set_ready(bool ready);
+int devm_liuqin_audio_pm_register(struct device *dev, enum liuqin_audio_pm_order order);
+void liuqin_audio_suspend_devices(void);
+int liuqin_audio_resume_devices(void);
+#else
+static inline bool liuqin_audio_transport_ready(void) { return true; }
+static inline unsigned int liuqin_audio_generation(void) { return 0; }
+static inline void liuqin_audio_set_ready(bool ready) { }
+static inline int devm_liuqin_audio_pm_register(struct device *dev,
+					      enum liuqin_audio_pm_order order) { return 0; }
+static inline void liuqin_audio_suspend_devices(void) { }
+static inline int liuqin_audio_resume_devices(void) { return 0; }
+#endif
+
+static inline int liuqin_audio_clk_resume(struct device *dev)
+{
+	/* pm_clk_resume() itself ignores failures returned by clock prepare. */
+	return liuqin_audio_transport_ready() ? pm_clk_resume(dev) : -EBUSY;
+}
+
+static inline int liuqin_audio_swr_clock_enable(struct regmap *map, unsigned int reg,
+		unsigned int clock_mask, unsigned int reset_mask, unsigned int *generation)
+{
+	unsigned int generation_now = liuqin_audio_generation();
+	bool reset = liuqin_board_quirks() && *generation != generation_now;
+	int ret, reset_ret = 0;
+
+	/* OEM macro SSR resets the SoundWire clock domain on its first vote. */
+	if (reset) {
+		ret = regmap_update_bits(map, reg, reset_mask, reset_mask);
+		if (ret)
+			return ret;
+	}
+	ret = regmap_update_bits(map, reg, clock_mask, clock_mask);
+	if (reset)
+		reset_ret = regmap_update_bits(map, reg, reset_mask, 0);
+	if (ret || reset_ret) {
+		regmap_update_bits(map, reg, clock_mask, 0);
+		return ret ?: reset_ret;
+	}
+	*generation = generation_now;
+	return 0;
+}
+
+/* The desktop streams are stopped by the card before its suppliers suspend. */
+static inline int liuqin_audio_system_suspend(struct device *dev)
+{
+	return liuqin_board_quirks() ? pm_runtime_force_suspend(dev) : 0;
+}
+
+static inline int liuqin_audio_system_resume(struct device *dev)
+{
+	return liuqin_board_quirks() ? pm_runtime_force_resume(dev) : 0;
+}
+
+#endif
