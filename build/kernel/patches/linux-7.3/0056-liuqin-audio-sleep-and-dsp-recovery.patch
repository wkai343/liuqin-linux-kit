+static int liuqin_audio_suspend_ports(struct snd_soc_card *card)
+{
+	struct sc8280xp_snd_data *data = snd_soc_card_get_drvdata(card);
+	struct snd_soc_pcm_runtime *rtd;
+	int direction, ret;
+
+	/* The OEM master refuses clock stop while any port is enabled. */
+	for_each_card_rtds(card, rtd) {
+		unsigned int id = snd_soc_rtd_to_cpu(rtd, 0)->id;
+
+		if (!rtd->dai_link->no_pcm || !data->stream_prepared[id])
+			continue;
+		for_each_pcm_streams(direction) {
+			struct snd_pcm_substream *s;
+			struct sdw_stream_runtime *stream;
+
+			s = snd_soc_dpcm_get_substream(rtd, direction);
+			if (!s || !s->runtime)
+				continue;
+			stream = qcom_snd_sdw_get_stream(s);
+			if (IS_ERR_OR_NULL(stream))
+				continue;
+			/* Remember partial failures too, so resume can roll back. */
+			data->suspended_stream[id] = stream;
+			ret = sdw_disable_stream(stream);
+			if (ret)
+				return ret;
+		}
+	}
+	return 0;
+}
+
+static int liuqin_audio_suspend_pre(struct snd_soc_card *card)
+{
+	struct sc8280xp_snd_data *data = snd_soc_card_get_drvdata(card);
+
+	data->suspend_error = q6apm_suspend_audio();
+	/* Disable data ports before DAPM powers down their clock sources. */
+	if (!data->suspend_error)
+		data->suspend_error = liuqin_audio_suspend_ports(card);
+	return data->suspend_error;
+}
+
+static int liuqin_audio_resume_pre(struct snd_soc_card *card)
+{
+	struct sc8280xp_snd_data *data = snd_soc_card_get_drvdata(card);
+	int id, ret, error = 0;
+
+	/* Enable ports before DAPM powers up and unmutes the codecs. */
+	for (id = 0; id < AFE_PORT_MAX; id++) {
+		if (!data->suspended_stream[id])
+			continue;
+		ret = sdw_enable_stream(data->suspended_stream[id]);
+		if (ret) {
+			dev_err(card->dev, "SoundWire port %d resume failed: %d\n", id, ret);
+			error = ret;
+		} else {
+			data->suspended_stream[id] = NULL;
+		}
+	}
+	return error;
+}
+
+static int sc8280xp_system_suspend(struct device *dev)
+{
+	struct snd_soc_card *card = dev_get_drvdata(dev);
+	struct sc8280xp_snd_data *data = snd_soc_card_get_drvdata(card);
+	int ret;
+
+	if (!liuqin_board_quirks())
+		return 0;
+
+	data->suspend_error = 0;
+	ret = snd_soc_suspend(dev);
+	if (!ret)
+		ret = data->suspend_error;
+	if (ret)
+		snd_soc_resume(dev);
+	return ret;
+}
+
+static int sc8280xp_system_resume(struct device *dev)
+{
+	return liuqin_board_quirks() ? snd_soc_resume(dev) : 0;
+}
+
+static const struct dev_pm_ops sc8280xp_pm_ops = {
+	SYSTEM_SLEEP_PM_OPS(sc8280xp_system_suspend, sc8280xp_system_resume)
+};
