+				(rsp_opcode && result->opcode == rsp_opcode),
+				msecs_to_jiffies(100));
+		if (ret)
+			return gpr_service_up(svc) ? ret : -ENETRESET;
+	} while (time_before(jiffies, deadline));
+	return 0;
+}
