+/*
+ * SoundWire is built in, while PRM is modular. PAS owns both the retained
+ * clock device and this state, so consumers never depend on an absent module.
+ * Before the first PRM probe, missing clock providers defer the consumers.
+ */
+static DEFINE_SPINLOCK(liuqin_audio_state_lock);
+static bool liuqin_audio_online = true;
+static unsigned int liuqin_audio_epoch;
+static void liuqin_audio_cache_devices(void);
+
+bool liuqin_audio_transport_ready(void)
+{
+	return !liuqin_board_quirks() || smp_load_acquire(&liuqin_audio_online);
+}
+EXPORT_SYMBOL_GPL(liuqin_audio_transport_ready);
+
+unsigned int liuqin_audio_generation(void)
+{
+	return liuqin_board_quirks() ? READ_ONCE(liuqin_audio_epoch) : 0;
+}
+EXPORT_SYMBOL_GPL(liuqin_audio_generation);
+
+void liuqin_audio_set_ready(bool ready)
+{
+	unsigned long flags;
+
+	if (!liuqin_board_quirks())
+		return;
+	spin_lock_irqsave(&liuqin_audio_state_lock, flags);
+	if (ready && !liuqin_audio_online)
+		WRITE_ONCE(liuqin_audio_epoch, liuqin_audio_epoch + 1);
+	smp_store_release(&liuqin_audio_online, ready);
+	spin_unlock_irqrestore(&liuqin_audio_state_lock, flags);
+	if (!ready)
+		liuqin_audio_cache_devices();
+}
+EXPORT_SYMBOL_GPL(liuqin_audio_set_ready);
+
+struct liuqin_audio_pm_device {
+	struct list_head node;
+	struct device *dev;
+	enum liuqin_audio_pm_order order;
+	bool quiesced;
+};
+
+static DEFINE_MUTEX(liuqin_audio_pm_lock);
+static LIST_HEAD(liuqin_audio_pm_devices);
+
+static void liuqin_audio_cache_devices(void)
+{
+	struct liuqin_audio_pm_device *entry;
+	struct regmap *map;
+
+	guard(mutex)(&liuqin_audio_pm_lock);
+	/* A crash may already have removed clocks before card teardown runs. */
+	list_for_each_entry(entry, &liuqin_audio_pm_devices, node) {
+		map = dev_get_regmap(entry->dev, NULL);
+		if (map) {
+			regcache_cache_only(map, true);
+			regcache_mark_dirty(map);
+		}
+	}
+}
+
+static void liuqin_audio_pm_unregister(void *data)
+{
+	struct liuqin_audio_pm_device *entry = data;
+
+	guard(mutex)(&liuqin_audio_pm_lock);
+	list_del(&entry->node);
+	/* Balance the PM disable before the driver's remaining devres cleanup. */
+	if (entry->quiesced)
+		pm_runtime_force_resume(entry->dev);
+}
+
+int devm_liuqin_audio_pm_register(struct device *dev, enum liuqin_audio_pm_order order)
+{
+	struct liuqin_audio_pm_device *entry, *pos;
+	struct list_head *before = &liuqin_audio_pm_devices;
+
+	if (!liuqin_board_quirks())
+		return 0;
+	entry = devm_kzalloc(dev, sizeof(*entry), GFP_KERNEL);
+	if (!entry)
+		return -ENOMEM;
+	entry->dev = dev;
+	entry->order = order;
+	mutex_lock(&liuqin_audio_pm_lock);
+	list_for_each_entry(pos, &liuqin_audio_pm_devices, node) {
+		if (pos->order > order) {
+			before = &pos->node;
+			break;
+		}
+	}
+	list_add_tail(&entry->node, before);
+	mutex_unlock(&liuqin_audio_pm_lock);
+	return devm_add_action_or_reset(dev, liuqin_audio_pm_unregister, entry);
+}
+EXPORT_SYMBOL_GPL(devm_liuqin_audio_pm_register);
+
+void liuqin_audio_suspend_devices(void)
+{
+	struct liuqin_audio_pm_device *entry;
+	int ret;
+
+	if (!liuqin_board_quirks())
+		return;
+	guard(mutex)(&liuqin_audio_pm_lock);
+	/* Called after the old card is gone and firmware commands are disabled. */
+	list_for_each_entry_reverse(entry, &liuqin_audio_pm_devices, node) {
+		if (entry->quiesced || !pm_runtime_enabled(entry->dev))
+			continue;
+		ret = pm_runtime_force_suspend(entry->dev);
+		if (ret)
+			dev_err(entry->dev, "audio restart suspend failed: %d\n", ret);
+		else
+			entry->quiesced = true;
+	}
+}
+EXPORT_SYMBOL_GPL(liuqin_audio_suspend_devices);
+
+int liuqin_audio_resume_devices(void)
+{
+	struct liuqin_audio_pm_device *entry;
+	int ret, error = 0;
+
+	if (!liuqin_board_quirks())
+		return 0;
+	guard(mutex)(&liuqin_audio_pm_lock);
+	/* PRM is ready; drop every matching PM disable even if one resume fails. */
+	list_for_each_entry(entry, &liuqin_audio_pm_devices, node) {
+		if (!entry->quiesced)
+			continue;
+		ret = pm_runtime_force_resume(entry->dev);
+		entry->quiesced = false;
+		if (ret) {
+			dev_err(entry->dev, "audio restart resume failed: %d\n", ret);
+			if (!error)
+				error = ret;
+		}
+	}
+	return error;
+}
+EXPORT_SYMBOL_GPL(liuqin_audio_resume_devices);
