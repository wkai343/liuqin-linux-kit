+			return ret;
+		ret = pinctrl_pm_select_default_state(card->dev);
+		if (ret)
+			return ret;
+	}
+
+	/* The machine device survives APM removal, but its ALSA card does not. */
+	data->jack_setup = false;
+	memset(data->stream_prepared, 0, sizeof(data->stream_prepared));
+	memset(data->suspended_stream, 0, sizeof(data->suspended_stream));
+	return 0;
+}
+
