+static int liuqin_create_prm_clocks(struct qcom_pas *pas)
+{
+	struct device_node *edge __free(device_node) = NULL;
+	struct device_node *gpr __free(device_node) = NULL;
+	struct device_node *prm __free(device_node) = NULL;
+	struct device_node *clocks __free(device_node) = NULL;
+
+	if (!liuqin_board_quirks() || !pas->info_name || strcmp(pas->info_name, "adsp"))
+		return 0;
+
+	edge = of_get_child_by_name(pas->dev->of_node, "glink-edge");
+	gpr = of_get_compatible_child(edge, "qcom,gpr");
+	prm = of_get_compatible_child(gpr, "qcom,q6prm");
+	clocks = of_get_compatible_child(prm, "qcom,q6prm-lpass-clocks");
+	if (!clocks)
+		return -ENODEV;
+
+	/* GPR devices disappear on SSR; the remoteproc device does not. */
+	pas->prm_clocks = of_platform_device_create(clocks, NULL, pas->dev);
+	return pas->prm_clocks ? 0 : -ENOMEM;
+}
