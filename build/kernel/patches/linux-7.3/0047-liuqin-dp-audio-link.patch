From: Liuqin Linux Kit <liuqin@localhost>
Subject: [PATCH] arm64: dts: qcom: liuqin: connect DisplayPort audio

Connect the AudioReach DISPLAY_PORT_RX_0 backend to the existing MSM DP0
HDMI codec. The SM8450 machine driver already configures this backend for
48 kHz, 16-bit stereo and registers the DP0 hotplug jack. Give the codec
controls a stable DisplayPort0 prefix, as on other Qualcomm DP boards.

The independent front-end and display-port DSP sink are supplied by the
board topology; the protected TDM speaker path is unchanged.

diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts
@@ -1040,6 +1040,22 @@
 		};
 	};
 
+	dp-playback-dai-link {
+		link-name = "DisplayPort Playback";
+
+		cpu {
+			sound-dai = <&q6apmbedai DISPLAY_PORT_RX_0>;
+		};
+
+		platform {
+			sound-dai = <&q6apm>;
+		};
+
+		codec {
+			sound-dai = <&mdss_dp0>;
+		};
+	};
+
 	mic-capture-dai-link {
 		link-name = "WCD Capture";
 
@@ -1228,6 +1244,7 @@
  * HDMI/DP dock up.
  */
 &mdss_dp0 {
+	sound-name-prefix = "DisplayPort0";
 	status = "okay";
 };
 
