From: Liuqin Linux Kit maintainers
Subject: [PATCH] usb: typec: ucsi: read Liuqin CC orientation before USB roles

Liuqin ordinary USB attach does not reliably generate a DP PAN event.
Read Xiaomi XM_CC_ORIENTATION through the existing serialized battery
service and apply it in UCSI's pre-role connector-status hook. Retry a
briefly stale detached value, validate the firmware encoding, and never
use gpio91 as a CC input. Keep the ABL-aware board helper, existing role
and alternate-mode policy, and shared SuperSpeed board ceiling.

diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -20,6 +20,7 @@
 #include <linux/property.h>
 #include <linux/soc/qcom/pdr.h>
 #include <linux/soc/qcom/pmic_glink.h>
+#include <linux/soc/qcom/battmgr.h>
 #include <linux/spinlock.h>
 #include <linux/math.h>
 #include <linux/units.h>
@@ -118,6 +119,7 @@
 #define XM_ADAPTER_SVID			18
 #define XM_PD_VERIFIED			19
 #define XM_PDO2			20
+#define XM_CC_ORIENTATION		36
 #define XM_FASTCHG_MODE			38
 /* M81 inserts BLANK_STATUS/SCREEN_CCTOG at 40/41 before SOC_DECIMAL. */
 #define XM_QUICK_CHARGE_TYPE		44
@@ -756,6 +758,7 @@
 } \
 static DEVICE_ATTR_RO(_name)
 
+QCOM_BATTMGR_RAW_ATTR(raw_xm_cc_orientation, BATTMGR_XM_PROPERTY_GET, XM_CC_ORIENTATION);
 QCOM_BATTMGR_RAW_ATTR(raw_usb_real_type, BATTMGR_USB_PROPERTY_GET, USB_REAL_TYPE);
 QCOM_BATTMGR_RAW_ATTR(raw_xm_authentic, BATTMGR_XM_PROPERTY_GET, XM_AUTHENTIC);
 QCOM_BATTMGR_RAW_ATTR(raw_xm_real_type, BATTMGR_XM_PROPERTY_GET, XM_REAL_TYPE);
@@ -771,6 +774,7 @@
 QCOM_BATTMGR_RAW_ATTR(raw_xm_power_max, BATTMGR_XM_PROPERTY_GET, XM_POWER_MAX);
 
 static struct attribute *qcom_battmgr_raw_attrs[] = {
+	&dev_attr_raw_xm_cc_orientation.attr,
 	&dev_attr_raw_usb_real_type.attr,
 	&dev_attr_raw_xm_authentic.attr,
 	&dev_attr_raw_xm_real_type.attr,
@@ -2901,6 +2905,45 @@
 	.driver.pm = pm_sleep_ptr(&qcom_battmgr_pm_ops),
 };
 
+static int qcom_battmgr_match_child(struct device *dev, const void *data)
+{
+	return str_has_prefix(dev_name(dev), "pmic_glink.power-supply.");
+}
+
+/* Keep the supplier bound for the entire serialized firmware transaction. */
+int qcom_battmgr_read_cc_orientation(struct device *pmic, unsigned int *orientation)
+{
+	struct qcom_battmgr *battmgr;
+	struct device *dev;
+	unsigned int value;
+	int ret = -EAGAIN;
+
+	dev = device_find_child(pmic, NULL, qcom_battmgr_match_child);
+	if (!dev)
+		return -EAGAIN;
+	device_lock(dev);
+	if (dev->driver != &qcom_battmgr_driver.driver)
+		goto out;
+	battmgr = dev_get_drvdata(dev);
+	if (battmgr->variant != QCOM_BATTMGR_SM8475) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	ret = qcom_battmgr_raw_property(battmgr, BATTMGR_XM_PROPERTY_GET,
+					XM_CC_ORIENTATION, &value);
+	if (!ret) {
+		if (value > 2)
+			ret = -EPROTO;
+		else
+			*orientation = value;
+	}
+out:
+	device_unlock(dev);
+	put_device(dev);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_battmgr_read_cc_orientation);
+
 module_auxiliary_driver(qcom_battmgr_driver);
 
 MODULE_DESCRIPTION("Qualcomm PMIC GLINK battery manager driver");
diff --git a/include/linux/soc/qcom/battmgr.h b/include/linux/soc/qcom/battmgr.h
new file mode 100644
--- /dev/null
+++ b/include/linux/soc/qcom/battmgr.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __LINUX_SOC_QCOM_BATTMGR_H__
+#define __LINUX_SOC_QCOM_BATTMGR_H__
+
+#include <linux/errno.h>
+#include <linux/kconfig.h>
+
+struct device;
+
+/* Xiaomi SM8475 XM property 36: 0 detached, 1 CC1, 2 CC2. */
+#if IS_REACHABLE(CONFIG_BATTERY_QCOM_BATTMGR)
+int qcom_battmgr_read_cc_orientation(struct device *pmic, unsigned int *orientation);
+#else
+static inline int qcom_battmgr_read_cc_orientation(struct device *pmic,
+						unsigned int *orientation)
+{
+	return -EOPNOTSUPP;
+}
+#endif
+
+#endif
diff --git a/drivers/usb/typec/ucsi/ucsi_glink.c b/drivers/usb/typec/ucsi/ucsi_glink.c
--- a/drivers/usb/typec/ucsi/ucsi_glink.c
+++ b/drivers/usb/typec/ucsi/ucsi_glink.c
@@ -4,6 +4,8 @@
  * Copyright (c) 2023, Linaro Ltd
  */
 #include <linux/auxiliary_bus.h>
+#include <linux/delay.h>
+#include <linux/soc/qcom/battmgr.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
 #include <linux/of_device.h>
@@ -195,6 +197,10 @@
 {
 	struct pmic_glink_ucsi *ucsi = ucsi_get_drvdata(con->ucsi);
 
+	if (liuqin_board_quirks() && con->num == 1) {
+		con->typec_cap.orientation_aware = true;
+		return;
+	}
 	if (con->num > PMIC_GLINK_MAX_PORTS ||
 	    !ucsi->port_orientation[con->num - 1])
 		return;
@@ -202,13 +208,51 @@
 	con->typec_cap.orientation_aware = true;
 }
 
+/*
+ * Ordinary USB does not require a DP PAN notification. Read the CC state
+ * through the battery owner's lock before UCSI enables the USB role/mux.
+ * The PMIC can publish connector status slightly ahead of its CC property.
+ */
+static int pmic_glink_ucsi_liuqin_orientation(struct pmic_glink_ucsi *ucsi,
+					   unsigned int *orientation)
+{
+	int attempt, ret;
+
+	for (attempt = 0; attempt < 10; attempt++) {
+		ret = qcom_battmgr_read_cc_orientation(ucsi->dev->parent, orientation);
+		if (!ret && *orientation)
+			return 0;
+		if (ret && ret != -EAGAIN)
+			return ret;
+		if (attempt < 9)
+			msleep(50);
+	}
+	return -EAGAIN;
+}
+
 static void pmic_glink_ucsi_connector_status(struct ucsi_connector *con)
 {
 	struct pmic_glink_ucsi *ucsi = ucsi_get_drvdata(con->ucsi);
-	int orientation;
+	unsigned int cc;
+	int orientation, ret;
 
 	if (!UCSI_CONSTAT(con, CONNECTED)) {
 		typec_set_orientation(con->port, TYPEC_ORIENTATION_NONE);
+		return;
+	}
+
+	if (liuqin_board_quirks() && con->num == 1) {
+		ret = pmic_glink_ucsi_liuqin_orientation(ucsi, &cc);
+		if (ret) {
+			dev_warn_ratelimited(ucsi->dev, "CC orientation unavailable: %d\n", ret);
+			return;
+		}
+		orientation = cc == 1 ? TYPEC_ORIENTATION_NORMAL : TYPEC_ORIENTATION_REVERSE;
+		ret = typec_set_orientation(con->port, orientation);
+		if (ret)
+			dev_err(ucsi->dev, "CC%u lane switch failed: %d\n", cc, ret);
+		else
+			dev_dbg(ucsi->dev, "connector %u CC%u orientation applied\n", con->num, cc);
 		return;
 	}
 
