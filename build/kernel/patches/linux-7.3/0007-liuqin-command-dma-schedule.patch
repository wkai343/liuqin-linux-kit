diff --git a/drivers/gpu/drm/msm/dsi/dsi_cmd_schedule.h b/drivers/gpu/drm/msm/dsi/dsi_cmd_schedule.h
new file mode 100644
index 00000000000..3694c28e008
--- /dev/null
+++ b/drivers/gpu/drm/msm/dsi/dsi_cmd_schedule.h
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __DSI_CMD_SCHEDULE_H__
+#define __DSI_CMD_SCHEDULE_H__
+
+/* Pure policy shared by the paired-host driver and its boundary tests. */
+static inline int dsi_cmd_schedule_calculate(const struct drm_display_mode *m,
+					     u32 *line, u32 *guard)
+{
+	u32 front, back, sync;
+
+	if (!m || m->clock <= 0 || m->htotal <= 0 || m->vdisplay <= 0 ||
+	    m->vsync_start <= m->vdisplay || m->vsync_end <= m->vsync_start ||
+	    m->vtotal <= m->vsync_end || m->vtotal > 65535)
+		return -EINVAL;
+	front = m->vsync_start - m->vdisplay;
+	back = m->vtotal - m->vsync_end;
+	sync = m->vsync_end - m->vsync_start;
+	if (front < 2)
+		return -EINVAL;
+	*line = m->vdisplay + back + sync + 1;
+	/* Vendor allowance: 100 us of memory/trigger latency before the slot. */
+	*guard = DIV_ROUND_UP_ULL(100ULL * m->clock, 1000ULL * m->htotal);
+	if (!*guard || *guard >= *line)
+		return -EINVAL;
+	return 0;
+}
+
+static inline bool dsi_cmd_schedule_line_safe(u32 current_line, u32 line,
+					      u32 guard, u32 total)
+{
+	return current_line <= total &&
+	       (current_line < line - guard || current_line > line + 1);
+}
+#endif
