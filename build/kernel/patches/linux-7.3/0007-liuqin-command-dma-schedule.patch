+/* Raw 6G offset 0x100, after the host's +4-byte base adjustment. */
+#define LIUQIN_DMA_SCHEDULE_CTRL 0xfc
+#define LIUQIN_DMA_SCHEDULE_MASK (BIT(28) | GENMASK(15, 0))
+
+int msm_dsi_host_cmd_schedule_prepare(struct mipi_dsi_host *host,
+				      struct msm_dsi_cmd_schedule *state)
+{
+	struct msm_dsi_host *h = to_msm_dsi_host(host);
+	int ret;
+
+	if (!h->power_on || !h->enabled ||
+	    !(h->mode_flags & MIPI_DSI_MODE_VIDEO))
+		return 0;
+	ret = dsi_cmd_schedule_calculate(h->mode, &state->line, &state->guard);
+	if (ret)
+		return ret;
+	state->total = h->mode->vtotal;
+	state->saved = dsi_read(h, LIUQIN_DMA_SCHEDULE_CTRL);
+	state->active = true;
+	h->cmd_dma_scheduled = true;
+	dsi_write(h, LIUQIN_DMA_SCHEDULE_CTRL,
+		  (state->saved & ~LIUQIN_DMA_SCHEDULE_MASK) | BIT(28) |
+			  state->line);
+	/* Read back before either DMA can be armed. Preserve unrelated bits. */
+	if (dsi_read(h, LIUQIN_DMA_SCHEDULE_CTRL) !=
+	    ((state->saved & ~LIUQIN_DMA_SCHEDULE_MASK) | BIT(28) |
+	     state->line))
+		return -EIO;
+	dev_info_once(&h->pdev->dev,
+		      "Liuqin command schedule: line %u guard %u total %u\n",
+		      state->line, state->guard, state->total);
+	return 1;
+}
+
+int msm_dsi_host_cmd_schedule_finish(struct mipi_dsi_host *host,
+				     struct msm_dsi_cmd_schedule *state)
+{
+	struct msm_dsi_host *h = to_msm_dsi_host(host);
+	u32 status, ctrl;
+	int ret;
+
+	if (!state->active)
+		return 0;
+	/* Check the non-trigger link too; do not remove scheduling while busy. */
+	ret = readl_poll_timeout(h->ctrl_base + REG_DSI_STATUS0, status,
+				 !(status & DSI_STATUS0_CMD_MODE_DMA_BUSY), 50,
+				 20000);
+	if (ret) {
+		/* Abort only the command engine; keep video, PHY and rails intact. */
+		ctrl = dsi_read(h, REG_DSI_CTRL);
+		dsi_write(h, REG_DSI_CTRL, ctrl & ~DSI_CTRL_CMD_MODE_EN);
+		/* Complete command-engine abort before removing scheduling. */
+		wmb();
+		dev_err_ratelimited(
+			&h->pdev->dev,
+			"Liuqin command schedule DMA busy timeout\n");
+	}
+	dsi_write(h, LIUQIN_DMA_SCHEDULE_CTRL, state->saved);
+	h->cmd_dma_scheduled = false;
+	state->active = false;
+	return ret;
+}
