 		};
+
 		opp-439000000 {
 			opp-hz = /bits/ 64 <439000000>;
 			opp-level = <RPMH_REGULATOR_LEVEL_LOW_SVS_L2>;
+			qcom,opp-cx-level = <RPMH_REGULATOR_LEVEL_SVS>;
+			qcom,opp-acd-level = <0xc0285ffd>;
