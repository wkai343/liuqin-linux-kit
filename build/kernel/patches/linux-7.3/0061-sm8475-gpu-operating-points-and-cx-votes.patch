index 0bd7d6b69..58c2a5cc2 100644
--- a/Documentation/devicetree/bindings/opp/opp-v2-qcom-adreno.yaml
+++ b/Documentation/devicetree/bindings/opp/opp-v2-qcom-adreno.yaml
@@ -36,6 +36,16 @@ patternProperties:
 
       opp-supported-hw: true
 
+      qcom,opp-cx-level:
+        description: |
+          Minimum CX voltage corner required while the GPU uses this OPP.
+          On A730 the GMU performance table carries the CX corner index
+          separately from the GX/MX vote. The driver translates this RPMh
+          voltage level through the platform's cx.lvl command database.
+          When used, every GPU OPP must specify this property. Without it,
+          the driver preserves the firmware's existing CX dependency policy.
+        $ref: /schemas/types.yaml#/definitions/uint32
+
       qcom,opp-acd-level:
         description: |
           A positive value representing the ACD (Adaptive Clock Distribution,
diff --git a/arch/arm64/boot/dts/qcom/sm8475.dtsi b/arch/arm64/boot/dts/qcom/sm8475.dtsi
index c650983a2..90e9263ae 100644
--- a/arch/arm64/boot/dts/qcom/sm8475.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8475.dtsi
@@ -5,6 +5,7 @@
 
 #include "sm8450.dtsi"
 
+/delete-node/ &gpu_opp_table;
 /delete-node/ &usb_1_hsphy;
 /delete-node/ &ufs_mem_phy;
 
@@ -62,62 +63,101 @@ &gcc {
 };
 
