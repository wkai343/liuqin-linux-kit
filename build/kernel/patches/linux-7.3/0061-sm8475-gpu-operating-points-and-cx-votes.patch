 &gpucc {
diff --git a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
index be97598d5..1de052a26 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
@@ -1851,6 +1851,66 @@ static int a6xx_gmu_rpmh_dep_votes_init(struct device *dev, u32 *votes,
  * and BCM parameters to build the votes.
  */
 
+static int a6xx_gmu_rpmh_gx_cx_votes_init(struct a6xx_gmu *gmu)
+{
+	struct a6xx_gpu *a6xx_gpu = container_of(gmu, struct a6xx_gpu, gmu);
+	struct adreno_gpu *adreno_gpu = &a6xx_gpu->base;
+	struct device *dev = &adreno_gpu->base.pdev->dev;
+	u32 levels[GMU_MAX_GX_FREQS] = { 0 };
+	const u16 *cx;
+	size_t size, count;
+	int i, j, ret, present = 0;
+
+	/* Keep the existing wire value for platforms without a CX dependency. */
+	memset(gmu->gx_cx_votes, 0xff, sizeof(gmu->gx_cx_votes));
+	for (i = 1; i < gmu->nr_gpu_freqs; i++) {
+		struct dev_pm_opp *opp;
+		struct device_node *np;
+
+		opp = dev_pm_opp_find_freq_exact(dev, gmu->gpu_freqs[i], true);
+		if (IS_ERR(opp))
+			return PTR_ERR(opp);
+		np = dev_pm_opp_get_of_node(opp);
+		if (!of_property_present(np, "qcom,opp-cx-level")) {
+			of_node_put(np);
+			dev_pm_opp_put(opp);
+			continue;
+		}
+		ret = of_property_read_u32(np, "qcom,opp-cx-level", &levels[i]);
+		of_node_put(np);
+		dev_pm_opp_put(opp);
+		if (ret)
+			return ret;
+		present++;
+	}
+	if (!present)
+		return 0;
+
+	/* Only A730's GEN7 HFI contract is verified for this optional field. */
+	if (!adreno_is_a730(adreno_gpu) || present != gmu->nr_gpu_freqs - 1)
+		return dev_err_probe(dev, -EINVAL, "incomplete or unsupported GPU CX table\n");
+
+	cx = cmd_db_read_aux_data("cx.lvl", &size);
+	if (IS_ERR(cx))
+		return PTR_ERR(cx);
+	if (!cx || !size || size % sizeof(*cx))
+		return -EINVAL;
+	count = size / sizeof(*cx);
+
+	/* Include the off entry, which must release the GPU's CX vote. */
+	for (i = 0; i < gmu->nr_gpu_freqs; i++) {
+		for (j = 0; j < count; j++)
+			if (cx[j] >= levels[i])
+				break;
+		if (j == count)
+			return dev_err_probe(dev, -EINVAL, "unsupported GPU CX corner %u\n",
+					     levels[i]);
+		gmu->gx_cx_votes[i] = j;
+	}
+
+	return 0;
+}
+
 static int a6xx_gmu_rpmh_votes_init(struct a6xx_gmu *gmu)
 {
 	struct a6xx_gpu *a6xx_gpu = container_of(gmu, struct a6xx_gpu, gmu);
@@ -1861,6 +1921,10 @@ static int a6xx_gmu_rpmh_votes_init(struct a6xx_gmu *gmu)
 	const u16 *gmxc;
 	int ret;
 
+	ret = a6xx_gmu_rpmh_gx_cx_votes_init(gmu);
+	if (ret)
+		return ret;
+
 	gmxc = cmd_db_read_aux_data("gmxc.lvl", NULL);
 	if (gmxc == ERR_PTR(-EPROBE_DEFER))
 		return -EPROBE_DEFER;
@@ -2468,7 +2532,9 @@ int a6xx_gmu_init(struct a6xx_gpu *a6xx_gpu, struct device_node *node)
 	gmu->gxpd = dev_pm_domain_attach_by_name(gmu->dev, "gx");
 
 	/* Get the power levels for the GMU and GPU */
-	a6xx_gmu_pwrlevels_probe(gmu);
+	ret = a6xx_gmu_pwrlevels_probe(gmu);
+	if (ret)
+		goto detach_gxpd;
 
 	ret = a6xx_gmu_acd_probe(gmu);
 	if (ret)
diff --git a/drivers/gpu/drm/msm/adreno/a6xx_gmu.h b/drivers/gpu/drm/msm/adreno/a6xx_gmu.h
index 3f96b10b5..4b44e4291 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_gmu.h
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gmu.h
@@ -98,6 +98,7 @@ struct a6xx_gmu {
 	int nr_gpu_freqs;
 	unsigned long gpu_freqs[GMU_MAX_GX_FREQS];
 	u32 gx_arc_votes[GMU_MAX_GX_FREQS];
+	u32 gx_cx_votes[GMU_MAX_GX_FREQS];
 	u32 dep_arc_votes[GMU_MAX_GX_FREQS];
 	struct a6xx_hfi_acd_table acd_table;
 
diff --git a/drivers/gpu/drm/msm/adreno/a6xx_hfi.c b/drivers/gpu/drm/msm/adreno/a6xx_hfi.c
index 186a73c0b..5c54a1ffd 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_hfi.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_hfi.c
@@ -341,7 +341,7 @@ static int a6xx_hfi_send_perf_table(struct a6xx_gmu *gmu)
 
 	for (i = 0; i < gmu->nr_gpu_freqs; i++) {
 		msg.gx_votes[i].vote = gmu->gx_arc_votes[i];
-		msg.gx_votes[i].acd = 0xffffffff;
+		msg.gx_votes[i].cx_vote = gmu->gx_cx_votes[i];
 		msg.gx_votes[i].freq = gmu->gpu_freqs[i] / 1000;
 	}
 
diff --git a/drivers/gpu/drm/msm/adreno/a6xx_hfi.h b/drivers/gpu/drm/msm/adreno/a6xx_hfi.h
index e10d32ce9..fe0a9768e 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_hfi.h
+++ b/drivers/gpu/drm/msm/adreno/a6xx_hfi.h
@@ -110,7 +110,8 @@ struct perf_level {
 
 struct perf_gx_level {
 	u32 vote;
-	u32 acd;
+	/* A7xx GX-to-CX dependency index; 0xffffffff disables the vote. */
+	u32 cx_vote;
 	u32 freq;
 } __packed;
 
