@@ -160,6 +171,12 @@ static void vfe_wm_start(struct vfe_device *vfe, u8 rdi, struct vfe_line *line)
 	u32 cfg;
 	u8 wm;
 
+	if (camss_680_pix && !vfe_is_lite(vfe) && rdi == VFE_LINE_PIX) {
+		vfe_disable_irq(vfe);
+		vfe680_pix_start(vfe, line);
+		return;
+	}
+
 	cfg = VFE_BUS_IMAGE_CFG0_DATA(pix->height, stride);
 	wm = RDI_WM(rdi);
 
@@ -197,6 +214,22 @@ static void vfe_wm_stop(struct vfe_device *vfe, u8 rdi)
 {
 	u8 wm = RDI_WM(rdi);
 
+	if (camss_680_pix && !vfe_is_lite(vfe) && rdi == VFE_LINE_PIX) {
+		u32 violation = readl(vfe->base +
+				      VFE_BUS_WR_IMAGE_VIOLATION_STATUS(vfe));
+		u32 overflow =
+			readl(vfe->base + VFE_BUS_WR_OVERFLOW_STATUS(vfe));
+
+		if (violation || overflow)
+			dev_warn(
+				vfe->camss->dev,
+				"IFE680 PIX image violation %#x overflow %#x\n",
+				violation, overflow);
+		writel(0, vfe->base + VFE_BUS_WRITE_CLIENT_CFG(vfe, 0));
+		writel(0, vfe->base + VFE_BUS_WRITE_CLIENT_CFG(vfe, 1));
+		return;
+	}
+
 	writel(0, vfe->base + VFE_BUS_WRITE_CLIENT_CFG(vfe, wm));
