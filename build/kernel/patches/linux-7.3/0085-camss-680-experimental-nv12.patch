@@ -0,0 +1,182 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Experimental IFE680 single-IFE NV12 pipeline. Register addresses/packing
+ * checked against the shipping Liuqin Titan680 IQ implementation; this is
+ * deliberately not the older Titan480 register layout.
+ * No statistics, per-frame tuning, LSC, black subtraction or HDR yet.
+ */
+static unsigned int ife680_red_gain = 1024;
+static unsigned int ife680_blue_gain = 1024;
+module_param(ife680_red_gain, uint, 0444);
+module_param(ife680_blue_gain, uint, 0444);
+MODULE_PARM_DESC(ife680_red_gain, "Manual red gain, Q10, clamped to 1..32767");
+MODULE_PARM_DESC(ife680_blue_gain,
+		 "Manual blue gain, Q10, clamped to 1..32767");
+
+/* sRGB OETF sampled at i / 256, rounded to the Gamma151 12-bit domain. */
+static const u16 vfe680_srgb[257] = {
+	0,    203,  347,  452,	538,  613,  679,  739,	794,  845,  894,  939,
+	982,  1023, 1062, 1099, 1136, 1170, 1204, 1237, 1268, 1299, 1329, 1358,
+	1386, 1414, 1441, 1467, 1493, 1518, 1543, 1567, 1591, 1615, 1638, 1660,
+	1683, 1704, 1726, 1747, 1768, 1789, 1809, 1829, 1849, 1868, 1888, 1907,
+	1926, 1944, 1962, 1981, 1998, 2016, 2034, 2051, 2068, 2085, 2102, 2119,
+	2135, 2151, 2168, 2184, 2199, 2215, 2231, 2246, 2261, 2277, 2292, 2307,
+	2321, 2336, 2351, 2365, 2379, 2394, 2408, 2422, 2436, 2449, 2463, 2477,
+	2490, 2504, 2517, 2530, 2543, 2557, 2570, 2582, 2595, 2608, 2621, 2633,
+	2646, 2658, 2670, 2683, 2695, 2707, 2719, 2731, 2743, 2755, 2767, 2778,
+	2790, 2802, 2813, 2825, 2836, 2847, 2859, 2870, 2881, 2892, 2903, 2914,
+	2925, 2936, 2947, 2958, 2969, 2979, 2990, 3001, 3011, 3022, 3032, 3043,
+	3053, 3063, 3074, 3084, 3094, 3104, 3114, 3124, 3134, 3144, 3154, 3164,
+	3174, 3184, 3194, 3203, 3213, 3223, 3232, 3242, 3252, 3261, 3271, 3280,
+	3289, 3299, 3308, 3317, 3327, 3336, 3345, 3354, 3363, 3372, 3382, 3391,
+	3400, 3409, 3418, 3426, 3435, 3444, 3453, 3462, 3471, 3479, 3488, 3497,
+	3505, 3514, 3523, 3531, 3540, 3548, 3557, 3565, 3574, 3582, 3590, 3599,
+	3607, 3615, 3624, 3632, 3640, 3648, 3656, 3665, 3673, 3681, 3689, 3697,
+	3705, 3713, 3721, 3729, 3737, 3745, 3753, 3761, 3769, 3776, 3784, 3792,
+	3800, 3807, 3815, 3823, 3831, 3838, 3846, 3854, 3861, 3869, 3876, 3884,
+	3891, 3899, 3906, 3914, 3921, 3929, 3936, 3944, 3951, 3958, 3966, 3973,
+	3980, 3988, 3995, 4002, 4009, 4017, 4024, 4031, 4038, 4045, 4053, 4060,
+	4067, 4074, 4081, 4088, 4095,
+};
+
+#define VFE680_WB_MODULE_CFG 0x4560
+#define VFE680_WB_GAIN_G 0x4568
+#define VFE680_WB_GAIN_B 0x456c
+#define VFE680_WB_GAIN_R 0x4570
+#define VFE680_WB_OFFSETS 0x4574
+#define VFE680_WB_CHANNEL_CFG 0x4594
+#define VFE680_DEMOSAIC_MODULE_CFG 0x5660
+#define VFE680_DEMOSAIC_CFG 0x5668
+#define VFE680_GAMMA_DMI_ADDR 0x5f08
+#define VFE680_GAMMA_DMI_SELECT 0x5f0c
+#define VFE680_GAMMA_DMI_DATA 0x5f10
+#define VFE680_GAMMA_DMI_BANK 0x5f58
+#define VFE680_GAMMA_BANK 0x5f5c
+#define VFE680_GAMMA_MODULE_CFG 0x5f60
+#define VFE680_CST_MODULE_CFG 0x6160
+#define VFE680_CST_CFG 0x6168
+#define VFE680_MNDS_Y 0x9860
+#define VFE680_MNDS_C 0x9a60
+#define VFE680_ROUND_Y_MODULE_CFG 0x9c60
+#define VFE680_ROUND_Y_CFG 0x9c70
+#define VFE680_ROUND_C_MODULE_CFG 0x9e60
+#define VFE680_ROUND_C_CFG 0x9e70
+
+static void vfe680_write_words(struct vfe_device *vfe, u32 offset,
+			       const u32 *data, unsigned int count)
+{
+	unsigned int i;
+
+	for (i = 0; i < count; i++)
+		writel(data[i], vfe->base + offset + 4 * i);
+}
+
+static void vfe680_pix_configure(struct vfe_device *vfe, struct vfe_line *line)
+{
+	struct v4l2_pix_format_mplane *p =
+		&line->video_out.active_fmt.fmt.pix_mp;
+	u32 w = p->width, h = p->height;
+	/* MNDS23: full-size luma; 2:1 chroma reduction in both dimensions. */
+	u32 mnds[] = {
+		1,	    0x600, ((w - 1) << 16) | (h - 1),
+		0xc0200000, 0,	   0xc0200000,
+		0,	    0,	   0,
+		0,
+	};
+	static const u32 demosaic[] = { 0x80, 0, 0x00200000, 0x66 };
+	/* CST12: G/B/R input, BT.601 full-range Y/Cb/Cr, 12-bit offsets. */
+	static const u32 cst[] = {
+		0x00750259, 0x00000132, 0,	    0, 0, 0xfff00000,
+		0x01fe1ea6, 0x00001f54, 0x40000000, 0, 0, 0xfff00000,
+		0x1fad1e55, 0x000001fe, 0x40000000, 0, 0, 0xfff00000,
+	};
+	static const u32 round_y[] = { 0, 0x16, 0, 0, 0, 0, 255, 0, 0, 0 };
+	static const u32 round_c[] = { 0, 0x17, 0, 0x17, 0, 0, 255, 255, 0, 0 };
+	unsigned int i, j;
+
+	/* Top680 configuration, bypassing the unused DS4/DS16 branches. */
+	writel(0x1e000, vfe->base + 0x24);
+	writel(0, vfe->base + 0x28);
+	writel(0, vfe->base + 0x2c);
+	writel(0, vfe->base + 0x8c);
+	writel(1, vfe->base + 0x90);
+	writel(h / 2, vfe->base + 0x9c);
+	/* Common configuration emitted by IFEPipelineTitan680. */
+	writel(1, vfe->base + 0x2300);
+	writel(1, vfe->base + 0x2600);
+
+	/* WB201: Q10 gains in G/B/R order, zero offsets, no channel reduction. */
+	writel(1024 << 17, vfe->base + VFE680_WB_GAIN_G);
+	writel(clamp_t(u32, ife680_blue_gain, 1, 32767) << 17,
+	       vfe->base + VFE680_WB_GAIN_B);
+	writel(clamp_t(u32, ife680_red_gain, 1, 32767) << 17,
+	       vfe->base + VFE680_WB_GAIN_R);
+	for (i = 0; i < 8; i++)
+		writel(0, vfe->base + VFE680_WB_OFFSETS + 4 * i);
+	writel(3 << 8, vfe->base + VFE680_WB_CHANNEL_CFG);
+	writel(1, vfe->base + VFE680_WB_MODULE_CFG);
+
+	vfe680_write_words(vfe, VFE680_DEMOSAIC_CFG, demosaic,
+			   ARRAY_SIZE(demosaic));
+	writel(1, vfe->base + VFE680_DEMOSAIC_MODULE_CFG);
+
+	/* Gamma151: 256 entries, 12-bit base and signed 12-bit delta. */
+	writel(0, vfe->base + VFE680_GAMMA_DMI_BANK);
+	writel(0, vfe->base + VFE680_GAMMA_BANK);
+	for (i = 1; i <= 3; i++) {
+		writel(0, vfe->base + VFE680_GAMMA_DMI_ADDR);
+		writel(i, vfe->base + VFE680_GAMMA_DMI_SELECT);
+		for (j = 0; j < 256; j++) {
+			u32 delta = vfe680_srgb[j + 1] - vfe680_srgb[j];
+
+			writel(vfe680_srgb[j] | (delta << 12),
+			       vfe->base + VFE680_GAMMA_DMI_DATA);
+		}
+	}
+	writel(0, vfe->base + VFE680_GAMMA_DMI_SELECT);
+	writel(1, vfe->base + VFE680_GAMMA_MODULE_CFG);
+
+	vfe680_write_words(vfe, VFE680_CST_CFG, cst, ARRAY_SIZE(cst));
+	writel(1, vfe->base + VFE680_CST_MODULE_CFG);
+	vfe680_write_words(vfe, VFE680_MNDS_Y, mnds, ARRAY_SIZE(mnds));
+	mnds[3] = 0xc0400000;
+	mnds[5] = 0xc0400000;
+	vfe680_write_words(vfe, VFE680_MNDS_C, mnds, ARRAY_SIZE(mnds));
+	vfe680_write_words(vfe, VFE680_ROUND_Y_CFG, round_y,
+			   ARRAY_SIZE(round_y));
+	vfe680_write_words(vfe, VFE680_ROUND_C_CFG, round_c,
+			   ARRAY_SIZE(round_c));
+	writel(0xc01, vfe->base + VFE680_ROUND_Y_MODULE_CFG);
+	writel(0x3c01, vfe->base + VFE680_ROUND_C_MODULE_CFG);
+}
+
+static void vfe680_pix_start(struct vfe_device *vfe, struct vfe_line *line)
+{
+	struct v4l2_pix_format_mplane *p =
+		&line->video_out.active_fmt.fmt.pix_mp;
+	u32 stride = p->plane_fmt[0].bytesperline;
+	unsigned int wm;
+
+	vfe680_pix_configure(vfe, line);
+	for (wm = 0; wm < 2; wm++) {
+		u32 height = p->height >> wm;
+
+		writel((height << 16) | p->width,
+		       vfe->base + VFE_BUS_IMAGE_CFG0(vfe, wm));
+		writel(0, vfe->base + VFE_BUS_IMAGE_CFG1(vfe, wm));
+		writel(stride, vfe->base + VFE_BUS_IMAGE_CFG2(vfe, wm));
+		writel(3, vfe->base + VFE_BUS_PACKER_CFG(vfe, wm));
+		writel(0, vfe->base + 0xe1c + wm * 0x100);
+		writel(11 << 8, vfe->base + 0xe80 + wm * 0x100);
+		writel(stride * height,
+		       vfe->base + VFE_BUS_FRAME_INCR(vfe, wm));
+		writel(1, vfe->base + VFE_BUS_MMU_PREFETCH_CFG(vfe, wm));
+		writel(stride * height - 1,
+		       vfe->base + VFE_BUS_MMU_PREFETCH_MAX_OFFSET(vfe, wm));
+		writel(1, vfe->base + VFE_BUS_FRAMEDROP_PATTERN(vfe, wm));
+		writel(0, vfe->base + VFE_BUS_FRAMEDROP_PERIOD(vfe, wm));
+		writel(1, vfe->base + VFE_BUS_IRQ_SUBSAMPLE_PATTERN(vfe, wm));
+		writel(0, vfe->base + VFE_BUS_IRQ_SUBSAMPLE_PERIOD(vfe, wm));
+		writel(1, vfe->base + VFE_BUS_WRITE_CLIENT_CFG(vfe, wm));
+	}
+}
