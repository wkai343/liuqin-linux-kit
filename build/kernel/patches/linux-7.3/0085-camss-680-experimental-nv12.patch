+	writel((in->height - 1) << 16, csid->base + CSID_IPP_VCROP);
+	writel(9, csid->base + CSID_IPP_ERR_RECOVERY_CFG0);
+	writel(0, csid->base + CSID_IPP_CAMIF_FRAME_CFG);
+	writel((in->height / 2) << 16, csid->base + CSID_IPP_EPOCH_IRQ_CFG);
