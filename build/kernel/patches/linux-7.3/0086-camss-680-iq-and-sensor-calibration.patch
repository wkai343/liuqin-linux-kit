From: Liuqin Linux contributors <liuqin@localhost>
Subject: [PATCH] media: camss: add local IFE680 IQ controls and sensor-owned calibration

Expose fixed-shape Bayer statistics, white balance, lens shading and CC131
colour matrix controls for the opt-in IFE680 NV12 path. Queue the RGB
matrix with the white balance update. Preserve the RAW black pedestal
through LSC/WB before BLS and carry the flipped CFA through CSID CAMIF.

Own the front module EEPROM through IMX596 runtime PM, serialize reads with
sensor controls and reject them during streaming. No independent at24 probe
or EEPROM write is introduced.

This is a local experimental ABI, not a general-purpose register interface.

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index df7fc3424..d0ca54c5d 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -172,6 +172,7 @@ config VIDEO_IMX214
 config VIDEO_IMX596
 	tristate "Sony IMX596 sensor support"
 	depends on I2C && VIDEO_DEV
+	select NVMEM
 	select V4L2_CCI_I2C
 	help
 	  Support the Sony IMX596 four-lane RAW10 sensor at 19.2 MHz.
diff --git a/drivers/media/i2c/imx596.c b/drivers/media/i2c/imx596.c
index 490e83dee..c0b776991 100644
--- a/drivers/media/i2c/imx596.c
+++ b/drivers/media/i2c/imx596.c
@@ -9,6 +9,8 @@
 #include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/module.h>
+#include <linux/nvmem-provider.h>
+#include <linux/platform_data/liuqin.h>
 #include <linux/pm_runtime.h>
 #include <linux/regulator/consumer.h>
 #include <media/v4l2-cci.h>
@@ -35,6 +37,8 @@ struct imx596_mode {
 };
 
 struct imx596 {
+	struct i2c_client *eeprom;
+	struct nvmem_device *nvmem;
 	struct device *dev;
 	struct regmap *regmap;
 	struct clk *xclk;
@@ -1000,6 +1004,84 @@ static int imx596_check_endpoint(struct device *dev)
 	return ret;
 }
 
+/*
+ * The AAC EEPROM shares IOVDD with the sensor. Do not power it independently
+ * during asynchronous probe: keep the module's complete rail sequence under
+ * the sensor runtime-PM owner. Registration performs no bus transactions.
+ */
+static int imx596_eeprom_read(void *priv, unsigned int offset, void *val,
+			      size_t bytes)
+{
+	struct imx596 *sensor = priv;
+	u8 address[2];
+	u8 *data = val;
+	struct i2c_msg msgs[2] = {
+		{ .addr = 0x51, .len = 2, .buf = address },
+		{ .addr = 0x51, .flags = I2C_M_RD },
+	};
+	int ret;
+
+	if (offset > 8192 || bytes > 8192 - offset)
+		return -EINVAL;
+	mutex_lock(sensor->ctrls.lock);
+	if (v4l2_subdev_is_streaming(&sensor->sd)) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+	ret = pm_runtime_resume_and_get(sensor->dev);
+	if (ret < 0)
+		goto unlock;
+	while (bytes) {
+		unsigned int count = min_t(size_t, bytes, 12);
+
+		address[0] = offset >> 8;
+		address[1] = offset;
+		msgs[1].len = count;
+		msgs[1].buf = data;
+		ret = i2c_transfer(sensor->eeprom->adapter, msgs, 2);
+		if (ret != 2) {
+			ret = ret < 0 ? ret : -EIO;
+			goto put_pm;
+		}
+		offset += count;
+		data += count;
+		bytes -= count;
+	}
+	ret = 0;
+put_pm:
+	pm_runtime_mark_last_busy(sensor->dev);
+	pm_runtime_put_autosuspend(sensor->dev);
+unlock:
+	mutex_unlock(sensor->ctrls.lock);
+	return ret;
+}
+
+static int imx596_register_eeprom(struct imx596 *sensor, struct i2c_client *client)
+{
+	struct nvmem_config config = {
+		.dev = sensor->dev,
+		.name = "imx596-aac-eeprom",
+		.id = NVMEM_DEVID_AUTO,
+		.type = NVMEM_TYPE_EEPROM,
+		.owner = THIS_MODULE,
+		.read_only = true,
+		.root_only = true,
+		.size = 8192,
+		.word_size = 1,
+		.stride = 1,
+		.reg_read = imx596_eeprom_read,
+		.priv = sensor,
+	};
+
+	if (!liuqin_board_quirks())
+		return 0;
+	sensor->eeprom = devm_i2c_new_dummy_device(sensor->dev, client->adapter, 0x51);
+	if (IS_ERR(sensor->eeprom))
+		return PTR_ERR(sensor->eeprom);
+	sensor->nvmem = nvmem_register(&config);
+	return PTR_ERR_OR_ZERO(sensor->nvmem);
+}
+
 static int imx596_probe(struct i2c_client *client)
 {
 	struct device *dev = &client->dev;
@@ -1064,9 +1146,15 @@ static int imx596_probe(struct i2c_client *client)
 	pm_runtime_set_active(dev);
 	pm_runtime_get_noresume(dev);
 	pm_runtime_enable(dev);
-	ret = v4l2_async_register_subdev_sensor(&sensor->sd);
+	ret = imx596_register_eeprom(sensor, client);
 	if (ret)
 		goto disable_pm;
+	ret = v4l2_async_register_subdev_sensor(&sensor->sd);
+	if (ret) {
+		if (sensor->nvmem)
+			nvmem_unregister(sensor->nvmem);
+		goto disable_pm;
+	}
 	pm_runtime_set_autosuspend_delay(dev, 1000);
 	pm_runtime_use_autosuspend(dev);
 	pm_runtime_put_autosuspend(dev);
@@ -1090,7 +1178,10 @@ static int imx596_probe(struct i2c_client *client)
 static void imx596_remove(struct i2c_client *client)
 {
 	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx596 *sensor = to_imx596(sd);
 
+	if (sensor->nvmem)
+		nvmem_unregister(sensor->nvmem);
 	v4l2_async_unregister_subdev(sd);
 	v4l2_subdev_cleanup(sd);
 	media_entity_cleanup(&sd->entity);
