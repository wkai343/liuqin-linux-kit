 		if (buf_done_val & BIT(0))
 			camss_buf_done(csid->camss, csid->id, VFE_LINE_PIX);
 	}
diff --git a/drivers/media/platform/qcom/camss/camss-vfe-680-iq.h b/drivers/media/platform/qcom/camss/camss-vfe-680-iq.h
new file mode 100644
index 000000000..07f5538f4
--- /dev/null
+++ b/drivers/media/platform/qcom/camss/camss-vfe-680-iq.h
@@ -0,0 +1,323 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Experimental local ABI; paired with the Liuqin libcamera pipeline. */
+#include <linux/dma-mapping.h>
+#include <media/v4l2-ctrls.h>
+
+#define VFE680_CID_BASE (V4L2_CID_USER_BASE + 0x3000)
+#define VFE680_STATS_WORDS (32 * 24 * 20)
+#define VFE680_STATS_ALLOC SZ_64K
+
+/* U16 payload stores signed Q10 coefficients biased by 2048, RGB row-major. */
+static const u16 vfe680_cc_identity[9] = {
+	3072, 2048, 2048, 2048, 3072, 2048, 2048, 2048, 3072,
+};
+
+struct vfe680_iq {
+	struct v4l2_ctrl_handler handler;
+	struct vfe_line *line;
+	void *dma;
+	dma_addr_t dma_addr;
+	u32 queued, completed, done;
+	u32 gains[2];
+	u16 mesh[884];
+	u16 cc[9];
+	bool cc_dirty;
+	bool lsc;
+	u32 stats[VFE680_STATS_WORDS + 2];
+};
+
+static int vfe680_iq_set(struct v4l2_ctrl *ctrl)
+{
+	struct vfe680_iq *iq =
+		container_of(ctrl->handler, struct vfe680_iq, handler);
+	struct vfe_device *vfe = to_vfe(iq->line);
+	unsigned long flags;
+
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	if (ctrl->id == VFE680_CID_BASE + 3) {
+		if (iq->line->output.state != VFE_OUTPUT_OFF) {
+			spin_unlock_irqrestore(&vfe->output_lock, flags);
+			return -EBUSY;
+		}
+		memcpy(iq->mesh, ctrl->p_new.p_u16, sizeof(iq->mesh));
+		iq->lsc = true;
+	}
+	if (ctrl->id == VFE680_CID_BASE + 4) {
+		memcpy(iq->cc, ctrl->p_new.p_u16, sizeof(iq->cc));
+		iq->cc_dirty = true;
+	}
+	if (ctrl->id == VFE680_CID_BASE + 1)
+		memcpy(iq->gains, ctrl->p_new.p_u32, sizeof(iq->gains));
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+	return 0;
+}
+
+static int vfe680_iq_get(struct v4l2_ctrl *ctrl)
+{
+	struct vfe680_iq *iq =
+		container_of(ctrl->handler, struct vfe680_iq, handler);
+	struct vfe_device *vfe = to_vfe(iq->line);
+	unsigned long flags;
+
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	memcpy(ctrl->p_new.p_u32, iq->stats, sizeof(iq->stats));
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+	return 0;
+}
+
+static const struct v4l2_ctrl_ops vfe680_iq_ops = {
+	.s_ctrl = vfe680_iq_set,
+	.g_volatile_ctrl = vfe680_iq_get,
+};
+
+int vfe680_iq_init(struct vfe_line *line)
+{
+	struct vfe_device *vfe = to_vfe(line);
+	struct device *dev = vfe->camss->dev;
+	struct vfe680_iq *iq;
+	const struct v4l2_ctrl_config configs[] = {
+		{ .id = VFE680_CID_BASE,
+		  .name = "IFE680 IQ ABI",
+		  .type = V4L2_CTRL_TYPE_INTEGER,
+		  .min = 1,
+		  .max = 1,
+		  .step = 1,
+		  .def = 1,
+		  .flags = V4L2_CTRL_FLAG_READ_ONLY },
+		{ .ops = &vfe680_iq_ops,
+		  .id = VFE680_CID_BASE + 1,
+		  .name = "IFE680 red blue gains",
+		  .type = V4L2_CTRL_TYPE_U32,
+		  .min = 1024,
+		  .max = 16384,
+		  .step = 1,
+		  .def = 1024,
+		  .dims = { 2 } },
+		{ .ops = &vfe680_iq_ops,
+		  .id = VFE680_CID_BASE + 2,
+		  .name = "IFE680 Bayer grid",
+		  .type = V4L2_CTRL_TYPE_U32,
+		  .min = 0,
+		  .max = U32_MAX,
+		  .step = 1,
+		  .dims = { VFE680_STATS_WORDS + 2 },
+		  .flags = V4L2_CTRL_FLAG_READ_ONLY | V4L2_CTRL_FLAG_VOLATILE },
+		{ .ops = &vfe680_iq_ops,
+		  .id = VFE680_CID_BASE + 3,
+		  .name = "IFE680 calibrated lens shading",
+		  .type = V4L2_CTRL_TYPE_U16,
+		  .min = 512,
+		  .max = 16383,
+		  .step = 1,
+		  .def = 1024,
+		  .dims = { 884 } },
+		{ .ops = &vfe680_iq_ops,
+		  .id = VFE680_CID_BASE + 4,
+		  .name = "IFE680 RGB colour matrix",
+		  .type = V4L2_CTRL_TYPE_U16,
+		  .min = 0,
+		  .max = 4095,
+		  .step = 1,
+		  .def = 2048,
+		  .p_def.p_const = vfe680_cc_identity,
+		  .dims = { 9 } },
+	};
+	unsigned int i;
+
+	iq = devm_kzalloc(dev, sizeof(*iq), GFP_KERNEL);
+	if (!iq)
+		return -ENOMEM;
+	iq->line = line;
+	iq->gains[0] = iq->gains[1] = 1024;
+	memcpy(iq->cc, vfe680_cc_identity, sizeof(iq->cc));
+	iq->dma = dmam_alloc_coherent(dev, 2 * VFE680_STATS_ALLOC,
+				      &iq->dma_addr, GFP_KERNEL);
+	if (!iq->dma)
+		return -ENOMEM;
+	line->iq = iq;
+	v4l2_ctrl_handler_init(&iq->handler, ARRAY_SIZE(configs));
+	for (i = 0; i < ARRAY_SIZE(configs); i++)
+		v4l2_ctrl_new_custom(&iq->handler, &configs[i], NULL);
+	line->subdev.ctrl_handler = &iq->handler;
+	return iq->handler.error;
+}
+
+void vfe680_iq_cleanup(struct vfe_line *line)
+{
+	if (line->iq) {
+		v4l2_ctrl_handler_free(&line->iq->handler);
+		line->subdev.ctrl_handler = NULL;
+		line->iq = NULL;
+	}
+}
+
+static void vfe680_lsc_start(struct vfe_device *vfe, struct vfe_line *line)
+{
+	struct vfe680_iq *iq = line->iq;
+	u32 h = line->fmt[0].height;
+	/* Validated OEM grid optimisation for the two supported binned modes. */
+	u32 level = h == 1952 ? 1 : 2;
+	u32 sx = h == 1952 ? 41 : 21, sy = h == 1952 ? 41 : 16;
+	u32 dx = h == 1952 ? 8 : 24, dy = h == 1952 ? 4 : 16;
+	u32 bx = dx / sx, by = dy / sy;
+	u32 cfg[] = {
+		0xbf,
+		((sx << level) - 1) | (((sy << level) - 1) << 16),
+		(sx - 1) | (((1 << 20) / sx) << 12),
+		(sy - 1) | (((1 << 20) / sy) << 12),
+		(dx % sx) | ((dy % sy) << 16),
+		16384 << 14,
+		(dy % sy) * ((1 << 20) / sy),
+		0,
+		0,
+		0,
+		0,
+		16384 << 14,
+		0,
+	};
+	unsigned int i, bank;
+
+	if (!iq->lsc) {
+		writel(0, vfe->base + 0x4360);
+		return;
+	}
+	writel(0, vfe->base + 0x4358);
+	writel(0, vfe->base + 0x435c);
+	for (i = 0; i < ARRAY_SIZE(cfg); i++)
+		writel(cfg[i], vfe->base + 0x4368 + i * 4);
+	for (bank = 1; bank <= 3; bank++) {
+		writel(0, vfe->base + 0x4308);
+		writel(bank, vfe->base + 0x430c);
+		for (i = 0; i < 221; i++) {
+			u32 value = 0;
+
+			if (bank == 1)
+				value = iq->mesh[i] | (iq->mesh[221 + i] << 14);
+			if (bank == 2)
+				value = iq->mesh[663 + i] |
+					(iq->mesh[442 + i] << 14);
+			writel(value, vfe->base + 0x4310);
+		}
+	}
+	writel(0, vfe->base + 0x430c);
+	writel(1 | (level << 12) | ((bx >> level) << 16) |
+		       ((by >> level) << 20) |
+		       ((bx & ((1 << level) - 1)) << 24) |
+		       ((by & ((1 << level) - 1)) << 28),
+	       vfe->base + 0x4360);
+}
+
+static void vfe680_iq_start(struct vfe_device *vfe, struct vfe_line *line)
+{
+	struct vfe680_iq *iq = line->iq;
+	u32 w = line->fmt[0].width, h = line->fmt[0].height;
+	u32 rw = (w / 32) & ~1, rh = (h / 24) & ~1;
+	u32 x = ((w - rw * 32) / 2) & ~1, y = ((h - rh * 24) / 2) & ~1;
+	unsigned int i;
+
+	vfe680_lsc_start(vfe, line);
+	iq->cc_dirty = true;
+	iq->queued = iq->completed = iq->done = 0;
+	memset(iq->stats, 0, sizeof(iq->stats));
+	memset(iq->dma, 0, 2 * VFE680_STATS_ALLOC);
+	/* BLS121, RAW10 black 64 expanded to the 18-bit IFE domain; Q11 scale. */
+	writel(16384 << 14, vfe->base + 0x4b68);
+	writel(2184, vfe->base + 0x4b6c);
+	for (i = 0; i < 4; i++)
+		writel(0, vfe->base + 0x4b70 + 4 * i);
+	writel(1, vfe->base + 0x4b60);
+	/* AWBBG17, 32 x 24 regions, all pixels, unsaturated RGB sums. */
+	writel(31 << 16 | x, vfe->base + 0xb86c);
+	writel(rw - 1, vfe->base + 0xb870);
+	writel(23 << 16 | y, vfe->base + 0xb874);
+	writel(rh - 1, vfe->base + 0xb878);
+	writel(0, vfe->base + 0xb87c);
+	for (i = 0; i < 5; i++) {
+		writel(250000U << 14, vfe->base + 0xb880 + 4 * i);
+		writel(0, vfe->base + 0xb894 + 4 * i);
+	}
+	writel(0x04120a00, vfe->base + 0xb868);
+	writel(0, vfe->base + 0xb864);
+	writel(0xffff0001, vfe->base + 0xb860);
+	/* Statistics use frame-based WM14, fixed composite group 6. */
+	writel(0, vfe->base + VFE_BUS_IMAGE_CFG0(vfe, 14));
+	writel(0, vfe->base + VFE_BUS_IMAGE_CFG1(vfe, 14));
+	writel(1, vfe->base + VFE_BUS_IMAGE_CFG2(vfe, 14));
+	writel(10, vfe->base + VFE_BUS_PACKER_CFG(vfe, 14));
+	writel(VFE680_STATS_ALLOC, vfe->base + VFE_BUS_FRAME_INCR(vfe, 14));
+	writel(0, vfe->base + VFE_BUS_MMU_PREFETCH_CFG(vfe, 14));
+	writel(1, vfe->base + VFE_BUS_FRAMEDROP_PATTERN(vfe, 14));
+	writel(0, vfe->base + VFE_BUS_FRAMEDROP_PERIOD(vfe, 14));
+	writel(1, vfe->base + VFE_BUS_IRQ_SUBSAMPLE_PATTERN(vfe, 14));
+	writel(0, vfe->base + VFE_BUS_IRQ_SUBSAMPLE_PERIOD(vfe, 14));
+	writel(0x10001, vfe->base + VFE_BUS_WRITE_CLIENT_CFG(vfe, 14));
+}
+
+/* CC131: G/B/R input/output, signed 12-bit coefficients, Q7 + qfactor 3.
+ * Verified against the shipping Titan680 packer. Public payload stays RGB.
+ * Called under output_lock, alongside WB and the next register update.
+ */
+static void vfe680_cc_queue(struct vfe_device *vfe, struct vfe680_iq *iq)
+{
+	static const u8 order[] = { 4, 7, 1, 5, 8, 2, 3, 6, 0 };
+	u32 c[9];
+	unsigned int i;
+
+	if (!iq->cc_dirty)
+		return;
+	for (i = 0; i < ARRAY_SIZE(c); i++)
+		c[i] = (iq->cc[order[i]] - 2048) & 0xfff;
+	for (i = 0; i < 3; i++) {
+		writel(c[3 * i] | (c[3 * i + 1] << 16),
+		       vfe->base + 0x5868 + 8 * i);
+		writel(c[3 * i + 2], vfe->base + 0x586c + 8 * i);
+		writel(0, vfe->base + 0x5880 + 4 * i);
+	}
+	writel(3, vfe->base + 0x588c);
+	writel(1, vfe->base + 0x5860);
+	iq->cc_dirty = false;
+}
+
+static void vfe680_iq_queue(struct vfe_device *vfe, struct vfe_line *line)
+{
+	struct vfe680_iq *iq = line->iq;
+
+	writel(iq->dma_addr + (iq->queued++ % 2) * VFE680_STATS_ALLOC,
+	       vfe->base + VFE_BUS_IMAGE_ADDR(vfe, 14));
+	vfe680_cc_queue(vfe, iq);
+	writel(iq->gains[0] << 17, vfe->base + 0x4570);
+	writel(iq->gains[1] << 17, vfe->base + 0x456c);
+}
+
+static void vfe680_iq_done(struct vfe_device *vfe, int port)
+{
+	struct vfe_line *line = &vfe->line[VFE_LINE_PIX];
+	struct vfe680_iq *iq = line->iq;
+	unsigned long flags;
+
+	if (port == 4 && !iq)
+		return;
+	if (!iq || (port != VFE_LINE_PIX && port != 4)) {
+		vfe_buf_done(vfe, port);
+		return;
+	}
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	if (line->output.state == VFE_OUTPUT_OFF) {
+		spin_unlock_irqrestore(&vfe->output_lock, flags);
+		return;
+	}
+	iq->done |= port == 4 ? 2 : 1;
+	if (iq->done != 3) {
+		spin_unlock_irqrestore(&vfe->output_lock, flags);
+		return;
+	}
+	iq->done = 0;
+	dma_rmb();
+	memcpy(iq->stats + 2,
+	       iq->dma + (iq->completed % 2) * VFE680_STATS_ALLOC,
+	       VFE680_STATS_WORDS * sizeof(u32));
+	iq->stats[0] = iq->completed++;
+	iq->stats[1] = 1;
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+	vfe_buf_done(vfe, VFE_LINE_PIX);
+}
