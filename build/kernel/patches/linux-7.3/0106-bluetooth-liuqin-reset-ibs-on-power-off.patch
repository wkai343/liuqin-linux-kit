Subject: [PATCH] Bluetooth: hci_qca: reset IBS on Liuqin WCN6855 power-off

The pre-shutdown command goes through qca_enqueue() after the initial
timer deletion and can leave TX awake with a fresh idle timer. The next
powered session reuses qca_data while the controller starts from reset.

Quiesce previous-session IBS traffic on the Liuqin WCN6855 before
dropping its BT power target. Drain wake work before reusable timers,
then settle clock votes and restore both initial sleep states. Accept new
traffic once the UART has reopened on a successful power-on. Firmware
setup retains its existing IBS bypass.

OEM: Xiaomi M81 OS2.0.6.0.VMYCNXM, vendor_a/lib64/hw/
     android.hardware.bluetooth@1.0-impl-qti.so. UartController::Cleanup()
     stops the IBS timers and destroys the handler. UartController::Init()
     constructs a new handler and calls IbsHandler::InitInt().

The Linux power-cycle fix adapts work by Birk Skyum and Vladyslav Tymoshchuk.

diff --git a/drivers/bluetooth/hci_qca.c b/drivers/bluetooth/hci_qca.c
index 174d7b3..29e42b3 100644
--- a/drivers/bluetooth/hci_qca.c
+++ b/drivers/bluetooth/hci_qca.c
@@ -73,6 +73,7 @@
 
 enum qca_flags {
 	QCA_IBS_DISABLED,
+	QCA_IBS_STOPPED,	/* Previous powered session ended */
 	QCA_DROP_VENDOR_EVENT,
 	QCA_SUSPENDING,
 	QCA_MEMDUMP_COLLECTION,
@@ -761,6 +762,11 @@ static void device_want_to_wakeup(struct hci_uart *hu)
 
 	spin_lock_irqsave(&qca->hci_ibs_lock, flags);
 
+	if (test_bit(QCA_IBS_STOPPED, &qca->flags)) {
+		spin_unlock_irqrestore(&qca->hci_ibs_lock, flags);
+		return;
+	}
+
 	qca->ibs_recv_wakes++;
 
 	/* Don't wake the rx up when suspending. */
@@ -813,6 +819,11 @@ static void device_want_to_sleep(struct hci_uart *hu)
 
 	spin_lock_irqsave(&qca->hci_ibs_lock, flags);
 
+	if (test_bit(QCA_IBS_STOPPED, &qca->flags)) {
+		spin_unlock_irqrestore(&qca->hci_ibs_lock, flags);
+		return;
+	}
+
 	qca->ibs_recv_slps++;
 
 	switch (qca->rx_ibs_state) {
@@ -850,6 +861,11 @@ static void device_woke_up(struct hci_uart *hu)
 
 	spin_lock_irqsave(&qca->hci_ibs_lock, flags);
 
+	if (test_bit(QCA_IBS_STOPPED, &qca->flags)) {
+		spin_unlock_irqrestore(&qca->hci_ibs_lock, flags);
+		return;
+	}
+
 	qca->ibs_recv_wacks++;
 
 	/* Don't react to the wake-up-acknowledgment when suspending. */
@@ -913,6 +929,12 @@ static int qca_enqueue(struct hci_uart *hu, struct sk_buff *skb)
 
 	spin_lock_irqsave(&qca->hci_ibs_lock, flags);
 
+	if (test_bit(QCA_IBS_STOPPED, &qca->flags)) {
+		spin_unlock_irqrestore(&qca->hci_ibs_lock, flags);
+		kfree_skb(skb);
+		return 0;
+	}
+
 	/* Don't go to sleep in middle of patch download or
 	 * Out-Of-Band(GPIOs control) sleep is selected.
 	 * Don't wake the device up when suspending.
@@ -1877,6 +1899,8 @@ static int qca_power_on(struct hci_dev *hdev)
 		}
 	}
 
+	if (!ret)
+		clear_bit(QCA_IBS_STOPPED, &qca->flags);
 	clear_bit(QCA_BT_OFF, &qca->flags);
 	return ret;
 }
@@ -2222,6 +2246,37 @@ static const struct qca_device_data qca_soc_data_wcn7850 __maybe_unused = {
 			QCA_CAP_HFP_HW_OFFLOAD,
 };
 
+/* A powered-down WCN6855 loses both ends of the IBS handshake. */
+static void qca_stop_ibs(struct hci_uart *hu)
+{
+	struct qca_data *qca = hu->priv;
+	unsigned long flags;
+
+	/* The port can still deliver indications while we drain the old work. */
+	spin_lock_irqsave(&qca->hci_ibs_lock, flags);
+	set_bit(QCA_IBS_STOPPED, &qca->flags);
+	set_bit(QCA_IBS_DISABLED, &qca->flags);
+	spin_unlock_irqrestore(&qca->hci_ibs_lock, flags);
+
+	/* Wake work arms timers, and timer callbacks can queue clock votes. */
+	cancel_work_sync(&qca->ws_awake_device);
+	cancel_work_sync(&qca->ws_awake_rx);
+	timer_delete_sync(&qca->wake_retrans_timer);
+	timer_delete_sync(&qca->tx_idle_timer);
+	cancel_work_sync(&qca->ws_tx_vote_off);
+	cancel_work_sync(&qca->ws_rx_vote_off);
+
+	spin_lock_irqsave(&qca->hci_ibs_lock, flags);
+	qca_flush(hu);
+	qca->tx_ibs_state = HCI_IBS_TX_ASLEEP;
+	qca->rx_ibs_state = HCI_IBS_RX_ASLEEP;
+	if (qca->tx_vote)
+		serial_clock_vote(HCI_IBS_TX_VOTE_CLOCK_OFF, hu);
+	if (qca->rx_vote)
+		serial_clock_vote(HCI_IBS_RX_VOTE_CLOCK_OFF, hu);
+	spin_unlock_irqrestore(&qca->hci_ibs_lock, flags);
+}
+
 static void qca_power_off(struct hci_uart *hu)
 {
 	struct qca_serdev *qcadev;
@@ -2235,10 +2290,14 @@ static void qca_power_off(struct hci_uart *hu)
 	 * still be open, stop queueing the IBS data and flush all the buffered
 	 * data in skb's.
 	 */
-	spin_lock_irqsave(&qca->hci_ibs_lock, flags);
-	set_bit(QCA_IBS_DISABLED, &qca->flags);
-	qca_flush(hu);
-	spin_unlock_irqrestore(&qca->hci_ibs_lock, flags);
+	if (hu->serdev && soc_type == QCA_WCN6855 && liuqin_board_quirks()) {
+		qca_stop_ibs(hu);
+	} else {
+		spin_lock_irqsave(&qca->hci_ibs_lock, flags);
+		set_bit(QCA_IBS_DISABLED, &qca->flags);
+		qca_flush(hu);
+		spin_unlock_irqrestore(&qca->hci_ibs_lock, flags);
+	}
 
 	/* Non-serdev device usually is powered by external power
 	 * and don't need additional action in driver for power down
