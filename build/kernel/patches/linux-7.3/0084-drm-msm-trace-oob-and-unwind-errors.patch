 			*value = adreno_gpu->funcs->get_timestamp(gpu);
 			pm_runtime_put_autosuspend(&gpu->pdev->dev);
 
diff --git a/drivers/gpu/drm/msm/msm_gpu_trace.h b/drivers/gpu/drm/msm/msm_gpu_trace.h
index 5417f8d38..77e44ea8a 100644
--- a/drivers/gpu/drm/msm/msm_gpu_trace.h
+++ b/drivers/gpu/drm/msm/msm_gpu_trace.h
@@ -8,6 +8,39 @@
 #define TRACE_SYSTEM drm_msm_gpu
 #define TRACE_INCLUDE_FILE msm_gpu_trace
 
+TRACE_EVENT(msm_gmu_oob,
+	TP_PROTO(u32 state, int ret, u64 elapsed_us, u32 info,
+		 u32 power, u32 busy, bool hung, bool needs_hw_init,
+		 unsigned long caller),
+	TP_ARGS(state, ret, elapsed_us, info, power, busy, hung, needs_hw_init, caller),
+	TP_STRUCT__entry(
+		__field(u32, state)
+		__field(int, ret)
+		__field(u64, elapsed_us)
+		__field(u32, info)
+		__field(u32, power)
+		__field(u32, busy)
+		__field(bool, hung)
+		__field(bool, needs_hw_init)
+		__field(unsigned long, caller)
+	),
+	TP_fast_assign(
+		__entry->state = state;
+		__entry->ret = ret;
+		__entry->elapsed_us = elapsed_us;
+		__entry->info = info;
+		__entry->power = power;
+		__entry->busy = busy;
+		__entry->hung = hung;
+		__entry->needs_hw_init = needs_hw_init;
+		__entry->caller = caller;
+	),
+	TP_printk("state=%u ret=%d elapsed_us=%llu info=%#x power=%#x busy=%#x hung=%d needs_hw_init=%d caller=%pS",
+		__entry->state, __entry->ret, __entry->elapsed_us,
+		__entry->info, __entry->power, __entry->busy,
+		__entry->hung, __entry->needs_hw_init, (void *)__entry->caller)
+);
+
 TRACE_EVENT(msm_gpu_submit,
 	    TP_PROTO(pid_t pid, u32 ringid, u32 id, u32 nr_bos, u32 nr_cmds),
 	    TP_ARGS(pid, ringid, id, nr_bos, nr_cmds),
