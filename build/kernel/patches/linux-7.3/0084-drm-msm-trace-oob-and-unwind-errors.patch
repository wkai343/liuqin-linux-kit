diff --git a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
index ba5940928..15e57f34c 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
@@ -395,6 +395,7 @@ int a6xx_gmu_set_oob(struct a6xx_gmu *gmu, enum a6xx_gmu_oob_state state)
 	struct a6xx_gpu *a6xx_gpu = container_of(gmu, struct a6xx_gpu, gmu);
 	struct adreno_gpu *adreno_gpu = &a6xx_gpu->base;
 	int ret, attempt;
+	ktime_t start;
 	u32 val;
 	int request, ack;
 
@@ -421,7 +422,8 @@ int a6xx_gmu_set_oob(struct a6xx_gmu *gmu, enum a6xx_gmu_oob_state state)
 		}
 	}
 
-	/* Trigger the equested OOB operation */
+	start = ktime_get();
+	/* Trigger the requested OOB operation */
 	gmu_write(gmu, REG_A6XX_GMU_HOST2GMU_INTR_SET, 1 << request);
 
 	for (attempt = 0; attempt < 2; attempt++) {
@@ -454,6 +456,15 @@ int a6xx_gmu_set_oob(struct a6xx_gmu *gmu, enum a6xx_gmu_oob_state state)
 				gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO),
 				__builtin_return_address(0));
 
+	if (trace_msm_gmu_oob_enabled())
+		trace_msm_gmu_oob(state, ret, ktime_us_delta(ktime_get(), start),
+			val, gmu_read(gmu, adreno_is_a8xx(adreno_gpu) ?
+				REG_A8XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE :
+				REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE),
+			gmu_read(gmu, REG_A6XX_GPU_GMU_AO_GPU_CX_BUSY_STATUS), gmu->hung,
+			adreno_gpu->base.needs_hw_init,
+			(unsigned long)__builtin_return_address(0));
+
 	/* Clear the acknowledge interrupt */
 	gmu_write(gmu, REG_A6XX_GMU_GMU2HOST_INTR_CLR, 1 << ack);
 
diff --git a/drivers/gpu/drm/msm/adreno/a6xx_gpu.c b/drivers/gpu/drm/msm/adreno/a6xx_gpu.c
index 253f25c09..011e37a68 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_gpu.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gpu.c
@@ -1202,8 +1202,11 @@ static int hw_init(struct msm_gpu *gpu)
 	if (!adreno_has_gmu_wrapper(adreno_gpu)) {
 		/* Make sure the GMU keeps the GPU on while we set it up */
 		ret = a6xx_gmu_set_oob(&a6xx_gpu->gmu, GMU_OOB_GPU_SET);
-		if (ret)
+		if (ret) {
+			/* The request remains asserted even if its ACK times out. */
+			a6xx_gmu_clear_oob(gmu, GMU_OOB_GPU_SET);
 			return ret;
+		}
 	}
 
 	/* Clear GBIF halt in case GX domain was not collapsed */
diff --git a/drivers/gpu/drm/msm/adreno/adreno_gpu.c b/drivers/gpu/drm/msm/adreno/adreno_gpu.c
