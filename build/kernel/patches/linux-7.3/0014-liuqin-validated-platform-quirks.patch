From: Liuqin Linux Kit contributors
Subject: [PATCH] Preserve liuqin feature sanitisation and validate factory metadata

Limit the SpecSEI exception to this board and exactly the known 0/1 variation;
retain HIGHER_SAFE and every unrelated strict field. Accept self-linked factory
backup GPT headers only on the two measured 32 MiB LUNs, after both header/entry
CRCs validate and both arrays agree. An internal Qualcomm UFS ancestor is required; OTG disks are excluded.
No block writes are performed.

Ignore only the inert ABL overlay sink when building mainline supplier links.
Preserve live GPIO dependencies, DRM, audio, power domains and OTG. Classify
normal touch state polling as informational, retaining terminal failures, and
bound keyboard wake NACK retries without delaying successful IRQ reads.

diff --git a/arch/arm64/kernel/cpufeature.c b/arch/arm64/kernel/cpufeature.c
index 3ae3ad1a1..ae8671e09 100644
--- a/arch/arm64/kernel/cpufeature.c
+++ b/arch/arm64/kernel/cpufeature.c
@@ -73,6 +73,7 @@
 #include <linux/minmax.h>
 #include <linux/mm.h>
 #include <linux/cpu.h>
+#include <linux/platform_data/liuqin.h>
 #include <linux/kasan.h>
 #include <linux/percpu.h>
 #include <linux/sched/isolation.h>
@@ -1281,12 +1282,22 @@ static void update_cpu_ftr_reg(struct arm64_ftr_reg *reg, u64 new)
 static int check_update_ftr_reg(u32 sys_id, int cpu, u64 val, u64 boot)
 {
 	struct arm64_ftr_reg *regp = get_arm64_ftr_reg(sys_id);
+	u64 strict_mask;
 
 	if (!regp)
 		return 0;
 
 	update_cpu_ftr_reg(regp, val);
-	if ((boot & regp->strict_mask) == (val & regp->strict_mask))
+	strict_mask = regp->strict_mask;
+	/* Retain HIGHER_SAFE sanitisation; permit only the observed 0/1
+	 * SpecSEI difference between SM8475's core clusters on this board.
+	 */
+	if (sys_id == SYS_ID_AA64MMFR1_EL1 && liuqin_board_quirks() &&
+	    (val ^ boot) == BIT_ULL(ID_AA64MMFR1_EL1_SpecSEI_SHIFT) &&
+	    ((val | boot) & GENMASK_ULL(27, 24)) ==
+			BIT_ULL(ID_AA64MMFR1_EL1_SpecSEI_SHIFT))
+		strict_mask &= ~GENMASK_ULL(27, 24);
+	if ((boot & strict_mask) == (val & strict_mask))
 		return 0;
 	pr_warn("SANITY CHECK: Unexpected variation in %s. Boot CPU: %#016llx, CPU%d: %#016llx\n",
 			regp->name, boot, cpu, val);
