diff --git a/include/linux/platform_data/liuqin.h b/include/linux/platform_data/liuqin.h
new file mode 100644
index 000000000..2a629b4e4
--- /dev/null
+++ b/include/linux/platform_data/liuqin.h
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_PLATFORM_DATA_LIUQIN_H
+#define _LINUX_PLATFORM_DATA_LIUQIN_H
+#include <linux/of.h>
+
+/* ABL may replace compatible with generic cape identifiers. */
+static inline bool liuqin_board_quirks(void)
+{
+	u32 id[2];
+
+	if (of_machine_is_compatible("xiaomi,liuqin"))
+		return true;
+	return of_property_match_string(of_root, "model",
+		"Liuqin based on Qualcomm Technologies, Inc SM8475") == 0 &&
+		!of_property_read_u32_array(of_root, "xiaomi,miboard-id", id, 2) &&
+		id[0] == 0x10 && id[1] == 0;
+}
+#endif
