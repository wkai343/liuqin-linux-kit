@@ -476,13 +477,59 @@ is_pte_valid(const gpt_entry *pte, const u64 lastlba)
  * and prints warnings on discrepancies.
  * 
  */
+static bool liuqin_factory_disk(struct parsed_partitions *state, u64 lastlba)
+{
+	struct device *dev;
+
+	if (!liuqin_board_quirks() || lastlba != 8191 ||
+	    (strcmp(state->disk->disk_name, "sdd") &&
+	     strcmp(state->disk->disk_name, "sdf")))
+		return false;
+
+	/* OTG disks must never inherit the internal factory-LUN exception. */
+	for (dev = disk_to_dev(state->disk)->parent; dev; dev = dev->parent)
+		if (dev->of_node && of_device_is_compatible(dev->of_node,
+						       "qcom,sm8450-ufshc"))
+			return true;
+	return false;
+}
+
+static bool liuqin_factory_backup(struct parsed_partitions *state,
+				 const gpt_header *pgpt, const gpt_header *agpt,
+				 const gpt_entry *pptes, const gpt_entry *aptes,
+				 u64 lastlba)
+{
+	size_t bytes;
+
+	if (!pgpt || !agpt || !pptes || !aptes ||
+	    !liuqin_factory_disk(state, lastlba) ||
+	    le64_to_cpu(pgpt->my_lba) != 1 ||
+	    le64_to_cpu(pgpt->alternate_lba) != lastlba ||
+	    le64_to_cpu(agpt->my_lba) != lastlba ||
+	    le64_to_cpu(agpt->alternate_lba) != lastlba ||
+	    pgpt->first_usable_lba != agpt->first_usable_lba ||
+	    pgpt->last_usable_lba != agpt->last_usable_lba ||
+	    efi_guidcmp(pgpt->disk_guid, agpt->disk_guid) ||
+	    pgpt->num_partition_entries != agpt->num_partition_entries ||
+	    pgpt->sizeof_partition_entry != agpt->sizeof_partition_entry ||
+	    pgpt->partition_entry_array_crc32 != agpt->partition_entry_array_crc32)
+		return false;
+
+	/* Called only after both headers and both entry CRCs validated. */
+	bytes = (size_t)le32_to_cpu(pgpt->num_partition_entries) *
+		le32_to_cpu(pgpt->sizeof_partition_entry);
+	return bytes && !memcmp(pptes, aptes, bytes);
+}
+
