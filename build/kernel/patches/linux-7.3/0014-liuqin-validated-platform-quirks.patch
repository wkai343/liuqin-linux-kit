 		pr_warn("GPT:%lld != %lld\n",
 		       (unsigned long long)le64_to_cpu(pgpt->my_lba),
@@ -634,7 +681,14 @@ static int find_valid_gpt(struct parsed_partitions *state, gpt_header **gpt,
         if (!good_pgpt && !good_agpt)
                 goto fail;
 
-        compare_gpts(pgpt, agpt, lastlba);
