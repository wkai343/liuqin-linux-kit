diff --git a/drivers/phy/qualcomm/phy-qcom-i2c-eusb2-repeater.c b/drivers/phy/qualcomm/phy-qcom-i2c-eusb2-repeater.c
index e386336e5..87ea85eb6 100644
--- a/drivers/phy/qualcomm/phy-qcom-i2c-eusb2-repeater.c
+++ b/drivers/phy/qualcomm/phy-qcom-i2c-eusb2-repeater.c
@@ -4,6 +4,7 @@
  */
 
 #include <linux/err.h>
+#include <linux/delay.h>
 #include <linux/i2c.h>
 #include <linux/gpio/consumer.h>
 #include <linux/module.h>
@@ -88,10 +89,18 @@ struct i2c_eusb2_repeater {
 
 static int eusb2_i2c_read_reg(struct i2c_eusb2_repeater *rptr, u8 reg, u8 *val)
 {
-	int ret;
+	int ret, attempt;
 	unsigned int reg_val;
 
-	ret = regmap_read(rptr->regmap, reg, &reg_val);
+	/* A newly powered repeater may NACK until its I2C interface wakes.
+	 * Retry only transient bus errors; keep terminal failures visible.
+	 */
+	for (attempt = 0; attempt < 5; attempt++) {
+		ret = regmap_read(rptr->regmap, reg, &reg_val);
+		if (!ret || (ret != -ENXIO && ret != -EREMOTEIO) || attempt == 4)
+			break;
+		usleep_range(1000, 2000);
+	}
 	if (ret < 0) {
 		dev_err(rptr->dev, "Failed to read reg: 0x%02x ret=%d\n", reg, ret);
 		return ret;
@@ -186,19 +195,24 @@ static int i2c_eusb2_repeater_init(struct phy *phy)
 
 	switch (chip->repeater_type) {
 	case TI_REPEATER:
-		eusb2_i2c_read_reg(rptr, REV_ID, &reg_val);
+		ret = eusb2_i2c_read_reg(rptr, REV_ID, &reg_val);
 		break;
 	case NXP_REPEATER:
-		eusb2_i2c_read_reg(rptr, REVISION_ID, &reg_val);
+		ret = eusb2_i2c_read_reg(rptr, REVISION_ID, &reg_val);
 		break;
 	default:
 		dev_err(rptr->dev, "Invalid repeater\n");
+		ret = -EINVAL;
 	}
 
-	dev_info(rptr->dev, "eUSB2 repeater version = 0x%x\n", reg_val);
+	/* The revision is diagnostic; an unavailable value must not be printed
+	 * uninitialised, or prevent the otherwise working PHY/OTG lifecycle.
+	 */
+	if (!ret)
+		dev_info(rptr->dev, "eUSB2 repeater version = 0x%x\n", reg_val);
 	dev_info(rptr->dev, "eUSB2 repeater init\n");
 
-	return ret;
+	return 0;
 }
 
