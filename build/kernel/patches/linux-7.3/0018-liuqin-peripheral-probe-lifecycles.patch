+static int rx_macro_reg_compare(const void *left, const void *right)
+{
+	const struct reg_default *a = left, *b = right;
+
+	return (a->reg > b->reg) - (a->reg < b->reg);
+}
+
 static int rx_macro_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -3858,6 +3866,10 @@ static int rx_macro_probe(struct platform_device *pdev)
 	if (!reg_config)
 		return -ENOMEM;
 
+	/* Both source arrays are sorted, but their concatenation is not.
+	 * Sort our writable copy before giving it to regmap.
+	 */
+	sort(reg_defaults, def_count, sizeof(*reg_defaults), rx_macro_reg_compare, NULL);
 	reg_config->reg_defaults = reg_defaults;
 	reg_config->num_reg_defaults = def_count;
 
