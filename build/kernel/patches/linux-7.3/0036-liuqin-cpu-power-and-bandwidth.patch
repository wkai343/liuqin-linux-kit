diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts
@@ -438,34 +438,42 @@
 /* OEM Cape capacities; normalized with each cluster's maximum frequency. */
 &cpu0 {
 	capacity-dmips-mhz = <1024>;
+	dynamic-power-coefficient = <100>;
 };
 
 &cpu1 {
 	capacity-dmips-mhz = <1024>;
+	dynamic-power-coefficient = <100>;
 };
 
 &cpu2 {
 	capacity-dmips-mhz = <1024>;
+	dynamic-power-coefficient = <100>;
 };
 
 &cpu3 {
 	capacity-dmips-mhz = <1024>;
+	dynamic-power-coefficient = <100>;
 };
 
 &cpu4 {
 	capacity-dmips-mhz = <2253>;
+	dynamic-power-coefficient = <257>;
 };
 
 &cpu5 {
 	capacity-dmips-mhz = <2253>;
+	dynamic-power-coefficient = <257>;
 };
 
 &cpu6 {
 	capacity-dmips-mhz = <2253>;
+	dynamic-power-coefficient = <257>;
 };
 
 &cpu7 {
 	capacity-dmips-mhz = <2386>;
+	dynamic-power-coefficient = <509>;
 };
 
 &iris {
@@ -1985,3 +1993,86 @@
 		};
 	};
 };
+
+/* Cape BWMON v5 (LLCC -> DDR) and v4 (CPU -> LLCC). */
+&soc {
+	llcc_bwmon: pmu@19091000 {
+		compatible = "qcom,sm8475-llcc-bwmon", "qcom,sc7280-llcc-bwmon";
+		reg = <0 0x19091000 0 0x1000>;
+		interrupts = <GIC_SPI 81 IRQ_TYPE_LEVEL_HIGH>;
+		interconnects = <&mc_virt MASTER_LLCC QCOM_ICC_TAG_ACTIVE_ONLY
+				 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ACTIVE_ONLY>;
+		operating-points-v2 = <&llcc_bwmon_opp_table>;
+
+		llcc_bwmon_opp_table: opp-table {
+			compatible = "operating-points-v2";
+
+			/* OEM frequency in kHz * 4-byte bus width = kB/s. */
+			opp-0 {
+				opp-peak-kBps = <(547000 * 4)>;
+			};
+
+			opp-1 {
+				opp-peak-kBps = <(768000 * 4)>;
+			};
+
+			opp-2 {
+				opp-peak-kBps = <(1555000 * 4)>;
+			};
+
+			opp-3 {
+				opp-peak-kBps = <(1708000 * 4)>;
+			};
+
+			opp-4 {
+				opp-peak-kBps = <(2092000 * 4)>;
+			};
+
+			opp-5 {
+				opp-peak-kBps = <(2736000 * 4)>;
+			};
+
+			opp-6 {
+				opp-peak-kBps = <(3196000 * 4)>;
+			};
+		};
+	};
+
+	cpu_bwmon: pmu@190b6400 {
+		compatible = "qcom,sm8475-cpu-bwmon", "qcom,sdm845-bwmon";
+		reg = <0 0x190b6400 0 0x300>;
+		interrupts = <GIC_SPI 581 IRQ_TYPE_LEVEL_HIGH>;
+		interconnects = <&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
+				 &gem_noc SLAVE_LLCC QCOM_ICC_TAG_ACTIVE_ONLY>;
+		operating-points-v2 = <&cpu_bwmon_opp_table>;
+
+		cpu_bwmon_opp_table: opp-table {
+			compatible = "operating-points-v2";
+
+			/* OEM frequency in kHz * 16-byte bus width = kB/s. */
+			opp-0 {
+				opp-peak-kBps = <(300000 * 16)>;
+			};
+
+			opp-1 {
+				opp-peak-kBps = <(466000 * 16)>;
+			};
+
+			opp-2 {
+				opp-peak-kBps = <(600000 * 16)>;
+			};
+
+			opp-3 {
+				opp-peak-kBps = <(806000 * 16)>;
+			};
+
+			opp-4 {
+				opp-peak-kBps = <(933000 * 16)>;
+			};
+
+			opp-5 {
+				opp-peak-kBps = <(1066000 * 16)>;
+			};
+		};
+	};
+};
