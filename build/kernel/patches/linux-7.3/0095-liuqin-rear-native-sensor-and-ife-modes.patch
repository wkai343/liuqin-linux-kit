+	/* Mode tables program HTS; changing its read-only control range has no I2C side effect. */
+	s5kjn1->hblank = v4l2_ctrl_new_std(ctrl_hdlr, NULL,
 					   V4L2_CID_HBLANK, hblank,
 					   hblank, 1, hblank);
