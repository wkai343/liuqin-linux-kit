+static void s5kjn1_write_mode(struct s5kjn1 *sensor, int *err)
+{
+	const struct s5kjn1_mode *mode = sensor->mode;
+	const struct s5kjn1_reg_list *list = &mode->reg_list;
+	unsigned int i, first = 0;
+
+	for (i = 0; i < mode->num_overrides; i++) {
+		const struct s5kjn1_reg_override *entry = &mode->overrides[i];
+
+		cci_multi_reg_write(sensor->regmap, list->regs + first,
+				    entry->index - first, err);
+		cci_write(sensor->regmap, list->regs[entry->index].reg,
+			  entry->value, err);
+		first = entry->index + 1;
+	}
+	cci_multi_reg_write(sensor->regmap, list->regs + first,
+			    list->num_regs - first, err);
+}
+
