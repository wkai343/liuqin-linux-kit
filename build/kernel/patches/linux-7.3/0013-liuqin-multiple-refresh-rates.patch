 struct mipi_dsi_host_ops {
+	int (*get_refresh_rate)(struct mipi_dsi_host *host);
 	int (*attach)(struct mipi_dsi_host *host,
 		      struct mipi_dsi_device *dsi);
 	int (*detach)(struct mipi_dsi_host *host,
