+static void nvt_count_pen_frame(struct nvt_pen_stats *stats, u8 format)
+{
+	switch (format) {
+	case NVT_PEN_POSITION:
+		stats->position++;
+		break;
+	case NVT_PEN_ABSENT:
+		stats->absent++;
+		break;
+	case NVT_PEN_ID:
+		stats->id++;
+		break;
+	default:
+		stats->other++;
+		break;
+	}
