+	if (buffer_type == BUF_ARP && core->iris_platform_data->requires_secure_arp) {
+		ret = iris_secure_buffer_alloc(core, buffer);
+		if (ret) {
+			kfree(buffer);
+			return ret;
+		}
+	} else {
+		buffer->kvaddr = dma_alloc_attrs(core->dev, buffer->buffer_size,
+						 &buffer->device_addr, GFP_KERNEL,
+						 buffer->dma_attrs);
+		if (!buffer->kvaddr) {
+			kfree(buffer);
+			return -ENOMEM;
+		}
 	}
 
 	list_add_tail(&buffer->list, &buffers->list);
@@ -653,8 +664,11 @@ void iris_destroy_internal_buffer(struct iris_inst *inst, struct iris_buffer *bu
 	struct iris_core *core = inst->core;
 
