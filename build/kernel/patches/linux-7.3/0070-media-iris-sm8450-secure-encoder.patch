diff --git a/drivers/media/platform/qcom/iris/iris_secure_memory.c b/drivers/media/platform/qcom/iris/iris_secure_memory.c
new file mode 100644
index 000000000..42f54eb70
--- /dev/null
+++ b/drivers/media/platform/qcom/iris/iris_secure_memory.c
@@ -0,0 +1,193 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Iris2 encoder ARP uses CP_NON_PIXEL memory even for non-secure sessions. */
+#include <linux/dma-mapping.h>
+#include <linux/firmware/qcom/qcom_scm.h>
+#include <linux/iommu.h>
+#include <linux/of_platform.h>
+#include <linux/slab.h>
+
+#include "iris_buffer.h"
+#include "iris_core.h"
+#include "iris_secure_memory.h"
+
+#define IRIS_SECURE_IOVA_START	0x01000000ULL
+#define IRIS_SECURE_IOVA_END	0x25800000ULL
+
+struct iris_secure_buffer {
+	struct device *dev;
+	struct sg_table *sgt;
+	size_t size;
+	u64 owners[];
+};
+
+static int iris_secure_buffer_reclaim(struct iris_secure_buffer *secure)
+{
+	const struct qcom_scm_vmperm perm = {
+		QCOM_SCM_VMID_HLOS, QCOM_SCM_PERM_RW | QCOM_SCM_PERM_EXEC,
+	};
+	struct scatterlist *sg;
+	int i, ret, error = 0;
+
+	for_each_sg(secure->sgt->sgl, sg, secure->sgt->orig_nents, i) {
+		if (secure->owners[i] == BIT_ULL(QCOM_SCM_VMID_HLOS))
+			continue;
+		ret = qcom_scm_assign_mem(sg_phys(sg), sg->length,
+					  &secure->owners[i], &perm, 1);
+		if (ret)
+			error = ret;
+	}
+
+	return error;
+}
+
+void iris_secure_buffer_free(struct iris_secure_buffer *secure)
+{
+	int ret;
+
+	ret = iris_secure_buffer_reclaim(secure);
+	if (ret) {
+		/* Never return protected pages to the allocator after a failed reclaim. */
+		dev_err(secure->dev, "ARP reclaim failed: %d; retaining allocation until reboot\n",
+			ret);
+		return;
+	}
+
+	dma_free_noncontiguous(secure->dev, secure->size, secure->sgt, DMA_BIDIRECTIONAL);
+	put_device(secure->dev);
+	kfree(secure);
+}
+
+int iris_secure_buffer_alloc(struct iris_core *core, struct iris_buffer *buffer)
+{
+	const struct qcom_scm_vmperm perm = {
+		QCOM_SCM_VMID_CP_NON_PIXEL, QCOM_SCM_PERM_RW,
+	};
+	struct iris_secure_buffer *secure;
+	struct scatterlist *sg;
+	struct sg_table *sgt;
+	struct device *dev;
+	dma_addr_t address;
+	size_t size = PAGE_ALIGN(buffer->buffer_size);
+	int i, ret;
+
+	if (!core->secure_pdev)
+		return -ENODEV;
+	dev = &core->secure_pdev->dev;
+
+	/*
+	 * Unlike dma_map_page(), this API passes GFP_KERNEL to the IOMMU.
+	 * The dedicated context must share new page tables via sleepable SCM.
+	 * Each session gets its own DMA-contiguous, CPU-unmapped allocation.
+	 */
+	sgt = dma_alloc_noncontiguous(dev, size, DMA_BIDIRECTIONAL, GFP_KERNEL | __GFP_ZERO, 0);
+	if (!sgt)
+		return -ENOMEM;
+
+	address = sg_dma_address(sgt->sgl);
+	if (address < IRIS_SECURE_IOVA_START ||
+	    size > IRIS_SECURE_IOVA_END || address > IRIS_SECURE_IOVA_END - size) {
+		ret = -ERANGE;
+		goto free_dma;
+	}
+
+	secure = kzalloc(struct_size(secure, owners, sgt->orig_nents), GFP_KERNEL);
+	if (!secure) {
+		ret = -ENOMEM;
+		goto free_dma;
+	}
+	secure->dev = get_device(dev);
+	secure->sgt = sgt;
+	secure->size = size;
+	for (i = 0; i < sgt->orig_nents; i++)
+		secure->owners[i] = BIT_ULL(QCOM_SCM_VMID_HLOS);
+
+	for_each_sg(sgt->sgl, sg, sgt->orig_nents, i) {
+		ret = qcom_scm_assign_mem(sg_phys(sg), sg->length,
+					  &secure->owners[i], &perm, 1);
+		if (ret) {
+			iris_secure_buffer_free(secure);
+			return ret;
+		}
+	}
+
+	buffer->secure = secure;
+	buffer->device_addr = address;
+	return 0;
+
+free_dma:
+	dma_free_noncontiguous(dev, size, sgt, DMA_BIDIRECTIONAL);
+	return ret;
+}
+
+static int iris_secure_memory_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct iommu_domain *domain = iommu_get_domain_for_dev(dev);
+	int ret;
+
+	if (!qcom_scm_is_available())
+		return -EPROBE_DEFER;
+	/* Never share the non-secure video device's IOVA domain. */
+	if (!domain || (domain->type != IOMMU_DOMAIN_DMA &&
+			domain->type != IOMMU_DOMAIN_DMA_FQ) ||
+	    domain == iommu_get_domain_for_dev(dev->parent))
+		return -EINVAL;
+
+	ret = dma_set_mask_and_coherent(dev, IRIS_SECURE_IOVA_END - 1);
+	if (ret)
+		return ret;
+	dma_set_max_seg_size(dev, DMA_BIT_MASK(32));
+	dma_set_seg_boundary(dev, DMA_BIT_MASK(32));
+	platform_set_drvdata(pdev, dev);
+
+	return 0;
+}
+
+static const struct of_device_id iris_secure_memory_match[] = {
+	{ .compatible = "qcom,sm8450-iris-cp-nonpixel" },
+	{ }
+};
+
+struct platform_driver iris_secure_memory_driver = {
+	.probe = iris_secure_memory_probe,
+	.driver = {
+		.name = "iris-cp-nonpixel",
+		.of_match_table = iris_secure_memory_match,
+		.suppress_bind_attrs = true,
+	},
+};
+
+static void iris_secure_memory_remove(void *data)
+{
+	of_platform_device_destroy(&((struct platform_device *)data)->dev, NULL);
+}
+
+int iris_secure_memory_init(struct iris_core *core)
+{
+	struct device_node *np;
+	struct platform_device *pdev;
+	int ret;
+
+	if (!core->iris_platform_data->requires_secure_arp)
+		return 0;
+
+	np = of_get_child_by_name(core->dev->of_node, "secure-nonpixel");
+	if (!np || !of_device_is_available(np)) {
+		of_node_put(np);
+		dev_warn(core->dev, "no secure non-pixel context; encoder disabled\n");
+		return 0;
+	}
+	pdev = of_platform_device_create(np, NULL, core->dev);
+	of_node_put(np);
+	if (!pdev)
+		return -ENODEV;
+
+	ret = devm_add_action_or_reset(core->dev, iris_secure_memory_remove, pdev);
+	if (ret)
+		return ret;
+	if (!platform_get_drvdata(pdev))
+		return -EPROBE_DEFER;
+
+	core->secure_pdev = pdev;
+	return 0;
+}
