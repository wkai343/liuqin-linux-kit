+/* Caller holds audio->lock and has an active, clocked mainlink. */
+static void msm_dp_audio_start(struct msm_dp_audio_private *audio)
+{
+	msm_dp_audio_setup_sdp(audio);
+	msm_dp_audio_setup_acr(audio);
+	msm_dp_audio_safe_to_exit_level(audio);
+	msm_dp_audio_enable(audio, true);
+	audio->enabled = true;
+}
+
+void msm_dp_audio_link_enable(struct msm_dp_audio *dp_audio, u32 bw_code,
+			      u32 lane_count)
+{
+	struct msm_dp_audio_private *audio;
+
+	audio = container_of(dp_audio, struct msm_dp_audio_private, msm_dp_audio);
+	guard(mutex)(&audio->lock);
+
+	dp_audio->bw_code = bw_code;
+	dp_audio->lane_count = lane_count;
+	audio->link_on = true;
+
+	/* Reapply SDP/ACR after a modeset, even if ALSA kept the PCM open. */
+	if (audio->prepared)
+		msm_dp_audio_start(audio);
+}
+
+void msm_dp_audio_link_disable(struct msm_dp_audio *dp_audio)
+{
+	struct msm_dp_audio_private *audio;
+
+	audio = container_of(dp_audio, struct msm_dp_audio_private, msm_dp_audio);
+	guard(mutex)(&audio->lock);
+
+	/* Quiesce the engine before PUSH_IDLE, PHY shutdown or clock removal. */
+	if (audio->enabled)
+		msm_dp_audio_enable(audio, false);
+	audio->enabled = false;
+	audio->link_on = false;
+}
