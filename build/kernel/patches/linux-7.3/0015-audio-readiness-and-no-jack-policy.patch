 }
 
+/* State replies carry one word, unlike BASIC_RSP_RESULT's two words. */
+static bool q6apm_state_response(struct q6apm *apm,
+			       const struct gpr_resp_pkt *data)
+{
+	if (data->hdr.opcode == APM_CMD_RSP_GET_SPF_STATE) {
+		if (data->payload_size < (int)sizeof(u32)) {
+			dev_warn_ratelimited(apm->dev, "short SPF state response\n");
+			return true;
+		}
+		WRITE_ONCE(apm->state, get_unaligned_le32(data->payload));
+		apm->result.opcode = data->hdr.opcode;
+		apm->result.status = 0;
+	} else if (data->hdr.opcode == GPR_BASIC_RSP_RESULT &&
+		   data->payload_size >= (int)sizeof(struct gpr_ibasic_rsp_result_t) &&
+		   get_unaligned_le32(data->payload) == APM_CMD_GET_SPF_STATE) {
+		u32 status = get_unaligned_le32(data->payload + sizeof(u32));
+
+		/* Preserve the old ACK behavior: only the state reply completes
+		 * a successful query. An explicit DSP error can complete it early.
+		 */
+		if (!status)
+			return true;
+		WRITE_ONCE(apm->state, APM_SPF_STATE_NOT_READY);
+		apm->result.opcode = APM_CMD_GET_SPF_STATE;
+		apm->result.status = status;
+	} else {
+		return false;
+	}
+	wake_up(&apm->wait);
+	return true;
+}
+
 static int apm_callback(const struct gpr_resp_pkt *data, void *priv, int op)
 {
 	gpr_device_t *gdev = priv;
