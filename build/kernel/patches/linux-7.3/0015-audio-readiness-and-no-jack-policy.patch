 bool q6apm_is_adsp_ready(void)
 {
-	if (g_apm)
-		return q6apm_get_apm_state(g_apm);
-
-	return false;
+	bool ready = false;
+
+	mutex_lock(&apm_ready_lock);
+	/* apr_device_probe installs this callback only after probe returns. */
+	if (g_apm && READ_ONCE(g_apm->gdev->svc.callback))
