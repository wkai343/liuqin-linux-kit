@@ -2594,7 +2597,7 @@ static int tx_macro_runtime_suspend(struct device *dev)
 
 	regcache_cache_only(tx->regmap, true);
 
-	ret = pm_clk_suspend(dev);
+	ret = tx_macro_set_clocks(tx, false);
 	if (ret) {
 		regcache_cache_only(tx->regmap, false);
 		return ret;
@@ -2610,7 +2613,7 @@ static int tx_macro_runtime_resume(struct device *dev)
 	struct tx_macro *tx = dev_get_drvdata(dev);
 	int ret;
 
-	ret = liuqin_audio_clk_resume(dev);
+	ret = tx_macro_set_clocks(tx, true);
 	if (ret) {
 		regcache_cache_only(tx->regmap, true);
 		regcache_mark_dirty(tx->regmap);
@@ -2622,7 +2625,7 @@ static int tx_macro_runtime_resume(struct device *dev)
 	if (ret) {
 		regcache_cache_only(tx->regmap, true);
 		regcache_mark_dirty(tx->regmap);
