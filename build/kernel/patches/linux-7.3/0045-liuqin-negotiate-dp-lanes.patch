+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -11,6 +11,7 @@
 #include <linux/delay.h>
 #include <linux/iopoll.h>
 #include <linux/phy/phy.h>
+#include <linux/platform_data/liuqin.h>
 #include <linux/phy/phy-dp.h>
 #include <linux/pm_opp.h>
 #include <linux/rational.h>
@@ -2038,6 +2039,11 @@ int msm_dp_ctrl_phy_init(struct msm_dp_ctrl *msm_dp_ctrl)
 	 * Conservative RBR/2-lane options here; the real link parameters are
 	 * applied later by msm_dp_ctrl_enable_mainlink_clocks().
 	 */
+	if (liuqin_board_quirks())
+		ctrl->phy_opts.dp = (struct phy_configure_opts_dp) {
+			.lanes = 2,
+			.link_rate = 1620,
+		};
 	if (!ctrl->phy_opts.dp.lanes)
 		ctrl->phy_opts.dp.lanes = 2;
 	if (!ctrl->phy_opts.dp.link_rate)
diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
index fbdcc3f..b4a8386 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -575,7 +575,8 @@ static int msm_dp_init_sub_modules(struct msm_dp_display_private *dp)
 		goto error_link;
 	}
 
-	dp->panel = msm_dp_panel_get(dev, dp->aux, dp->link, dp->link_base, dp->p0_base);
+	dp->panel = msm_dp_panel_get(dev, dp->aux, dp->link, phy,
+				      dp->link_base, dp->p0_base);
 	if (IS_ERR(dp->panel)) {
 		rc = PTR_ERR(dp->panel);
 		DRM_ERROR("failed to initialize panel, rc = %d\n", rc);
diff --git a/drivers/gpu/drm/msm/dp/dp_panel.c b/drivers/gpu/drm/msm/dp/dp_panel.c
index e76dad0..c16a3ca 100644
--- a/drivers/gpu/drm/msm/dp/dp_panel.c
+++ b/drivers/gpu/drm/msm/dp/dp_panel.c
@@ -13,6 +13,8 @@
 #include <drm/drm_print.h>
 
 #include <linux/io.h>
+#include <linux/phy/phy.h>
+#include <linux/platform_data/liuqin.h>
 #include <linux/types.h>
 #include <asm/byteorder.h>
 
@@ -24,6 +26,7 @@ struct msm_dp_panel_private {
 	struct msm_dp_panel msm_dp_panel;
 	struct drm_dp_aux *aux;
 	struct msm_dp_link *link;
+	struct phy *phy;
 	void __iomem *link_base;
 	void __iomem *p0_base;
 	bool panel_on;
@@ -85,7 +88,7 @@ static void msm_dp_panel_read_psr_cap(struct msm_dp_panel_private *panel)
 	}
 }
 
-static int msm_dp_panel_read_dpcd(struct msm_dp_panel *msm_dp_panel)
+static int msm_dp_panel_read_dpcd(struct msm_dp_panel *msm_dp_panel, bool is_edp)
 {
 	int rc, max_lttpr_lanes, max_lttpr_rate;
 	struct msm_dp_panel_private *panel;
@@ -197,6 +200,17 @@ static int msm_dp_panel_read_dpcd(struct msm_dp_panel *msm_dp_panel)
 	if (max_lttpr_lanes && max_lttpr_lanes < link_info->num_lanes)
 		link_info->num_lanes = max_lttpr_lanes;
 
+	if (!is_edp && liuqin_board_quirks()) {
+		union phy_configure_opts opts = { .dp.lanes = link_info->num_lanes };
+
+		/* The PHY knows which lanes the Type-C mux allocated to DP. */
+		if (phy_validate(panel->phy, PHY_MODE_DP, PHY_SUBMODE_DP, &opts))
+			opts.dp.lanes = min(opts.dp.lanes, 2U);
+		link_info->num_lanes = opts.dp.lanes;
+		dev_info(panel->dev, "DP: using %u lanes at up to %u kHz (sink: %u lanes)\n",
+			 link_info->num_lanes, link_info->rate, drm_dp_max_lane_count(dpcd));
+	}
+
 	drm_dbg_dp(panel->drm_dev, "version: %d.%d\n", major, minor);
 	drm_dbg_dp(panel->drm_dev, "link_rate=%d\n", link_info->rate);
 	drm_dbg_dp(panel->drm_dev, "link_rate_set=%d\n", link_info->rate_set);
@@ -246,7 +260,8 @@ int msm_dp_panel_read_link_caps(struct msm_dp_panel *msm_dp_panel,
 
 	panel = container_of(msm_dp_panel, struct msm_dp_panel_private, msm_dp_panel);
 
-	rc = msm_dp_panel_read_dpcd(msm_dp_panel);
+	rc = msm_dp_panel_read_dpcd(msm_dp_panel,
+				    connector->connector_type == DRM_MODE_CONNECTOR_eDP);
 	if (rc) {
 		DRM_ERROR("read dpcd failed %d\n", rc);
 		return rc;
@@ -699,7 +714,7 @@ int msm_dp_panel_init_panel_info(struct msm_dp_panel *msm_dp_panel,
 }
 
 struct msm_dp_panel *msm_dp_panel_get(struct device *dev, struct drm_dp_aux *aux,
-			      struct msm_dp_link *link,
+			      struct msm_dp_link *link, struct phy *phy,
 			      void __iomem *link_base,
 			      void __iomem *p0_base)
 {
@@ -718,6 +733,7 @@ struct msm_dp_panel *msm_dp_panel_get(struct device *dev, struct drm_dp_aux *aux
 	panel->dev = dev;
 	panel->aux = aux;
 	panel->link = link;
+	panel->phy = phy;
 	panel->link_base = link_base;
 	panel->p0_base = p0_base;
 
