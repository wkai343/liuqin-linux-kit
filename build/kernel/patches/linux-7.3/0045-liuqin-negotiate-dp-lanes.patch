diff --git a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
index 7898aa2..eed70aa 100644
--- a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
@@ -15,6 +15,7 @@
 #include <linux/of_address.h>
 #include <linux/of_graph.h>
 #include <linux/phy/phy.h>
+#include <linux/platform_data/liuqin.h>
 #include <linux/platform_device.h>
 #include <linux/regulator/consumer.h>
 #include <linux/reset.h>
@@ -2672,6 +2673,7 @@ struct qmp_combo {
 	struct mutex phy_mutex;
 	int init_count;
 	enum qmpphy_mode qmpphy_mode;
+	enum qmpphy_mode typec_mode;
 
 	struct phy *usb_phy;
 	enum phy_mode phy_mode;
@@ -4145,6 +4147,28 @@ static int qmp_v8_configure_dp_phy(struct qmp_combo *qmp)
 	return 0;
 }
 
+static unsigned int qmp_combo_dp_lane_limit(struct qmp_combo *qmp)
+{
+	lockdep_assert_held(&qmp->phy_mutex);
+
+	/* Both the requested and applied mux modes must permit four lanes. */
+	return qmp->typec_mode == QMPPHY_MODE_DP_ONLY &&
+	       qmp->qmpphy_mode == QMPPHY_MODE_DP_ONLY ? 4 : 2;
+}
+
+static int qmp_combo_dp_validate(struct phy *phy, enum phy_mode mode,
+				 int submode, union phy_configure_opts *opts)
+{
+	struct qmp_combo *qmp = phy_get_drvdata(phy);
+
+	if (mode != PHY_MODE_DP || submode != PHY_SUBMODE_DP || !liuqin_board_quirks())
+		return -EOPNOTSUPP;
+
+	guard(mutex)(&qmp->phy_mutex);
+	opts->dp.lanes = min(opts->dp.lanes, qmp_combo_dp_lane_limit(qmp));
+	return 0;
+}
+
 static int qmp_combo_dp_configure(struct phy *phy, union phy_configure_opts *opts)
 {
 	const struct phy_configure_opts_dp *dp_opts = &opts->dp;
@@ -4386,6 +4410,13 @@ static int qmp_combo_dp_power_on(struct phy *phy)
 
 	mutex_lock(&qmp->phy_mutex);
 
+	/* Recheck under the mux lock if the assignment changed since DPCD. */
+	if (qmp->dp_opts.lanes > 2 && liuqin_board_quirks() &&
+	    qmp->dp_opts.lanes > qmp_combo_dp_lane_limit(qmp)) {
+		mutex_unlock(&qmp->phy_mutex);
+		return -EAGAIN;
+	}
+
 	serdes_ret = qmp_combo_dp_serdes_init(qmp);
 	if (serdes_ret)
 		goto out_unlock;
@@ -4579,6 +4610,7 @@ static const struct phy_ops qmp_combo_usb_phy_ops = {
 static const struct phy_ops qmp_combo_dp_phy_ops = {
 	.init		= qmp_combo_dp_init,
 	.configure	= qmp_combo_dp_configure,
+	.validate	= qmp_combo_dp_validate,
 	.power_on	= qmp_combo_dp_power_on,
 	.calibrate	= qmp_combo_dp_calibrate,
 	.power_off	= qmp_combo_dp_power_off,
@@ -5066,6 +5098,8 @@ static int qmp_combo_typec_mux_set(struct typec_mux_dev *mux, struct typec_mux_s
 		new_mode = QMPPHY_MODE_USB3_ONLY;
 	}
 
+	qmp->typec_mode = new_mode;
+
 	if (new_mode == qmp->qmpphy_mode) {
 		dev_dbg(qmp->dev, "typec_mux_set: same qmpphy mode, bail out\n");
 		return 0;
