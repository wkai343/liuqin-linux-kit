+	if (!liuqin_can_multi_refresh(ctx))
+		return 0;
+	if (ctx->refresh_status)
+		return ctx->refresh_status > 0 ? 0 : ctx->refresh_status;
+	rate = ctx->dsi[0]->host->ops->get_refresh_rate(ctx->dsi[0]->host);
+	other = ctx->dsi[1]->host->ops->get_refresh_rate(ctx->dsi[1]->host);
+	if (rate != other) {
+		ctx->refresh_status = -EINVAL;
+		return -EINVAL;
+	}
