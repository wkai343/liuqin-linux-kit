+static void dpu_kms_try_live_modeset(struct msm_kms *kms, struct drm_atomic_commit *state)
+{
+	struct dpu_kms *dpu_kms = to_dpu_kms(kms);
+	struct drm_private_state *old_resources, *new_resources;
+	struct dpu_global_state *old_dpu, *new_dpu;
+	struct drm_crtc_state *old, *new;
+	struct drm_crtc *crtc;
+	struct drm_encoder *encoder;
+	struct drm_connector *connector;
+	struct drm_connector_state *old_conn, *new_conn;
+	int i;
+
+	/* ABL may rewrite the root compatible. The panel opts both hosts in. */
+	if (!msm_dsi_live_vfp_supported(kms->dsi[0]))
+		return;
+
+	for_each_oldnew_crtc_in_state(state, crtc, old, new, i) {
+		if (!new->mode_changed || !old->active || !new->active)
+			continue;
+		drm_info(crtc->dev, "Liuqin live attempt: old=%d new=%d clocks=%d/%d totals=%dx%d/%dx%d\n",
+			 drm_mode_vrefresh(&old->adjusted_mode), drm_mode_vrefresh(&new->adjusted_mode),
+			 old->adjusted_mode.clock, new->adjusted_mode.clock,
+			 old->adjusted_mode.htotal, old->adjusted_mode.vtotal,
+			 new->adjusted_mode.htotal, new->adjusted_mode.vtotal);
+		if (!liuqin_live_refresh_mode(&old->adjusted_mode) ||
+		    !liuqin_live_refresh_mode(&new->adjusted_mode) ||
+		    drm_mode_equal(&old->adjusted_mode, &new->adjusted_mode)) {
+			drm_info(crtc->dev, "Liuqin live reject: stage=kms reason=mode-profile\n");
+			continue;
+		}
+
+		if (!old->enable || !new->enable ||
+		    !old->active || !new->active ||
+		    old->self_refresh_active || new->self_refresh_active ||
+		    new->active_changed || new->connectors_changed ||
+		    new->color_mgmt_changed ||
+		    old->connector_mask != new->connector_mask ||
+		    hweight32(new->connector_mask) != 1 ||
+		    old->encoder_mask != new->encoder_mask ||
+		    hweight32(new->encoder_mask) != 1) {
+			drm_info(crtc->dev, "Liuqin live reject: stage=kms reason=crtc-state enable=%d/%d self_refresh=%d/%d changes=%d/%d/%d connectors=%#x/%#x encoders=%#x/%#x\n",
+				 old->enable, new->enable, old->self_refresh_active, new->self_refresh_active,
+				 new->active_changed, new->connectors_changed, new->color_mgmt_changed,
+				 old->connector_mask, new->connector_mask, old->encoder_mask, new->encoder_mask);
+			continue;
+		}
+
+		old_resources = drm_atomic_get_old_private_obj_state(state, &dpu_kms->global_state);
+		new_resources = drm_atomic_get_new_private_obj_state(state, &dpu_kms->global_state);
+		if (!old_resources || !new_resources) {
+			drm_info(crtc->dev, "Liuqin live reject: stage=kms reason=missing-dpu-state\n");
+			continue;
+		}
+		old_dpu = to_dpu_global_state(old_resources);
+		new_dpu = to_dpu_global_state(new_resources);
+		if (memcmp(&old_dpu->pingpong_to_crtc_id, &new_dpu->pingpong_to_crtc_id,
+			   sizeof(*old_dpu) - offsetof(struct dpu_global_state, pingpong_to_crtc_id))) {
+			drm_info(crtc->dev, "Liuqin live reject: stage=kms reason=dpu-resources\n");
+			continue;
+		}
+
+		drm_for_each_encoder_mask(encoder, crtc->dev, new->encoder_mask) {
+			if (encoder->encoder_type != DRM_MODE_ENCODER_DSI)
+				continue;
+			connector = drm_atomic_get_new_connector_for_encoder(state, encoder);
+			if (!connector) {
+				drm_info(crtc->dev, "Liuqin live reject: stage=kms reason=missing-connector\n");
+				continue;
+			}
+			old_conn = drm_atomic_get_old_connector_state(state, connector);
+			new_conn = drm_atomic_get_new_connector_state(state, connector);
+			if (!old_conn || !new_conn || old_conn->crtc != crtc ||
+			    new_conn->crtc != crtc ||
+			    old_conn->best_encoder != new_conn->best_encoder) {
+				drm_info(crtc->dev, "Liuqin live reject: stage=kms reason=connector-state\n");
+				continue;
+			}
+			if (dpu_encoder_live_refresh(encoder, &old->adjusted_mode,
+					     &new->adjusted_mode)) {
+				new->mode_changed = false;
+				drm_info(crtc->dev, "Liuqin: live refresh %d Hz\n",
+					 drm_mode_vrefresh(&new->adjusted_mode));
+			}
+		}
+	}
+}
