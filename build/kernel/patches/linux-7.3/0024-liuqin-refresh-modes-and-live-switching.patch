diff --git a/include/drm/drm_liuqin.h b/include/drm/drm_liuqin.h
new file mode 100644
index 000000000..e749babaf
--- /dev/null
+++ b/include/drm/drm_liuqin.h
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __DRM_LIUQIN_H__
+#define __DRM_LIUQIN_H__
+
+#include <drm/drm_modes.h>
+
+/* Exact M81 profiles from the pinned ROM, at one fixed DSC link clock. */
+static inline bool liuqin_live_refresh_mode(const struct drm_display_mode *m)
+{
+	int hfp, vfp;
+
+	switch (m->clock) {
+	case 785245:
+		hfp = 200;
+		if (m->vtotal == 3122)
+			vfp = 26;
+		else if (m->vtotal == 6244)
+			vfp = 3148;
+		else
+			return false;
+		break;
+	case 874197:
+		hfp = 52;
+		vfp = 26;
+		break;
+	case 672478:
+		hfp = 500;
+		vfp = 26;
+		break;
+	default:
+		return false;
+	}
+
+	return m->hdisplay == 1800 && m->hsync_start == 1800 + hfp &&
+	       m->hsync_end == 1804 + hfp && m->htotal == 1896 + hfp &&
+	       m->vdisplay == 2880 && m->vsync_start == 2880 + vfp &&
+	       m->vsync_end == 2882 + vfp && m->vtotal == 3096 + vfp &&
+	       !m->flags && !m->hskew && !m->vscan;
+}
+
+/* Bonded link, 900 active pixels compressed to 300 pixel clocks. */
+static inline unsigned int liuqin_line_clocks(const struct drm_display_mode *m)
+{
+	return (m->htotal - m->hdisplay) / 2 + 300;
+}
+
+#endif
