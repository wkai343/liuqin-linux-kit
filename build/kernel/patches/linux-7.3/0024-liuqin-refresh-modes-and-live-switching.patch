+bool dpu_hw_intf_live_timing_matches(struct dpu_hw_intf *intf,
+				   const struct drm_display_mode *mode)
+{
+	u32 line = liuqin_line_clocks(mode);
+	const struct { u32 reg, mask, expected; } checks[] = {
+		{ INTF_TIMING_ENGINE_EN, ~0U, 1 },
+		{ INTF_CONFIG, BIT(31) | INTF_CFG_ACTIVE_H_EN | INTF_CFG_ACTIVE_V_EN, 0 },
+		{ INTF_HSYNC_SKEW, ~0U, 0 },
+		{ INTF_HSYNC_CTL, ~0U, (line << 16) | 2 },
+		{ INTF_VSYNC_PERIOD_F0, ~0U, line * mode->vtotal },
+		{ INTF_VSYNC_PULSE_WIDTH_F0, ~0U, line * 2 },
+		{ INTF_DISPLAY_V_START_F0, ~0U, line * 216 },
+		{ INTF_DISPLAY_V_END_F0, ~0U, line * 3096 - 1 },
+		{ INTF_DISPLAY_HCTL, ~0U, (347 << 16) | 48 },
+	};
+	unsigned int i;
+	u32 value;
+
+	for (i = 0; i < ARRAY_SIZE(checks); i++) {
+		value = DPU_REG_READ(&intf->hw, checks[i].reg);
+		if ((value & checks[i].mask) != checks[i].expected) {
+			pr_info("Liuqin live reject: stage=intf intf=%d reg=%#x actual=%#x mask=%#x expected=%#x rate=%d\n",
+				intf->idx - INTF_0, checks[i].reg, value,
+				checks[i].mask, checks[i].expected, drm_mode_vrefresh(mode));
+			return false;
+		}
+	}
+	return true;
+}
+
+void dpu_hw_intf_live_timing_write(struct dpu_hw_intf *intf,
+				 const struct drm_display_mode *mode)
+{
+	u32 line = liuqin_line_clocks(mode);
+
+	DPU_REG_WRITE(&intf->hw, INTF_HSYNC_CTL, (line << 16) | 2);
+	DPU_REG_WRITE(&intf->hw, INTF_VSYNC_PERIOD_F0, line * mode->vtotal);
+	DPU_REG_WRITE(&intf->hw, INTF_VSYNC_PULSE_WIDTH_F0, line * 2);
+	DPU_REG_WRITE(&intf->hw, INTF_DISPLAY_V_START_F0, line * 216);
+	DPU_REG_WRITE(&intf->hw, INTF_DISPLAY_V_END_F0, line * 3096 - 1);
+}
+
+u32 dpu_hw_intf_frame_count(struct dpu_hw_intf *intf)
+{
+	return DPU_REG_READ(&intf->hw, INTF_FRAME_COUNT);
+}
+
+u32 dpu_hw_intf_read_vperiod(struct dpu_hw_intf *intf)
+{
+	return DPU_REG_READ(&intf->hw, INTF_VSYNC_PERIOD_F0);
+}
+
+void dpu_hw_intf_write_vperiod(struct dpu_hw_intf *intf, u32 period)
+{
+	DPU_REG_WRITE(&intf->hw, INTF_VSYNC_PERIOD_F0, period);
