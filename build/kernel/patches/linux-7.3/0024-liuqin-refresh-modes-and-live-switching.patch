 /* ABL may replace compatible with generic cape identifiers. */
 static inline bool liuqin_board_quirks(void)
@@ -15,4 +18,66 @@ static inline bool liuqin_board_quirks(void)
 		!of_property_read_u32_array(of_root, "xiaomi,miboard-id", id, 2) &&
 		id[0] == 0x10 && id[1] == 0;
 }
+
+enum liuqin_panel {
+	LIUQIN_PANEL_UNKNOWN = -1,
+	LIUQIN_PANEL_TIANMA,
+	LIUQIN_PANEL_CSOT,
+};
+
+/* Only ABL's primary-display token identifies the fitted panel. */
+static inline enum liuqin_panel liuqin_panel_from_bootargs(const char *args)
+{
+	static const char key[] = "msm_drm.dsi_display0=";
+	static const char * const names[] = {
+		[LIUQIN_PANEL_TIANMA] = "qcom,mdss_dsi_m81_36_02_0a_dualdsi_dsc_lcd_video",
+		[LIUQIN_PANEL_CSOT] = "qcom,mdss_dsi_m81_42_02_0b_dualdsi_dsc_lcd_video",
+	};
+	enum liuqin_panel selected = LIUQIN_PANEL_UNKNOWN;
+
+	if (!args)
+		return selected;
+
+	while (*args) {
+		const char *end, *name, *colon;
+		size_t length, i;
+
+		while (isspace((unsigned char)*args))
+			args++;
+		if (!*args)
+			break;
+		end = args;
+		while (*end && !isspace((unsigned char)*end))
+			end++;
+		if ((size_t)(end - args) < sizeof(key) - 1 ||
+		    strncmp(args, key, sizeof(key) - 1)) {
+			args = end;
+			continue;
+		}
+
+		name = args + sizeof(key) - 1;
+		colon = memchr(name, ':', end - name);
+		length = (colon ? colon : end) - name;
+		for (i = 0; i < ARRAY_SIZE(names); i++) {
+			if (strlen(names[i]) == length && !strncmp(name, names[i], length))
+				break;
+		}
+		if (i == ARRAY_SIZE(names) ||
+		    (selected != LIUQIN_PANEL_UNKNOWN && selected != (enum liuqin_panel)i))
+			return LIUQIN_PANEL_UNKNOWN;
+		selected = i;
+		args = end;
+	}
+	return selected;
+}
+
+static inline enum liuqin_panel liuqin_boot_panel(void)
+{
+	const char *args;
+
+	if (of_property_read_string(of_chosen, "bootargs", &args))
+		return LIUQIN_PANEL_UNKNOWN;
+
+	return liuqin_panel_from_bootargs(args);
+}
 #endif
