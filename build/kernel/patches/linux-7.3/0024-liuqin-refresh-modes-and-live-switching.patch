diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_ctl.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_ctl.c
index e8729fe1c..ff54992bb 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_ctl.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_ctl.c
@@ -140,6 +140,21 @@ static u32 dpu_hw_ctl_get_pending_flush(struct dpu_hw_ctl *ctx)
 	return ctx->pending_flush_mask;
 }
 
+bool dpu_hw_ctl_can_flush_intfs(struct dpu_hw_ctl *ctx, u32 mask)
+{
+	return DPU_REG_READ(&ctx->hw, CTL_INTF_ACTIVE) == mask &&
+	       !DPU_REG_READ(&ctx->hw, CTL_FLUSH);
+}
+
+void dpu_hw_ctl_flush_intfs(struct dpu_hw_ctl *ctx, u32 mask)
+{
+	/* Leave the pending plane flush bitmap to the normal atomic kickoff. */
+	wmb(); /* Order both interface timing writes before the latch. */
+	DPU_REG_WRITE(&ctx->hw, CTL_INTF_FLUSH, mask);
+	wmb();
+	DPU_REG_WRITE(&ctx->hw, CTL_FLUSH, BIT(INTF_IDX));
+}
+
 static inline void dpu_hw_ctl_trigger_flush_v1(struct dpu_hw_ctl *ctx)
 {
 	int dspp;
