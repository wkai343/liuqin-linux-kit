+static int liuqin_get_modes(struct nt36532 *ctx, struct drm_connector *connector)
+{
+	const struct drm_display_mode *base = &liuqin_mode_120;
+	struct drm_display_mode *mode;
+	unsigned int i, compressed_total;
+
+	for (i = 0; i < ARRAY_SIZE(liuqin_refresh_modes); i++) {
+		/* Long-VFP modes still show flicker and panel faults on hardware. */
+		if (!liuqin_refresh_allowed(ctx, liuqin_refresh_modes[i].rate))
+			break;
+		mode = drm_mode_duplicate(connector->dev, base);
+		if (!mode)
+			break;
+		mode->hsync_start = mode->hdisplay + liuqin_refresh_modes[i].hfp;
+		mode->hsync_end = mode->hsync_start + 4;
+		mode->htotal = mode->hsync_end + 92;
+		mode->vsync_start = mode->vdisplay + liuqin_refresh_modes[i].vfp;
+		mode->vsync_end = mode->vsync_start + 2;
+		mode->vtotal = mode->vsync_end + 214;
+		compressed_total = mode->htotal - mode->hdisplay + 600;
+		mode->clock = DIV_ROUND_CLOSEST_ULL(1007032320ULL * mode->htotal,
+						    3000ULL * compressed_total);
+		if (!i)
+			mode->type |= DRM_MODE_TYPE_PREFERRED;
+		drm_mode_set_name(mode);
+		drm_mode_probed_add(connector, mode);
+	}
+	if (i) {
+		connector->display_info.width_mm = base->width_mm;
+		connector->display_info.height_mm = base->height_mm;
+	}
