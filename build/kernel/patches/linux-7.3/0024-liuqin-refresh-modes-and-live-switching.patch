+	const unsigned long tolerance = 100; /* Less than one ppm; PLL rounding only. */
+	unsigned long actual_pixel, actual_byte;
+	u32 ctrl, db;
+
+	if (!h->power_on || !h->enabled || !h->mode ||
+	    !(h->mode_flags & MIPI_DSI_MODE_LIVE_VFP) ||
+	    !drm_mode_equal(h->mode, old) || h->lanes != 4 || !h->dsc ||
+	    h->dsc->bits_per_component != 8 || h->dsc->bits_per_pixel != (8 << 4)) {
