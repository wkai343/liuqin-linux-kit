From: Liuqin Linux Kit contributors <build@liuqin.invalid>
Subject: [PATCH] drm/input: coordinate M81 refresh modes and live switching

Use the OEM M81 HFP/VFP tables, with 120 Hz preferred and the same qualified
DSC-adjusted link-clock request for every mode. Schedule DSI command DMA
against the running video timing with guarded scanline margins. Match the
panel B3/B2 scan commands to both host rates before declaring display ready
for touch; reject mismatches and partial-command replay.

Use the exact ABL primary-panel identity for both display and touch firmware
selection. Support guarded Tianma and CSOT 60/90/120/144 Hz transitions
without restarting the panel or reloading touch firmware on success.
Admit only one active CRTC with unchanged resources, both bonded SM8450
DSI hosts, matching hardware timings and common running clocks. Ignore
disabled CRTCs. Check running clocks against the M81 target and cache
without depending on a repeated clk_round_rate().

Use the VFP-only path for 120/60 Hz. Other pairs stage both DSI video
timings and the corresponding DPU registers, then send OEM B3/B2 scan
commands before waiting for frame and flush completion. Retain old host
caches while scheduling commands. Serialize against blanking and TDDI
recovery, check readback, and publish caches only after confirmation.
Keep a 2000-2010 us panel-vsync margin and write barrier before disabling
each host's timing double buffer, including programmed failure cleanup.
Log rejection reasons and fall back to full modesetting on failure.

Retain separate liuqin_live_60, liuqin_live_60_csot and liuqin_live_all
controls, all enabled by desktop boot arguments. Preserve diagnostic
low-refresh modes and panel-specific wake behavior. CSOT support still
lacks hardware validation; this consolidation changes no source behavior.

Combines the local command-DMA scheduling, refresh-mode table and guarded
four-rate live-switching patches. References:
- MiCode kernel_devicetree liuqin-t-oss at
  1c507816ba8aa6117dcec41f577ef7a66d2091f7, primary-panel identity.
- OS2.0.6.0.VMYCNXM dtbo.img entry 15 and msm_drm.ko, M81 timings and commands.
  DTBO SHA256:
  5e0377c7781e57f65c474f20edf3d7fb61f03f6030ca170e4edc29467a7993dd
  msm_drm.ko SHA256:
  3079f8d315440d34d58a57de82d31e42b8bc4ff01b5cd64bf141a4c5dfb1d7ba
- lineage-24.0-20261022-UNOFFICIAL-liuqin.zip, SHA256
  f2b79cdf443e41300fef26b2d497ae40376a0d32a68e4d32e6baecb810cf36a8;
  DTBO entry 32 and vendor_dlkm msm_drm.ko, SHA256
  d5ac950c380361a7ab3b63fcc4e46b6d436deb64af49cad1b7329e52105fb8e1.
- Qualcomm display-drivers at
  e7ab2aa8bd2f6f27b311ccada3722d20dee4bcef, DFPS and timing updates;
  LineageOS SM8450 modules at 3b30ba7df6608c97c0ba2d55d679a6b5987c4c66,
  per-host timing-buffer exit wait, cross-checked against the M81 module.

diff --git a/drivers/gpu/drm/bridge/panel.c b/drivers/gpu/drm/bridge/panel.c
index c815a045f..aff28942f 100644
--- a/drivers/gpu/drm/bridge/panel.c
+++ b/drivers/gpu/drm/bridge/panel.c
@@ -262,6 +262,75 @@ void drm_panel_bridge_complete_first_frame(struct drm_bridge *bridge,
 }
 EXPORT_SYMBOL(drm_panel_bridge_complete_first_frame);
 
+/**
+ * drm_panel_bridge_live_refresh_begin - lock and validate an active panel
+ * @bridge: panel bridge
+ * @old: current mode
+ * @new: requested mode
+ *
+ * Return: Zero with backlight_lock held, or an error without any lock held.
+ * Every success must be paired with drm_panel_bridge_live_refresh_end().
+ */
+int drm_panel_bridge_live_refresh_begin(struct drm_bridge *bridge,
+				       const struct drm_display_mode *old,
+				       const struct drm_display_mode *new)
+{
+	struct drm_panel *panel;
+	int ret = -EOPNOTSUPP;
+
+	if (!drm_bridge_is_panel(bridge))
+		return ret;
+	panel = drm_bridge_to_panel_bridge(bridge)->panel;
+	if (!panel->funcs || !panel->funcs->prepare_live_refresh ||
+	    !panel->funcs->apply_live_refresh) {
+		dev_info(panel->dev, "Liuqin live reject: stage=bridge reason=missing-callback\n");
+		return ret;
+	}
+
+	mutex_lock(&panel->backlight_lock);
+	if (panel->prepared && panel->enabled && !panel->backlight_pending)
+		ret = panel->funcs->prepare_live_refresh(panel, old, new);
+	else
+		dev_info(panel->dev, "Liuqin live reject: stage=bridge prepared=%d enabled=%d pending=%d\n",
+			 panel->prepared, panel->enabled, panel->backlight_pending);
+	if (ret)
+		mutex_unlock(&panel->backlight_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(drm_panel_bridge_live_refresh_begin);
+
+/**
+ * drm_panel_bridge_live_refresh_apply - send scan commands before timing latch
+ * @bridge: bridge successfully locked by live_refresh_begin
+ * @old: previous mode
+ * @new: pending mode whose host timing has been submitted
+ *
+ * Keeps backlight_lock held. The host command lock must be released.
+ */
+int drm_panel_bridge_live_refresh_apply(struct drm_bridge *bridge,
+				       const struct drm_display_mode *old,
+				       const struct drm_display_mode *new)
+{
+	struct drm_panel *panel = drm_bridge_to_panel_bridge(bridge)->panel;
+
+	lockdep_assert_held(&panel->backlight_lock);
+	return panel->funcs->apply_live_refresh(panel, old, new);
+}
+EXPORT_SYMBOL_GPL(drm_panel_bridge_live_refresh_apply);
+
+/**
+ * drm_panel_bridge_live_refresh_end - release the running-panel transaction
+ * @bridge: bridge successfully locked by live_refresh_begin
+ */
+void drm_panel_bridge_live_refresh_end(struct drm_bridge *bridge)
+{
+	struct drm_panel *panel = drm_bridge_to_panel_bridge(bridge)->panel;
+
+	lockdep_assert_held(&panel->backlight_lock);
+	mutex_unlock(&panel->backlight_lock);
+}
+EXPORT_SYMBOL_GPL(drm_panel_bridge_live_refresh_end);
+
 /**
  * drm_panel_bridge_add - Creates a &drm_bridge and &drm_connector that
  * just calls the appropriate functions from &drm_panel.
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
index 1f20695f8..7eba350d9 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
@@ -10,9 +10,12 @@
 #define pr_fmt(fmt)	"[drm:%s:%d] " fmt, __func__, __LINE__
 #include <linux/debugfs.h>
 #include <linux/kthread.h>
+#include <linux/iopoll.h>
 #include <linux/seq_file.h>
 
+#include <drm/drm_liuqin.h>
 #include <drm/drm_atomic.h>
+#include <drm/drm_bridge.h>
 #include <drm/drm_crtc.h>
 #include <drm/drm_file.h>
 #include <drm/drm_probe_helper.h>
@@ -540,6 +543,30 @@ int dpu_encoder_get_vsync_count(struct drm_encoder *drm_enc)
 	return phys ? atomic_read(&phys->vsync_cnt) : 0;
 }
 
+/* Read both existing INTF mappings; never map physical addresses from DSI. */
+int dpu_encoder_get_cmd_linecounts(struct drm_encoder *encoder, u32 lines[2])
+{
+	struct dpu_encoder_virt *enc;
+	struct dpu_encoder_phys *phys;
+	int i;
+
+	if (!encoder || !lines)
+		return -EINVAL;
+	enc = to_dpu_encoder_virt(encoder);
+	if (enc->num_phys_encs != 2)
+		return -EOPNOTSUPP;
+	for (i = 0; i < 2; i++) {
+		phys = enc->phys_encs[i];
+		if (!phys || phys->intf_mode != INTF_MODE_VIDEO ||
+		    !phys->hw_intf || !phys->hw_intf->ops.get_line_count)
+			return -EOPNOTSUPP;
+		if (phys->enable_state != DPU_ENC_ENABLED)
+			return -EAGAIN;
+		lines[i] = phys->hw_intf->ops.get_line_count(phys->hw_intf);
+	}
+	return 0;
+}
+
 /**
  * dpu_encoder_get_linecount - get interface line count for the encoder.
  * @drm_enc:    Pointer to previously created drm encoder structure
@@ -1148,6 +1175,247 @@ void dpu_encoder_cleanup_wb_job(struct drm_encoder *drm_enc,
 	}
 }
 
+/* Both links must be near the start of the same frame. */
+static bool dpu_live_vfp_in_window(struct dpu_hw_intf *left, struct dpu_hw_intf *right)
+{
+	u32 a = left->ops.get_line_count(left);
+	u32 b = right->ops.get_line_count(right);
+
+	return a > 30 && a < 180 && b > 30 && b < 180;
+}
+
+bool dpu_encoder_live_vfp(struct drm_encoder *encoder,
+			  const struct drm_display_mode *old,
+			  const struct drm_display_mode *new)
+{
+	const u32 line_clocks = 448;
+	const u32 intf_mask = BIT(INTF_1 - INTF_0) | BIT(INTF_2 - INTF_0);
+	struct dpu_encoder_virt *enc = to_dpu_encoder_virt(encoder);
+	struct dpu_encoder_phys *left, *right;
+	struct dpu_hw_intf *intf0, *intf1;
+	struct dpu_hw_ctl *ctl;
+	unsigned long flags;
+	bool ready;
+	int ret;
+
+	if (!enc->enabled || enc->num_phys_encs != 2 || enc->intfs_swapped ||
+	    enc->disp_info.intf_type != INTF_DSI || enc->disp_info.is_cmd_mode ||
+	    !enc->dsc) {
+		drm_info(encoder->dev, "Liuqin: live refresh skipped: encoder topology\n");
+		return false;
+	}
+
+	left = enc->phys_encs[0];
+	right = enc->phys_encs[1];
+	ctl = left->hw_ctl;
+	intf0 = left->hw_intf;
+	intf1 = right->hw_intf;
+	if (!ctl || ctl != right->hw_ctl || !intf0 || !intf1 ||
+	    intf0->idx != INTF_1 || intf1->idx != INTF_2 ||
+	    left->enable_state != DPU_ENC_ENABLED || right->enable_state != DPU_ENC_ENABLED ||
+	    !drm_mode_equal(&left->cached_mode, old) ||
+	    !drm_mode_equal(&right->cached_mode, old) ||
+	    dpu_hw_intf_read_vperiod(intf0) != old->vtotal * line_clocks ||
+	    dpu_hw_intf_read_vperiod(intf1) != old->vtotal * line_clocks ||
+	    !dpu_hw_ctl_can_flush_intfs(ctl, intf_mask)) {
+		drm_info(encoder->dev, "Liuqin: live refresh skipped: DPU hardware not ready\n");
+		return false;
+	}
+
+	if (!msm_dsi_live_vfp_begin(left->dpu_kms->base.dsi[0], old)) {
+		drm_info(encoder->dev, "Liuqin: live refresh skipped: DSI hosts not ready\n");
+		return false;
+	}
+
+	ret = read_poll_timeout(dpu_live_vfp_in_window, ready, ready,
+				20, 22000, false, intf0, intf1);
+	spin_lock_irqsave(&enc->enc_spinlock, flags);
+	if (ret || !dpu_live_vfp_in_window(intf0, intf1) ||
+	    !dpu_hw_ctl_can_flush_intfs(ctl, intf_mask)) {
+		spin_unlock_irqrestore(&enc->enc_spinlock, flags);
+		msm_dsi_live_vfp_end(false, NULL);
+		drm_info(encoder->dev, "Liuqin: live refresh skipped: missed frame window\n");
+		return false;
+	}
+
+	msm_dsi_live_vfp_write(new->vtotal);
+	dpu_hw_intf_write_vperiod(intf0, new->vtotal * line_clocks);
+	dpu_hw_intf_write_vperiod(intf1, new->vtotal * line_clocks);
+	dpu_hw_ctl_flush_intfs(ctl, intf_mask);
+	spin_unlock_irqrestore(&enc->enc_spinlock, flags);
+
+	ret = read_poll_timeout(dpu_hw_ctl_can_flush_intfs, ready, ready,
+				100, 24000, false, ctl, intf_mask);
+	if (ret || dpu_hw_intf_read_vperiod(intf0) != new->vtotal * line_clocks ||
+	    dpu_hw_intf_read_vperiod(intf1) != new->vtotal * line_clocks)
+		new = NULL;
+	if (!msm_dsi_live_vfp_end(true, new)) {
+		drm_warn(encoder->dev, "Liuqin: live timing not confirmed, using full modeset\n");
+		return false;
+	}
+
+	drm_mode_copy(&left->cached_mode, new);
+	drm_mode_copy(&right->cached_mode, new);
+	return true;
+}
+
+/* Require both links to have crossed the latch boundary before using new caches. */
+static bool dpu_live_refresh_latched(struct dpu_hw_ctl *ctl, u32 mask,
+				     struct dpu_hw_intf *left, struct dpu_hw_intf *right,
+				     u32 frame0, u32 frame1)
+{
+	return dpu_hw_ctl_can_flush_intfs(ctl, mask) &&
+	       dpu_hw_intf_frame_count(left) != frame0 &&
+	       dpu_hw_intf_frame_count(right) != frame1;
+}
+
+static bool dpu_encoder_live_hfp(struct drm_encoder *encoder,
+				 struct drm_bridge *panel_bridge,
+				 const struct drm_display_mode *old,
+				 const struct drm_display_mode *new)
+{
+	const u32 intf_mask = BIT(INTF_1 - INTF_0) | BIT(INTF_2 - INTF_0);
+	struct dpu_encoder_virt *enc = to_dpu_encoder_virt(encoder);
+	struct dpu_encoder_phys *left, *right;
+	struct dpu_hw_intf *intf0, *intf1;
+	struct dpu_hw_ctl *ctl;
+	unsigned long flags;
+	u32 frame0, frame1;
+	bool ready;
+	int ret;
+
+	if (!enc->enabled || enc->num_phys_encs != 2 || enc->intfs_swapped ||
+	    enc->disp_info.intf_type != INTF_DSI || enc->disp_info.is_cmd_mode ||
+	    !enc->dsc || enc->dsc->bits_per_component != 8 ||
+	    enc->dsc->bits_per_pixel != (8 << 4)) {
+		drm_info(encoder->dev, "Liuqin live reject: stage=encoder enabled=%d phys=%u swapped=%d intf=%d cmd=%d bpc=%u bpp=%u\n",
+			 enc->enabled, enc->num_phys_encs, enc->intfs_swapped,
+			 enc->disp_info.intf_type, enc->disp_info.is_cmd_mode,
+			 enc->dsc ? enc->dsc->bits_per_component : 0,
+			 enc->dsc ? enc->dsc->bits_per_pixel : 0);
+		return false;
+	}
+
+	left = enc->phys_encs[0];
+	right = enc->phys_encs[1];
+	ctl = left->hw_ctl;
+	intf0 = left->hw_intf;
+	intf1 = right->hw_intf;
+	if (!ctl || ctl != right->hw_ctl || !intf0 || !intf1 ||
+	    intf0->idx != INTF_1 || intf1->idx != INTF_2 ||
+	    left->enable_state != DPU_ENC_ENABLED || right->enable_state != DPU_ENC_ENABLED ||
+	    !drm_mode_equal(&left->cached_mode, old) ||
+	    !drm_mode_equal(&right->cached_mode, old) ||
+	    !dpu_hw_intf_live_timing_matches(intf0, old) ||
+	    !dpu_hw_intf_live_timing_matches(intf1, old) ||
+	    !dpu_hw_ctl_can_flush_intfs(ctl, intf_mask)) {
+		drm_info(encoder->dev, "Liuqin live reject: stage=dpu-state ctl=%d pair=%d intfs=%d/%d states=%d/%d cached=%d/%d\n",
+			 !!ctl, ctl == right->hw_ctl, intf0 ? intf0->idx : -1,
+			 intf1 ? intf1->idx : -1, left->enable_state, right->enable_state,
+			 drm_mode_equal(&left->cached_mode, old),
+			 drm_mode_equal(&right->cached_mode, old));
+		return false;
+	}
+
+	if (!msm_dsi_live_hfp_begin(left->dpu_kms->base.dsi[0], old)) {
+		drm_info(encoder->dev, "Liuqin live reject: stage=encoder reason=dsi-not-ready\n");
+		return false;
+	}
+
+	/* The active raster starts at line 216 in every admitted profile. */
+	ret = read_poll_timeout(dpu_live_vfp_in_window, ready, ready,
+				20, 22000, false, intf0, intf1);
+	spin_lock_irqsave(&enc->enc_spinlock, flags);
+	if (ret || !dpu_live_vfp_in_window(intf0, intf1) ||
+	    !dpu_hw_ctl_can_flush_intfs(ctl, intf_mask)) {
+		spin_unlock_irqrestore(&enc->enc_spinlock, flags);
+		msm_dsi_live_hfp_release();
+		msm_dsi_live_hfp_end(false, NULL);
+		drm_info(encoder->dev, "Liuqin live reject: stage=window ret=%d lines=%u/%u\n",
+			 ret, intf0->ops.get_line_count(intf0), intf1->ops.get_line_count(intf1));
+		return false;
+	}
+	frame0 = dpu_hw_intf_frame_count(intf0);
+	frame1 = dpu_hw_intf_frame_count(intf1);
+	msm_dsi_live_hfp_write(new);
+	dpu_hw_intf_live_timing_write(intf0, new);
+	dpu_hw_intf_live_timing_write(intf1, new);
+	dpu_hw_ctl_flush_intfs(ctl, intf_mask);
+	spin_unlock_irqrestore(&enc->enc_spinlock, flags);
+
+	msm_dsi_live_hfp_release();
+	/* Downstream M81 sends its FPS scan group at kickoff, before waiting
+	 * for a new frame. Keep the old host cache for that frame's DMA slot.
+	 */
+	ret = drm_panel_bridge_live_refresh_apply(panel_bridge, old, new);
+	if (ret) {
+		msm_dsi_live_hfp_end(true, NULL);
+		drm_warn(encoder->dev, "Liuqin live reject: stage=scan-before-latch ret=%d\n", ret);
+		return false;
+	}
+
+	ret = read_poll_timeout(dpu_live_refresh_latched, ready, ready,
+				100, 40000, false, ctl, intf_mask, intf0, intf1,
+				frame0, frame1);
+	if (ret || !dpu_hw_intf_live_timing_matches(intf0, new) ||
+	    !dpu_hw_intf_live_timing_matches(intf1, new)) {
+		drm_info(encoder->dev, "Liuqin live reject: stage=latch ret=%d frames=%u/%u old=%u/%u\n",
+			 ret, dpu_hw_intf_frame_count(intf0), dpu_hw_intf_frame_count(intf1),
+			 frame0, frame1);
+		new = NULL;
+	}
+	if (!msm_dsi_live_hfp_end(true, new)) {
+		drm_warn(encoder->dev, "Liuqin: live HFP timing not confirmed, using full modeset\n");
+		return false;
+	}
+
+	drm_mode_copy(&left->cached_mode, new);
+	drm_mode_copy(&right->cached_mode, new);
+	return true;
+}
+
+bool dpu_encoder_live_refresh(struct drm_encoder *encoder,
+			      const struct drm_display_mode *old,
+			      const struct drm_display_mode *new)
+{
+	struct drm_bridge *panel_bridge = NULL;
+	bool updated;
+	int ret;
+
+	if (!liuqin_live_refresh_mode(old) || !liuqin_live_refresh_mode(new) ||
+	    drm_mode_equal(old, new)) {
+		drm_info(encoder->dev, "Liuqin live reject: stage=mode old=%d new=%d clocks=%d/%d totals=%dx%d/%dx%d\n",
+			 drm_mode_vrefresh(old), drm_mode_vrefresh(new), old->clock, new->clock,
+			 old->htotal, old->vtotal, new->htotal, new->vtotal);
+		return false;
+	}
+	drm_for_each_bridge_in_chain(encoder, bridge) {
+		if (drm_bridge_is_panel(bridge)) {
+			panel_bridge = bridge;
+			break;
+		}
+	}
+	if (!panel_bridge) {
+		drm_info(encoder->dev, "Liuqin live reject: stage=bridge reason=missing-panel\n");
+		return false;
+	}
+	ret = drm_panel_bridge_live_refresh_begin(panel_bridge, old, new);
+	if (ret) {
+		drm_info(encoder->dev, "Liuqin live reject: stage=panel ret=%d old=%d new=%d\n",
+			 ret, drm_mode_vrefresh(old), drm_mode_vrefresh(new));
+		return false;
+	}
+
+	/* Lock order: panel backlight -> DSI command -> encoder spinlock. */
+	if (old->htotal == new->htotal)
+		updated = dpu_encoder_live_vfp(encoder, old, new);
+	else
+		updated = dpu_encoder_live_hfp(encoder, panel_bridge, old, new);
+
+	drm_panel_bridge_live_refresh_end(panel_bridge);
+	return updated;
+}
+
