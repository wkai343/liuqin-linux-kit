+bool msm_dsi_host_live_hfp_matches(struct mipi_dsi_host *host,
+				   const struct drm_display_mode *mode)
+{
+	struct msm_dsi_host *h = to_msm_dsi_host(host);
+	const struct { u32 reg, expected; } checks[] = {
+		{ REG_DSI_TOTAL, DSI_TOTAL_H_TOTAL(liuqin_line_clocks(mode) - 1) |
+				 DSI_TOTAL_V_TOTAL(mode->vtotal - 1) },
+		{ REG_DSI_ACTIVE_H, DSI_ACTIVE_H_START(48) | DSI_ACTIVE_H_END(348) },
+		{ REG_DSI_ACTIVE_V, DSI_ACTIVE_V_START(216) | DSI_ACTIVE_V_END(3096) },
+		{ REG_DSI_ACTIVE_HSYNC, DSI_ACTIVE_HSYNC_END(2) },
+		{ REG_DSI_ACTIVE_VSYNC_HPOS, 0 },
+		{ REG_DSI_ACTIVE_VSYNC_VPOS, DSI_ACTIVE_VSYNC_VPOS_END(2) },
+	};
+	unsigned int i;
+	u32 value;
+
+	for (i = 0; i < ARRAY_SIZE(checks); i++) {
+		value = dsi_read(h, checks[i].reg);
+		if (value != checks[i].expected) {
+			pr_info("Liuqin live reject: stage=dsi-timing host=%d reg=%#x actual=%#x expected=%#x rate=%d\n",
+				h->id, checks[i].reg, value, checks[i].expected,
+				drm_mode_vrefresh(mode));
+			return false;
+		}
+	}
+	return true;
+}
