+		return false;
+
+	return (liuqin_live_60 && ctx->oem_panel == &liuqin_oem_panels[LIUQIN_PANEL_TIANMA]) ||
+	       (liuqin_live_60_csot && ctx->oem_panel == &liuqin_oem_panels[LIUQIN_PANEL_CSOT]);
