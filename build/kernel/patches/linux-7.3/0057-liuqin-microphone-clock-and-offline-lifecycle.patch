 			       struct snd_kcontrol *kcontrol, int event)
 {
@@ -919,6 +1055,11 @@ static int tx_macro_enable_dec(struct snd_soc_dapm_widget *w,
 	u16 adc_mux_reg, adc_reg, adc_n, dmic;
 	u16 dmic_clk_reg;
 	struct tx_macro *tx = snd_soc_component_get_drvdata(component);
+	int ret;
+
+	ret = tx_macro_capture_prepare(tx, SND_SOC_DAPM_EVENT_ON(event));
+	if (ret)
+		return ret;
 
 	decimator = w->shift;
 	tx_vol_ctl_reg = CDC_TXn_TX_PATH_CTL(decimator);
@@ -950,8 +1091,9 @@ static int tx_macro_enable_dec(struct snd_soc_dapm_widget *w,
 					      CDC_TXn_PGA_MUTE_MASK, 0x1);
 		break;
 	case SND_SOC_DAPM_POST_PMU:
-		snd_soc_component_write_field(component, tx_vol_ctl_reg,
-					     CDC_TXn_CLK_EN_MASK, 0x1);
+		ret = tx_macro_dec_clock(tx, decimator, true);
+		if (ret)
+			return ret;
 		if (!is_amic_enabled(component, tx, decimator)) {
 			snd_soc_component_update_bits(component, hpf_gate_reg, 0x01, 0x00);
 			/* Minimum 1 clk cycle delay is required as per HW spec */
@@ -962,6 +1104,8 @@ static int tx_macro_enable_dec(struct snd_soc_dapm_widget *w,
 
 		tx->tx_hpf_work[decimator].hpf_cut_off_freq =
 						hpf_cut_off_freq;
+		tx->tx_hpf_work[decimator].restore_pending =
+				hpf_cut_off_freq != CF_MIN_3DB_150HZ;
 
 		if (hpf_cut_off_freq != CF_MIN_3DB_150HZ)
 			snd_soc_component_write_field(component, dec_cfg_reg,
@@ -1010,6 +1154,16 @@ static int tx_macro_enable_dec(struct snd_soc_dapm_widget *w,
 		}
 		break;
 	case SND_SOC_DAPM_PRE_PMD:
+		if (liuqin_board_quirks()) {
+			/* Join unmute first, so it cannot undo the shutdown mute. */
+			cancel_delayed_work_sync(&tx->tx_mute_dwork[decimator].dwork);
+			cancel_delayed_work_sync(&tx->tx_hpf_work[decimator].dwork);
+			snd_soc_component_write_field(component, tx_vol_ctl_reg,
+						      CDC_TXn_PGA_MUTE_MASK, 0x1);
+			if (tx->tx_hpf_work[decimator].restore_pending)
+				tx_macro_restore_hpf(&tx->tx_hpf_work[decimator]);
+			break;
+		}
 		hpf_cut_off_freq =
 			tx->tx_hpf_work[decimator].hpf_cut_off_freq;
 		snd_soc_component_write_field(component, tx_vol_ctl_reg,
@@ -1048,12 +1202,15 @@ static int tx_macro_enable_dec(struct snd_soc_dapm_widget *w,
 		cancel_delayed_work_sync(&tx->tx_mute_dwork[decimator].dwork);
 		break;
 	case SND_SOC_DAPM_POST_PMD:
-		snd_soc_component_write_field(component, tx_vol_ctl_reg,
-					      CDC_TXn_CLK_EN_MASK, 0x0);
+		ret = tx_macro_dec_clock(tx, decimator, false);
+		if (ret)
+			return ret;
 		snd_soc_component_write_field(component, dec_cfg_reg,
 					      CDC_TXn_ADC_MODE_MASK, 0x0);
 		snd_soc_component_write_field(component, tx_vol_ctl_reg,
-					      CDC_TXn_PGA_MUTE_MASK, 0x0);
+					      CDC_TXn_PGA_MUTE_MASK,
+					      liuqin_board_quirks() &&
+					      test_bit(decimator, &tx->dec_clock_mask));
 		if (tx->bcs_enable) {
 			snd_soc_component_write_field(component, dec_cfg_reg,
 						      CDC_TXn_PH_EN_MASK, 0x0);
@@ -1196,7 +1353,10 @@ static int tx_macro_digital_mute(struct snd_soc_dai *dai, int mute, int stream)
 	for_each_set_bit(decimator, &tx->active_ch_mask[dai->id], TX_MACRO_DEC_MAX)
 		snd_soc_component_write_field(component,
 					      CDC_TXn_TX_PATH_CTL(decimator),
-					      CDC_TXn_PGA_MUTE_MASK, !!mute);
+					      CDC_TXn_PGA_MUTE_MASK,
+					      mute || (liuqin_board_quirks() &&
+					      tx->four_channel_clock && decimator < 4 &&
+					      !tx->dec_active[decimator]));
 
 	return 0;
 }
@@ -2117,6 +2277,11 @@ static int tx_macro_component_probe(struct snd_soc_component *comp)
 	int i, ret;
 
 	tx_macro_reset_capture_routes(tx);
+	if (liuqin_board_quirks()) {
+		memset(tx->dec_active, 0, sizeof(tx->dec_active));
+		tx->dec_clock_mask = 0;
+		tx->four_channel_clock = false;
+	}
 	ret = tx_macro_component_extend(comp);
 	if (ret)
 		return ret;
@@ -2126,6 +2291,7 @@ static int tx_macro_component_probe(struct snd_soc_component *comp)
 	for (i = 0; i < NUM_DECIMATORS; i++) {
 		tx->tx_hpf_work[i].tx = tx;
 		tx->tx_hpf_work[i].decimator = i;
+		tx->tx_hpf_work[i].restore_pending = false;
 		INIT_DELAYED_WORK(&tx->tx_hpf_work[i].dwork,
 			tx_macro_tx_hpf_corner_freq_callback);
 	}
@@ -2149,6 +2315,26 @@ static int tx_macro_component_probe(struct snd_soc_component *comp)
 	return 0;
 }
 
+static void tx_macro_component_remove(struct snd_soc_component *comp)
+{
+	struct tx_macro *tx = snd_soc_component_get_drvdata(comp);
+	int i;
+
+	if (!liuqin_board_quirks())
+		return;
+
+	/* The macro survives APM card removal, but no work may retain that card. */
+	for (i = 0; i < NUM_DECIMATORS; i++) {
+		cancel_delayed_work_sync(&tx->tx_mute_dwork[i].dwork);
+		cancel_delayed_work_sync(&tx->tx_hpf_work[i].dwork);
+		if (tx->tx_hpf_work[i].restore_pending)
+			tx_macro_restore_hpf(&tx->tx_hpf_work[i]);
+		tx_macro_capture_prepare(tx, false);
+		tx_macro_dec_clock(tx, i, false);
+	}
+	tx->component = NULL;
+}
+
 static int swclk_gate_enable(struct clk_hw *hw)
 {
 	struct tx_macro *tx = to_tx_macro(hw);
@@ -2245,6 +2431,7 @@ static int tx_macro_register_mclk_output(struct tx_macro *tx)
 static const struct snd_soc_component_driver tx_macro_component_drv = {
 	.name = "TX-MACRO",
 	.probe = tx_macro_component_probe,
+	.remove = tx_macro_component_remove,
 	.controls = tx_macro_snd_controls,
 	.num_controls = ARRAY_SIZE(tx_macro_snd_controls),
 	.dapm_widgets = tx_macro_dapm_widgets,
