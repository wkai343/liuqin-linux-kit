From a9d4f80a89f029e86ba9c7e39f7f11991ade239f Mon Sep 17 00:00:00 2001
From: wk <58632380+wkai343@users.noreply.github.com>
Date: Fri, 13 Nov 2026 14:45:01 +0800
Subject: [PATCH] ASoC: liuqin: fix shared microphone clocks, HPF timing and
 offline cleanup

Follow OEM last-ADC ownership for WCD analog clocks and the Bolero TX sample-rate delay between HPF gate writes. Keep all four codec-DMA capture slots clocked while any physical input remains active, retaining inactive-slot mute across stream unmute. Retire ADC and MICBIAS votes in cache after ADSP loss, skip the offline volatile bank-rate register, and drain unmute/HPF work before channel or card removal.

OEM reference: xiaomi-sm8450-kernel/android_vendor_qcom_opensource_audio-kernel at 721c4fb115d50aea74a2dec9ee864bf0f12682c8.
---
 sound/soc/codecs/lpass-tx-macro.c | 223 +++++++++++++++++++++++++++---
 sound/soc/codecs/wcd938x.c        | 125 ++++++++++++++---
 2 files changed, 309 insertions(+), 39 deletions(-)

diff --git a/sound/soc/codecs/lpass-tx-macro.c b/sound/soc/codecs/lpass-tx-macro.c
index 5d99800c7..c89263039 100644
--- a/sound/soc/codecs/lpass-tx-macro.c
+++ b/sound/soc/codecs/lpass-tx-macro.c
@@ -253,6 +253,7 @@ struct hpf_work {
 	struct tx_macro *tx;
 	u8 decimator;
 	u8 hpf_cut_off_freq;
+	bool restore_pending;
 	struct delayed_work dwork;
 };
 
@@ -282,6 +283,8 @@ struct tx_macro {
 	struct clk *fsgen;
 	struct clk_hw hw;
 	bool dec_active[NUM_DECIMATORS];
+	unsigned long dec_clock_mask;
+	bool four_channel_clock;
 	int tx_mclk_users;
 	bool bcs_enable;
 	int dec_mode[NUM_DECIMATORS];
@@ -674,24 +677,69 @@ static bool is_amic_enabled(struct snd_soc_component *component,
 	return false;
 }
 
-static void tx_macro_tx_hpf_corner_freq_callback(struct work_struct *work)
+static int tx_macro_capture_prepare(struct tx_macro *tx, bool enable)
 {
-	struct delayed_work *hpf_delayed_work;
-	struct hpf_work *hpf_work;
-	struct tx_macro *tx;
-	struct snd_soc_component *component;
-	u16 dec_cfg_reg, hpf_gate_reg;
-	u8 hpf_cut_off_freq;
+	if (!liuqin_board_quirks() || liuqin_audio_transport_ready())
+		return 0;
+	if (enable)
+		return -ENETRESET;
 
-	hpf_delayed_work = to_delayed_work(work);
-	hpf_work = container_of(hpf_delayed_work, struct hpf_work, dwork);
-	tx = hpf_work->tx;
-	component = tx->component;
-	hpf_cut_off_freq = hpf_work->hpf_cut_off_freq;
+	regcache_cache_only(tx->regmap, true);
+	regcache_mark_dirty(tx->regmap);
+	return 0;
+}
+
+static void tx_macro_amic_hpf_delay(struct snd_soc_component *component, u8 decimator)
+{
+	/* OEM waits one sample period between the two analog HPF gate writes. */
+	switch (snd_soc_component_read_field(component, CDC_TXn_TX_PATH_CTL(decimator),
+					     CDC_TXn_PCM_RATE_MASK)) {
+	case 0:
+		usleep_range(125, 130);
+		break;
+	case 1:
+		usleep_range(62, 65);
+		break;
+	case 3:
+		usleep_range(31, 32);
+		break;
+	case 4:
+		usleep_range(20, 21);
+		break;
+	case 5:
+		usleep_range(10, 11);
+		break;
+	case 6:
+		usleep_range(5, 6);
+		break;
+	default:
+		usleep_range(125, 130);
+		break;
+	}
+}
+
+static void tx_macro_restore_hpf(struct hpf_work *hpf_work)
+{
+	struct tx_macro *tx = hpf_work->tx;
+	struct snd_soc_component *component = tx->component;
+	u16 dec_cfg_reg, hpf_gate_reg;
+	u8 hpf_cut_off_freq = hpf_work->hpf_cut_off_freq;
 
 	dec_cfg_reg = CDC_TXn_TX_PATH_CFG0(hpf_work->decimator);
 	hpf_gate_reg = CDC_TXn_TX_PATH_SEC2(hpf_work->decimator);
 
+	if (liuqin_board_quirks() && !liuqin_audio_transport_ready()) {
+		/* Retire the temporary 150 Hz setting in cache, without a HW pulse. */
+		tx_macro_capture_prepare(tx, false);
+		snd_soc_component_write_field(component, dec_cfg_reg,
+					      CDC_TXn_HPF_CUT_FREQ_MASK, hpf_cut_off_freq);
+		snd_soc_component_update_bits(component, hpf_gate_reg,
+					      CDC_TXn_HPF_F_CHANGE_MASK |
+					      CDC_TXn_HPF_ZERO_GATE_MASK, 0x01);
+		hpf_work->restore_pending = false;
+		return;
+	}
+
 	if (is_amic_enabled(component, tx, hpf_work->decimator)) {
 		snd_soc_component_write_field(component,
 				dec_cfg_reg,
@@ -701,6 +749,8 @@ static void tx_macro_tx_hpf_corner_freq_callback(struct work_struct *work)
 					      CDC_TXn_HPF_F_CHANGE_MASK |
 					      CDC_TXn_HPF_ZERO_GATE_MASK,
 					      0x02);
+		if (liuqin_board_quirks())
+			tx_macro_amic_hpf_delay(component, hpf_work->decimator);
 		snd_soc_component_update_bits(component, hpf_gate_reg,
 					      CDC_TXn_HPF_F_CHANGE_MASK |
 					      CDC_TXn_HPF_ZERO_GATE_MASK,
@@ -716,6 +766,19 @@ static void tx_macro_tx_hpf_corner_freq_callback(struct work_struct *work)
 		snd_soc_component_write_field(component, hpf_gate_reg,
 					      CDC_TXn_HPF_F_CHANGE_MASK, 0x0);
 	}
+	hpf_work->restore_pending = false;
+}
+
+static void tx_macro_tx_hpf_corner_freq_callback(struct work_struct *work)
+{
+	struct hpf_work *hpf_work = container_of(to_delayed_work(work),
+					       struct hpf_work, dwork);
+
+	/* DAPM teardown will restore the saved cutoff in cache while offline. */
+	if (liuqin_board_quirks() && !liuqin_audio_transport_ready())
+		return;
+
+	tx_macro_restore_hpf(hpf_work);
 }
 
 static void tx_macro_mute_update_callback(struct work_struct *work)
@@ -726,6 +789,9 @@ static void tx_macro_mute_update_callback(struct work_struct *work)
 	struct delayed_work *delayed_work;
 	u8 decimator;
 
+	if (liuqin_board_quirks() && !liuqin_audio_transport_ready())
+		return;
+
 	delayed_work = to_delayed_work(work);
 	tx_mute_dwork = container_of(delayed_work, struct tx_mute_work, dwork);
 	tx = tx_mute_dwork->tx;
@@ -907,6 +973,76 @@ static int tx_macro_tx_mixer_put(struct snd_kcontrol *kcontrol,
 	return 1;
 }
 
+static int tx_macro_dec_clock(struct tx_macro *tx, u8 decimator, bool enable)
+{
+	struct snd_soc_component *component = tx->component;
+	unsigned long clocks = BIT(decimator), old_clocks = tx->dec_clock_mask;
+	bool old_group = tx->four_channel_clock, active = false;
+	unsigned long i;
+	int ret, error = 0;
+
+	if (!liuqin_board_quirks()) {
+		snd_soc_component_write_field(component, CDC_TXn_TX_PATH_CTL(decimator),
+					      CDC_TXn_CLK_EN_MASK, enable);
+		return 0;
+	}
+
+	if (enable) {
+		if (decimator < 4 &&
+		    tx->active_ch_mask[TX_MACRO_AIF1_CAP] == GENMASK(3, 0))
+			tx->four_channel_clock = true;
+		if (decimator < 4 && tx->four_channel_clock)
+			clocks = GENMASK(3, 0);
+
+		/* Codec DMA consumes four slots even when one physical ADC is off. */
+		for_each_set_bit(i, &clocks, NUM_DECIMATORS) {
+			unsigned int mask = CDC_TXn_CLK_EN_MASK;
+
+			if (!tx->dec_active[i])
+				mask |= CDC_TXn_PGA_MUTE_MASK;
+			ret = snd_soc_component_update_bits(component, CDC_TXn_TX_PATH_CTL(i),
+							    mask, mask);
+			if (ret < 0)
+				goto rollback;
+			set_bit(i, &tx->dec_clock_mask);
+		}
+		tx->dec_active[decimator] = true;
+		return 0;
+	}
+
+	tx->dec_active[decimator] = false;
+	if (decimator < 4 && tx->four_channel_clock) {
+		for (i = 0; i < 4; i++)
+			active |= tx->dec_active[i];
+		if (active) {
+			ret = snd_soc_component_write_field(component,
+						CDC_TXn_TX_PATH_CTL(decimator),
+						CDC_TXn_PGA_MUTE_MASK, 1);
+			return ret < 0 ? ret : 0;
+		}
+		clocks = GENMASK(3, 0);
+		tx->four_channel_clock = false;
+	}
+	for_each_set_bit(i, &clocks, NUM_DECIMATORS) {
+		ret = snd_soc_component_update_bits(component, CDC_TXn_TX_PATH_CTL(i),
+						    CDC_TXn_CLK_EN_MASK | CDC_TXn_PGA_MUTE_MASK, 0);
+		if (ret < 0)
+			error = error ?: ret;
+		else
+			clear_bit(i, &tx->dec_clock_mask);
+	}
+	return error;
+
+rollback:
+	clocks = tx->dec_clock_mask & ~old_clocks;
+	for_each_set_bit(i, &clocks, NUM_DECIMATORS)
+		snd_soc_component_update_bits(component, CDC_TXn_TX_PATH_CTL(i),
+					      CDC_TXn_CLK_EN_MASK | CDC_TXn_PGA_MUTE_MASK, 0);
+	tx->dec_clock_mask = old_clocks;
+	tx->four_channel_clock = old_group;
+	return ret;
+}
+
