+			if (ret && liuqin_board_quirks())
+				return ret;
 		}
 		break;
 	}
@@ -1183,9 +1217,26 @@ static int wcd938x_codec_enable_adc(struct snd_soc_dapm_widget *w,
 {
 	struct snd_soc_component *component = snd_soc_dapm_to_component(w->dapm);
 	struct wcd938x_priv *wcd938x = snd_soc_component_get_drvdata(component);
+	int ret;
+
+	ret = wcd938x_capture_prepare(wcd938x, event == SND_SOC_DAPM_PRE_PMU);
+	if (ret)
+		return ret;
 
 	switch (event) {
 	case SND_SOC_DAPM_PRE_PMU:
+		if (liuqin_board_quirks()) {
+			ret = snd_soc_component_update_bits(component,
+					WCD938X_DIGITAL_CDC_ANA_CLK_CTL,
+					WCD938X_ANA_TX_CLK_EN_MASK |
+					WCD938X_ANA_TX_DIV2_CLK_EN_MASK,
+					WCD938X_ANA_TX_CLK_EN_MASK |
