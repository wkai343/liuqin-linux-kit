+static int wcd938x_capture_prepare(struct wcd938x_priv *wcd938x, bool enable)
+{
+	if (!liuqin_board_quirks() || liuqin_audio_transport_ready())
+		return 0;
+	if (enable)
+		return -ENETRESET;
+
+	/* Still retire votes and cached enables after ADSP has gone away. */
+	regcache_cache_only(wcd938x->regmap, true);
+	regcache_mark_dirty(wcd938x->regmap);
+	return 0;
+}
+
+static bool wcd938x_adcs_active(struct wcd938x_priv *wcd938x)
+{
+	return wcd938x->status_mask & GENMASK(WCD_ADC4, WCD_ADC1);
+}
