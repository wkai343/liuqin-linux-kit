 			       struct snd_kcontrol *kcontrol, int event)
 {
@@ -1102,6 +1121,11 @@ static int wcd938x_tx_swr_ctrl(struct snd_soc_dapm_widget *w,
 	struct wcd938x_priv *wcd938x = snd_soc_component_get_drvdata(component);
 	int bank;
 	int rate;
+	int ret;
+
