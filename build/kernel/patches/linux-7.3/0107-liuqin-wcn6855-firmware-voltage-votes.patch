+static int liuqin_wcn_get_supplies(struct device *dev,
+				   struct liuqin_wcn_radio *radio,
+				   const struct liuqin_wcn_supply *levels,
+				   unsigned int count)
+{
+	unsigned int i;
+
+	radio->regs = devm_kcalloc(dev, count, sizeof(*radio->regs), GFP_KERNEL);
+	if (!radio->regs)
+		return -ENOMEM;
+
+	radio->levels = levels;
+	radio->count = count;
+	for (i = 0; i < count; i++)
+		radio->regs[i].supply = levels[i].name;
+
+	return devm_regulator_bulk_get(dev, count, radio->regs);
+}
+
+static int liuqin_wcn_vote_one(struct liuqin_wcn_radio *radio,
+			       unsigned int i, bool boot)
+{
+	const struct liuqin_wcn_supply *level = &radio->levels[i];
+
+	return regulator_set_voltage(radio->regs[i].consumer,
+				     boot ? level->min_uv : 0, level->max_uv);
+}
+
+static int liuqin_wcn_vote(struct liuqin_wcn_radio *radio, bool boot)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < radio->count; i++) {
+		ret = liuqin_wcn_vote_one(radio, i, boot);
+		if (ret) {
+			while (i--)
+				if (liuqin_wcn_vote_one(radio, i, radio->boot_vote))
+					pr_err("WCN6855: failed to restore %s vote\n",
+					       radio->levels[i].name);
+			return ret;
+		}
+	}
+
+	radio->boot_vote = boot;
+	return 0;
+}
+
+static int liuqin_wcn_power_on(struct liuqin_wcn_radio *radio)
+{
+	int ret;
+
+	if (!radio->count)
+		return 0;
+
+	ret = liuqin_wcn_vote(radio, true);
+	if (ret)
+		return ret;
+
+	ret = regulator_bulk_enable(radio->count, radio->regs);
+	if (ret)
+		liuqin_wcn_vote(radio, false);
+	return ret;
+}
+
+static int liuqin_wcn_power_off(struct liuqin_wcn_radio *radio)
+{
+	int ret;
+
+	if (!radio->count)
+		return 0;
+
+	ret = regulator_bulk_disable(radio->count, radio->regs);
+	if (ret)
+		return ret;
+
+	ret = liuqin_wcn_vote(radio, false);
+	if (ret && regulator_bulk_enable(radio->count, radio->regs))
+		pr_err("WCN6855: failed to restore regulator enables\n");
+	return ret;
+}
