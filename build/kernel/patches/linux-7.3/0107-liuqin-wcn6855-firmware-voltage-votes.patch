+static inline bool liuqin_wcn6855_fw_supplies(struct device_node *radio)
+{
+	struct device_node *aon __free(device_node) = NULL;
+	struct device_node *regs __free(device_node) = NULL;
+	struct device_node *pmu __free(device_node) = NULL;
+
+	if (!radio || !liuqin_board_quirks())
+		return false;
+
+	aon = of_parse_phandle(radio, "vddaon-supply", 0);
+	regs = of_get_parent(aon);
+	pmu = of_get_parent(regs);
+	return of_device_is_compatible(pmu, "xiaomi,liuqin-wcn6855-pmu");
+}
