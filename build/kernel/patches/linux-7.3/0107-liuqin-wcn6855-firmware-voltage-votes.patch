+/**
+ * pwrseq_set_retention() - Change the supplies for a powered target.
+ * @desc: Target descriptor, possibly separate from its power owner (PCI).
+ * @retain: Release bootstrap requirements after firmware takes over.
+ *
+ * Does not acquire or release a power reference. A target without a
+ * retention callback has identical supply requirements in both modes.
+ *
+ * Return: 0 on success or a negative error code.
+ */
+int pwrseq_set_retention(struct pwrseq_desc *desc, bool retain)
+{
+	struct pwrseq_device *pwrseq;
+
+	if (!desc)
+		return 0;
+
+	pwrseq = desc->pwrseq;
+	guard(rwsem_read)(&pwrseq->rw_lock);
+	if (!device_is_registered(&pwrseq->dev))
+		return -ENODEV;
+
+	if (!desc->target->set_retention)
+		return 0;
+
+	guard(mutex)(&pwrseq->state_lock);
+	if (!desc->target->unit->enable_count)
+		return retain ? 0 : -EHOSTDOWN;
+
+	return desc->target->set_retention(pwrseq, retain);
+}
+EXPORT_SYMBOL_GPL(pwrseq_set_retention);
