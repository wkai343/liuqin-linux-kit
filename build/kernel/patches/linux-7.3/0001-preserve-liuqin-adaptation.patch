+/*
+ * The touchscreen is a Novatek NT36532 on chip select 0 of QUPv3 wrapper 0's
+ * fifth serial engine. Frequency, chip select and interrupt line are taken from
+ * the device tree the vendor bootloader hands the vendor kernel on this exact
+ * unit, captured during the E4 boot:
+ * abl-final-fdt.dts:12799-12835, node spi@990000/touchscreen@0.
+ *
+ * No supply here on purpose: the vendor node has none either. The controller is
+ * fed from the panel's rails, which is also why it can be brought up before the
+ * display is.
+ */
+&spi4 {
+	status = "okay";
+
+	touchscreen@0 {
+		compatible = "novatek,NVT-ts-spi";
+		reg = <0>;
+
+		spi-max-frequency = <9600000>;
+
+		/*
+		 * The trigger type is fixed in the driver (INT_TRIGGER_TYPE),
+		 * which requests the interrupt from gpio_to_irq() rather than
+		 * from this specifier, so this cell is documentation.
+		 */
+		novatek,irq-gpio = <&tlmm 21 IRQ_TYPE_EDGE_RISING>;
+
+		/*
+		 * Software reset register of the NT36532. The vendor tree does
+		 * not carry this property -- its driver has the address
+		 * compiled in -- but nvt_parse_dt() treats it as mandatory and
+		 * fails probe without it. The value is the one the mainline
+		 * driver's own NT36532 register table holds, and matches yudi,
+		 * which has the same touch controller.
+		 */
+		novatek,swrst-n8-addr = <0x1fb43e>;
+
+		novatek,pen-support;
+
+		firmware-name = "novatek/liuqin/novatek_nt36532_m81_fw_csot.bin";
+
+		/*
+		 * The NT36532 is a TDDI die shared with the display. The DRM
+		 * panel prepare sequence resets it and discards the RAM-loaded
+		 * touch firmware, so the touch driver must follow the panel and
+		 * download the firmware again after every prepare (E22 finding:
+		 * touch worked in E12/E13 only because no display driver
+		 * existed yet to reset the die).
+		 */
+		panel = <&panel>;
+	};
+};
+
+/*
+ * Fingerprint sensor FPC1264 on chip select 0 of QUPv3 wrapper 1's
+ * third serial engine (spi10 / spi@a88000).
+ * Interrupt line is GPIO 40, reset line is GPIO 41, and power is fed from
+ * pm8350c_l9 (LDO9, strictly locked to 3.0 V, 2960000-3008000 uV).
+ */
+&spi10 {
+	status = "okay";
+	pinctrl-0 = <&qup_spi10_data_clk>, <&qup_spi10_cs>;
+	pinctrl-names = "default";
+
+	fingerprint@0 {
+		compatible = "fpc,fpc1020";
+		reg = <0>;
+		spi-max-frequency = <8000000>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <40 IRQ_TYPE_EDGE_RISING>;
+		reset-gpios = <&tlmm 41 GPIO_ACTIVE_LOW>;
+		vdd-supply = <&pm8350c_l9>;
+		pinctrl-0 = <&fingerprint_irq>, <&fingerprint_rst>;
+		pinctrl-names = "default";
+	};
+};
+
+&tlmm {
+	gpio-reserved-ranges = <28 4>;
+	status = "okay";
+
+	fingerprint_irq: fingerprint-irq-state {
+		pins = "gpio40";
+		function = "gpio";
+		bias-pull-down;
+		input-enable;
+	};
+
+	fingerprint_rst: fingerprint-rst-state {
+		pins = "gpio41";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+		output-high;
+	};
+
+	cam_sensor_mclk2_active: cam-sensor-mclk2-active-state {
+		pins = "gpio102";
+		function = "cam_mclk";
+		drive-strength = <4>;
+		bias-disable;
+	};
+
+	cam_sensor_active_rst0: cam-sensor-active-rst0-state {
+		pins = "gpio126";
+		function = "gpio";
+		drive-strength = <4>;
+		bias-disable;
+	};
+
+	/*
+	 * The QMP USB3/DP PHY port select line, the vendor's
+	 * usb3phy_portselect_default state (function usb_phy, pull-down,
+	 * drive 2). The QMP driver does the port select in software
+	 * (SW_PORTSELECT_MUX) from the typec orientation, but the vendor
+	 * applies this state to the PHY and pin 91's default function is
+	 * usb_phy, so match it.
+	 */
+	usb3_phy_portselect_default: usb3-phy-portselect-default {
+		pins = "gpio91";
+		function = "usb_phy";
+		bias-pull-down;
+		drive-strength = <2>;
+	};
+
+	/*
+	 * The QCA6490 enable lines come up deasserted and are raised by the
+	 * power sequencer when a radio is actually claimed. Levels, direction
+	 * and bias match the vendor's own deasserted states -- bt_en_sleep
+	 * (abl-final-fdt.dts:2570) and cnss_wlan_en_sleep (:4426) -- which is
+	 * what the vendor's Bluetooth node uses as its default. The drive
+	 * strength is 16 rather than the 2 those two states carry, because
+	 * that is what the vendor selects in cnss_wlan_en_active (:4410) for
+	 * the moment the line is actually driven, and it matches
+	 * sm8450-hdk.dts, the mainline reference for this PMU.
+	 */
+	bt_en_state: bt-en-state {
+		pins = "gpio81";
+		function = "gpio";
+		drive-strength = <16>;
+		output-low;
+		bias-pull-down;
+	};
+
+	/* Vendor xiaomi_hall_default: input, pull-up, drive 2. */
+	hall_default: hall-default-state {
+		pins = "gpio10", "gpio23";
+		function = "gpio";
+		drive-strength = <2>;
+		input-enable;
+		bias-pull-up;
+	};
+
+	/*
+	 * The rest of the vendor's nanosic_keyboard_mcu group
+	 * (abl-final-fdt.dts:5284-5331), split by function because the pins
+	 * belong to two different consumers here -- gpio62 to the regulator,
+	 * the other three to the bridge node. Drive strength and bias are the
+	 * vendor's: xiaomi_keyboard_default puts gpio46, gpio83 and gpio62
+	 * together at drive 2 with bias disabled, xiaomi_keyboard_sleep_default
+	 * gives gpio42 a pull-down.
+	 *
+	 * gpio10 and gpio23 came out of that same vendor group and are
+	 * described above as hall_default, owned by gpio-keys. They are not
+	 * part of this set.
+	 */
+	kb_vdd_default: kb-vdd-default-state {
+		pins = "gpio62";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	kb_reset_default: kb-reset-default-state {
+		pins = "gpio83";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	kb_wake_default: kb-wake-default-state {
+		pins = "gpio42";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	/* The vendor group leaves this an output-capable pin; it is an input. */
+	kb_wakeup_irq_default: kb-wakeup-irq-default-state {
+		pins = "gpio46";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	/*
+	 * The vendor tree configures no pin state at all for gpio50 and relies
+	 * on its driver calling gpio_direction_input(). This one is ours. The
+	 * bridge drives the line push-pull, so it needs no bias.
+	 */
+	kb_data_irq_default: kb-data-irq-default-state {
+		pins = "gpio50";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	/*
+	 * CS35L41 reset and INTB pins. Drive 16 / bias-disable / output-high
+	 * on reset and drive 2 / input-enable / pull-up on IRQ are the vendor
+	 * cirrus_reset_default_* and cirrus_irq_default_* states at
+	 * abl-final-fdt.dts:5185-5281.
+	 */
+	cirrus_reset_tl: cirrus-reset-tl {
+		pins = "gpio1";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+		output-high;
+	};
+
+	cirrus_irq_tl: cirrus-irq-tl {
+		pins = "gpio88";
+		function = "gpio";
+		drive-strength = <2>;
+		input-enable;
+		bias-pull-up;
+	};
+
+	cirrus_reset_tr: cirrus-reset-tr {
+		pins = "gpio3";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+		output-high;
+	};
+
+	cirrus_irq_tr: cirrus-irq-tr {
+		pins = "gpio63";
+		function = "gpio";
+		drive-strength = <2>;
+		input-enable;
+		bias-pull-up;
+	};
+
+	cirrus_reset_br: cirrus-reset-br {
+		pins = "gpio92";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+		output-high;
+	};
+
+	cirrus_irq_br: cirrus-irq-br {
+		pins = "gpio89";
+		function = "gpio";
+		drive-strength = <2>;
+		input-enable;
+		bias-pull-up;
+	};
+
+	cirrus_reset_bl: cirrus-reset-bl {
+		pins = "gpio87";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+		output-high;
+	};
+
+	cirrus_irq_bl: cirrus-irq-bl {
+		pins = "gpio90";
+		function = "gpio";
+		drive-strength = <2>;
+		input-enable;
+		bias-pull-up;
+	};
+
+	/*
+	 * Tertiary TDM to the CS35L41s. Function, pins and drive come from
+	 * abl-final-fdt.dts:1795-1928; sleep states are gpio + pull-down.
+	 */
+	tert_tdm_clk_active: tert-tdm-clk-active {
+		pins = "gpio121";
+		function = "mi2s2_sck";
+		drive-strength = <8>;
+		bias-disable;
+		output-high;
+	};
+
+	tert_tdm_clk_sleep: tert-tdm-clk-sleep {
+		pins = "gpio121";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		input-enable;
+	};
+
+	tert_tdm_ws_active: tert-tdm-ws-active {
+		pins = "gpio123";
+		function = "mi2s2_ws";
+		drive-strength = <8>;
+		bias-disable;
+		output-high;
+	};
+
+	tert_tdm_ws_sleep: tert-tdm-ws-sleep {
+		pins = "gpio123";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		input-enable;
+	};
+
+	tert_tdm_din_active: tert-tdm-din-active {
+		pins = "gpio122";
+		function = "mi2s2_data0";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	tert_tdm_din_sleep: tert-tdm-din-sleep {
+		pins = "gpio122";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		input-enable;
+	};
+
+	tert_tdm_dout_active: tert-tdm-dout-active {
+		pins = "gpio124";
+		function = "mi2s2_data1";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	tert_tdm_dout_sleep: tert-tdm-dout-sleep {
+		pins = "gpio124";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		input-enable;
+	};
+
+	/*
+	 * The panel reset line. Function, drive strength and bias are the
+	 * vendor's own sde_dsi_active (abl-final-fdt.dts:5527-5539); its
+	 * counterpart sde_dsi_suspend, which pulls gpio0 down at drive strength
+	 * 2, is not described because nothing here ever selects a suspend
+	 * state for the panel.
+	 */
+	sde_dsi_active: sde-dsi-active-state {
+		pins = "gpio0";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	wlan_en_state: wlan-en-state {
+		pins = "gpio80";
+		function = "gpio";
+		drive-strength = <16>;
+		output-low;
+		bias-pull-down;
+	};
+
+	/*
+	 * The vendor tree names gpio204 as qcom,xo-clk-gpio in both QCA6490
+	 * nodes but configures no pin state for it, so this one follows
+	 * sm8450-hdk.dts to give it a defined level before the sequencer
+	 * pulses it.
+	 */
+	xo_clk_state: xo-clk-state {
+		pins = "gpio204";
+		function = "gpio";
+		drive-strength = <16>;
+		output-low;
+		bias-pull-down;
+	};
+};
+
+&uart7 {
+	status = "okay";
+};
+
+/*
+ * Bluetooth. The QCA6490's HCI transport is a 4-wire UART on QUPv3
+ * wrapper 2's sixth serial engine, which the vendor tree describes at
+ * abl-final-fdt.dts:13795 as qcom,qup_uart@894000 -- the same 0x894000
+ * that sm8450.dtsi calls uart20. Pins are inherited from that .dtsi's
+ * qup_uart20_default, whose cts/rts/tx/rx are gpio76/77/78/79, matching
+ * the vendor's qupv3_se20_4uart_pins (:4148) pin for pin; that node's
+ * wakeup interrupt on gpio79 independently confirms which end is rx.
+ * Do not copy sm8450-hdk.dts's uart20_default override here: it labels
+ * gpio78 rx and gpio79 tx, the other way round from both of those.
+ */
+&uart20 {
+	status = "okay";
+
+	bluetooth {
+		compatible = "qcom,wcn6855-bt";
+
+		vddrfacmn-supply = <&vreg_pmu_rfa_cmn_0p8>;
+		vddaon-supply = <&vreg_pmu_aon_0p8>;
+		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
+		vddwlmx-supply = <&vreg_pmu_wlmx_0p8>;
+		vddbtcmx-supply = <&vreg_pmu_btcmx_0p8>;
+		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
+		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
+		vddrfa1p8-supply = <&vreg_pmu_rfa_1p7>;
+
+		max-speed = <3200000>;
+	};
+};
+
+&ufs_mem_hc {
+	reset-gpios = <&tlmm 210 GPIO_ACTIVE_LOW>;
+
+	vcc-supply = <&pm8350_l7>;
+	vcc-max-microamp = <1100000>;
+	vccq-supply = <&pm8350_l9>;
+	vccq-max-microamp = <1200000>;
+
+	status = "okay";
+};
+
+&ufs_mem_phy {
+	vdda-phy-supply = <&pm8350_l5>;
+	vdda-pll-supply = <&pm8350c_l10>;
+
+	status = "okay";
+};
+
+&usb_1 {
+	/* select-utmi-as-pipe-clk removed: it waives the QMP pipe clock and is
+	 * only valid for USB2-only operation. */
+	status = "okay";
+};
+
+/* DWC3 is a single flattened node on the new Qualcomm binding. */
+&usb_1 {
+	dr_mode = "otg";
+	usb-role-switch;
+	/*
+	 * The role comes from UCSI on the ADSP.  ucsi_partner_change() reports
+	 * USB_ROLE_NONE whenever it does not recognise PARTNER_TYPE or sees
+	 * PARTNER_FLAG_USB clear, and dwc3 maps every role other than host/device
+	 * onto role-switch-default-mode -- which, left unset, is "peripheral".
+	 * Attaching a dock that the ADSP describes that way therefore switched
+	 * the port to device mode, tore the xHCI down and killed *all* USB,
+	 * plain USB2 included.  Default to host instead: the tablet is the host
+	 * for docks and drives.  The rescue gadget still gets peripheral mode,
+	 * because initramfs/init writes that role to the switch itself when no
+	 * UDC is registered.
+	 */
+	role-switch-default-mode = "host";
+	phys = <&usb_1_hsphy>, <&usb_1_qmpphy QMP_USB43DP_USB3_PHY>;
+	phy-names = "usb2-phy", "usb3-phy";
+};
+
+&usb_1_dwc3_hs {
+	remote-endpoint = <&pmic_glink_hs_in>;
+};
+
+&usb_1_hsphy {
+	vdd-supply = <&pm8350_l5>;
+	vdda12-supply = <&pm8350c_l10>;
+	phys = <&nxp_eusb2_repeater>;
+
+	status = "okay";
+};
+
+&usb_1_qmpphy {
+	compatible = "qcom,sm8475-qmp-usb3-dp-phy", "qcom,sm8450-qmp-usb3-dp-phy";
+	pinctrl-names = "default";
+	pinctrl-0 = <&usb3_phy_portselect_default>;
+	status = "okay";
+
+	vdda-phy-supply = <&pm8350c_l10>;
+	vdda-pll-supply = <&pm8350_l1>;
+};
+
+&usb_1_qmpphy_out {
+	remote-endpoint = <&pmic_glink_ss_in>;
+};
+
+/* Camera control path: enable SM8475 CAMCC and the rear camera's CCI0. */
+&camcc {
+	compatible = "qcom,sm8475-camcc";
+	power-domains = <&rpmhpd RPMHPD_MMCX>,
+			<&rpmhpd RPMHPD_MXC>;
+	required-opps = <&rpmhpd_opp_low_svs>,
+			<&rpmhpd_opp_low_svs>;
+	status = "okay";
+};
+
+&cci0 {
+	assigned-clocks = <&camcc CAM_CC_CAMNOC_AXI_CLK>,
+			  <&camcc CAM_CC_CCI_0_CLK>;
+	assigned-clock-rates = <300000000>, <37500000>;
+	status = "okay";
+};
+
+&cci0_i2c1 {
+	status = "okay";
+
+	camera@10 {
+		compatible = "samsung,s5kjn1";
+		reg = <0x10>;
+		orientation = <1>;
+		rotation = <180>;
+
+		/* Vendor cam_clk-supply resolves to CAMCC TITAN_TOP_GDSC. */
+		power-domains = <&camcc TITAN_TOP_GDSC>;
+
+		clocks = <&camcc CAM_CC_MCLK2_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK2_CLK>;
+		assigned-clock-rates = <19200000>;
+
+		reset-gpios = <&tlmm 126 GPIO_ACTIVE_LOW>;
+		vdda-supply = <&camera_wide_avdd_ldo>;
+		vddd-supply = <&camera_wide_dvdd_ldo>;
+		vddio-supply = <&pm8350c_l1>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam_sensor_mclk2_active &cam_sensor_active_rst0>;
+		status = "okay";
+
+		port {
+			s5kjn1_ep: endpoint {
+				link-frequencies = /bits/ 64 <700000000>;
+				clock-lanes = <0>;
+				data-lanes = <1 2 3 4>;
+				remote-endpoint = <&camss_port3_ep>;
+			};
+		};
+	};
+};
+
+/*
+ * SM8475/Cape CAMSS path for the rear S5KJN1.
+ * Runtime resources are derived from Qualcomm Cape/waipio camera DT.
+ */
+&soc {
+	camss: isp@ac62000 {
+		compatible = "qcom,sm8475-camss";
+
+		reg = <0x0 0x0ac62000 0x0 0xf000>,
+		      <0x0 0x0acb7000 0x0 0x0d00>,
+		      <0x0 0x0acb6000 0x0 0x1000>,
+		      <0x0 0x0ace4000 0x0 0x2000>,
+		      <0x0 0x0ace6000 0x0 0x2000>,
+		      <0x0 0x0ace8000 0x0 0x2000>,
+		      <0x0 0x0acea000 0x0 0x2000>;
+		reg-names = "vfe0", "csid0", "csid_wrapper",
+			    "csiphy0", "csiphy1", "csiphy2", "csiphy3";
+
+		clocks = <&camcc CAM_CC_CAMNOC_AXI_CLK>,
+			 <&camcc CAM_CC_CPAS_AHB_CLK>,
+			 <&camcc CAM_CC_CPAS_FAST_AHB_CLK>,
+			 <&camcc CAM_CC_CPAS_IFE_0_CLK>,
+			 <&camcc CAM_CC_CSID_CLK>,
+			 <&camcc CAM_CC_CSIPHY0_CLK>,
+			 <&camcc CAM_CC_CSI0PHYTIMER_CLK>,
+			 <&camcc CAM_CC_CSIPHY1_CLK>,
+			 <&camcc CAM_CC_CSI1PHYTIMER_CLK>,
+			 <&camcc CAM_CC_CSIPHY2_CLK>,
+			 <&camcc CAM_CC_CSI2PHYTIMER_CLK>,
+			 <&camcc CAM_CC_CSIPHY3_CLK>,
+			 <&camcc CAM_CC_CSI3PHYTIMER_CLK>,
+			 <&camcc CAM_CC_CSID_CSIPHY_RX_CLK>,
+			 <&gcc GCC_CAMERA_HF_AXI_CLK>,
+			 <&camcc CAM_CC_IFE_0_CLK>,
+			 <&camcc CAM_CC_IFE_0_FAST_AHB_CLK>;
+		clock-names = "camnoc_axi",
+			      "cpas_ahb",
+			      "cpas_fast_ahb_clk",
+			      "cpas_vfe0",
+			      "csid",
+			      "csiphy0",
+			      "csiphy0_timer",
+			      "csiphy1",
+			      "csiphy1_timer",
+			      "csiphy2",
+			      "csiphy2_timer",
+			      "csiphy3",
+			      "csiphy3_timer",
+			      "csiphy_rx",
+			      "gcc_axi_hf",
+			      "vfe0",
+			      "vfe0_fast_ahb";
+
+		interrupts = <GIC_SPI 465 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 464 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 477 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 478 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 479 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 448 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "vfe0", "csid0",
+				  "csiphy0", "csiphy1", "csiphy2", "csiphy3";
