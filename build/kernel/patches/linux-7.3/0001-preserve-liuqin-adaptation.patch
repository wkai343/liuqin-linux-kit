+static int liuqin_dsi_set_gating(bool on)
+{
+	struct device *dev = &dsi_mgr_get_dsi(DSI_CLOCK_MASTER)->pdev->dev;
+	struct of_phandle_args args;
+	struct platform_device *provider;
+	struct resource resource;
+	struct regmap *map;
