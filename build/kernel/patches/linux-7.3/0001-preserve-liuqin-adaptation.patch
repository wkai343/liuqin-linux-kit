+		/* Downstream sets this while parsing DT */
+		.slice_count = 2,
+
+		.bits_per_component = 8,
+		.bits_per_pixel = 8 << 4, /* 4 fractional bits */
+		.block_pred_enable = true,
+	},
+	.format = MIPI_DSI_FMT_RGB888,
+	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+		      MIPI_DSI_CLOCK_NON_CONTINUOUS,
+	.drm_mode = liuqin_mode_120,
+	.init_sequence = liuqin_init_sequence,
+	.reset_sequence = liuqin_reset,
+};
+
+static const struct panel_desc yudi_desc = {
+	.dsi_info = {
+		.type = "yudi",
+		.channel = 0,
+		.node = NULL,
+	},
+	.dsc = {
+		.dsc_version_major = 1,
+		.dsc_version_minor = 1,
+		.slice_height = 20,
+		.slice_width = 720,
+		/* Downstream sets this while parsing DT */
+		.slice_count = 2,
+
+		.bits_per_component = 8,
+		.bits_per_pixel = 8 << 4, /* 4 fractional bits */
+		.block_pred_enable = true,
+	},
+	.format = MIPI_DSI_FMT_RGB888,
+	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST | MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM,
+	.drm_mode = yudi_mode_120,
+	.init_sequence = yudi_init_sequence,
+	.reset_sequence = yudi_reset
+};
+
+/* Track the panel's votes, not the regulator core's boot-on state. */
+#define LIUQIN_IOVDD_VOTE BIT(0)
+#define LIUQIN_DIGITAL_VOTES (BIT(1) | BIT(2))
+#define LIUQIN_ALL_VOTES (LIUQIN_IOVDD_VOTE | LIUQIN_DIGITAL_VOTES)
+
+static void liuqin_log_supplies(struct nt36532 *ctx, const char *stage)
+{
+	dev_info(ctx->panel.dev,
+		 "Liuqin power %s: retained=%d votes=%x iovdd=%d buck=%d ldo=%d\n",
+		 stage, ctx->keep_iovdd, ctx->supply_votes,
+		 regulator_is_enabled(ctx->supplies[0].consumer),
+		 regulator_is_enabled(ctx->supplies[1].consumer),
+		 regulator_is_enabled(ctx->supplies[2].consumer));
+}
+
+static int liuqin_release_supply_votes(struct nt36532 *ctx, unsigned int mask)
+{
+	int first_error = 0;
+	int i, ret;
+
+	for (i = ARRAY_SIZE(ctx->supplies) - 1; i >= 0; i--) {
+		if (!(mask & ctx->supply_votes & BIT(i)))
+			continue;
+		ret = regulator_disable(ctx->supplies[i].consumer);
+		if (ret) {
+			dev_warn(ctx->panel.dev, "Failed to release %s: %d\n",
+				 ctx->supplies[i].supply, ret);
+			if (!first_error)
+				first_error = ret;
+		} else {
+			ctx->supply_votes &= ~BIT(i);
+		}
+		/* OEM post-off waits: IOVDD=2 ms, buck=2 ms, LDO=0. */
+		if (i != 2)
+			usleep_range(2000, 2010);
+	}
+	return first_error;
+}
+
+static int nt36532_enable_supplies(struct nt36532 *ctx)
+{
+	unsigned int original_votes = ctx->supply_votes;
+	unsigned int i;
+	int ret;
+
+	if (ctx->desc != &liuqin_desc)
+		return regulator_bulk_enable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+
+	for (i = 0; i < ARRAY_SIZE(ctx->supplies); i++) {
+		if (ctx->supply_votes & BIT(i))
+			continue;
+		ret = regulator_enable(ctx->supplies[i].consumer);
+		if (ret) {
+			/* Never unwind votes retained from the preceding cycle. */
+			liuqin_release_supply_votes(ctx,
+				ctx->supply_votes & ~original_votes);
+			return ret;
+		}
+		ctx->supply_votes |= BIT(i);
+		/* OEM post-on waits: IOVDD=2 ms, buck=0, LDO=2 ms. */
+		if (i != 1)
+			usleep_range(2000, 2010);
+	}
+	return 0;
+}
+
+static void nt36532_disable_supplies(struct nt36532 *ctx)
+{
+	if (ctx->desc == &liuqin_desc) {
+		/* OEM retained mode keeps IOVDD; legacy comparison keeps 1.3 V. */
+		liuqin_release_supply_votes(ctx, ctx->keep_iovdd ?
+			LIUQIN_DIGITAL_VOTES : LIUQIN_IOVDD_VOTE);
+		liuqin_log_supplies(ctx, "off");
+	} else {
+		regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	}
+}
+
+static void liuqin_release_boot_supplies(void *data)
+{
+	struct nt36532 *ctx = data;
+
+	liuqin_release_supply_votes(ctx, LIUQIN_ALL_VOTES);
+}
+
+static int liuqin_hold_boot_supplies(struct nt36532 *ctx)
+{
+	bool cold = false;
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(ctx->supplies); i++)
+		cold |= regulator_is_enabled(ctx->supplies[i].consumer) <= 0;
+	ret = nt36532_enable_supplies(ctx);
+	if (ret)
+		return ret;
+	/* The touch probe needs the existing Novatek 10 ms POR settling time
+	 * if late unused-regulator cleanup switched a boot-on rail off.
+	 */
+	if (cold)
+		usleep_range(10000, 11000);
+	return 0;
+}
+
+static int nt36532_off(struct nt36532 *ctx)
+{
+	struct mipi_dsi_device *dsi = nt36532_cmd_dsi(ctx);
+	struct device *dev = &dsi->dev;
+	int ret;
+
+	if (ctx->oem_panel)
+		return liuqin_send_oem_cmds(ctx, liuqin_oem_off,
+					  ARRAY_SIZE(liuqin_oem_off));
+
+	ret = mipi_dsi_dcs_set_display_off(dsi);
+	if (ret < 0) {
+		dev_err(dev, "Failed to set display off: %d\n", ret);
+		return ret;
+	}
+	msleep(20);
+
+	ret = mipi_dsi_dcs_enter_sleep_mode(dsi);
+	if (ret < 0) {
+		dev_err(dev, "Failed to enter sleep mode: %d\n", ret);
+		return ret;
+	}
+	msleep(120);
+
+
+	return 0;
+}
+
+static bool esd_monitor = true;
+module_param(esd_monitor, bool, 0444);
+MODULE_PARM_DESC(esd_monitor, "Monitor qualified M81 error GPIOs; report faults without resetting in IRQ");
+
+static bool esd_confirm_level = true;
+module_param(esd_confirm_level, bool, 0444);
+MODULE_PARM_DESC(esd_confirm_level, "Confirm an asserted error level before latching a hardware fault");
+
+/* esd_lock protects IRQ enable depth, event state and the active generation. */
+static void liuqin_esd_mask_locked(struct nt36532 *ctx)
+{
+	unsigned int i;
+
+	lockdep_assert_held(&ctx->esd_lock);
+	for (i = 0; i < ARRAY_SIZE(ctx->esd_irq); i++) {
+		if (ctx->esd_armed & BIT(i))
+			disable_irq_nosync(ctx->esd_irq[i]);
+	}
+	ctx->esd_armed = 0;
+}
+
+static bool liuqin_esd_fault(struct nt36532 *ctx, unsigned int line, bool injected)
+{
+	u64 event;
+	unsigned int cycle;
+
+	mutex_lock(&ctx->esd_lock);
+	if (!ctx->esd_available || !ctx->esd_enabled || ctx->esd_stopping ||
+	    ctx->esd_pending || (!injected && !(ctx->esd_armed & BIT(line)))) {
+		mutex_unlock(&ctx->esd_lock);
+		return false;
+	}
+	if (!injected && esd_confirm_level) {
+		int level = gpiod_get_value_cansleep(ctx->esd_gpio[line]);
+
+		/* A pending interrupt may outlive the level seen during startup.
+		 * The generic IRQ handler acknowledges it; leave an inactive line
+		 * armed instead of resetting a potentially healthy display.
+		 */
+		if (!level) {
+			dev_info_ratelimited(ctx->panel.dev,
+					     "Liuqin panel IRQ ignored: line %u level=0 cycle %u\n",
+					     line, ctx->esd_cycle);
+			mutex_unlock(&ctx->esd_lock);
+			return false;
+		}
+		if (level < 0) {
+			/* Avoid a level-IRQ storm if the GPIO cannot be read. */
+			liuqin_esd_mask_locked(ctx);
+			mod_delayed_work(system_wq, &ctx->esd_arm_work,
+					 msecs_to_jiffies(2000));
+			dev_warn_ratelimited(ctx->panel.dev,
+					     "Liuqin panel IRQ deferred: line %u GPIO error %d\n",
+					     line, level);
+			mutex_unlock(&ctx->esd_lock);
+			return false;
+		}
+		dev_info_ratelimited(ctx->panel.dev,
+				     "Liuqin panel IRQ confirmed: line %u level=1 cycle %u\n",
+				     line, ctx->esd_cycle);
+	}
+	ctx->esd_pending = true;
+	event = ++ctx->esd_events;
+	ctx->esd_last_line = line;
+	cycle = ctx->esd_cycle;
+	liuqin_esd_mask_locked(ctx);
+	mutex_unlock(&ctx->esd_lock);
+	dev_warn(ctx->panel.dev, "Liuqin panel fault: event %llu cycle %u source %s%u\n",
+		 (unsigned long long)event, cycle, injected ? "test" : "irq", line);
+	/* kernfs POLLPRI wakes the session coordinator; no DCS read or reset here. */
+	sysfs_notify(&ctx->panel.dev->kobj, NULL, "esd_status");
+	return true;
+}
+
+static irqreturn_t liuqin_esd_irq(int irq, void *data)
+{
+	struct nt36532 *ctx = data;
+	unsigned int line = irq == ctx->esd_irq[0] ? 0 : 1;
+
+	liuqin_esd_fault(ctx, line, false);
+	return IRQ_HANDLED;
+}
+
+static void liuqin_esd_arm_work(struct work_struct *work)
+{
+	struct nt36532 *ctx = container_of(to_delayed_work(work), struct nt36532, esd_arm_work);
+	struct drm_panel *panel = &ctx->panel;
+	unsigned int i;
+	unsigned long ready;
+	bool retry = false;
+
+	/* Same ordering as the post-backlight hook: core lock before esd_lock. */
+	mutex_lock(&panel->backlight_lock);
+	mutex_lock(&ctx->esd_lock);
+	if (!esd_monitor || !ctx->esd_enabled || ctx->esd_stopping || ctx->esd_pending ||
+	    !panel->enabled || panel->backlight_pending ||
+	    ctx->esd_cycle != panel->backlight_cookie)
+		goto unlock;
+	ready = ctx->esd_started + msecs_to_jiffies(1000);
+	if (time_before(jiffies, ready)) {
+		mod_delayed_work(system_wq, &ctx->esd_arm_work, ready - jiffies);
+		goto unlock;
+	}
+	for (i = 0; i < ARRAY_SIZE(ctx->esd_irq); i++) {
+		int level;
+
+		if (ctx->esd_armed & BIT(i))
+			continue;
+		level = gpiod_get_value_cansleep(ctx->esd_gpio[i]);
+		/* A healthy unit can boot with the second line high. Do not invent
+		 * a polarity or treat that initial unqualified level as an event.
+		 */
+		if (level != 0) {
+			retry = true;
+			continue;
+		}
+		ctx->esd_armed |= BIT(i);
+		enable_irq(ctx->esd_irq[i]);
+	}
+	if (retry)
+		mod_delayed_work(system_wq, &ctx->esd_arm_work, msecs_to_jiffies(2000));
+unlock:
+	mutex_unlock(&ctx->esd_lock);
+	mutex_unlock(&panel->backlight_lock);
+}
+
+/* Called with the core backlight lock held, after successful first-frame setup. */
+static void liuqin_esd_start(struct nt36532 *ctx)
+{
+	lockdep_assert_held(&ctx->panel.backlight_lock);
+	mutex_lock(&ctx->esd_lock);
+	if (esd_monitor && ctx->esd_available && !ctx->esd_stopping &&
+	    ctx->panel.backlight_after_first_frame && ctx->panel.backlight_cookie) {
+		ctx->esd_enabled = true;
+		ctx->esd_pending = false;
+		ctx->esd_cycle = ctx->panel.backlight_cookie;
+		ctx->esd_started = jiffies;
+		mod_delayed_work(system_wq, &ctx->esd_arm_work, msecs_to_jiffies(1000));
+	}
+	mutex_unlock(&ctx->esd_lock);
+	sysfs_notify(&ctx->panel.dev->kobj, NULL, "esd_status");
+}
+
+static void liuqin_esd_stop(struct nt36532 *ctx, bool stopping)
+{
+	mutex_lock(&ctx->esd_lock);
+	ctx->esd_enabled = false;
+	ctx->esd_stopping |= stopping;
+	liuqin_esd_mask_locked(ctx);
+	mutex_unlock(&ctx->esd_lock);
+	/* Atomic disable may hold modeset locks. Never wait for the worker here. */
+	cancel_delayed_work(&ctx->esd_arm_work);
+}
+
+static void liuqin_esd_shutdown(struct nt36532 *ctx)
+{
+	unsigned int i;
+
+	liuqin_esd_stop(ctx, true);
+	cancel_delayed_work_sync(&ctx->esd_arm_work);
+	for (i = 0; i < ARRAY_SIZE(ctx->esd_irq); i++)
+		if (ctx->esd_irq[i] >= 0)
+			synchronize_irq(ctx->esd_irq[i]);
+}
+
+static ssize_t esd_status_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct nt36532 *ctx = dev_get_drvdata(dev);
+	ssize_t size;
+
+	mutex_lock(&ctx->esd_lock);
+	size = sysfs_emit(buf,
+			  "version=1 available=%u enabled=%u pending=%u armed=%u cycle=%u events=%llu last=%u age_ms=%u\n",
+		ctx->esd_available, ctx->esd_enabled, ctx->esd_pending, ctx->esd_armed,
+		ctx->esd_cycle, (unsigned long long)ctx->esd_events, ctx->esd_last_line,
+		ctx->esd_enabled ? jiffies_to_msecs(jiffies - ctx->esd_started) : 0);
+	mutex_unlock(&ctx->esd_lock);
+	return size;
+}
+static DEVICE_ATTR_RO(esd_status);
+
+static ssize_t esd_inject_store(struct device *dev, struct device_attribute *attr,
+				const char *buf, size_t count)
+{
+	struct nt36532 *ctx = dev_get_drvdata(dev);
+	unsigned int value;
+
+	if (kstrtouint(buf, 10, &value) || value != 1)
+		return -EINVAL;
+	/* Privileged test event only: never alter voltage or panel registers. */
+	if (!liuqin_esd_fault(ctx, 2, true))
+		return -EBUSY;
+	return count;
+}
+static DEVICE_ATTR_WO(esd_inject);
+
+static struct attribute *liuqin_esd_attrs[] = {
+	&dev_attr_esd_status.attr,
+	&dev_attr_esd_inject.attr,
+	NULL,
+};
+
+static const struct attribute_group liuqin_esd_group = {
+	.attrs = liuqin_esd_attrs,
+};
+
+static int liuqin_esd_init(struct nt36532 *ctx)
+{
+	struct device *dev = ctx->panel.dev;
+	unsigned int i;
+	int ret;
+
+	if (!ctx->oem_panel || ctx->desc != &liuqin_desc || !esd_monitor ||
+	    !of_find_property(dev->of_node, "error-gpios", NULL))
+		return 0;
+	for (i = 0; i < ARRAY_SIZE(ctx->esd_irq); i++) {
+		ctx->esd_gpio[i] = devm_gpiod_get_index(dev, "error", i, GPIOD_IN);
+		if (IS_ERR(ctx->esd_gpio[i]))
+			return dev_err_probe(dev, PTR_ERR(ctx->esd_gpio[i]),
+					     "ESD GPIO unavailable\n");
+		ret = gpiod_to_irq(ctx->esd_gpio[i]);
+		if (ret < 0)
+			return dev_err_probe(dev, ret, "ESD IRQ unavailable\n");
+		ctx->esd_irq[i] = ret;
+		ret = devm_request_threaded_irq(dev, ctx->esd_irq[i], NULL, liuqin_esd_irq,
+						IRQF_TRIGGER_HIGH | IRQF_ONESHOT | IRQF_NO_AUTOEN,
+						i ? "liuqin-esd1" : "liuqin-esd0", ctx);
+		if (ret) {
+			ctx->esd_irq[i] = -1;
+			return dev_err_probe(dev, ret, "ESD IRQ request failed\n");
+		}
+	}
+	ctx->esd_available = true;
+	ret = devm_device_add_group(dev, &liuqin_esd_group);
+	if (ret)
+		ctx->esd_available = false;
+	return ret;
+}
+
+/* Exact M81 CABC modes. -1 leaves the panel's reset/ON-table state alone. */
+static int oem_cabc = -1;
+module_param(oem_cabc, int, 0444);
+MODULE_PARM_DESC(oem_cabc, "M81 initial CABC: -1 unchanged, 0 off, 1 UI, 2 still, 3 movie");
+
+static const char * const liuqin_cabc_modes[] = {
+	"off", "ui", "still", "movie",
+};
+
+static const char *liuqin_cabc_name(int mode)
+{
+	if (mode < 0 || mode >= (int)ARRAY_SIZE(liuqin_cabc_modes))
+		return "unknown";
+	return liuqin_cabc_modes[mode];
+}
+
+/* Caller holds backlight_lock, also used by dimming and the start of blanking. */
+static int liuqin_cabc_apply(struct nt36532 *ctx)
+{
+	struct drm_panel *panel = &ctx->panel;
+	struct mipi_dsi_device *dsi = nt36532_cmd_dsi(ctx);
+	const struct mipi_dsi_host_ops *ops = dsi->host->ops;
+	u8 packets[2][2] = { { 0xff, 0x10 }, { 0x55, ctx->cabc_requested } };
+	unsigned int i;
+	int ret = 0;
+
+	lockdep_assert_held(&panel->backlight_lock);
+	if (ctx->cabc_requested < 0)
+		return 0;
+	if (ctx->cabc_requested >= (int)ARRAY_SIZE(liuqin_cabc_modes))
+		return -EINVAL;
+	if (ctx->cabc_applied == ctx->cabc_requested &&
+	    ctx->cabc_cycle == panel->backlight_cookie && !ctx->cabc_error)
+		return 0;
+	ctx->cabc_applied = -1;
+	ctx->cabc_cycle = 0;
+	if (!ops || !ops->transfer) {
+		ret = -EOPNOTSUPP;
+		goto done;
+	}
+	/* ROM uses two separate DCS short writes, in LP, on the bonded path. */
+	for (i = 0; i < ARRAY_SIZE(packets); i++) {
+		struct mipi_dsi_msg msg = {
+			.channel = dsi->channel,
+			.type = MIPI_DSI_DCS_SHORT_WRITE_PARAM,
+			.flags = MIPI_DSI_MSG_USE_LPM,
+			.tx_len = sizeof(packets[i]),
+			.tx_buf = packets[i],
+		};
+		ssize_t sent = ops->transfer(dsi->host, &msg);
+
+		if (sent < 0 || sent < sizeof(packets[i])) {
+			ret = sent < 0 ? sent : -EIO;
+			goto done;
+		}
+	}
+	if (READ_ONCE(ctx->esd_pending)) {
+		ret = -EAGAIN;
+		goto done;
+	}
+	ctx->cabc_applied = ctx->cabc_requested;
+	ctx->cabc_cycle = panel->backlight_cookie;
+done:
+	ctx->cabc_error = ret;
+	return ret;
+}
+
+static bool liuqin_cabc_can_update(struct nt36532 *ctx)
+{
+	struct drm_panel *panel = &ctx->panel;
+
+	lockdep_assert_held(&panel->backlight_lock);
+	return ctx->oem_panel && ctx->cabc_ready && !ctx->dimming_stopping &&
+		!READ_ONCE(ctx->esd_pending) && panel->enabled &&
+		!panel->backlight_pending && panel->backlight &&
+		!backlight_is_blank(panel->backlight);
+}
+
+/* Called only after normal-display setup, with the core backlight lock held. */
+static void liuqin_cabc_first_frame(struct nt36532 *ctx)
+{
+	int ret;
+
+	lockdep_assert_held(&ctx->panel.backlight_lock);
+	ctx->cabc_ready = !ctx->dimming_stopping && !READ_ONCE(ctx->esd_pending);
+	if (!ctx->oem_panel || !ctx->cabc_ready)
+		return;
+	ret = liuqin_cabc_apply(ctx);
+	if (ret)
+		dev_err(ctx->panel.dev, "Liuqin CABC setup failed: %d\n", ret);
+	/* An optional policy failure must not block first-frame completion/recovery. */
+}
+
+static ssize_t cabc_mode_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct nt36532 *ctx = dev_get_drvdata(dev);
+	ssize_t size;
+
+	mutex_lock(&ctx->panel.backlight_lock);
+	size = sysfs_emit(buf, "%s\n", ctx->cabc_requested < 0 ?
+			  "unchanged" : liuqin_cabc_name(ctx->cabc_requested));
+	mutex_unlock(&ctx->panel.backlight_lock);
+	return size;
+}
+
+static ssize_t cabc_mode_store(struct device *dev, struct device_attribute *attr,
+			       const char *buf, size_t count)
+{
+	struct nt36532 *ctx = dev_get_drvdata(dev);
+	int mode, ret = 0;
+
+	mode = sysfs_match_string(liuqin_cabc_modes, buf);
+	if (mode < 0)
+		return -EINVAL;
+	mutex_lock(&ctx->panel.backlight_lock);
+	if (!ctx->oem_panel || ctx->dimming_stopping) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	ctx->cabc_requested = mode;
+	if (liuqin_cabc_can_update(ctx))
+		ret = liuqin_cabc_apply(ctx);
+unlock:
+	mutex_unlock(&ctx->panel.backlight_lock);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_RW(cabc_mode);
+
+static ssize_t cabc_status_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct nt36532 *ctx = dev_get_drvdata(dev);
+	ssize_t size;
+
+	mutex_lock(&ctx->panel.backlight_lock);
+	size = sysfs_emit(buf, "requested=%s programmed=%s cycle=%u ready=%u error=%d\n",
+			  ctx->cabc_requested < 0 ? "unchanged" :
+			  liuqin_cabc_name(ctx->cabc_requested),
+			  liuqin_cabc_name(ctx->cabc_applied), ctx->cabc_cycle,
+			  liuqin_cabc_can_update(ctx), ctx->cabc_error);
+	mutex_unlock(&ctx->panel.backlight_lock);
+	return size;
+}
+static DEVICE_ATTR_RO(cabc_status);
+
+static struct attribute *liuqin_cabc_attrs[] = {
+	&dev_attr_cabc_mode.attr,
+	&dev_attr_cabc_status.attr,
+	NULL,
+};
+
+static const struct attribute_group liuqin_cabc_group = {
+	.attrs = liuqin_cabc_attrs,
+};
+
+static int liuqin_cabc_init(struct nt36532 *ctx)
+{
+	ctx->cabc_requested = -1;
+	ctx->cabc_applied = -1;
+	if (!ctx->oem_panel)
+		return 0;
+	if (oem_cabc >= -1 && oem_cabc < (int)ARRAY_SIZE(liuqin_cabc_modes))
+		ctx->cabc_requested = oem_cabc;
+	else
+		dev_warn(ctx->panel.dev, "Invalid CABC boot mode; leaving panel unchanged\n");
+	return devm_device_add_group(ctx->panel.dev, &liuqin_cabc_group);
+}
+
+/* Exact M81 ROM dimming-on packets; the first pair is one command group. */
+static const struct liuqin_oem_cmd liuqin_oem_dimming_on[] = {
+	{ 0x39, 0x40, 0, 2, { 0xff, 0x27 } },
+	{ 0x39, 0, 0, 2, { 0xd1, 0x28 } },
+	{ 0x15, 0, 0, 2, { 0xff, 0x10 } },
+	{ 0x15, 0, 0, 2, { 0x53, 0x2c } },
+};
+
+static bool oem_delayed_dimming = true;
+module_param(oem_delayed_dimming, bool, 0444);
+MODULE_PARM_DESC(oem_delayed_dimming,
+		 "Apply M81 dimming after successful first-frame backlight setup");
+
+static int liuqin_send_dimming_on(struct nt36532 *ctx)
+{
+	struct mipi_dsi_device *dsi = nt36532_cmd_dsi(ctx);
+	const struct mipi_dsi_host_ops *ops = dsi->host->ops;
+	size_t i;
+	int ret;
+
+	if (!ops || !ops->transfer)
+		return -EOPNOTSUPP;
+	/* Preserve the ROM's long-write batch and the two separate short writes. */
+	ret = liuqin_send_oem_cmds(ctx, liuqin_oem_dimming_on, 2);
+	if (ret)
+		return ret;
+	for (i = 2; i < ARRAY_SIZE(liuqin_oem_dimming_on); i++) {
+		const struct liuqin_oem_cmd *cmd = &liuqin_oem_dimming_on[i];
+		struct mipi_dsi_msg msg = {
+			.channel = dsi->channel,
+			.type = cmd->type,
+			.flags = MIPI_DSI_MSG_USE_LPM,
+			.tx_len = cmd->len,
+			.tx_buf = cmd->data,
+		};
+		ssize_t sent = ops->transfer(dsi->host, &msg);
+
+		if (sent < 0)
+			return sent;
+		if (sent < cmd->len)
+			return -EIO;
+	}
+	return 0;
+}
+
+static void liuqin_dimming_work(struct work_struct *work)
+{
+	struct nt36532 *ctx = container_of(to_delayed_work(work),
+					 struct nt36532, dimming_work);
+	struct drm_panel *panel = &ctx->panel;
+	int ret;
+
+	/* Serialize with first-frame completion and the start of backlight off. */
+	mutex_lock(&panel->backlight_lock);
+	if (!ctx->dimming_pending)
+		goto unlock;
+	ctx->dimming_pending = false;
+	if (ctx->dimming_stopping || READ_ONCE(ctx->esd_pending) ||
+	    !oem_delayed_dimming || !ctx->oem_panel ||
+	    !panel->enabled || panel->backlight_pending ||
+	    ctx->dimming_cookie != panel->backlight_cookie ||
+	    !panel->backlight || !backlight_get_brightness(panel->backlight))
+		goto unlock;
+	ret = liuqin_send_dimming_on(ctx);
+	if (ret)
+		dev_err(panel->dev, "Liuqin OEM delayed dimming failed: %d\n", ret);
+	else
+		dev_info(panel->dev, "Liuqin OEM delayed dimming enabled: cycle %u\n",
+			 ctx->dimming_cookie);
+unlock:
+	mutex_unlock(&panel->backlight_lock);
+}
+
+/* Called from the post-backlight hook with the core backlight lock held. */
+static void liuqin_schedule_dimming(struct nt36532 *ctx)
+{
+	struct drm_panel *panel = &ctx->panel;
+
+	lockdep_assert_held(&panel->backlight_lock);
+	if (!oem_delayed_dimming || !ctx->oem_panel || ctx->dimming_stopping ||
+	    !panel->enabled || !panel->backlight_after_first_frame)
+		return;
+	ctx->dimming_cookie = panel->backlight_cookie;
+	ctx->dimming_pending = true;
+	mod_delayed_work(system_wq, &ctx->dimming_work,
+			 msecs_to_jiffies(ctx->oem_panel->dimming_delay_ms));
+	dev_info(panel->dev, "Liuqin OEM dimming queued: cycle %u, delay %u ms\n",
+		 ctx->dimming_cookie, ctx->oem_panel->dimming_delay_ms);
+}
+
+static void liuqin_cancel_dimming(struct nt36532 *ctx, bool stopping)
+{
+	mutex_lock(&ctx->panel.backlight_lock);
+	ctx->dimming_pending = false;
+	ctx->dimming_stopping |= stopping;
+	ctx->cabc_ready = false;
+	ctx->cabc_applied = -1;
+	ctx->cabc_cycle = 0;
+	mutex_unlock(&ctx->panel.backlight_lock);
+	/* Never wait for work while holding the lock that the worker needs. */
+	cancel_delayed_work_sync(&ctx->dimming_work);
+}
+
+static int nt36532_prepare(struct drm_panel *panel)
+{
+	struct nt36532 *ctx = to_nt36532(panel);
+	struct mipi_dsi_device *dsi = nt36532_cmd_dsi(ctx);
+	struct device *dev = &dsi->dev;
+	struct drm_dsc_picture_parameter_set pps;
+	int ret;
+
+	liuqin_esd_stop(ctx, false);
+
+	liuqin_cancel_dimming(ctx, false);
+
+	/* Match the retained-power resume path: reset low before digital rails. */
+	if (ctx->desc == &liuqin_desc && ctx->keep_iovdd &&
+	    (ctx->supply_votes & LIUQIN_DIGITAL_VOTES) != LIUQIN_DIGITAL_VOTES)
+		gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+
+	ret = nt36532_enable_supplies(ctx);
+	if (ret < 0) {
+		dev_err(dev, "Failed to enable regulators: %d\n", ret);
+		mipi_dsi_panel_stage(ctx->dsi[0], MIPI_DSI_PANEL_PREPARE_FAILED);
+		return ret;
+	}
+
+	if (ctx->desc == &liuqin_desc)
+		liuqin_log_supplies(ctx, "prepare");
+	msleep(120);
+
+	ctx->dsi[0]->mode_flags |= MIPI_DSI_MODE_LPM;
+	if (ctx->dsi[1])
+		ctx->dsi[1]->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	ctx->desc->reset_sequence(ctx);
+
+	msleep(120);
+
+	ret = ctx->desc->init_sequence(ctx);
+	if (ret < 0) {
+		dev_err(panel->dev, "failed to initialize panel: %d\n", ret);
+		goto fail;
+	}
+
+	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+
+	ret = mipi_dsi_picture_parameter_set(dsi, &pps);
+	if (ret < 0) {
+		dev_err(panel->dev, "failed to transmit PPS: %d\n", ret);
+		goto fail;
+	}
+
+	/* OEM ON tables configure DSC, followed by one PPS transfer. */
+	if (!ctx->oem_panel) {
+		ret = mipi_dsi_compression_mode(dsi, true);
+		if (ret < 0) {
+			dev_err(dev, "failed to enable compression mode: %d\n", ret);
+			goto fail;
+		}
+	}
+
+	msleep(120);
+
+	ret = mipi_dsi_panel_stage(ctx->dsi[0], MIPI_DSI_PANEL_PREPARED);
+	if (ret)
+		goto fail;
+	return 0;
+
+fail:
+	/* On a host cleanup error keep rails until the later disable retry. */
+	if (mipi_dsi_panel_stage(ctx->dsi[0], MIPI_DSI_PANEL_PREPARE_FAILED))
+		return ret;
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	nt36532_disable_supplies(ctx);
+	return ret;
+}
+
+static int nt36532_enable(struct drm_panel *panel)
+{
+	struct nt36532 *ctx = to_nt36532(panel);
+	struct drm_dsc_picture_parameter_set pps;
+	struct mipi_dsi_device *dsi = nt36532_cmd_dsi(ctx);
+	struct device *dev = &dsi->dev;
+	int ret;
+
+	/* The OEM ON table and PPS have already completed in prepare. */
+	if (ctx->oem_panel)
+		return 0;
+
+	ret = mipi_dsi_dcs_set_display_on(dsi);
+	if (ret < 0) {
+		dev_err(dev, "Failed to set display on: %d\n", ret);
+		return ret;
+	}
+
+	usleep_range(10000, 11000);
+
+	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+
+	print_hex_dump(KERN_INFO, "DSC:", DUMP_PREFIX_NONE, 16,
+	       1, (void *)&pps, sizeof(pps), false);
+
+	ret = mipi_dsi_picture_parameter_set(dsi, &pps);
+	if (ret < 0) {
+		dev_err(panel->dev, "failed to transmit PPS: %d\n", ret);
+		return ret;
+	}
+
+	msleep(28);
+
+	return ret;
+}
+
+static int nt36532_disable(struct drm_panel *panel)
+{
+	struct nt36532 *ctx = to_nt36532(panel);
+	struct device *dev = &ctx->dsi[0]->dev;
+	int ret;
+
+	liuqin_esd_stop(ctx, false);
+	liuqin_cancel_dimming(ctx, false);
+	ret = mipi_dsi_panel_stage(ctx->dsi[0], MIPI_DSI_PANEL_DEFER_OFF);
+	if (ret < 0)
+		return ret;
+	if (ret > 0) {
+		/* DRM disables the DPU encoder between disable and unprepare. */
+		ctx->off_deferred = true;
+		dev_info(dev, "Liuqin DSI: panel OFF deferred until post-disable\n");
+		return 0;
+	}
+	ret = mipi_dsi_panel_stage(ctx->dsi[0], MIPI_DSI_PANEL_DISABLING);
+	if (ret)
+		return ret;
+	ret = nt36532_off(ctx);
+	if (ret < 0)
+		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
+
+	return ret;
+}
+
+static int nt36532_unprepare(struct drm_panel *panel)
+{
+	struct nt36532 *ctx = to_nt36532(panel);
+	int ret;
+
+	liuqin_esd_stop(ctx, false);
+
+	liuqin_cancel_dimming(ctx, false);
+
+	if (ctx->off_deferred) {
+		/* The DPU has stopped feeding the link at this bridge phase. */
+		ret = mipi_dsi_panel_stage(ctx->dsi[0], MIPI_DSI_PANEL_DISABLING);
+		if (ret)
+			return ret;
+		/* Never replay an OFF group after a partial command failure. */
+		ctx->off_deferred = false;
+		ret = nt36532_off(ctx);
+		if (ret < 0)
+			dev_err(panel->dev, "Failed to un-initialize panel: %d\n", ret);
+	}
+
+	ret = mipi_dsi_panel_stage(ctx->dsi[0], MIPI_DSI_PANEL_UNPREPARING);
+	if (ret)
+		return ret;
+
+	ctx->dsi[0]->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	if (ctx->dsi[1])
+		ctx->dsi[1]->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	nt36532_disable_supplies(ctx);
+
+	return 0;
+}
+
+static int nt36532_get_modes(struct drm_panel *panel,
+					struct drm_connector *connector)
+{
+	struct nt36532 *ctx = to_nt36532(panel);
+	const struct drm_display_mode *mode;
+	mode = &(ctx->desc->drm_mode);
+	return drm_connector_helper_get_modes_fixed(connector, mode);
+}
+
+/* Exact M81 ROM post-backlight sequence: select DCS page, exit black mode.
+ * Keep the short 0x15 page-select and long 0x39 NORMAL_MODE packets intact.
+ * This does not introduce the separate OEM enter-black/dimming policies.
+ */
+static const struct liuqin_oem_cmd liuqin_oem_normal_display[] = {
+	{ 0x15, 0, 0, 2, { 0xff, 0x10 } },
+	{ 0x39, 0, 0, 2, { 0x13, 0x00 } },
+};
+
+static bool oem_normal_display = true;
+module_param(oem_normal_display, bool, 0444);
+MODULE_PARM_DESC(oem_normal_display,
+		 "Restore known Liuqin panel normal display mode after backlight enable");
+
+static int nt36532_post_backlight_enable(struct drm_panel *panel)
+{
+	struct nt36532 *ctx = to_nt36532(panel);
+	struct mipi_dsi_device *dsi;
+	const struct mipi_dsi_host_ops *ops;
+	size_t i;
+
+	if (!ctx->oem_panel)
+		return 0;
+	dsi = nt36532_cmd_dsi(ctx);
+	ops = dsi->host->ops;
+	if (!oem_normal_display)
+		goto ready;
+	if (!ops || !ops->transfer)
+		return -EOPNOTSUPP;
+	for (i = 0; i < ARRAY_SIZE(liuqin_oem_normal_display); i++) {
+		const struct liuqin_oem_cmd *cmd = &liuqin_oem_normal_display[i];
+		struct mipi_dsi_msg msg = {
+			.channel = dsi->channel,
+			.type = cmd->type,
+			.flags = MIPI_DSI_MSG_USE_LPM,
+			.tx_len = cmd->len,
+			.tx_buf = cmd->data,
+		};
+		ssize_t ret = ops->transfer(dsi->host, &msg);
+
+		if (ret < 0)
+			return ret;
+		if (ret < cmd->len)
+			return -EIO;
+	}
+	dev_info(panel->dev, "Liuqin OEM post-backlight: normal display restored\n");
+ready:
+	liuqin_esd_start(ctx);
+	liuqin_cabc_first_frame(ctx);
+	liuqin_schedule_dimming(ctx);
+	return 0;
+}
+
+static const struct drm_panel_funcs nt36532_panel_funcs = {
+	.prepare = nt36532_prepare,
+	.enable = nt36532_enable,
+	.disable = nt36532_disable,
+	.unprepare = nt36532_unprepare,
+	.get_modes = nt36532_get_modes,
+	.post_backlight_enable = nt36532_post_backlight_enable,
+};
+
+static int nt36532_probe(struct mipi_dsi_device *dsi)
+{
+	struct mipi_dsi_host *dsi_sec_host;
+	struct nt36532 *ctx;
+	struct device *dev = &dsi->dev;
+	struct device_node *dsi_sec;
+	int ret, i;
+
+	ctx = devm_drm_panel_alloc(dev, struct nt36532, panel,
+				   &nt36532_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->supplies[0].supply = "vddio";
+	ctx->supplies[1].supply = "dvddbuck";
+	ctx->supplies[2].supply = "dvddldo";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ctx->supplies),
+				      ctx->supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to get regulators\n");
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->desc = of_device_get_match_data(dev);
+	if (!ctx->desc)
+		return -ENODEV;
+
+	dsi_sec = of_graph_get_remote_node(dsi->dev.of_node, 1, -1);
+
+	if (dsi_sec) {
+		const struct mipi_dsi_device_info info = { "nt36532", 0,
+							   dsi_sec };
+
+		dev_notice(dev, "Using Dual-DSI with OF node `%s`\n", dsi_sec->name);
+
+		dsi_sec_host = of_find_mipi_dsi_host_by_node(dsi_sec);
+		of_node_put(dsi_sec);
+		if (!dsi_sec_host) {
+			return dev_err_probe(dev, -EPROBE_DEFER,
+					     "Cannot get secondary DSI host\n");
+		}
+
+		ctx->dsi[1] =
+			devm_mipi_dsi_device_register_full(dev, dsi_sec_host, &info);
+		if (IS_ERR(ctx->dsi[1])) {
+			return dev_err_probe(dev, PTR_ERR(ctx->dsi[1]),
+					     "Cannot get secondary DSI node\n");
+		}
+
+		mipi_dsi_set_drvdata(ctx->dsi[1], ctx);
+	} else {
+		dev_notice(dev, "Using Single-DSI\n");
+	}
+
+	ctx->dsi[0] = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	INIT_DELAYED_WORK(&ctx->dimming_work, liuqin_dimming_work);
+	mutex_init(&ctx->esd_lock);
+	INIT_DELAYED_WORK(&ctx->esd_arm_work, liuqin_esd_arm_work);
+	ctx->esd_irq[0] = -1;
+	ctx->esd_irq[1] = -1;
+	if (ctx->desc == &liuqin_desc) {
+		liuqin_select_oem_panel(ctx);
+		ctx->keep_iovdd = liuqin_retained_power && ctx->oem_panel;
+		ctx->panel.backlight_after_first_frame =
+			first_frame_backlight && ctx->oem_panel;
+	}
+	ctx->panel.prepare_prev_first = true;
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to get backlight\n");
+
+	if (ctx->desc == &liuqin_desc) {
+		/* All dependencies are ready. Preserve boot-on rails before the
+		 * panel is published to followers; the first prepare reuses votes.
+		 * This also protects them from unused-regulator cleanup.
+		 */
+		ret = liuqin_hold_boot_supplies(ctx);
+		if (ret)
+			return dev_err_probe(dev, ret, "Failed to hold boot supplies\n");
+		ret = devm_add_action_or_reset(dev, liuqin_release_boot_supplies, ctx);
+		if (ret)
+			return ret;
+		liuqin_log_supplies(ctx, "probe");
+	}
+
+	ret = liuqin_cabc_init(ctx);
+	if (ret)
+		return ret;
+
+	ret = liuqin_esd_init(ctx);
+	if (ret)
+		return ret;
+
+	drm_panel_add(&ctx->panel);
+
+	memcpy(&ctx->dsc, &ctx->desc->dsc, sizeof(ctx->desc->dsc));
+
+	for (i = 0; i < ARRAY_SIZE(ctx->dsi); i++) {
+		if (!ctx->dsi[i])
+			continue;
+		/* This panel only supports DSC; unconditionally enable it */
+		ctx->dsi[i]->dsc = &ctx->dsc;
+		/* vendor packs two 450-px slices into each video packet */
+		ctx->dsi[i]->dsc_slice_per_pkt = 2;
+
+		ctx->dsi[i]->lanes = 4;
+		ctx->dsi[i]->format = MIPI_DSI_FMT_RGB888;
+		ctx->dsi[i]->mode_flags = ctx->desc->mode_flags;
+		if (ctx->desc == &liuqin_desc && ctx->oem_panel)
+			ctx->dsi[i]->mode_flags |= MIPI_DSI_MODE_PANEL_STAGES;
+
+		ret = devm_mipi_dsi_attach(dev, ctx->dsi[i]);
+
+		if (ret < 0) {
+			liuqin_cancel_dimming(ctx, true);
+			liuqin_esd_shutdown(ctx);
+			drm_panel_remove(&ctx->panel);
+			return dev_err_probe(dev, ret,
+					     "Failed to attach to DSI%d\n", i);
+		}
+	}
+
+	return 0;
+}
+
+static void nt36532_remove(struct mipi_dsi_device *dsi)
+{
+	struct nt36532 *ctx = mipi_dsi_get_drvdata(dsi);
+	liuqin_esd_shutdown(ctx);
+	liuqin_cancel_dimming(ctx, true);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id nt36532_of_match[] = {
+	{
+		.compatible = "xiaomi,liuqin-nt36532",
+		.data = &liuqin_desc,
+	},
+	{
+		.compatible = "xiaomi,pipa-nt36532",
+		.data = &pipa_desc,
+	},
+	{
+		.compatible = "xiaomi,yudi-nt36532",
+		.data = &yudi_desc,
+	},
+	{},
+};
+MODULE_DEVICE_TABLE(of, nt36532_of_match);
+
+static struct mipi_dsi_driver nt36532_driver = {
+	.probe = nt36532_probe,
+	.remove = nt36532_remove,
+	.driver = {
+		.name = "panel-nt36532",
+		.of_match_table = nt36532_of_match,
+	},
+};
+module_mipi_dsi_driver(nt36532_driver);
+
+MODULE_AUTHOR("Luka Panio <luakapnio@gmail.com>");
+MODULE_AUTHOR("Sophie 'Tyalie' Friedrich <kernel@flowerpot.me>");
+MODULE_AUTHOR("Jens Reidel <adrian@travitia.xyz>");
+MODULE_DESCRIPTION("DRM panel driver for the Novatek NT36532 Driver-IC");
+MODULE_LICENSE("GPL");
