+	if (id != DSI_CLOCK_MASTER || !liuqin_dsi_requested())
+		return 0;
+	mutex_lock(&dsi_cmd_lock);
+	if (!liuqin_dsi.active) {
+		ret = -EIO;
+		goto out;
+	}
+	switch (stage) {
+	case MIPI_DSI_PANEL_DEFER_OFF:
+		ret = liuqin_oem_shutdown_order && liuqin_dsi.powered;
+		break;
+	case MIPI_DSI_PANEL_PREPARED:
+		ret = liuqin_dsi_video_start();
+		break;
+	case MIPI_DSI_PANEL_DISABLING:
+		if (liuqin_oem_shutdown_order) {
+			ret = liuqin_dsi_video_stop();
+			if (!ret)
+				pr_info("Liuqin DSI: video stopped before panel OFF\n");
+		}
+		break;
+	case MIPI_DSI_PANEL_UNPREPARING:
+		if (liuqin_oem_shutdown_order)
+			ret = liuqin_dsi_power_off();
+		break;
+	case MIPI_DSI_PANEL_PREPARE_FAILED:
+		ret = liuqin_dsi_power_off();
+		break;
+	default:
+		ret = -EINVAL;
+	}
+out:
+	mutex_unlock(&dsi_cmd_lock);
+	return ret;
+}
