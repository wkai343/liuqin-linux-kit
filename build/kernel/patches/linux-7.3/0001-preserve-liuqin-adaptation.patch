+static const struct liuqin_oem_panel *
+liuqin_oem_from_bootargs(const char *args)
+{
+	static const char key[] = "msm_drm.dsi_display0=";
+	const struct liuqin_oem_panel *selected = NULL;
+
+	if (!args)
+		return NULL;
+	while (*args) {
+		const struct liuqin_oem_panel *candidate = NULL;
+		const char *end, *name, *colon;
+		size_t length, i;
+
+		while (isspace((unsigned char)*args))
+			args++;
+		if (!*args)
+			break;
+		end = args;
+		while (*end && !isspace((unsigned char)*end))
+			end++;
+		if ((size_t)(end - args) < sizeof(key) - 1 ||
+		    strncmp(args, key, sizeof(key) - 1)) {
+			args = end;
+			continue;
+		}
+
+		name = args + sizeof(key) - 1;
+		colon = memchr(name, ':', end - name);
+		length = (colon ? colon : end) - name;
+		for (i = 0; i < ARRAY_SIZE(liuqin_oem_panels); i++) {
+			const struct liuqin_oem_panel *panel = &liuqin_oem_panels[i];
+
+			if (strlen(panel->boot_name) == length &&
+			    !strncmp(name, panel->boot_name, length)) {
+				candidate = panel;
+				break;
+			}
+		}
+		/* Unknown or conflicting primary selectors keep the legacy path. */
+		if (!candidate || (selected && selected != candidate))
+			return NULL;
+		selected = candidate;
+		args = end;
+	}
+	return selected;
+}
+
+static void liuqin_select_oem_panel(struct nt36532 *ctx)
+{
+	struct device_node *chosen = of_find_node_by_path("/chosen");
+	const char *args;
+
+	if (chosen && !of_property_read_string(chosen, "bootargs", &args))
+		ctx->oem_panel = liuqin_oem_from_bootargs(args);
+	of_node_put(chosen);
+
+	if (ctx->oem_panel)
+		dev_info(ctx->panel.dev, "Liuqin OEM commands: %s\n",
+			 ctx->oem_panel->label);
+	else
+		dev_warn(ctx->panel.dev,
+			 "Unknown bootloader panel selection; keeping legacy commands\n");
+}
+
+static bool oem_batch_commands = true;
+module_param(oem_batch_commands, bool, 0444);
+MODULE_PARM_DESC(oem_batch_commands, "Use OEM ordered command groups for known Liuqin panels");
+
+static int liuqin_send_oem_cmds(struct nt36532 *ctx,
+		const struct liuqin_oem_cmd *commands, size_t count)
+{
+	struct mipi_dsi_device *dsi = nt36532_cmd_dsi(ctx);
+	const struct mipi_dsi_host_ops *ops = dsi->host->ops;
+	struct mipi_dsi_msg *msgs;
+	size_t i, start = 0, payload = 0, groups = 0;
+	bool batch;
+	int ret = 0;
+
+	if (!ops || !ops->transfer)
+		return -ENOSYS;
+	if (!count || count > 256)
+		return -EINVAL;
+	/* Validate the whole immutable table before sending even the first group. */
+	for (i = 0; i < count; i++) {
+		if (commands[i].type != MIPI_DSI_DCS_LONG_WRITE ||
+		    !commands[i].len || commands[i].len > sizeof(commands[i].data) ||
+		    (commands[i].flags & ~0x40) ||
+		    ((commands[i].flags & 0x40) &&
+		     (commands[i].wait_ms || i + 1 == count)))
+			return -EINVAL;
+	}
+	msgs = kcalloc(count, sizeof(*msgs), GFP_KERNEL);
+	if (!msgs)
+		return -ENOMEM;
+	batch = oem_batch_commands && ops->transfer_batch;
+	for (i = 0; i < count; i++) {
+		msgs[i].channel = dsi->channel;
+		msgs[i].type = commands[i].type;
+		msgs[i].flags = MIPI_DSI_MSG_USE_LPM;
+		msgs[i].tx_len = commands[i].len;
+		msgs[i].tx_buf = commands[i].data;
+	}
+	for (i = 0; i < count; i++) {
+		ssize_t sent;
+
+		payload += msgs[i].tx_len;
+		if (batch && (commands[i].flags & 0x40))
+			continue;
+		if (batch)
+			sent = ops->transfer_batch(dsi->host, &msgs[start], i - start + 1);
+		else
+			sent = ops->transfer(dsi->host, &msgs[i]);
+		if (sent < 0 || (size_t)sent < payload) {
+			ret = sent < 0 ? sent : -EIO;
+			break; /* Never replay a group that might have partly transmitted. */
+		}
+		groups++;
+		if (commands[i].wait_ms)
+			usleep_range(commands[i].wait_ms * 1000,
+				     commands[i].wait_ms * 1000 + 10);
+		start = i + 1;
+		payload = 0;
+	}
+	if (!ret)
+		dev_info(ctx->panel.dev, "Liuqin OEM transport: batch=%d commands=%zu groups=%zu\n",
+			 batch, count, groups);
+	kfree(msgs);
+	return ret;
+}
+
+static int liuqin_init_sequence(struct nt36532 *ctx)
+{
+	if (!ctx->oem_panel)
+		return pipa_init_sequence(ctx);
+	return liuqin_send_oem_cmds(ctx, ctx->oem_panel->on,
+				  ctx->oem_panel->on_count);
+}
