+static ssize_t keyboard_status_show(struct device *dev,
+				    struct device_attribute *attr, char *buf)
+{
+	struct nanosic *nano = dev_get_drvdata(dev);
+
+	guard(mutex)(&nano->lock);
+	return sysfs_emit(buf, "known=%d connected=%d flags=%u reports=%llu\n",
