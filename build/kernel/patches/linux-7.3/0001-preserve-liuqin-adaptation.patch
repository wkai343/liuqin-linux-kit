+static bool dsi_7nm_liuqin_panel_known(const char *args)
+{
+	static const char key[] = "msm_drm.dsi_display0=";
+	static const char * const names[] = {
+		"qcom,mdss_dsi_m81_36_02_0a_dualdsi_dsc_lcd_video",
+		"qcom,mdss_dsi_m81_42_02_0b_dualdsi_dsc_lcd_video",
+	};
+	unsigned int selected = 0;
+
+	if (!args)
+		return false;
+	while (*args) {
+		const char *end, *name, *colon;
+		unsigned int candidate = 0, i;
+		size_t length;
+
+		while (isspace((unsigned char)*args))
+			args++;
+		if (!*args)
+			break;
+		end = args;
+		while (*end && !isspace((unsigned char)*end))
+			end++;
+		if ((size_t)(end - args) < sizeof(key) - 1 ||
+		    strncmp(args, key, sizeof(key) - 1)) {
+			args = end;
+			continue;
+		}
+		name = args + sizeof(key) - 1;
+		colon = memchr(name, ':', end - name);
+		length = (colon ? colon : end) - name;
+		for (i = 0; i < ARRAY_SIZE(names); i++)
+			if (strlen(names[i]) == length && !strncmp(name, names[i], length))
+				candidate = i + 1;
+		if (!candidate || (selected && selected != candidate))
+			return false;
+		selected = candidate;
+		args = end;
+	}
+	return selected != 0;
