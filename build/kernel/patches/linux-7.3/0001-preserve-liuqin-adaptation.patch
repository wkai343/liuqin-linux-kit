+	/*
+	 * Onboard microphones: four analog MEMS mics on WCD938x AMIC1/3/4/5,
+	 * carried over SoundWire to the TX macro (vendor sku_cape mixer paths:
+	 * handset-mic->amic1, speaker-mic->amic5, back-mic->amic4,
+	 * sidebottom-mic->amic3).  The vendor's swr-dmic nodes and DMIC
+	 * pinctrls are all disabled in the ABL-final FDT -- there is no
+	 * AP-visible digital mic.  Supplies/reset/micbias from the vendor
+	 * wcd938x-codec node (abl-final-fdt.dts:32298-32346).  No MBHC: this
+	 * tablet has no headset jack.  See docs/features/audio-mic.zh-CN.md.
+	 */
+	wcd938x: audio-codec {
+		compatible = "qcom,wcd9380-codec";
+
+		reset-gpios = <&tlmm 43 GPIO_ACTIVE_LOW>;
+
+		vdd-buck-supply = <&pm8350_s10>;
+		vdd-rxtx-supply = <&pm8350_s10>;
+		vdd-io-supply = <&pm8350_s10>;
+		vdd-mic-bias-supply = <&pm8350c_bob>;
+
+		qcom,micbias1-microvolt = <2750000>;
+		qcom,micbias2-microvolt = <2750000>;
+		qcom,micbias3-microvolt = <2750000>;
+		qcom,micbias4-microvolt = <2750000>;
+
+		qcom,rx-device = <&wcd_rx>;
+		qcom,tx-device = <&wcd_tx>;
+
+		#sound-dai-cells = <1>;
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		pinctrl-0 = <&vol_up_n>, <&hall_default>;
+		pinctrl-names = "default";
+
+		/*
+		 * Two hall switches, plain TLMM GPIOs (vendor hall_key/hall_key1,
+		 * abl-final-fdt.dts gpio_keys): gpio10 closes with the folio lid,
+		 * gpio23 is the second cover magnet.  SW_LID lets logind blank on close;
+		 * Connector presence is reported by the NanoSic MCU.  The
+		 * nanosic keyboard MCU reads the same magnets separately; these
+		 * switches do not depend on it.
+		 */
+		event-hall-lid {
+			label = "Hall Lid";
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_LID>;
+			gpios = <&tlmm 10 GPIO_ACTIVE_LOW>;
+			debounce-interval = <150>;
+			wakeup-source;
+		};
+
+		/* GPIO23 is a cover magnet, not pogo-pin keyboard presence.
+		 * The NanoSic MCU reports SW_TABLET_MODE on its own input device.
+		 */
+
+		key-volume-up {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&pm8350_gpios 6 GPIO_ACTIVE_LOW>;
+			debounce-interval = <15>;
+			linux,can-disable;
+			wakeup-source;
+		};
+	};
+
+	/*
+	 * The charger PD runs on ADSP and publishes PMIC_RTR_ADSP_APPS, exactly
+	 * as the vendor FDT describes.  The connector is now wired through as
+	 * well: pmic-glink UCSI reports the data role, the DWC3 follows it as an
+	 * OTG dual-role port, and the QMP combo PHY takes the cable orientation
+	 * for its lane swap.
+	 *
+	 * The cable orientation reaches the kernel only through the DP alt-mode
+	 * notification (pmic_glink_altmode), decoded as typec_orientation enum
+	 * values, and that is the source the vendor DP driver uses too -- its
+	 * dp_aux_configure_aux_switch() maps 1 -> SBU normal, 2 -> SBU reverse.
+	 * There is deliberately no "orientation-gpios" here: TLMM gpio91 is the
+	 * QMP combo PHY port-select input (see usb3_phy_portselect_default), not
+	 * a CC-orientation line.  Declaring it as an orientation GPIO made
+	 * ucsi_glink drive the USB-C port orientation from a pin that reads a
+	 * constant, which pinned the FSA4480 SBU switch to one polarity and
+	 * broke DP AUX for both cable orientations.
+	 */
