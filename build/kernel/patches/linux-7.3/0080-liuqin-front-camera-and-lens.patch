+static const struct v4l2_subdev_pad_ops imx596_pad_ops = {
+	.set_fmt = imx596_set_fmt,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.enum_mbus_code = imx596_enum_code,
+	.enum_frame_size = imx596_enum_size,
+	.get_selection = imx596_get_selection,
+	.enable_streams = imx596_enable_streams,
+	.disable_streams = imx596_disable_streams,
+};
+static const struct v4l2_subdev_ops imx596_ops = {
+	.video = &imx596_video_ops,
+	.pad = &imx596_pad_ops,
+};
+static const struct v4l2_subdev_internal_ops imx596_internal_ops = {
+	.init_state = imx596_init_state,
+};
+static const struct media_entity_operations imx596_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static int imx596_power_on(struct device *dev)
+{
+	struct imx596 *sensor = to_imx596(dev_get_drvdata(dev));
+	int ret;
+
+	ret = regulator_enable(sensor->dvdd);
+	if (ret)
+		return ret;
+	ret = regulator_enable(sensor->iovdd);
+	if (ret)
+		goto disable_dvdd;
+	ret = regulator_enable(sensor->avdd);
+	if (ret)
+		goto disable_iovdd;
+	/* AAC module powerSetting: AVDD, wait 2 ms, reset, MCLK, wait 11 ms. */
+	usleep_range(2000, 2500);
+	gpiod_set_value_cansleep(sensor->reset, 0);
+	ret = clk_prepare_enable(sensor->xclk);
+	if (ret)
+		goto assert_reset;
+	usleep_range(11000, 12000);
+	return 0;
+
+assert_reset:
+	gpiod_set_value_cansleep(sensor->reset, 1);
+	regulator_disable(sensor->avdd);
+disable_iovdd:
+	regulator_disable(sensor->iovdd);
+disable_dvdd:
+	regulator_disable(sensor->dvdd);
+	return ret;
+}
+
+static int imx596_power_off(struct device *dev)
+{
+	struct imx596 *sensor = to_imx596(dev_get_drvdata(dev));
+
+	clk_disable_unprepare(sensor->xclk);
+	usleep_range(1000, 1500);
+	gpiod_set_value_cansleep(sensor->reset, 1);
+	usleep_range(1000, 1500);
+	regulator_disable(sensor->dvdd);
+	regulator_disable(sensor->iovdd);
+	regulator_disable(sensor->avdd);
+	return 0;
+}
+
+static int imx596_check_endpoint(struct device *dev)
+{
+	struct v4l2_fwnode_endpoint ep = { .bus_type = V4L2_MBUS_CSI2_DPHY };
+	struct fwnode_handle *fwnode;
+	unsigned long bitmap;
+	int ret;
+
+	fwnode = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!fwnode)
+		return -EINVAL;
+	ret = v4l2_fwnode_endpoint_alloc_parse(fwnode, &ep);
+	fwnode_handle_put(fwnode);
+	if (ret)
+		return ret;
+	if (ep.bus.mipi_csi2.num_data_lanes != 4)
+		ret = -EINVAL;
+	else
+		ret = v4l2_link_freq_to_bitmap(dev, ep.link_frequencies,
+			ep.nr_of_link_frequencies, imx596_link_freqs, 1, &bitmap);
+	v4l2_fwnode_endpoint_free(&ep);
+	return ret;
+}
+
+static int imx596_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct imx596 *sensor;
+	u64 id;
+	int ret;
+
+	sensor = devm_kzalloc(dev, sizeof(*sensor), GFP_KERNEL);
+	if (!sensor)
+		return -ENOMEM;
+	sensor->dev = dev;
+	v4l2_i2c_subdev_init(&sensor->sd, client, &imx596_ops);
+	sensor->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sensor->regmap))
+		return PTR_ERR(sensor->regmap);
+	sensor->xclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(sensor->xclk))
+		return dev_err_probe(dev, PTR_ERR(sensor->xclk), "no MCLK\n");
+	if (clk_get_rate(sensor->xclk) != IMX596_XCLK)
+		return dev_err_probe(dev, -EINVAL, "19.2 MHz MCLK required\n");
+	sensor->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(sensor->reset))
+		return dev_err_probe(dev, PTR_ERR(sensor->reset), "no reset GPIO\n");
+	sensor->avdd = devm_regulator_get(dev, "avdd");
+	if (IS_ERR(sensor->avdd))
+		return dev_err_probe(dev, PTR_ERR(sensor->avdd), "no AVDD\n");
+	sensor->dvdd = devm_regulator_get(dev, "dvdd");
+	if (IS_ERR(sensor->dvdd))
+		return dev_err_probe(dev, PTR_ERR(sensor->dvdd), "no DVDD\n");
+	sensor->iovdd = devm_regulator_get(dev, "iovdd");
+	if (IS_ERR(sensor->iovdd))
+		return dev_err_probe(dev, PTR_ERR(sensor->iovdd), "no IOVDD\n");
+	ret = imx596_check_endpoint(dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "invalid CSI-2 endpoint\n");
+	ret = imx596_power_on(dev);
+	if (ret)
+		return ret;
+	ret = cci_read(sensor->regmap, CCI_REG16(0x0016), &id, NULL);
+	if (ret)
+		goto power_off;
+	if (id != 0x0596) {
+		ret = dev_err_probe(dev, -ENODEV, "unexpected chip ID 0x%04llx\n", id);
+		goto power_off;
+	}
+	sensor->mode = &imx596_modes[0];
+	ret = imx596_init_controls(sensor);
+	if (ret)
+		goto free_controls;
+	sensor->sd.state_lock = sensor->ctrls.lock;
+	sensor->sd.internal_ops = &imx596_internal_ops;
+	sensor->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sensor->sd.entity.ops = &imx596_entity_ops;
+	sensor->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sensor->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&sensor->sd.entity, 1, &sensor->pad);
+	if (ret)
+		goto free_controls;
+	ret = v4l2_subdev_init_finalize(&sensor->sd);
+	if (ret)
+		goto clean_entity;
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	ret = v4l2_async_register_subdev_sensor(&sensor->sd);
+	if (ret)
+		goto disable_pm;
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_put_autosuspend(dev);
+	dev_info(dev, "IMX596: AAC RAW10, 3 sizes, 19.2 MHz MCLK\n");
+	return 0;
+
+disable_pm:
+	pm_runtime_disable(dev);
+	pm_runtime_put_noidle(dev);
+	pm_runtime_set_suspended(dev);
+	v4l2_subdev_cleanup(&sensor->sd);
+clean_entity:
+	media_entity_cleanup(&sensor->sd.entity);
+free_controls:
+	v4l2_ctrl_handler_free(&sensor->ctrls);
+power_off:
+	imx596_power_off(dev);
+	return ret;
+}
+
+static void imx596_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		imx596_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct dev_pm_ops imx596_pm_ops = {
+	SET_RUNTIME_PM_OPS(imx596_power_off, imx596_power_on, NULL)
+};
+static const struct of_device_id imx596_of_match[] = {
+	{ .compatible = "sony,imx596" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, imx596_of_match);
+
+static struct i2c_driver imx596_driver = {
+	.driver = {
+		.name = "imx596",
+		.pm = &imx596_pm_ops,
+		.of_match_table = imx596_of_match,
+	},
+	.probe = imx596_probe,
+	.remove = imx596_remove,
+};
+module_i2c_driver(imx596_driver);
+
+MODULE_DESCRIPTION("Sony IMX596 image sensor driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/regulator/qcom-rpmh-regulator.c b/drivers/regulator/qcom-rpmh-regulator.c
index 25c14de3c..4422e7b1c 100644
--- a/drivers/regulator/qcom-rpmh-regulator.c
+++ b/drivers/regulator/qcom-rpmh-regulator.c
@@ -10,6 +10,7 @@
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
+#include <linux/platform_data/liuqin.h>
 #include <linux/slab.h>
 #include <linux/string.h>
 #include <linux/regulator/driver.h>
@@ -549,6 +550,23 @@ static int rpmh_regulator_init_vreg(struct rpmh_vreg *vreg, struct device *dev,
 		vreg->rdesc.n_voltages = rpmh_data->hw_data->n_voltages;
 	}
 
+	/*
+	 * Liuqin's camera VAF firmware vote must be exactly the stock 3100 mV.
+	 * Rounding this request to the generic PLDO's 3104 mV causes a reset
+	 * when L7C is enabled. RPMh accepts millivolts, independently of the
+	 * PMIC selector table. This dedicated board rail has one operating point.
+	 */
+	if (liuqin_board_quirks() &&
+	    of_device_is_compatible(dev->of_node, "qcom,pm8350c-rpmh-regulators") &&
+	    !strcmp(rpmh_resource_name, "ldoc7")) {
+		static const struct linear_range vaf_range =
+			REGULATOR_LINEAR_RANGE(3100000, 0, 0, 0);
+
+		vreg->rdesc.linear_ranges = &vaf_range;
+		vreg->rdesc.n_linear_ranges = 1;
+		vreg->rdesc.n_voltages = 1;
+	}
+
 	vreg->always_wait_for_ack = of_property_read_bool(node,
 						"qcom,always-wait-for-ack");
 
