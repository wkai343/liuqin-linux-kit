+static int imx596_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx596 *sensor = container_of(ctrl->handler, struct imx596, ctrls);
+	int ret = 0, release;
+
+	if (ctrl->id == V4L2_CID_VBLANK)
+		__v4l2_ctrl_modify_range(sensor->exposure, 1,
+			sensor->mode->height + ctrl->val - IMX596_MARGIN, 1, 1000);
+
+	if (!pm_runtime_get_if_in_use(sensor->dev))
+		return 0;
+
+	cci_write(sensor->regmap, CCI_REG8(0x0104), 1, &ret);
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(sensor->regmap, CCI_REG16(0x0202), ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(sensor->regmap, CCI_REG16(0x0204), ctrl->val, &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(sensor->regmap, CCI_REG16(0x0340),
+			  sensor->mode->height + ctrl->val, &ret);
+		/* Lowering VTS may also clamp the cached exposure. */
+		cci_write(sensor->regmap, CCI_REG16(0x0202),
+			  sensor->exposure->val, &ret);
+		break;
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		cci_write(sensor->regmap, CCI_REG8(0x0101),
+			  sensor->hflip->val | (sensor->vflip->val << 1), &ret);
+		break;
+	default:
+		ret = -EINVAL;
+	}
+	/* Always release group hold, including after a failed data write. */
+	release = cci_write(sensor->regmap, CCI_REG8(0x0104), 0, NULL);
+	pm_runtime_put(sensor->dev);
+	return ret ?: release;
+}
+
+static const struct v4l2_ctrl_ops imx596_ctrl_ops = {
+	.s_ctrl = imx596_set_ctrl,
+};
+
+static int imx596_init_controls(struct imx596 *sensor)
+{
+	struct v4l2_ctrl_handler *hdl = &sensor->ctrls;
+	const struct imx596_mode *mode = sensor->mode;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	int ret;
+
+	v4l2_ctrl_handler_init(hdl, 10);
+	ctrl = v4l2_ctrl_new_int_menu(hdl, NULL, V4L2_CID_LINK_FREQ,
+				    0, 0, imx596_link_freqs);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	sensor->pixel_rate = v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_PIXEL_RATE,
+			 mode->pixel_rate, mode->pixel_rate, 1, mode->pixel_rate);
+	sensor->hblank = v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_HBLANK,
+			 mode->hts - mode->width, mode->hts - mode->width, 1,
+			 mode->hts - mode->width);
+	if (sensor->hblank)
+		sensor->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	sensor->vblank = v4l2_ctrl_new_std(hdl, &imx596_ctrl_ops, V4L2_CID_VBLANK,
+		mode->vts_min - mode->height, 0xffff - mode->height, 1,
+		mode->vts_def - mode->height);
+	sensor->exposure = v4l2_ctrl_new_std(hdl, &imx596_ctrl_ops,
+		V4L2_CID_EXPOSURE, 1, mode->vts_def - IMX596_MARGIN, 1, 1000);
+	v4l2_ctrl_new_std(hdl, &imx596_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			 0, 1008, 1, 0);
+
+	sensor->hflip = v4l2_ctrl_new_std(hdl, &imx596_ctrl_ops,
+				       V4L2_CID_HFLIP, 0, 1, 1, 0);
+	sensor->vflip = v4l2_ctrl_new_std(hdl, &imx596_ctrl_ops,
+				       V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (hdl->error)
+		return hdl->error;
+	sensor->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+	sensor->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+	ret = v4l2_fwnode_device_parse(sensor->dev, &props);
+	if (ret)
+		return ret;
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, &imx596_ctrl_ops, &props);
+	sensor->sd.ctrl_handler = hdl;
+	return ret;
+}
+
+static u32 imx596_code(struct imx596 *sensor)
+{
+	return imx596_codes[sensor->hflip->val | (sensor->vflip->val << 1)];
+}
+
+static int imx596_set_fmt(struct v4l2_subdev *sd,
+			struct v4l2_subdev_state *state,
+			struct v4l2_subdev_format *fmt)
+{
+	struct imx596 *sensor = to_imx596(sd);
+	const struct imx596_mode *mode;
+
+	if (v4l2_subdev_is_streaming(sd) && fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE)
+		return -EBUSY;
+	mode = v4l2_find_nearest_size(imx596_modes, ARRAY_SIZE(imx596_modes),
+				      width, height, fmt->format.width,
+				      fmt->format.height);
+	fmt->format = (struct v4l2_mbus_framefmt) {
+		.width = mode->width,
+		.height = mode->height,
+		.code = imx596_code(to_imx596(sd)),
+		.field = V4L2_FIELD_NONE,
+		.colorspace = V4L2_COLORSPACE_RAW,
+		.quantization = V4L2_QUANTIZATION_FULL_RANGE,
+		.xfer_func = V4L2_XFER_FUNC_NONE,
+	};
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+	*v4l2_subdev_state_get_crop(state, 0) = mode->crop;
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		sensor->mode = mode;
+		__v4l2_ctrl_modify_range(sensor->pixel_rate, mode->pixel_rate,
+					mode->pixel_rate, 1, mode->pixel_rate);
+		__v4l2_ctrl_modify_range(sensor->hblank, mode->hts - mode->width,
+					mode->hts - mode->width, 1,
+					mode->hts - mode->width);
+		__v4l2_ctrl_modify_range(sensor->vblank, mode->vts_min - mode->height,
+					0xffff - mode->height, 1,
+					mode->vts_def - mode->height);
+		__v4l2_ctrl_s_ctrl(sensor->vblank, mode->vts_def - mode->height);
+		/* Refresh even if the VBLANK value did not change. */
+		__v4l2_ctrl_modify_range(sensor->exposure, 1,
+					mode->vts_def - IMX596_MARGIN, 1, 1000);
+	}
+	return 0;
+}
+
+static int imx596_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.format = { .width = 2592, .height = 1952 },
+	};
+
+	return imx596_set_fmt(sd, state, &fmt);
+}
+
+static int imx596_enum_code(struct v4l2_subdev *sd,
+			    struct v4l2_subdev_state *state,
+			    struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+	code->code = imx596_code(to_imx596(sd));
+	return 0;
+}
+
+static int imx596_enum_size(struct v4l2_subdev *sd,
+			    struct v4l2_subdev_state *state,
+			    struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(imx596_modes) ||
+	    fse->code != imx596_code(to_imx596(sd)))
+		return -EINVAL;
+	fse->min_width = fse->max_width = imx596_modes[fse->index].width;
+	fse->min_height = fse->max_height = imx596_modes[fse->index].height;
+	return 0;
+}
+
+static int imx596_get_selection(struct v4l2_subdev *sd,
+			       struct v4l2_subdev_state *state,
+			       struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+		sel->r = (struct v4l2_rect) { .width = 5184, .height = 3904 };
+		return 0;
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int imx596_enable_streams(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state, u32 pad, u64 mask)
+{
+	struct imx596 *sensor = to_imx596(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sensor->dev);
+	if (ret)
+		return ret;
+	cci_multi_reg_write(sensor->regmap, imx596_init,
+			    ARRAY_SIZE(imx596_init), &ret);
+	cci_multi_reg_write(sensor->regmap, sensor->mode->regs,
+			    sensor->mode->num_regs, &ret);
+	if (!ret)
+		ret = __v4l2_ctrl_handler_setup(&sensor->ctrls);
+	cci_write(sensor->regmap, CCI_REG8(0x0100), 1, &ret);
+	if (ret) {
+		cci_write(sensor->regmap, CCI_REG8(0x0100), 0, NULL);
+		pm_runtime_put_autosuspend(sensor->dev);
+		return ret;
+	}
+	__v4l2_ctrl_grab(sensor->hflip, true);
+	__v4l2_ctrl_grab(sensor->vflip, true);
+	return 0;
+}
+
+static int imx596_disable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad, u64 mask)
+{
+	struct imx596 *sensor = to_imx596(sd);
+	int ret;
+
+	ret = cci_write(sensor->regmap, CCI_REG8(0x0100), 0, NULL);
+	if (ret)
+		dev_warn(sensor->dev, "stream stop failed: %d\n", ret);
+	__v4l2_ctrl_grab(sensor->hflip, false);
+	__v4l2_ctrl_grab(sensor->vflip, false);
+	pm_runtime_put_autosuspend(sensor->dev);
+	return 0;
+}
