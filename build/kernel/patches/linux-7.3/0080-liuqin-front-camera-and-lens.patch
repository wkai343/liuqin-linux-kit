diff --git a/drivers/media/i2c/gt9764.c b/drivers/media/i2c/gt9764.c
new file mode 100644
index 000000000..1a8243f58
--- /dev/null
+++ b/drivers/media/i2c/gt9764.c
@@ -0,0 +1,219 @@
+// SPDX-License-Identifier: GPL-2.0
+/* GT9764 in the liuqin Q-Tech S5KJN1 module. */
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <media/v4l2-async.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+
+#define GT9764_MOVE_US 7000
+#define GT9764_PARK_STEP 16
+
+struct gt9764 {
+	struct v4l2_subdev sd;
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *focus;
+	struct regmap *regmap;
+	struct regulator_bulk_data supplies[2];
+	u16 position;
+};
+
+static inline struct gt9764 *to_gt9764(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct gt9764, sd);
+}
+
+static int gt9764_move(struct gt9764 *lens, unsigned int position)
+{
+	int ret = cci_write(lens->regmap, CCI_REG16(0x03), position, NULL);
+
+	if (!ret)
+		lens->position = position;
+	return ret;
+}
+
+/* Approach/leave the requested code gradually when enabling/disabling power. */
+static int gt9764_ramp(struct gt9764 *lens, unsigned int target)
+{
+	int position = lens->position;
+	int ret;
+
+	while (position != target) {
+		position += clamp_t(int, (int)target - position,
+				    -GT9764_PARK_STEP, GT9764_PARK_STEP);
+		ret = gt9764_move(lens, position);
+		if (ret)
+			return ret;
+		usleep_range(GT9764_MOVE_US, GT9764_MOVE_US + 500);
+	}
+	return 0;
+}
+
+static int gt9764_resume(struct device *dev)
+{
+	struct gt9764 *lens = to_gt9764(dev_get_drvdata(dev));
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(lens->supplies), lens->supplies);
+	if (ret)
+		return ret;
+	usleep_range(3000, 3500);
+	/* Q-Tech actuatorDriverData: each write is followed by 100 us. */
+	cci_write(lens->regmap, CCI_REG8(0x02), 0x02, &ret);
+	usleep_range(100, 200);
+	cci_write(lens->regmap, CCI_REG8(0x06), 0x40, &ret);
+	usleep_range(100, 200);
+	cci_write(lens->regmap, CCI_REG8(0x07), 0x6a, &ret);
+	usleep_range(100, 200);
+	lens->position = 0;
+	if (!ret)
+		ret = gt9764_ramp(lens, lens->focus->val);
+	if (ret)
+		regulator_bulk_disable(ARRAY_SIZE(lens->supplies), lens->supplies);
+	return ret;
+}
+
+static int gt9764_suspend(struct device *dev)
+{
+	struct gt9764 *lens = to_gt9764(dev_get_drvdata(dev));
+	int ret;
+
+	ret = gt9764_ramp(lens, 0);
+	if (ret)
+		dev_warn(dev, "lens parking failed: %d\n", ret);
+	cci_write(lens->regmap, CCI_REG8(0x02), 0x01, NULL);
+	usleep_range(1000, 1500);
+	return regulator_bulk_disable(ARRAY_SIZE(lens->supplies), lens->supplies);
+}
+
+static int gt9764_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct gt9764 *lens = container_of(ctrl->handler, struct gt9764, ctrls);
+	int ret;
+
+	ret = pm_runtime_get_if_in_use(lens->sd.dev);
+	if (ret <= 0)
+		return ret;
+	ret = gt9764_move(lens, ctrl->val);
+	pm_runtime_put(lens->sd.dev);
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops gt9764_ctrl_ops = {
+	.s_ctrl = gt9764_set_ctrl,
+};
+
+static int gt9764_open(struct v4l2_subdev *sd, struct v4l2_subdev_fh *fh)
+{
+	return pm_runtime_resume_and_get(sd->dev);
+}
+
+static int gt9764_close(struct v4l2_subdev *sd, struct v4l2_subdev_fh *fh)
+{
+	pm_runtime_put_autosuspend(sd->dev);
+	return 0;
+}
+
+static const struct v4l2_subdev_internal_ops gt9764_internal_ops = {
+	.open = gt9764_open,
+	.close = gt9764_close,
+};
+static const struct v4l2_subdev_ops gt9764_ops = { };
+
+static int gt9764_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct gt9764 *lens;
+	int ret;
+
+	lens = devm_kzalloc(dev, sizeof(*lens), GFP_KERNEL);
+	if (!lens)
+		return -ENOMEM;
+	v4l2_i2c_subdev_init(&lens->sd, client, &gt9764_ops);
+	lens->regmap = devm_cci_regmap_init_i2c(client, 8);
+	if (IS_ERR(lens->regmap))
+		return PTR_ERR(lens->regmap);
+	lens->supplies[0].supply = "vdd";
+	lens->supplies[1].supply = "vddio";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(lens->supplies), lens->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot get lens supplies\n");
+	v4l2_ctrl_handler_init(&lens->ctrls, 1);
+	lens->focus = v4l2_ctrl_new_std(&lens->ctrls, &gt9764_ctrl_ops,
+				      V4L2_CID_FOCUS_ABSOLUTE, 0, 1023, 1, 0);
+	ret = lens->ctrls.error;
+	if (ret)
+		goto free_ctrls;
+	lens->sd.ctrl_handler = &lens->ctrls;
+	lens->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	lens->sd.internal_ops = &gt9764_internal_ops;
+	lens->sd.entity.function = MEDIA_ENT_F_LENS;
+	ret = media_entity_pads_init(&lens->sd.entity, 0, NULL);
+	if (ret)
+		goto free_ctrls;
+
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_enable(dev);
+	if (!IS_ENABLED(CONFIG_PM)) {
+		ret = gt9764_resume(dev);
+		if (ret)
+			goto disable_pm;
+	}
+	ret = v4l2_async_register_subdev(&lens->sd);
+	if (ret)
+		goto power_off;
+	return 0;
+
+power_off:
+	if (!IS_ENABLED(CONFIG_PM))
+		gt9764_suspend(dev);
+disable_pm:
+	pm_runtime_disable(dev);
+	media_entity_cleanup(&lens->sd.entity);
+free_ctrls:
+	v4l2_ctrl_handler_free(&lens->ctrls);
+	return ret;
+}
+
+static void gt9764_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct gt9764 *lens = to_gt9764(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		gt9764_suspend(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&lens->ctrls);
+}
+
+static const struct dev_pm_ops gt9764_pm_ops = {
+	SET_SYSTEM_SLEEP_PM_OPS(pm_runtime_force_suspend, pm_runtime_force_resume)
+	SET_RUNTIME_PM_OPS(gt9764_suspend, gt9764_resume, NULL)
+};
+static const struct of_device_id gt9764_of_match[] = {
+	{ .compatible = "qtech,liuqin-gt9764" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, gt9764_of_match);
+
+static struct i2c_driver gt9764_driver = {
+	.driver = {
+		.name = "gt9764",
+		.pm = &gt9764_pm_ops,
+		.of_match_table = gt9764_of_match,
+	},
+	.probe = gt9764_probe,
+	.remove = gt9764_remove,
+};
+module_i2c_driver(gt9764_driver);
+
+MODULE_DESCRIPTION("GT9764 lens driver for the liuqin Q-Tech module");
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/i2c/imx596.c b/drivers/media/i2c/imx596.c
new file mode 100644
index 000000000..490e83dee
--- /dev/null
+++ b/drivers/media/i2c/imx596.c
@@ -0,0 +1,1125 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Sony IMX596, AAC front module on Xiaomi liuqin.
+ * Register tables: OS2.0.6.0.VMYCNXM sensor module, common init and modes 0-3.
+ * V4L2 integration derived from the S5KJN1 driver, Copyright (c) 2025 Linaro Ltd.
+ */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+
+#define IMX596_MARGIN 24
+#define IMX596_XCLK 19200000
+
+static const s64 imx596_link_freqs[] = { 678400000 };
+static const u32 imx596_codes[] = {
+	MEDIA_BUS_FMT_SRGGB10_1X10, MEDIA_BUS_FMT_SGRBG10_1X10,
+	MEDIA_BUS_FMT_SGBRG10_1X10, MEDIA_BUS_FMT_SBGGR10_1X10,
+};
+
+struct imx596_mode {
+	u32 width, height;
+	u32 hts, vts_def, vts_min;
+	u64 pixel_rate;
+	struct v4l2_rect crop;
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
+struct imx596 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *xclk;
+	struct gpio_desc *reset;
+	struct regulator *avdd, *dvdd, *iovdd;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *exposure, *vblank, *hflip, *vflip;
+	struct v4l2_ctrl *hblank, *pixel_rate;
+	const struct imx596_mode *mode;
+};
+
+static inline struct imx596 *to_imx596(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct imx596, sd);
+}
+
+static const struct cci_reg_sequence imx596_init[] = {
+	{ CCI_REG8(0x0136), 0x13 },
+	{ CCI_REG8(0x0137), 0x33 },
+	{ CCI_REG8(0x321c), 0x00 },
