new file mode 100644
index 000000000..0fed17944
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/qtech,liuqin-gt9764.yaml
@@ -0,0 +1,29 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/qtech,liuqin-gt9764.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Q-Tech liuqin GT9764 voice coil lens actuator
+
+maintainers:
+  - wk <58632380+wkai343@users.noreply.github.com>
+
+description: |
+  Giantec GT9764 with the Q-Tech S5KJN1 module's resonance configuration.
+  The module uses 3.1 V actuator power and a 1.8 V CCI I/O rail shared
+  with the sensor. The module compatible selects its AAC timing.
+
+properties:
+  compatible:
+    const: qtech,liuqin-gt9764
+  reg:
+    maxItems: 1
+  vdd-supply: true
+  vddio-supply: true
+required:
+  - compatible
+  - reg
+  - vdd-supply
+  - vddio-supply
+additionalProperties: false
