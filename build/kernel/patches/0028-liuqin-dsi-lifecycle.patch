+++ b/drivers/gpu/drm/msm/dsi/dsi.h
@@ -58,6 +58,8 @@
 void msm_dsi_manager_unregister(struct msm_dsi *msm_dsi);
 void msm_dsi_manager_tpg_enable(void);
 
+int msm_dsi_manager_panel_stage(int id, enum mipi_dsi_panel_stage stage);
+
 /* dsi host */
 struct msm_dsi_host;
 int msm_dsi_host_xfer_prepare(struct mipi_dsi_host *host,
@@ -72,6 +74,7 @@
 					const struct mipi_dsi_msg *msg);
 void msm_dsi_host_cmd_xfer_commit(struct mipi_dsi_host *host,
 					u32 dma_base, u32 len);
+int msm_dsi_host_stop_video(struct mipi_dsi_host *host);
 int msm_dsi_host_enable(struct mipi_dsi_host *host);
 int msm_dsi_host_disable(struct mipi_dsi_host *host);
 void msm_dsi_host_enable_irq(struct mipi_dsi_host *host);
diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -8,6 +8,7 @@
 #include <linux/dma-mapping.h>
 #include <linux/err.h>
 #include <linux/interrupt.h>
+#include <linux/iopoll.h>
 #include <linux/mfd/syscon.h>
 #include <linux/of.h>
 #include <linux/of_graph.h>
@@ -1762,11 +1763,20 @@
 	return ret;
 }
 
+static int dsi_host_panel_stage(struct mipi_dsi_host *host,
+				enum mipi_dsi_panel_stage stage)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+
+	return msm_dsi_manager_panel_stage(msm_host->id, stage);
+}
+
 static const struct mipi_dsi_host_ops dsi_host_ops = {
 	.attach = dsi_host_attach,
 	.detach = dsi_host_detach,
 	.transfer = dsi_host_transfer,
 	.transfer_batch = dsi_host_transfer_batch,
+	.panel_stage = dsi_host_panel_stage,
 };
 
 /*
@@ -2462,6 +2472,29 @@
 	return 0;
 }
 
+/* Keep the command engine available for panel OFF and POST_OFF. */
+int msm_dsi_host_stop_video(struct mipi_dsi_host *host)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+	u32 value;
+	int ret;
+
+	if (!msm_host->power_on)
+		return -EIO;
+	value = dsi_read(msm_host, REG_DSI_CTRL);
+	dsi_write(msm_host, REG_DSI_CTRL, value & ~DSI_CTRL_VID_MODE_EN);
+	ret = read_poll_timeout(dsi_read, value,
+				!(value & DSI_STATUS0_VIDEO_MODE_ENGINE_BUSY),
+				1000, 50000, false, msm_host, REG_DSI_STATUS0);
+	/* Match the OEM busy-engine fallback, without resetting idle hosts. */
+	if (ret) {
+		dev_warn(&msm_host->pdev->dev, "Video stop timed out; reset host\n");
+		dsi_sw_reset(msm_host);
+	}
+	msm_host->enabled = false;
+	return 0;
+}
+
 int msm_dsi_host_disable(struct mipi_dsi_host *host)
 {
 	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
diff --git a/drivers/gpu/drm/msm/dsi/dsi_manager.c b/drivers/gpu/drm/msm/dsi/dsi_manager.c
--- a/drivers/gpu/drm/msm/dsi/dsi_manager.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_manager.c
@@ -2,6 +2,11 @@
 /*
