From: Liuqin Linux Kit <build@liuqin.invalid>
Subject: [PATCH] drm: coordinate Liuqin DSI panel stages and clock gating

Add independently selectable boot-time controls for video start after
ON/PPS, video stop before OFF with link shutdown before panel rails,
and OEM pixel/master-PHY dynamic gating. All controls default off.
Only a known Liuqin OEM panel on the bonded SM8450 pair opts in.

The command mutex serializes stage changes with paired transfers.
DISPCC updates use its shared regmap and preserve unrelated fields.
Clear gating before stopping HS clocks; never gate the slave PHY.
Keep the established command tables, PHY timings and panel delays.

Signed-off-by: Liuqin Linux Kit <build@liuqin.invalid>
---
diff --git a/include/drm/drm_mipi_dsi.h b/include/drm/drm_mipi_dsi.h
--- a/include/drm/drm_mipi_dsi.h
+++ b/include/drm/drm_mipi_dsi.h
@@ -64,11 +64,21 @@
 int mipi_dsi_create_packet(struct mipi_dsi_packet *packet,
 			   const struct mipi_dsi_msg *msg);
 
+/* Optional panel/host lifecycle coordination, called outside transfers. */
+enum mipi_dsi_panel_stage {
+	MIPI_DSI_PANEL_PREPARED,
+	MIPI_DSI_PANEL_DISABLING,
+	MIPI_DSI_PANEL_UNPREPARING,
+	MIPI_DSI_PANEL_PREPARE_FAILED,
+};
+
 /**
  * struct mipi_dsi_host_ops - DSI bus operations
  * @attach: attach DSI device to DSI host
  * @detach: detach DSI device from DSI host
  * @transfer: transmit a DSI packet
+ * @panel_stage: optional sleepable panel lifecycle notification; no transfer
+ *     lock may be held by the caller. Returns zero or a negative error.
  * @transfer_batch: optional ordered write group with no interleaved commands.
  *     All messages use the same channel and transfer flags. Returns the sum
  *     of payload lengths, or a negative error; a failed group must not be
@@ -98,6 +108,8 @@
 		      struct mipi_dsi_device *dsi);
 	ssize_t (*transfer)(struct mipi_dsi_host *host,
 			    const struct mipi_dsi_msg *msg);
+	int (*panel_stage)(struct mipi_dsi_host *host,
+			   enum mipi_dsi_panel_stage stage);
 	ssize_t (*transfer_batch)(struct mipi_dsi_host *host,
 				  const struct mipi_dsi_msg *msgs, size_t count);
 };
@@ -145,6 +157,9 @@
 /* transmit data ending at the same time for all lanes within one hsync */
 #define MIPI_DSI_HS_PKT_END_ALIGNED	BIT(12)
 
+/* Panel coordinates commands and rails with an optional host callback. */
+#define MIPI_DSI_MODE_PANEL_STAGES	BIT(13)
+
 enum mipi_dsi_pixel_format {
 	MIPI_DSI_FMT_RGB888,
 	MIPI_DSI_FMT_RGB666,
@@ -271,6 +286,15 @@
 devm_mipi_dsi_device_register_full(struct device *dev, struct mipi_dsi_host *host,
 				   const struct mipi_dsi_device_info *info);
 struct mipi_dsi_device *of_find_mipi_dsi_device_by_node(struct device_node *np);
+static inline int mipi_dsi_panel_stage(struct mipi_dsi_device *dsi,
+				       enum mipi_dsi_panel_stage stage)
+{
+	if (!(dsi->mode_flags & MIPI_DSI_MODE_PANEL_STAGES) ||
+	    !dsi->host->ops->panel_stage)
+		return 0;
+	return dsi->host->ops->panel_stage(dsi->host, stage);
+}
+
 int mipi_dsi_attach(struct mipi_dsi_device *dsi);
 int mipi_dsi_detach(struct mipi_dsi_device *dsi);
 int devm_mipi_dsi_attach(struct device *dev, struct mipi_dsi_device *dsi);
