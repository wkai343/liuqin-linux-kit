  */
+
+#include <linux/module.h>
+#include <linux/of_address.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
 
 #include "drm/drm_bridge_connector.h"
 
@@ -277,6 +282,238 @@
 	dsi_mgr_phy_disable(id);
 }
 
+/* Boot-only controls: all-off preserves the existing bridge path. */
+static bool liuqin_oem_video_order;
+module_param(liuqin_oem_video_order, bool, 0400);
+MODULE_PARM_DESC(liuqin_oem_video_order, "Start Liuqin video after panel ON/PPS");
+static bool liuqin_oem_shutdown_order;
+module_param(liuqin_oem_shutdown_order, bool, 0400);
+MODULE_PARM_DESC(liuqin_oem_shutdown_order, "Stop Liuqin video before panel OFF");
+static bool liuqin_oem_clk_gating;
+module_param(liuqin_oem_clk_gating, bool, 0400);
+MODULE_PARM_DESC(liuqin_oem_clk_gating, "Gate Liuqin pixels and master PHY");
+
+/* DISPCC MISC_CMD fields shared by the bonded pair, excluding MDP. */
+#define LIUQIN_DISP_CC_MISC_CMD	0xf000
+#define LIUQIN_DSI_GATING_MASK	((u32)GENMASK(10, 5))
+#define LIUQIN_DSI_GATING_ON	((u32)(BIT(5) | BIT(6) | BIT(9)))
+
+static struct {
+	bool active;
+	bool powered;
+	bool gated;
+	unsigned int video;
+} liuqin_dsi;
+
+static bool liuqin_dsi_requested(void)
+{
+	unsigned long required = MIPI_DSI_MODE_PANEL_STAGES |
+		MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+		MIPI_DSI_CLOCK_NON_CONTINUOUS;
+	struct msm_dsi *dsi;
+	int i;
+
+	if (!(liuqin_oem_video_order || liuqin_oem_shutdown_order ||
+	      liuqin_oem_clk_gating) || !IS_BONDED_DSI() ||
+	    !IS_SYNC_NEEDED() || !IS_MASTER_DSI_LINK(DSI_CLOCK_MASTER))
+		return false;
+	for (i = 0; i < DSI_MAX; i++) {
+		dsi = dsi_mgr_get_dsi(i);
+		if (!dsi || !dsi->host ||
+		    !of_device_is_compatible(dsi->pdev->dev.of_node,
+					     "qcom,sm8450-dsi-ctrl") ||
+		    (msm_dsi_host_get_mode_flags(dsi->host) & required) != required)
+			return false;
+	}
+	return true;
+}
+
+static int liuqin_dsi_set_gating(bool on)
+{
+	struct device *dev = &dsi_mgr_get_dsi(DSI_CLOCK_MASTER)->pdev->dev;
+	struct of_phandle_args args;
+	struct platform_device *provider;
+	struct resource resource;
+	struct regmap *map;
+	int index, ret;
+
+	index = of_property_match_string(dev->of_node, "clock-names", "byte");
+	if (index < 0)
+		return index;
+	ret = of_parse_phandle_with_args(dev->of_node, "clocks",
+					 "#clock-cells", index, &args);
+	if (ret)
+		return ret;
+	if (!of_device_is_compatible(args.np, "qcom,sm8475-dispcc") ||
+	    of_address_to_resource(args.np, 0, &resource) ||
+	    resource_size(&resource) < LIUQIN_DISP_CC_MISC_CMD + sizeof(u32)) {
+		of_node_put(args.np);
+		return -ENODEV;
+	}
+	provider = of_find_device_by_node(args.np);
+	of_node_put(args.np);
+	if (!provider)
+		return -ENODEV;
+
+	/* Serialize with provider unbind; never cache a devm-owned regmap. */
+	device_lock(&provider->dev);
+	map = provider->dev.driver ? dev_get_regmap(&provider->dev, NULL) : NULL;
+	ret = map ? pm_runtime_resume_and_get(&provider->dev) : -ENODEV;
+	if (ret >= 0) {
+		ret = regmap_update_bits(map, LIUQIN_DISP_CC_MISC_CMD,
+					 LIUQIN_DSI_GATING_MASK,
+					 on ? LIUQIN_DSI_GATING_ON : 0);
+		pm_runtime_put(&provider->dev);
+	}
+	device_unlock(&provider->dev);
+	put_device(&provider->dev);
+	if (!ret)
+		dev_info(dev, "Liuqin DSI gating %s, mask %#x value %#x\n",
+			 on ? "on" : "off", LIUQIN_DSI_GATING_MASK,
+			 on ? LIUQIN_DSI_GATING_ON : 0);
+	return ret;
+}
+
+/* All helpers below run under dsi_cmd_lock, outside host cmd_mutex. */
+static int liuqin_dsi_video_start(void)
+{
+	int i, ret;
+
+	if (!liuqin_dsi.powered)
+		return -EIO;
+	for (i = 0; i < DSI_MAX; i++) {
+		if (liuqin_dsi.video & BIT(i))
+			continue;
+		ret = msm_dsi_host_enable(dsi_mgr_get_dsi(i)->host);
+		if (ret)
+			return ret;
+		liuqin_dsi.video |= BIT(i);
+	}
+	pr_info("Liuqin DSI: video pair started, after_pps=%u\n",
+		liuqin_oem_video_order);
+	return 0;
+}
+
+static int liuqin_dsi_video_stop(void)
+{
+	int i, ret;
+
+	for (i = 0; i < DSI_MAX; i++) {
+		if (!(liuqin_dsi.video & BIT(i)))
+			continue;
+		ret = msm_dsi_host_stop_video(dsi_mgr_get_dsi(i)->host);
+		if (ret)
+			return ret;
+		liuqin_dsi.video &= ~BIT(i);
+	}
+	return 0;
+}
+
+static int liuqin_dsi_power_off(void)
+{
+	struct msm_dsi *master = dsi_mgr_get_dsi(DSI_CLOCK_MASTER);
+	int i, id, ret;
+
+	if (!liuqin_dsi.powered)
+		return 0;
+	if (liuqin_dsi.gated) {
+		ret = liuqin_dsi_set_gating(false);
+		if (ret)
+			return ret; /* Keep clocks/rails until a safe retry. */
+		liuqin_dsi.gated = false;
+	}
+	for (i = 0; i < DSI_MAX; i++) {
+		msm_dsi_host_disable(dsi_mgr_get_dsi(i)->host);
+		msm_dsi_host_disable_irq(dsi_mgr_get_dsi(i)->host);
+	}
+	liuqin_dsi.video = 0;
+	msm_dsi_phy_pll_save_state(master->phy);
+	for (i = 0; i < DSI_MAX; i++) {
+		id = liuqin_oem_shutdown_order ? DSI_MAX - 1 - i : i;
+		msm_dsi_host_power_off(dsi_mgr_get_dsi(id)->host);
+	}
+	dsi_mgr_phy_disable(DSI_CLOCK_MASTER);
+	liuqin_dsi.powered = false;
+	pr_info("Liuqin DSI: link pair off, before_rails=%u\n",
+		liuqin_oem_shutdown_order);
+	return 0;
+}
+
+static int liuqin_dsi_power_on(struct drm_bridge *bridge)
+{
+	int ret;
+
+	if (liuqin_dsi.powered)
+		return -EBUSY;
+	liuqin_dsi.active = true;
+	liuqin_dsi.video = 0;
+	liuqin_dsi.gated = false;
+	if (liuqin_oem_clk_gating) {
+		ret = liuqin_dsi_set_gating(false);
+		if (ret)
+			return ret;
+	}
+	ret = dsi_mgr_bridge_power_on(bridge);
+	if (ret)
+		return ret;
+	liuqin_dsi.powered = true;
+	if (liuqin_oem_clk_gating) {
+		/* A failed write may be partial; require a clear before teardown. */
+		liuqin_dsi.gated = true;
+		ret = liuqin_dsi_set_gating(true);
+		if (ret)
+			goto fail;
+	}
+	pr_info("Liuqin DSI: command pair ready, video=%u shutdown=%u gating=%u\n",
+		liuqin_oem_video_order, liuqin_oem_shutdown_order,
+		liuqin_oem_clk_gating);
+	if (liuqin_oem_video_order)
+		return 0;
+	ret = liuqin_dsi_video_start();
+	if (!ret)
+		return 0;
+fail:
+	liuqin_dsi_power_off();
+	return ret;
+}
+
+int msm_dsi_manager_panel_stage(int id, enum mipi_dsi_panel_stage stage)
+{
+	int ret = 0;
+
+	if (id != DSI_CLOCK_MASTER || !liuqin_dsi_requested())
+		return 0;
+	mutex_lock(&dsi_cmd_lock);
+	if (!liuqin_dsi.active) {
+		ret = -EIO;
+		goto out;
+	}
+	switch (stage) {
+	case MIPI_DSI_PANEL_PREPARED:
+		ret = liuqin_dsi_video_start();
+		break;
+	case MIPI_DSI_PANEL_DISABLING:
+		if (liuqin_oem_shutdown_order) {
+			ret = liuqin_dsi_video_stop();
+			if (!ret)
+				pr_info("Liuqin DSI: video stopped before panel OFF\n");
+		}
+		break;
+	case MIPI_DSI_PANEL_UNPREPARING:
+		if (liuqin_oem_shutdown_order)
+			ret = liuqin_dsi_power_off();
+		break;
+	case MIPI_DSI_PANEL_PREPARE_FAILED:
+		ret = liuqin_dsi_power_off();
+		break;
+	default:
+		ret = -EINVAL;
+	}
+out:
+	mutex_unlock(&dsi_cmd_lock);
+	return ret;
+}
+
 static void dsi_mgr_bridge_pre_enable(struct drm_bridge *bridge)
 {
 	int id = dsi_mgr_bridge_get_id(bridge);
@@ -291,6 +528,15 @@
 	/* Do nothing with the host if it is slave-DSI in case of bonded DSI */
 	if (is_bonded_dsi && !IS_MASTER_DSI_LINK(id))
 		return;
+
+	if (liuqin_dsi_requested()) {
+		mutex_lock(&dsi_cmd_lock);
+		ret = liuqin_dsi_power_on(bridge);
+		mutex_unlock(&dsi_cmd_lock);
+		if (ret)
+			dev_err(&msm_dsi->pdev->dev, "DSI staged power on: %d\n", ret);
+		return;
+	}
 
 	ret = dsi_mgr_bridge_power_on(bridge);
 	if (ret) {
@@ -343,6 +589,17 @@
 	int ret;
 
 	DBG("id=%d", id);
+
+	if (liuqin_dsi.active) {
+		if (!IS_MASTER_DSI_LINK(id))
+			return;
+		mutex_lock(&dsi_cmd_lock);
+		ret = liuqin_dsi_power_off();
+		mutex_unlock(&dsi_cmd_lock);
+		if (ret)
+			dev_err(&msm_dsi->pdev->dev, "DSI staged power off: %d\n", ret);
+		return;
+	}
 
 	/*
 	 * Do nothing with the host if it is slave-DSI in case of bonded DSI.
diff --git a/drivers/gpu/drm/panel/panel-novatek-nt36532.c b/drivers/gpu/drm/panel/panel-novatek-nt36532.c
--- a/drivers/gpu/drm/panel/panel-novatek-nt36532.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36532.c
@@ -1688,6 +1688,7 @@
 	ret = nt36532_enable_supplies(ctx);
 	if (ret < 0) {
 		dev_err(dev, "Failed to enable regulators: %d\n", ret);
+		mipi_dsi_panel_stage(ctx->dsi[0], MIPI_DSI_PANEL_PREPARE_FAILED);
 		return ret;
 	}
 
@@ -1728,9 +1729,15 @@
 
 	msleep(120);
 
+	ret = mipi_dsi_panel_stage(ctx->dsi[0], MIPI_DSI_PANEL_PREPARED);
+	if (ret)
+		goto fail;
 	return 0;
 
 fail:
+	/* On a host cleanup error keep rails until the later disable retry. */
+	if (mipi_dsi_panel_stage(ctx->dsi[0], MIPI_DSI_PANEL_PREPARE_FAILED))
+		return ret;
 	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
 	nt36532_disable_supplies(ctx);
 	return ret;
@@ -1780,6 +1787,9 @@
 
 	liuqin_esd_stop(ctx, false);
 	liuqin_cancel_dimming(ctx, false);
+	ret = mipi_dsi_panel_stage(ctx->dsi[0], MIPI_DSI_PANEL_DISABLING);
+	if (ret)
+		return ret;
 	ret = nt36532_off(ctx);
 	if (ret < 0)
 		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
@@ -1790,10 +1800,15 @@
 static int nt36532_unprepare(struct drm_panel *panel)
 {
 	struct nt36532 *ctx = to_nt36532(panel);
+	int ret;
 
 	liuqin_esd_stop(ctx, false);
 
 	liuqin_cancel_dimming(ctx, false);
+
+	ret = mipi_dsi_panel_stage(ctx->dsi[0], MIPI_DSI_PANEL_UNPREPARING);
+	if (ret)
+		return ret;
 
 	ctx->dsi[0]->mode_flags &= ~MIPI_DSI_MODE_LPM;
 	if (ctx->dsi[1])
@@ -1986,6 +2001,8 @@
 		ctx->dsi[i]->lanes = 4;
 		ctx->dsi[i]->format = MIPI_DSI_FMT_RGB888;
 		ctx->dsi[i]->mode_flags = ctx->desc->mode_flags;
+		if (ctx->desc == &liuqin_desc && ctx->oem_panel)
+			ctx->dsi[i]->mode_flags |= MIPI_DSI_MODE_PANEL_STAGES;
 
 		ret = devm_mipi_dsi_attach(dev, ctx->dsi[i]);
 
